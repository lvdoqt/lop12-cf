---
import Layout from '../layouts/Layout.astro';
import { db } from '../services/db';
export const prerender = false;

const user = Astro.locals.user;
const all = (await db.getExams()).filter(e => e.exam_type === 'vsat');
const subjects = await db.getSubjects();
const ids = all.map(e => e.id);
const [counts, attempts] = await Promise.all([db.getExamQuestionCounts(ids), db.getExamAttemptCounts(ids)]);
const url = new URL(Astro.request.url);
const subject = url.searchParams.get('mon') || '';
const query = (url.searchParams.get('q') || '').toLowerCase();
const exams = all.filter(e => (!subject || e.subject_id === subject) && (!query || e.title.toLowerCase().includes(query)));
---
<Layout title="Thi thử V-SAT online" showSidebar={false} description="Luyện thi V-SAT trên máy tính với giao diện mô phỏng phòng thi, bấm giờ và chấm điểm tự động.">
  <section class="relative overflow-hidden rounded-3xl bg-[#062e45] px-6 py-10 text-white md:px-12 md:py-14">
    <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full border-[48px] border-cyan-300/10"></div>
    <div class="relative max-w-3xl">
      <span class="rounded-full border border-cyan-200/30 bg-cyan-200/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-cyan-100">Standardized University Admissions Test for Vietnam</span>
      <h1 class="mt-5 font-serif text-4xl font-black md:text-5xl">Luyện thi V-SAT<br/><span class="text-cyan-300">như tại phòng máy</span></h1>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-sky-100/80">Làm bài độc lập theo môn, đồng hồ đếm ngược, phiếu trả lời cố định và các định dạng câu hỏi đặc trưng của V-SAT. Bộ luyện bám cấu trúc đề minh họa Toán và Tiếng Anh năm 2025 do Đại học Cần Thơ công bố.</p>
      <div class="mt-6 flex flex-wrap gap-2 text-xs font-bold"><span class="rounded-lg bg-white/10 px-3 py-2">Thi hoàn toàn trên máy tính</span><span class="rounded-lg bg-white/10 px-3 py-2">Toán & Ngữ văn: 90 phút</span><span class="rounded-lg bg-white/10 px-3 py-2">Các môn còn lại: 60 phút</span></div>
    </div>
  </section>

  <section class="my-8 grid gap-3 md:grid-cols-5">
    {[['01','Đúng / Sai','Nhiều mệnh đề trong một câu'],['02','Chọn A–D','Có thể theo nhóm ngữ liệu'],['03','Ghép cặp','4 nội dung với tối đa 6 phương án'],['04','Trả lời ngắn','Nhập trực tiếp kết quả'],['05','Điền một từ','Open cloze môn Tiếng Anh']].map(x => <div class="rounded-2xl border border-slate-200 bg-white p-4"><b class="text-xs text-cyan-700">{x[0]}</b><h2 class="mt-1 font-bold text-slate-800">{x[1]}</h2><p class="mt-1 text-xs text-slate-500">{x[2]}</p></div>)}
  </section>

  <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center">
    <form class="flex flex-1 gap-2" action="/v-sat"><input name="q" value={url.searchParams.get('q') || ''} placeholder="Tìm đề V-SAT…" class="min-w-0 flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm"/><select name="mon" class="rounded-xl border border-slate-200 px-3 text-sm"><option value="">Tất cả môn</option>{subjects.map(s => <option value={s.id} selected={subject === s.id}>{s.name}</option>)}</select><button class="rounded-xl bg-sky-800 px-5 text-sm font-bold text-white">Lọc</button></form>
    {user && ['admin','teacher'].includes(user.role) && <a href="/admin/v-sat/new" class="rounded-xl bg-cyan-600 px-5 py-2.5 text-center text-sm font-bold text-white">+ Tạo đề V-SAT</a>}
  </div>

  {exams.length ? <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{exams.map(e => <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg"><div class="h-2 bg-gradient-to-r from-sky-800 to-cyan-400"></div><div class="p-5"><div class="flex justify-between text-xs font-bold text-sky-700"><span>V-SAT · {e.subject?.name || 'Đề thi'}</span><span>{e.duration} phút</span></div><h2 class="mt-3 line-clamp-2 text-lg font-bold text-slate-800">{e.title}</h2><div class="my-4 flex gap-4 text-xs text-slate-500"><span>{counts[e.id] || 0} câu/ý</span><span>{attempts[e.id] || 0} lượt thi</span></div><a href={`/exams/${e.slug}`} class="block rounded-xl bg-[#075985] px-4 py-3 text-center text-sm font-bold text-white group-hover:bg-sky-700">Vào phòng thi →</a></div></article>)}</div> : <div class="rounded-2xl border border-dashed border-slate-300 py-16 text-center"><p class="font-bold text-slate-700">Chưa có đề V-SAT phù hợp</p><p class="mt-1 text-sm text-slate-500">Giáo viên có thể tạo đề đầu tiên trong trang quản trị.</p></div>}

  <section class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-950"><h2 class="font-bold">Lưu ý về cấu trúc</h2><p class="mt-2 leading-6">Cấu trúc có thể được đơn vị tổ chức cập nhật theo từng năm. Trang này mô phỏng đề minh họa Toán 2025 bạn cung cấp; khi dùng để đăng ký/xét tuyển, hãy kiểm tra thông báo mới nhất trên website chính thức của Đại học Cần Thơ.</p><a class="mt-3 inline-block font-bold underline" href="https://vsat.ctu.edu.vn/gioi-thieu" target="_blank" rel="noreferrer">Xem thông tin V-SAT chính thức</a></section>
</Layout>
