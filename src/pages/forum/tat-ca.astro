---
import Layout from '../../layouts/Layout.astro';
import ForumThreadList from '../../components/forum/ForumThreadList.astro';
import { db } from '../../services/db';
import type { ForumThreadStatus } from '../../types';

const q = Astro.url.searchParams.get('q')?.trim() || '';
const statusParam = Astro.url.searchParams.get('status') || 'all';
const status = (['all', 'open', 'solved'] as const).includes(statusParam as any)
  ? statusParam as ForumThreadStatus | 'all'
  : 'all';
const sortParam = Astro.url.searchParams.get('sort') || 'latest';
const sort = (['latest', 'active', 'popular'] as const).includes(sortParam as any)
  ? sortParam as 'latest' | 'active' | 'popular'
  : 'latest';
const tag = Astro.url.searchParams.get('tag')?.trim() || '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const pageSize = 20;

const [threadPage, categories] = await Promise.all([
  db.getForumThreadPage({ search: q, status, sort, tag }, page, pageSize),
  db.getForumCategories(),
]);
const threads = threadPage.threads;
---

<Layout
  title="Tất cả bài viết | Diễn đàn Học sinh"
  description="Tìm kiếm và khám phá mọi câu hỏi, thảo luận trên diễn đàn học sinh Lớp 12."
  canonical="/forum/tat-ca"
  breadcrumbs={[{ name: 'Diễn đàn Học sinh', url: '/forum' }, { name: 'Tất cả bài viết', url: '/forum/tat-ca' }]}
>
  <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
    <ForumThreadList
      threads={threads}
      actionUrl="/forum/tat-ca"
      search={q}
      status={status}
      sort={sort}
      showCategory={true}
      tag={tag}
      page={threadPage.page}
      total={threadPage.total}
      pageSize={threadPage.pageSize}
    />

    <aside class="space-y-5">
      <div class="rounded-2xl border border-violet-200 dark:border-violet-900/50 bg-violet-50/60 dark:bg-violet-950/20 p-5">
        <h2 class="text-sm font-extrabold text-violet-900 dark:text-violet-200">🧠 Tìm câu hỏi tương tự</h2>
        <p class="mt-1 text-[11px] text-violet-800/80 dark:text-violet-300/70">Nhập mô tả bài toán, hệ thống gợi ý các thread liên quan (ngữ nghĩa khi có AI, otherwise tag/từ khoá).</p>
        <form id="forum-semantic-form" class="mt-3 space-y-2">
          <input id="forum-semantic-q" type="search" minlength="3" required placeholder="Ví dụ: khảo sát hàm số có tiệm cận đứng" class="w-full rounded-xl border border-violet-200 bg-white px-3 py-2 text-xs outline-none focus:border-violet-500 dark:border-violet-800 dark:bg-slate-950" />
          <button type="submit" class="w-full rounded-xl bg-violet-600 px-3 py-2 text-xs font-bold text-white hover:bg-violet-700">Tìm kiếm</button>
        </form>
        <div id="forum-semantic-result" class="mt-3 space-y-2 text-xs"></div>
      </div>

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 h-fit">
      <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">📂 Chuyên mục</h2>
      <ul class="mt-3 space-y-1">
        {categories.map(c => (
          <li>
            <a
              href={`/forum/${c.slug}`}
              class="flex items-center justify-between rounded-lg px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition"
            >
              <span class="flex items-center gap-2"><span>{c.icon}</span>{c.name}</span>
              <span class="text-[11px] text-slate-400">{c.thread_count || 0}</span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    </aside>
  </div>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('forum-semantic-form');
    var input = document.getElementById('forum-semantic-q');
    var result = document.getElementById('forum-semantic-result');
    if (!form || !input || !result) return;
    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      var q = input.value.trim();
      if (q.length < 3) return;
      result.innerHTML = '<p class="text-slate-400">Đang tìm...</p>';
      try {
        var response = await fetch(window.withBase('/api/forum/search?q=' + encodeURIComponent(q) + '&limit=6'));
        var data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Không thể tìm kiếm.');
        if (!data.threads || !data.threads.length) {
          result.innerHTML = '<p class="text-slate-500">Không tìm thấy thread nào khớp.</p>';
          return;
        }
        result.innerHTML = '<p class="text-[10px] font-semibold uppercase tracking-wide text-violet-500">' +
          (data.semantic ? 'Kết quả ngữ nghĩa' : 'Kết quả gần nhất') + '</p>' +
          data.threads.map(function (t) {
            return '<a class="block rounded-lg px-2 py-1.5 hover:bg-violet-100 dark:hover:bg-violet-950/40" href="' +
              window.withBase('/forum/' + encodeURIComponent(t.category?.slug || '') + '/' + encodeURIComponent(t.slug)) + '">' +
              t.title + '</a>';
          }).join('');
      } catch (error) {
        result.innerHTML = '<p class="text-rose-600">' + (error.message || 'Có lỗi xảy ra.') + '</p>';
      }
    });
  })();
</script>
