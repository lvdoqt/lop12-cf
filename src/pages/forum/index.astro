---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../services/db';
import { forumExcerpt } from '../../lib/markdown';
import { forumNumber, forumRelativeTime } from '../../lib/forum-format';

const user = Astro.locals.user;
const [categories, latestThreads, activeThreads, unsolvedThreads, stats] = await Promise.all([
  db.getForumCategories(),
  db.getForumThreads({ sort: 'latest', limit: 8 }),
  db.getForumThreads({ sort: 'active', limit: 5 }),
  db.getForumThreads({ status: 'open', sort: 'active', limit: 5 }),
  db.getForumStats(),
]);

---

<Layout
  title="Diễn đàn Học sinh"
  description="Nơi học sinh lớp 12 hỏi đáp, chia sẻ kinh nghiệm học tập và giải đáp thắc mắc theo từng môn học."
  canonical="/forum"
>
  <div class="flex flex-col space-y-8">
    <!-- Hero -->
    <section class="order-1 relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-600 p-5 sm:p-7 md:p-10 text-white shadow-xl shadow-blue-600/20">
      <div class="absolute -right-16 -top-20 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
      <div class="absolute -bottom-24 right-32 h-56 w-56 rounded-full bg-cyan-300/20 blur-3xl"></div>
      <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 sm:gap-8">
        <div class="max-w-2xl">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-bold tracking-wide">
            💬 CỘNG ĐỒNG HỌC TẬP LỚP 12
          </span>
          <h1 class="mt-4 text-2xl sm:text-3xl md:text-4xl font-extrabold leading-tight">Diễn đàn Học sinh</h1>
          <p class="mt-3 text-blue-50/90 text-sm md:text-base leading-relaxed">
            Hỏi bài khó, chia sẻ cách học, tìm người cùng ôn thi. Mọi thắc mắc đều có chỗ ở đây —
            và câu trả lời hay sẽ được giáo viên xác nhận.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            {user ? (
              <a href="/forum/dang-bai" class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-blue-700 shadow-lg hover:bg-blue-50 transition">
                ✍️ Đăng bài hỏi đáp
              </a>
            ) : (
              <a href="/login" class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-blue-700 shadow-lg hover:bg-blue-50 transition">
                🔑 Đăng nhập để tham gia
              </a>
            )}
            <a href="#chuyen-muc" class="inline-flex items-center gap-2 rounded-xl border border-white/30 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10 transition">
              Khám phá chuyên mục ↓
            </a>
          </div>
        </div>

        <div class="grid grid-cols-4 lg:grid-cols-2 gap-2 sm:gap-3 w-full lg:w-80 shrink-0">
          {[
            { label: 'Bài viết', value: stats.threads, icon: '📝' },
            { label: 'Trả lời', value: stats.replies, icon: '💬' },
            { label: 'Đã giải', value: stats.solved, icon: '✅' },
            { label: 'Thành viên', value: stats.members, icon: '👥' },
          ].map(item => (
            <div class="rounded-xl sm:rounded-2xl bg-white/10 border border-white/15 p-2.5 sm:p-4 backdrop-blur-sm text-center lg:text-left">
              <div class="text-base sm:text-xl">{item.icon}</div>
              <div class="mt-0.5 sm:mt-1 text-base sm:text-2xl font-extrabold">{forumNumber(item.value)}</div>
              <div class="text-[10px] sm:text-[11px] text-blue-100/80 font-medium truncate">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Chuyên mục (dưới bài viết mới trên cả mobile và desktop) -->
    <section id="chuyen-muc" class="order-3">
      <div class="flex items-end justify-between mb-4">
        <div>
          <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Chuyên mục</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Chọn môn học hoặc chủ đề bạn quan tâm.</p>
        </div>
        <a href="/forum/bang-xep-hang" class="text-xs font-semibold text-blue-600 hover:underline">🏆 Bảng xếp hạng →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map(cat => (
          <a
            href={`/forum/${cat.slug}`}
            class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 dark:bg-blue-950/40 text-2xl">
                {cat.icon || '📚'}
              </div>
              <div class="min-w-0">
                <h3 class="font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                  {cat.name}
                </h3>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 line-clamp-2">{cat.description}</p>
                <p class="mt-3 text-[11px] font-semibold text-blue-600 dark:text-blue-400">
                  {forumNumber(cat.thread_count || 0)} bài viết →
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Threads (lên trên chuyên mục trên cả mobile và desktop) -->
    <section class="order-2 grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 px-5 py-4">
          <h2 class="font-extrabold text-slate-900 dark:text-white">🆕 Bài viết mới nhất</h2>
          <a href="/forum/tat-ca" class="text-xs font-semibold text-blue-600 hover:underline">Xem tất cả</a>
        </div>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800">
          {latestThreads.map(thread => (
            <li class="px-5 py-4 hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
              <div class="flex items-start gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 text-lg">
                  {thread.category?.icon || '💬'}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <a
                      href={`/forum/${thread.category?.slug}/${thread.slug}`}
                      class="font-bold text-slate-900 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400 line-clamp-1"
                    >
                      {thread.is_pinned && <span class="mr-1">📌</span>}{thread.title}
                    </a>
                    {thread.status === 'solved' && (
                      <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 dark:text-emerald-300">Đã giải</span>
                    )}
                  </div>
                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 line-clamp-1">{forumExcerpt(thread.body, 150)}</p>
                  <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-400 dark:text-slate-500">
                    <span class="font-medium text-slate-600 dark:text-slate-300">{thread.is_anonymous ? 'Ẩn danh' : (thread.author?.fullname || 'Thành viên')}</span>
                    <span>trong {thread.category?.name}</span>
                    <span>• {forumRelativeTime(thread.created_at)}</span>
                    <span>• 💬 {thread.reply_count}</span>
                    <span>• 👁 {forumNumber(thread.views_count)}</span>
                  </div>
                </div>
              </div>
            </li>
          ))}
          {latestThreads.length === 0 && (
            <li class="px-5 py-10 text-center text-sm text-slate-500">Chưa có bài viết nào. Hãy là người đầu tiên!</li>
          )}
        </ul>
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
          <div class="border-b border-slate-100 dark:border-slate-800 px-5 py-4">
            <h2 class="font-extrabold text-slate-900 dark:text-white">🔥 Đang thảo luận</h2>
          </div>
          <ul class="divide-y divide-slate-100 dark:divide-slate-800">
            {activeThreads.map((thread, i) => (
              <li class="px-5 py-3">
                <a href={`/forum/${thread.category?.slug}/${thread.slug}`} class="group flex gap-3">
                  <span class="text-lg font-black text-slate-300 dark:text-slate-600 group-hover:text-blue-500">{i + 1}</span>
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold text-slate-800 dark:text-slate-200 line-clamp-2 group-hover:text-blue-600">{thread.title}</span>
                    <span class="mt-1 block text-[11px] text-slate-400">{forumRelativeTime(thread.last_activity_at)} · {thread.reply_count} trả lời</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/70 dark:bg-amber-950/20 p-5">
          <h2 class="font-extrabold text-amber-900 dark:text-amber-200">🙋 Cần người giải đáp</h2>
          <p class="mt-1 text-xs text-amber-800/80 dark:text-amber-300/70">Những câu hỏi đang chờ câu trả lời đầu tiên.</p>
          <ul class="mt-4 space-y-3">
            {unsolvedThreads.map(thread => (
              <li>
                <a href={`/forum/${thread.category?.slug}/${thread.slug}`} class="block text-sm font-medium text-amber-900 dark:text-amber-100 hover:underline line-clamp-2">
                  {thread.title}
                </a>
              </li>
            ))}
            {unsolvedThreads.length === 0 && <li class="text-xs text-amber-700">Mọi câu hỏi đều đã có người giải đáp 🎉</li>}
          </ul>
        </div>
      </div>
    </section>
  </div>
</Layout>
