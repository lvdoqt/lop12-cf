---
import Layout from "../../../../layouts/Layout.astro";
import QuestionCard from "../../../../components/QuestionCard.astro";
import ReadListQuestion from "../../../../components/ReadListQuestion";
import MatchingQuestion from "../../../../components/MatchingQuestion";
import ClozeTextQuestion from "../../../../components/ClozeTextQuestion";
import { db } from "../../../../services/db";
import {
  uuidToSeed,
  mulberry32,
  shuffleArrayWithPRNG,
} from "../../../../lib/random";

export const prerender = false;

const { id, attemptId } = Astro.params;
if (!id || !attemptId) {
  return Astro.redirect("/dashboard");
}

const user = Astro.locals.user;
// Accept both slug and UUID
const exam = await db.getExamBySlug(id);
const attempt = await db.getAttemptById(attemptId);

if (!exam || !attempt) {
  return Astro.redirect("/de-thi");
}

if (attempt.user_id && attempt.user_id !== user?.id) {
  return Astro.redirect("/dashboard");
}

const allQuestions = await db.getQuestionsByExamId(exam.id);

import { buildShuffledExam } from "../../../../lib/exam";

const prng = mulberry32(uuidToSeed(attempt.id));
const rawQuestions = buildShuffledExam(allQuestions, prng);
const isVsatExam = exam.exam_type === 'vsat';
const isEnglishVsat = isVsatExam && exam.subject?.slug === 'tieng-anh-12';

let currentIndex = 1;
const questions = rawQuestions.map((q) => {
  const startIndex = currentIndex;
  let count = 1;
  if (q.type === "read" || q.type === "list" || q.type === "read_cloze" || q.type === "cloze_text") {
    count = (q.metadata as any)?.questions?.length || 1;
  }
  currentIndex += count;
  return { ...q, globalIndex: startIndex };
});

const hasMcq = questions.some(
  (q) => q.type === "single_choice",
);
const hasRead = questions.some((q) => q.type === "read");
const hasReadCloze = questions.some((q) => q.type === "read_cloze");
const groupEnglishTypes = hasMcq || hasRead || hasReadCloze;

const mcqQuestions = questions.filter(
  (q) =>
    q.type === "single_choice" ||
    (groupEnglishTypes && (q.type === "read" || q.type === "read_cloze")),
);
const multipleChoiceQuestions = questions.filter(
  (q) => q.type === "multiple_choice",
);
const msqQuestions = questions.filter((q) => q.type === "msq");
const saQuestions = questions.filter((q) => q.type === "sa");
const trueFalseQuestions = questions.filter((q) => q.type === "true_false");
const tlQuestions = questions.filter((q) => q.type === "tl");
const readQuestions = questions.filter(
  (q) => !groupEnglishTypes && q.type === "read",
);
const readClozeQuestions = questions.filter(
  (q) => !groupEnglishTypes && q.type === "read_cloze",
);
const listQuestions = questions.filter((q) => q.type === "list");
const matchingQuestions = questions.filter((q) => q.type === "matching");
const clozeTextQuestions = questions.filter((q) => q.type === "cloze_text");

const allSections = [
  { key: "read", label: "Đọc hiểu", items: readQuestions },
  { key: "read_cloze", label: "Điền vào chỗ trống", items: readClozeQuestions },
  { key: "list", label: "Kỹ năng nghe", items: listQuestions },
  { key: "matching", label: "Câu hỏi ghép cặp", items: matchingQuestions },
  { key: "cloze_text", label: "Điền một từ vào chỗ trống", items: clozeTextQuestions },
  {
    key: "mcq",
    label: "Câu trắc nghiệm chọn 1 phương án",
    items: mcqQuestions,
  },
  {
    key: "multiple_choice",
    label: "Câu hỏi chọn nhiều đáp án",
    items: multipleChoiceQuestions,
  },
  { key: "msq", label: "Câu trắc nghiệm đúng sai", items: msqQuestions },
  { key: "sa", label: "Câu trắc nghiệm trả lời ngắn", items: saQuestions },
  {
    key: "true_false",
    label: "Câu trắc nghiệm đúng/sai đơn",
    items: trueFalseQuestions,
  },
  { key: "tl", label: "Câu tự luận", items: tlQuestions },
];
const vsatSections = [
  { key: "msq", label: isEnglishVsat ? "PART 1 – Questions 1–9: TRUE / FALSE" : "Phần 1 – Câu hỏi Đúng / Sai", items: msqQuestions },
  { key: "mcq", label: isEnglishVsat ? "PART 2 – Questions 10–15: READING" : "Phần 2 – Trắc nghiệm 4 lựa chọn", items: mcqQuestions },
  { key: "matching", label: isEnglishVsat ? "PART 3 – Questions 16–20: MATCHING" : "Phần 3 – Câu hỏi Ghép hợp", items: matchingQuestions },
  { key: "cloze_text", label: isEnglishVsat ? "PART 4 – Questions 21–25: OPEN CLOZE" : "Phần 4 – Trả lời ngắn", items: clozeTextQuestions },
  { key: "sa", label: "Phần 4 – Trả lời ngắn", items: saQuestions },
];
const activeSections = (isVsatExam ? vsatSections : allSections).filter((s) => s.items.length > 0);
const Roman = (n: number) =>
  ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"][n - 1] || String(n);

// 1. Calculate time spent
const timeSpentMs = attempt.finished_at
  ? new Date(attempt.finished_at).getTime() -
    new Date(attempt.started_at).getTime()
  : 0;
const timeSpentMin = Math.floor(timeSpentMs / (60 * 1000));
const timeSpentSec = Math.floor((timeSpentMs % (60 * 1000)) / 1000);
const timeSpentStr =
  timeSpentMin > 0
    ? `${timeSpentMin} phút ${timeSpentSec} giây`
    : `${timeSpentSec} giây`;

// 2. Calculate correct answers count
let correctCount = 0;
let totalCount = 0;
questions.forEach((q) => {
  if (q.type === "cloze_text") {
    const blanks = (q.metadata as any)?.questions || [];
    totalCount += blanks.length;
    const submitted = attempt.answers_submitted?.[q.id];
    if (submitted && typeof submitted === "object" && !Array.isArray(submitted)) {
      blanks.forEach((blank: any, i: number) => {
        const actual = String((submitted as Record<string, string>)[String(i)] || '').trim().toLowerCase();
        const accepted = (Array.isArray(blank.accepted_answers) ? blank.accepted_answers : [blank.correct_answer]).map((x: any) => String(x || '').trim().toLowerCase());
        if (actual && accepted.includes(actual)) correctCount++;
      });
    }
    return;
  }
  if (q.type === "matching") {
    totalCount += 1;
    const pairs = (q.metadata as any)?.questions || [];
    const submitted = attempt.answers_submitted?.[q.id];
    if (submitted && typeof submitted === "object" && !Array.isArray(submitted) && pairs.length && pairs.every((p: any, i: number) => String((submitted as Record<string,string>)[String(i)] || '').toUpperCase() === String(p.correct_option || '').toUpperCase())) correctCount++;
    return;
  }
  if (q.type === "read" || q.type === "list" || q.type === "read_cloze") {
    const subs = (q.metadata && (q.metadata as any).questions) || [];
    totalCount += subs.length;
    const submitted = attempt.answers_submitted?.[q.id];
    if (
      submitted &&
      typeof submitted === "object" &&
      !Array.isArray(submitted)
    ) {
      subs.forEach((sq: any, i: number) => {
        const sel = (submitted as Record<string, string>)[String(i)];
        if (
          sel &&
          String(sel).toUpperCase() ===
            String(sq.correct_option || "").toUpperCase()
        ) {
          correctCount++;
        }
      });
    }
    return;
  }

  totalCount += 1;
  const submitted = attempt.answers_submitted?.[q.id];
  const correctAnswers = q.answers.filter((a) => a.is_correct).map((a) => a.id);

  if (!submitted) return;

  if (q.type === "single_choice" || q.type === "true_false") {
    const selectedId =
      typeof submitted === "string" ? submitted : (submitted as string[])[0];
    if (correctAnswers.includes(selectedId)) {
      correctCount++;
    }
  } else if (q.type === "multiple_choice") {
    const selectedIds = Array.isArray(submitted)
      ? (submitted as string[])
      : [submitted as string];
    const allCorrectSelected = correctAnswers.every((id) =>
      selectedIds.includes(id),
    );
    const noIncorrectSelected = selectedIds.every((id) =>
      correctAnswers.includes(id),
    );
    if (
      allCorrectSelected &&
      noIncorrectSelected &&
      correctAnswers.length === selectedIds.length
    ) {
      correctCount++;
    }
  } else if (q.type === "msq") {
    if (typeof submitted === "object" && submitted !== null) {
      let allCorrect = true;
      q.answers.forEach((a) => {
        const studentChoice = (submitted as any)[a.id];
        const correctChoice = a.is_correct ? "Đúng" : "Sai";
        if (studentChoice !== correctChoice) {
          allCorrect = false;
        }
      });
      if (allCorrect && q.answers.length > 0) {
        correctCount++;
      }
    }
  } else if (q.type === "sa") {
    if (typeof submitted === "string" && q.answer) {
      const normSubmitted = submitted
        .trim()
        .toLowerCase()
        .replace(/\s+/g, " ")
        .replace(",", ".");
      const normCorrect = q.answer
        .trim()
        .toLowerCase()
        .replace(/\s+/g, " ")
        .replace(",", ".");

      if (normSubmitted === normCorrect) {
        correctCount++;
      } else {
        const numSubmitted = Number(normSubmitted);
        const numCorrect = Number(normCorrect);
        if (
          !isNaN(numSubmitted) &&
          !isNaN(numCorrect) &&
          numSubmitted === numCorrect
        ) {
          correctCount++;
        }
      }
    }
  }
});

const score = attempt.score !== null ? Number(attempt.score) : 0;
const isVsat = isVsatExam;
const rawScore = Number(attempt.raw_score ?? score);
const abilityScore = attempt.ability_score == null ? null : Number(attempt.ability_score);
const themeScore = isVsat ? rawScore / 15 : score;

// 3. Theme color according to score
let scoreTheme = {
  bg: "bg-emerald-50 border-emerald-200/50 dark:bg-emerald-950/20 dark:border-emerald-900/35",
  text: "text-emerald-700 dark:text-emerald-400",
  title: "Xuất sắc!",
  desc: "Chúc mừng cậu nhé! Cậu đã nắm rất chắc kiến thức này.",
};

if (themeScore < 5.0) {
  scoreTheme = {
    bg: "bg-rose-50 border-rose-200/50 dark:bg-rose-950/20 dark:border-rose-900/35",
    text: "text-rose-700 dark:text-rose-400",
    title: "Cần cố gắng thêm!",
    desc: "Đừng nản lòng nhé. Hãy xem kỹ lời giải chi tiết và ôn lại bài học lý thuyết.",
  };
} else if (themeScore < 8.0) {
  scoreTheme = {
    bg: "bg-amber-50 border-amber-200/50 dark:bg-amber-950/20 dark:border-amber-900/35",
    text: "text-amber-700 dark:text-amber-400",
    title: "Khá tốt!",
    desc: "Cậu làm tốt lắm. Chỉ cần ôn luyện thêm một chút để đạt điểm tối đa nha.",
  };
}
---

<Layout title={`Kết quả thi: ${exam.title}`}>
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumb header -->
    <div>
      <a
        href={user ? "/dashboard" : "/"}
        class="inline-flex items-center text-xs font-bold text-gray-400 hover:text-gray-600 dark:hover:text-slate-350 transition-colors uppercase tracking-wider mb-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 mr-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {user ? "Quay lại Bảng điều khiển" : "Quay lại trang chủ"}
      </a>

      <h1
        class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight leading-snug"
      >
        Kết quả làm bài thi
      </h1>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">{exam.title}</p>
    </div>

    <!-- Score Visual Card -->
    <div
      class={`border rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 ${scoreTheme.bg}`}
    >
      <div class="text-center md:text-left space-y-2">
        <span
          class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-white/70 dark:bg-slate-900/80 border border-black/5 dark:border-white/5 uppercase tracking-wider"
        >
          {scoreTheme.title}
        </span>
        <p
          class="text-sm font-medium text-gray-600 dark:text-slate-300 leading-relaxed max-w-md"
        >
          {scoreTheme.desc}
        </p>
        <!-- Score progress bar -->
        <div class="w-full max-w-xs mt-3">
          <div class="flex justify-between text-xs font-semibold text-gray-500 dark:text-slate-400 mb-1">
            <span>0</span><span>{isVsat ? '150' : '10'}</span>
          </div>
          <div class="h-2.5 bg-white/40 dark:bg-slate-800/60 rounded-full overflow-hidden">
            <div
              class={`h-full rounded-full transition-all ${themeScore >= 8 ? 'bg-emerald-500' : themeScore >= 5 ? 'bg-amber-500' : 'bg-rose-500'}`}
              style={`width: ${Math.min(100, themeScore * 10)}%`}
            ></div>
          </div>
        </div>
      </div>

      <!-- Grade Circle -->
      <div
        class="w-32 h-32 rounded-full border-4 border-white dark:border-slate-800 bg-white dark:bg-slate-900 shadow-lg flex flex-col items-center justify-center flex-shrink-0"
      >
        <span class={`text-4xl font-black ${scoreTheme.text}`}>{isVsat ? rawScore : score}</span>
        <span
          class="text-[10px] font-bold text-gray-400 dark:text-slate-500 uppercase tracking-widest mt-0.5"
          >{isVsat ? 'điểm thô / 150' : 'trên 10'}</span
        >
      </div>
    </div>

    {isVsat && (
      <div class="grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-sky-200 bg-sky-50 p-5 dark:border-sky-900 dark:bg-sky-950/20">
          <p class="text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-400">Điểm thô V-SAT</p>
          <p class="mt-1 text-3xl font-black text-sky-950 dark:text-white">{rawScore} <span class="text-sm font-semibold text-sky-700 dark:text-sky-400">/ 150</span></p>
          <p class="mt-2 text-xs leading-5 text-sky-800 dark:text-sky-300">Tính trực tiếp theo số tiểu mục đúng và trọng số của từng dạng câu hỏi.</p>
        </div>
        <div class="rounded-2xl border border-violet-200 bg-violet-50 p-5 dark:border-violet-900 dark:bg-violet-950/20">
          <p class="text-xs font-bold uppercase tracking-wider text-violet-700 dark:text-violet-400">Điểm năng lực IRT</p>
          <p class="mt-1 text-3xl font-black text-violet-950 dark:text-white">{abilityScore ?? 'Chưa hiệu chỉnh'}</p>
          <p class="mt-2 text-xs leading-5 text-violet-800 dark:text-violet-300">Cần tham số câu hỏi và dữ liệu mẫu để ước lượng IRT; không quy đổi tuyến tính từ điểm thô.</p>
        </div>
      </div>
    )}

    <!-- Stats Table Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div
        class="bg-white border border-gray-250 dark:bg-slate-900 dark:border-slate-800/80 p-4 rounded-2xl shadow-sm text-center"
      >
        <p class="text-[11px] font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Số câu đúng</p>
        <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1 font-mono">{correctCount} / {totalCount}</p>
      </div>
      <div
        class="bg-white border border-gray-250 dark:bg-slate-900 dark:border-slate-800/80 p-4 rounded-2xl shadow-sm text-center"
      >
        <p class="text-[11px] font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Thời gian</p>
        <p class="text-xl font-bold text-gray-950 dark:text-white mt-1 font-mono">{timeSpentStr}</p>
      </div>
      <div
        class="bg-white border border-gray-250 dark:bg-slate-900 dark:border-slate-800/80 p-4 rounded-2xl shadow-sm text-center"
      >
        <p class="text-[11px] font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Độ chính xác</p>
        <p class="text-xl font-bold text-blue-600 dark:text-blue-400 mt-1 font-mono">
          {totalCount > 0 ? Math.round((correctCount / totalCount) * 100) : 0}%
        </p>
      </div>
      <div
        class="bg-white border border-gray-250 dark:bg-slate-900 dark:border-slate-800/80 p-4 rounded-2xl shadow-sm text-center"
      >
        <p class="text-[11px] font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Câu sai/bỏ trống</p>
        <p class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1 font-mono">{totalCount - correctCount}</p>
      </div>
    </div>

    <!-- Section Summary Table -->
    {activeSections.length > 1 && (
    <div class="bg-white border border-gray-200 dark:bg-slate-900 dark:border-slate-800/80 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-2 h-5 rounded-sm bg-blue-500"></span>
        <h2 class="text-base font-bold text-gray-900 dark:text-white">Tóm tắt theo phần thi</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wide border-b border-gray-100 dark:border-slate-800">
              <th class="text-left pb-2">Phần thi</th>
              <th class="text-center pb-2">Đúng</th>
              <th class="text-center pb-2">Tổng</th>
              <th class="text-center pb-2">Tỷ lệ</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 dark:divide-slate-800/60">
            {activeSections.map(section => {
              // Count correct for this section (simplified - only for standard MCQ types)
              const sectionCorrect = section.items.reduce((acc, q) => {
                if (q.type === 'read' || q.type === 'list' || q.type === 'read_cloze') return acc;
                const sub = attempt.answers_submitted?.[q.id];
                if (!sub) return acc;
                const correctIds = q.answers.filter((a: any) => a.is_correct).map((a: any) => a.id);
                if (q.type === 'single_choice' || q.type === 'true_false') {
                  const sel = typeof sub === 'string' ? sub : (sub as any[])[0];
                  return acc + (correctIds.includes(sel) ? 1 : 0);
                }
                return acc;
              }, 0);
              const sectionTotal = section.items.filter(q => q.type !== 'read' && q.type !== 'list' && q.type !== 'read_cloze').length || section.items.length;
              const pct = sectionTotal > 0 ? Math.round((sectionCorrect / sectionTotal) * 100) : 0;
              return (
              <tr class="text-gray-700 dark:text-slate-300">
                <td class="py-2.5 font-medium">{section.label}</td>
                <td class="py-2.5 text-center font-bold text-emerald-600 dark:text-emerald-400">{sectionCorrect}</td>
                <td class="py-2.5 text-center text-gray-500">{sectionTotal}</td>
                <td class="py-2.5 text-center">
                  <span class={`inline-block px-2 py-0.5 rounded text-xs font-bold ${
                    pct >= 80 ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400'
                    : pct >= 50 ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400'
                    : 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400'
                  }`}>{pct}%</span>
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
    )}

    <!-- Action Buttons -->
    <div class="flex flex-wrap gap-3">
      <a
        href={`/exams/${id}`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow-md shadow-blue-500/10 transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Làm lại đề thi này
      </a>
      <a
        href="/de-thi"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-800 text-sm font-semibold transition"
      >
        Xem đề thi khác
      </a>
      {user && (
      <a
        href="/dashboard"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-800 text-sm font-semibold transition"
      >
        Về trang Dashboard
      </a>
      )}
    </div>

    <!-- Review Questions Header + Filter -->
    <div class="border-t border-gray-250 dark:border-slate-850 pt-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center space-x-2">
          <div class="w-2.5 h-5 rounded-sm bg-blue-600"></div>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white">
            Xem lại chi tiết bài làm
          </h2>
        </div>
        <!-- Filter buttons -->
        <div class="flex items-center gap-2 flex-wrap">
          <button id="filter-all" onclick="filterQuestions('all')" class="result-filter-btn active px-3 py-1.5 rounded-lg text-xs font-bold border border-blue-500 bg-blue-500 text-white transition">
            Tất cả ({totalCount})
          </button>
          <button id="filter-correct" onclick="filterQuestions('correct')" class="result-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-slate-400 hover:border-emerald-500 hover:text-emerald-600 transition">
            ✔ Đúng ({correctCount})
          </button>
          <button id="filter-wrong" onclick="filterQuestions('wrong')" class="result-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-slate-400 hover:border-rose-500 hover:text-rose-600 transition">
            ✘ Sai ({totalCount - correctCount})
          </button>
        </div>
      </div>

      <div id="questions-container" class="space-y-8">
        {
          (() => {
            let sectionCounter = 0;
            return activeSections.map((section) => {
              const isCloze = section.key === "read_cloze";
              if (isCloze) {
                // Không header — render thẳng ReadListQuestion
                return (
                  <div class="space-y-4">
                    {section.items.map((question) => (
                      <ReadListQuestion
                        client:load
                        question={question}
                        index={question.globalIndex}
                        mode="review"
                        selectedAnswers={
                          (attempt.answers_submitted?.[question.id] as Record<
                            string,
                            string
                          >) || {}
                        }
                      />
                    ))}
                  </div>
                );
              }
              sectionCounter++;
              return (
                <div class="space-y-4">
                  <h3 class="text-lg font-bold text-gray-800 dark:text-white border-b border-gray-200 dark:border-slate-700 pb-2">
                    {isVsat ? section.label : `Phần ${Roman(sectionCounter)}. ${section.label}`}
                  </h3>
                  {section.key === "read" || section.key === "list"
                    ? section.items.map((question) => (
                        <ReadListQuestion
                          client:load
                          question={question}
                          index={question.globalIndex}
                          mode="review"
                          selectedAnswers={
                            (attempt.answers_submitted?.[question.id] as Record<
                              string,
                              string
                            >) || {}
                          }
                        />
                      ))
                    : section.items.map((question) => {
                        if (question.type === "matching") {
                          return <MatchingQuestion client:load question={question} index={question.globalIndex} mode="review" selected={(attempt.answers_submitted?.[question.id] as unknown as Record<string, string>) || {}} />;
                        }
                        if (question.type === "cloze_text") {
                          return <ClozeTextQuestion client:load question={question} index={question.globalIndex} mode="review" selected={(attempt.answers_submitted?.[question.id] as unknown as Record<string, string>) || {}} />;
                        }
                        if (
                          question.type === "read" ||
                          question.type === "read_cloze" ||
                          question.type === "list"
                        ) {
                          return (
                            <ReadListQuestion
                              client:load
                              question={question}
                              index={question.globalIndex}
                              mode="review"
                              selectedAnswers={
                                (attempt.answers_submitted?.[
                                  question.id
                                ] as Record<string, string>) || {}
                              }
                            />
                          );
                        }
                        const submittedRaw =
                          attempt.answers_submitted?.[question.id];
                        const selectedAnswers = (
                          Array.isArray(submittedRaw)
                            ? submittedRaw
                            : submittedRaw
                              ? [submittedRaw]
                              : []
                        ) as string[];
                        // Determine if this question was answered correctly for data attribute
                        const correctAnswerIds = question.answers.filter((a: any) => a.is_correct).map((a: any) => a.id);
                        let questionStatus = 'skipped';
                        if (submittedRaw) {
                          if (question.type === 'single_choice' || question.type === 'true_false') {
                            const sel = typeof submittedRaw === 'string' ? submittedRaw : (submittedRaw as any[])[0];
                            questionStatus = correctAnswerIds.includes(sel) ? 'correct' : 'wrong';
                          } else if (question.type === 'multiple_choice') {
                            const sels = Array.isArray(submittedRaw) ? submittedRaw : [submittedRaw];
                            questionStatus = (correctAnswerIds.length === sels.length && correctAnswerIds.every((id: string) => sels.includes(id))) ? 'correct' : 'wrong';
                          } else {
                            // msq, sa, tl — mark as answered
                            questionStatus = 'answered';
                          }
                        }
                        return (
                          <div data-question-status={questionStatus}>
                            <QuestionCard
                              question={question}
                              index={question.globalIndex}
                              mode="review"
                              selectedAnswers={selectedAnswers}
                            />
                          </div>
                        );
                      })}
                </div>
              );
            });
          })()
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  // Client-side filter for question cards
  function filterQuestions(filter: string) {
    const buttons = document.querySelectorAll('.result-filter-btn');
    buttons.forEach(btn => {
      btn.classList.remove('active', 'border-blue-500', 'bg-blue-500', 'text-white', 'border-emerald-500', 'text-emerald-600', 'border-rose-500', 'text-rose-600');
      btn.classList.add('border-gray-200', 'dark:border-slate-700', 'text-gray-600', 'dark:text-slate-400');
    });
    const activeBtn = document.getElementById(`filter-${filter}`);
    if (activeBtn) {
      activeBtn.classList.remove('border-gray-200', 'dark:border-slate-700', 'text-gray-600', 'dark:text-slate-400');
      if (filter === 'all') activeBtn.classList.add('border-blue-500', 'bg-blue-500', 'text-white');
      else if (filter === 'correct') activeBtn.classList.add('border-emerald-500', 'text-emerald-600', 'bg-emerald-50');
      else if (filter === 'wrong') activeBtn.classList.add('border-rose-500', 'text-rose-600', 'bg-rose-50');
    }

    const cards = document.querySelectorAll('[data-question-status]');
    cards.forEach(card => {
      const status = card.getAttribute('data-question-status');
      if (filter === 'all') {
        (card as HTMLElement).style.display = '';
      } else if (filter === 'correct') {
        (card as HTMLElement).style.display = status === 'correct' ? '' : 'none';
      } else if (filter === 'wrong') {
        (card as HTMLElement).style.display = (status === 'wrong' || status === 'skipped') ? '' : 'none';
      }
    });
  }

  // Make function globally accessible (called via onclick)
  (window as any).filterQuestions = filterQuestions;
</script>
