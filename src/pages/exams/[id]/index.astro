---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/ly-thuyet');
}

// Accept both slug and UUID (backward compat)
const exam = await db.getExamBySlug(id);
if (!exam) {
  return Astro.redirect('/de-thi');
}

const user = Astro.locals.user;
const questions = await db.getQuestionsByExamId(exam.id);
const questionsCount = questions.reduce((acc: number, q: any) => {
  if (q.type === 'read' || q.type === 'list' || q.type === 'read_cloze') {
    const subCount = q.metadata?.questions?.length || 1;
    return acc + subCount;
  }
  return acc + 1;
}, 0);

let errorMessage = '';

// Handle Start exam action (POST)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const studentName = (formData.get('student_name') as string)?.trim();
    const studentClass = (formData.get('student_class') as string)?.trim();

    if (!studentName || !studentClass) {
      errorMessage = 'Vui lòng nhập đầy đủ Họ và tên cùng với Lớp để bắt đầu làm bài thi.';
    } else {
      const attempt = await db.createAttempt(user?.id, exam.id, {
        fullname: studentName,
        class_name: studentClass
      });
      return Astro.redirect(`/exams/${exam.slug}/take?attemptId=${attempt.id}`);
    }
  } catch (err: any) {
    console.error('Failed to create exam attempt:', err);
    errorMessage = `Lỗi khởi tạo bài thi: ${err.message || 'Vui lòng thử lại.'}`;
  }
}

const examTypeNames: Record<string, string> = {
  '15m': 'Kiểm tra 15 phút',
  '45m': 'Kiểm tra 1 tiết (45 phút)',
  'semester': 'Thi Học Kỳ',
  'mock_thpt': 'Thi Thử THPT Quốc Gia',
  'vsat': 'Thi Đánh Giá Năng Lực V-SAT'
};

const examTypeColors: Record<string, string> = {
  '15m': 'bg-emerald-50 text-emerald-700 border-emerald-200/60 dark:bg-emerald-950/20 dark:text-emerald-400 dark:border-emerald-900/30',
  '45m': 'bg-blue-50 text-blue-700 border-blue-200/60 dark:bg-blue-950/20 dark:text-blue-400 dark:border-blue-900/30',
  'semester': 'bg-purple-50 text-purple-700 border-purple-200/60 dark:bg-purple-950/20 dark:text-purple-400 dark:border-purple-900/30',
  'mock_thpt': 'bg-rose-50 text-rose-700 border-rose-200/60 dark:bg-rose-950/20 dark:text-rose-400 dark:border-rose-900/30',
  'vsat': 'bg-teal-50 text-teal-700 border-teal-200/60 dark:bg-teal-950/20 dark:text-teal-400 dark:border-teal-900/30'
};
---

<Layout title={exam.title}>
  <div class="max-w-2xl mx-auto space-y-6">
    <!-- Back breadcrumb -->
    <div>
      <a href={exam.subject ? `/ly-thuyet/${exam.subject.slug}` : '/ly-thuyet'}
        class="inline-flex items-center text-xs font-bold text-gray-400 hover:text-gray-600 dark:hover:text-slate-350 transition-colors uppercase tracking-wider mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Quay lại môn học
      </a>
    </div>

    <!-- Main Exam Card -->
    <div class="bg-white dark:bg-slate-900 border border-gray-200/70 dark:border-slate-800/80 rounded-2xl p-6 md:p-8 shadow-sm">
      
      <!-- Badge Row -->
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border ${examTypeColors[exam.exam_type] || examTypeColors['45m']}`}>
          {exam.subject?.name} · {examTypeNames[exam.exam_type]}
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/60 dark:bg-emerald-950/20 dark:text-emerald-400 dark:border-emerald-900/30">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Sẵn sàng làm bài
        </span>
      </div>

      <!-- Exam Title -->
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white leading-tight mb-6">
        {exam.title}
      </h1>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
        <div class="p-4 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-150/40 dark:border-slate-850/40 text-center">
          <p class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider mb-1">Thời gian</p>
          <p class="text-xl font-black text-gray-900 dark:text-white">{exam.duration}<span class="text-sm font-semibold text-gray-400 ml-1">phút</span></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-150/40 dark:border-slate-850/40 text-center">
          <p class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider mb-1">Số câu</p>
          <p class="text-xl font-black text-gray-900 dark:text-white">{questionsCount}<span class="text-sm font-semibold text-gray-400 ml-1">câu</span></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-150/40 dark:border-slate-850/40 text-center col-span-2 sm:col-span-1">
          <p class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider mb-1">Hình thức</p>
          <p class="text-base font-bold text-gray-900 dark:text-white">Trực tuyến</p>
        </div>
      </div>

      <!-- Exam Rules -->
      <div class="text-left bg-blue-50/40 border border-blue-100/60 dark:bg-slate-800/40 dark:border-slate-700/50 p-5 rounded-2xl mb-8 space-y-3">
        <h4 class="font-bold text-sm text-gray-900 dark:text-white flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Hướng dẫn & Quy định làm bài:
        </h4>
        <ul class="text-xs text-gray-600 dark:text-slate-350 space-y-2 list-decimal pl-5 leading-relaxed font-medium">
          <li>Vui lòng nhập chính xác <strong>Họ tên</strong> và <strong>Lớp</strong> để hệ thống ghi nhận kết quả cho giáo viên.</li>
          <li>Đồng hồ đếm ngược bắt đầu ngay khi bạn nhấn <strong>Bắt đầu làm bài</strong>.</li>
          <li>Khi hết thời gian quy định, bài thi sẽ <strong>tự động nộp</strong>.</li>
          <li>Sau khi nộp bài, hệ thống <strong>chấm điểm tự động</strong> và lưu kết quả vào danh sách của lớp.</li>
        </ul>
      </div>

      <!-- Form nhập Họ tên & Lớp -->
      <form method="POST" id="start-exam-form" class="space-y-5">
        {errorMessage && (
          <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 flex items-center gap-3">
            <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-sm font-semibold text-rose-700 dark:text-rose-400">{errorMessage}</p>
          </div>
        )}

        <div class="p-5 md:p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 space-y-4">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-lg">✍️</span>
            <h3 class="text-sm font-bold text-gray-800 dark:text-slate-200 uppercase tracking-wider">
              Thông tin học sinh làm bài
            </h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Student Name -->
            <div>
              <label for="student_name" class="block text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Họ và tên <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="student_name"
                  id="student_name"
                  required
                  value={user?.fullname || ''}
                  placeholder="Ví dụ: Nguyễn Văn An"
                  class="w-full px-4 py-3 pl-10 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-sm font-medium text-gray-900 dark:text-white placeholder-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all"
                />
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm">👤</span>
              </div>
            </div>

            <!-- Student Class -->
            <div>
              <label for="student_class" class="block text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Lớp <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="student_class"
                  id="student_class"
                  required
                  placeholder="Ví dụ: 12A1, 12A2..."
                  class="w-full px-4 py-3 pl-10 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-sm font-medium text-gray-900 dark:text-white placeholder-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all"
                />
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm">🏫</span>
              </div>
            </div>
          </div>

          <p class="text-[11px] text-gray-500 dark:text-slate-400 leading-relaxed italic">
            * Kết quả bài làm của bạn sẽ được lưu trực tiếp vào cơ sở dữ liệu để giáo viên bộ môn tổng hợp và đánh giá.
          </p>
        </div>

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold py-4 rounded-xl shadow-lg shadow-blue-500/20 hover:shadow-xl transition-all duration-150 text-base flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Bắt đầu làm bài thi
        </button>
      </form>
    </div>

    <!-- Info note -->
    {user ? (
      <p class="text-center text-xs text-gray-400 dark:text-slate-500">
        Tài khoản đăng nhập: <strong class="text-gray-600 dark:text-slate-300">{user.fullname || user.email}</strong>
        · <a href="/dashboard" class="underline hover:text-indigo-500 transition-colors">Dashboard</a>
      </p>
    ) : (
      <p class="text-center text-xs text-gray-400 dark:text-slate-500">
        Bạn có thể làm bài trực tiếp hoặc <a href={`/login?redirect=/exams/${id}`} class="text-indigo-500 hover:text-indigo-600 font-semibold underline">đăng nhập</a> tài khoản của bạn.
      </p>
    )}
  </div>
</Layout>

<script>
  // Prevent double-click submit & provide instant visual feedback
  const form = document.getElementById('start-exam-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      const nameInput = document.getElementById('student_name') as HTMLInputElement | null;
      const classInput = document.getElementById('student_class') as HTMLInputElement | null;

      if (!nameInput?.value.trim() || !classInput?.value.trim()) {
        return; // Let browser HTML5 validation fire
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="white" stroke-width="4"></circle>
            <path class="opacity-75" fill="white" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span>Đang vào phòng thi...</span>`;
      }
    });
  }
</script>
