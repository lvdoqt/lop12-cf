---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
import {
  calculateEffectiveQuestionCount,
  getExamProgramMeta,
  checkExamSessionWindow,
  getEffectiveExamScoring,
} from '../../../lib/exam';

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/ly-thuyet');
}

const exam = await db.getExamBySlug(id);
if (!exam) {
  return Astro.redirect('/de-thi');
}

const user = Astro.locals.user;
const isStaff = Boolean(user && (user.role === 'admin' || user.role === 'teacher'));
const questions = await db.getQuestionsByExamId(exam.id);
const questionsCount = calculateEffectiveQuestionCount(questions, exam.settings);
const isGraded = Boolean(exam.settings?.is_graded);
const hasPassword = Boolean(exam.password && exam.password.trim().length > 0);
const maxAttempts = exam.settings?.max_attempts && exam.settings.max_attempts > 0 ? exam.settings.max_attempts : null;

const programMeta = getExamProgramMeta(exam);
const scoringMeta = getEffectiveExamScoring(exam);
const sessionWindow = checkExamSessionWindow(exam.settings);
const isBlockedBySchedule = !isStaff && sessionWindow.state !== 'open';

let errorMessage = '';
let submittedName = user?.fullname || '';
let submittedClass = '';
let submittedSbd = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const enteredPw = ((formData.get('exam_password') as string) || '').trim();

    if (isBlockedBySchedule) {
      errorMessage =
        sessionWindow.state === 'not_open'
          ? `Ca thi chưa bắt đầu. Đề thi sẽ mở vào lúc ${sessionWindow.openAtFormatted}.`
          : `Ca thi đã kết thúc vào lúc ${sessionWindow.closeAtFormatted}.`;
    } else if (hasPassword && enteredPw !== exam.password!.trim()) {
      errorMessage = 'Mật khẩu đề thi không chính xác. Vui lòng kiểm tra lại với giáo viên.';
    } else if (!isGraded) {
      if (hasPassword) {
        Astro.cookies.set(`exam_pw_${exam.id}`, '1', {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          maxAge: 60 * 60 * 6,
        });
      }
      return Astro.redirect(`/exams/${exam.slug}/take?mode=practice`);
    } else {
      const studentName = (formData.get('student_name') as string)?.trim() || '';
      const studentClass = (formData.get('student_class') as string)?.trim() || '';
      const studentSbd = (formData.get('student_sbd') as string)?.trim() || '';
      submittedName = studentName;
      submittedClass = studentClass;
      submittedSbd = studentSbd;

      if (!studentName || !studentClass || !studentSbd) {
        errorMessage = 'Vui lòng nhập đầy đủ Họ và tên, Số báo danh (STT) và Lớp để bắt đầu làm bài thi.';
      } else {
        // Check max_attempts per student / SBD if configured
        if (maxAttempts !== null && !isStaff) {
          const finishedAttempts = await db.getAttemptsByExamId(exam.id);
          const normSbd = studentSbd.toLowerCase();
          const normName = studentName.toLowerCase();
          const normClass = studentClass.toLowerCase();

          const usedCount = finishedAttempts.filter(att => {
            if (user?.id && att.user_id === user.id) return true;
            const aSbd = (att.student_sbd || '').trim().toLowerCase();
            const aClass = (att.student_class || '').trim().toLowerCase();
            const aName = (att.student_name || '').trim().toLowerCase();
            if (aSbd && aClass && aSbd === normSbd && aClass === normClass) return true;
            if (aName && aClass && aName === normName && aClass === normClass) return true;
            return false;
          }).length;

          if (usedCount >= maxAttempts) {
            errorMessage = `Bạn đã hoàn thành đủ số lượt làm bài cho phép của đề thi này (${usedCount}/${maxAttempts} lượt).`;
          }
        }

        if (!errorMessage) {
          const attempt = await db.createAttempt(user?.id, exam.id, {
            fullname: studentName,
            class_name: studentClass,
            sbd: studentSbd,
          });
          return Astro.redirect(`/exams/${exam.slug}/take?attemptId=${attempt.id}`);
        }
      }
    }
  } catch (err: any) {
    console.error('Failed to create exam attempt:', err);
    errorMessage = `Lỗi khởi tạo bài thi: ${err.message || 'Vui lòng thử lại.'}`;
  }
}
---

<Layout title={exam.title}>
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <a
        href={exam.subject ? `/ly-thuyet/${exam.subject.slug}` : '/de-thi'}
        class="inline-flex items-center text-xs font-bold text-gray-400 hover:text-gray-600 dark:hover:text-slate-350 transition-colors uppercase tracking-wider mb-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Quay lại danh sách
      </a>
    </div>

    <div class="bg-white dark:bg-slate-900 border border-gray-200/70 dark:border-slate-800/80 rounded-2xl p-6 md:p-8 shadow-sm">
      <!-- Badge Row -->
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <span class={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold border ${programMeta.badgeClass}`}>
          <span>{programMeta.icon}</span>
          <span>{exam.subject?.name ? `${exam.subject.name} · ` : ''}{programMeta.label}</span>
        </span>
        {isGraded ? (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/60 dark:bg-emerald-950/20 dark:text-emerald-400 dark:border-emerald-900/30">
            📝 Đề thi lấy điểm
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200/60 dark:bg-sky-950/20 dark:text-sky-400 dark:border-sky-900/30">
            📖 Chế độ luyện tập
          </span>
        )}
        {hasPassword && (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950/30 dark:text-amber-300 dark:border-amber-800/40">
            🔒 Có mật khẩu
          </span>
        )}
      </div>

      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white leading-tight mb-6">
        {exam.title}
      </h1>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="p-3.5 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-200/50 dark:border-slate-800 text-center">
          <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Thời gian</p>
          <p class="text-lg font-black text-gray-900 dark:text-white">{exam.duration}<span class="text-xs font-semibold text-gray-400 ml-1">phút</span></p>
        </div>
        <div class="p-3.5 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-200/50 dark:border-slate-800 text-center">
          <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Số câu</p>
          <p class="text-lg font-black text-gray-900 dark:text-white">{questionsCount}<span class="text-xs font-semibold text-gray-400 ml-1">câu</span></p>
        </div>
        <div class="p-3.5 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-200/50 dark:border-slate-800 text-center">
          <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Thang điểm</p>
          <p class="text-lg font-black text-gray-900 dark:text-white">{scoringMeta.maxScore}<span class="text-xs font-semibold text-gray-400 ml-1">điểm</span></p>
        </div>
        <div class="p-3.5 bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-gray-200/50 dark:border-slate-800 text-center">
          <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Số lượt thi</p>
          <p class="text-sm font-bold text-gray-900 dark:text-white">{maxAttempts ? `Tối đa ${maxAttempts}` : 'Tự do'}</p>
        </div>
      </div>

      <!-- Session Schedule Notice -->
      {(sessionWindow.openAtFormatted || sessionWindow.closeAtFormatted) && (
        <div class={`p-4 rounded-xl border text-xs font-semibold mb-6 flex flex-wrap items-center justify-between gap-2 ${
          sessionWindow.state === 'open'
            ? 'bg-emerald-50/60 border-emerald-200 text-emerald-800 dark:bg-emerald-950/20 dark:border-emerald-800/50 dark:text-emerald-300'
            : 'bg-amber-50 border-amber-200 text-amber-800 dark:bg-amber-950/25 dark:border-amber-800/50 dark:text-amber-300'
        }`}>
          <div class="space-y-0.5">
            {sessionWindow.openAtFormatted && <p>🟢 Mở ca thi: <strong>{sessionWindow.openAtFormatted}</strong></p>}
            {sessionWindow.closeAtFormatted && <p>🔴 Đóng ca thi: <strong>{sessionWindow.closeAtFormatted}</strong></p>}
          </div>
          {isStaff && sessionWindow.state !== 'open' && (
            <span class="px-2.5 py-1 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 font-bold">
              Quyền Giáo viên: Được phép vào kiểm tra trước giờ
            </span>
          )}
        </div>
      )}

      <!-- Exam Rules -->
      <div class="text-left bg-blue-50/40 border border-blue-100/60 dark:bg-slate-800/40 dark:border-slate-700/50 p-5 rounded-2xl mb-6 space-y-3">
        <h4 class="font-bold text-sm text-gray-900 dark:text-white">Hướng dẫn &amp; Quy định làm bài:</h4>
        <ul class="text-xs text-gray-600 dark:text-slate-300 space-y-1.5 list-decimal pl-5 leading-relaxed font-medium">
          {isGraded ? (
            <>
              <li>Nhập chính xác <strong>Họ tên</strong>, <strong>Lớp</strong> và <strong>Số báo danh (STT)</strong> để lưu điểm cho giáo viên.</li>
              <li>Đồng hồ đếm ngược chạy ngay khi bắt đầu và tự động nộp khi hết giờ. Hệ thống cảnh báo nếu rời tab quá 3 lần.</li>
              {maxAttempts && <li>Mỗi học sinh chỉ được phép thực hiện tối đa <strong>{maxAttempts} lượt thi</strong>.</li>}
            </>
          ) : (
            <>
              <li>Chế độ <strong>luyện tập tự do</strong>: không lưu điểm vào hệ thống, có thể luyện tập nhiều lần.</li>
              <li>Hỗ trợ viết đáp số câu trả lời ngắn bằng cả dấu phẩy (<code>12,5</code>) hoặc dấu chấm (<code>12.5</code>).</li>
            </>
          )}
        </ul>
      </div>

      {isBlockedBySchedule ? (
        <div class="p-5 rounded-2xl bg-rose-50 dark:bg-rose-950/25 border border-rose-200 dark:border-rose-800/50 text-center space-y-1.5">
          <p class="text-base font-extrabold text-rose-700 dark:text-rose-300">
            {sessionWindow.state === 'not_open' ? '⏳ Ca thi chưa đến giờ mở' : '🔒 Ca thi này đã kết thúc'}
          </p>
          <p class="text-xs text-rose-600 dark:text-rose-400">
            {sessionWindow.state === 'not_open'
              ? `Vui lòng quay lại vào lúc ${sessionWindow.openAtFormatted}.`
              : `Đề thi đã đóng lúc ${sessionWindow.closeAtFormatted}.`}
          </p>
        </div>
      ) : !isGraded && !hasPassword ? (
        <a
          href={`/exams/${exam.slug}/take?mode=practice`}
          class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold py-4 rounded-xl shadow-lg shadow-blue-500/20 hover:shadow-xl transition-all duration-150 text-base flex items-center justify-center gap-2"
        >
          <span>▶ Bắt đầu luyện tập ngay</span>
        </a>
      ) : (
        <form method="POST" id="start-exam-form" class="space-y-5">
          {errorMessage && (
            <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 flex items-center gap-3">
              <p class="text-sm font-semibold text-rose-700 dark:text-rose-400">⚠️ {errorMessage}</p>
            </div>
          )}

          <div class="p-5 md:p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 space-y-4">
            {isGraded && (
              <>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-lg">✍️</span>
                  <h3 class="text-sm font-bold text-gray-800 dark:text-slate-200 uppercase tracking-wider">
                    Thông tin thí sinh
                  </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="sm:col-span-2">
                    <label for="student_name" class="block text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                      Họ và tên <span class="text-rose-500">*</span>
                    </label>
                    <input
                      type="text"
                      name="student_name"
                      id="student_name"
                      required
                      value={submittedName}
                      placeholder="Ví dụ: Nguyễn Văn An"
                      class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-sm font-medium text-gray-900 dark:text-white outline-none focus:border-blue-500"
                    />
                  </div>

                  <div>
                    <label for="student_sbd" class="block text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                      Số báo danh (STT) <span class="text-rose-500">*</span>
                    </label>
                    <input
                      type="text"
                      name="student_sbd"
                      id="student_sbd"
                      required
                      value={submittedSbd}
                      placeholder="Ví dụ: 01, 12005..."
                      class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-sm font-medium text-gray-900 dark:text-white outline-none focus:border-blue-500"
                    />
                  </div>

                  <div>
                    <label for="student_class" class="block text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                      Lớp <span class="text-rose-500">*</span>
                    </label>
                    <input
                      type="text"
                      name="student_class"
                      id="student_class"
                      required
                      value={submittedClass}
                      placeholder="Ví dụ: 12A1"
                      class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-sm font-medium text-gray-900 dark:text-white outline-none focus:border-blue-500"
                    />
                  </div>
                </div>
              </>
            )}

            {hasPassword && (
              <div class={isGraded ? 'pt-3 border-t border-slate-200 dark:border-slate-700' : ''}>
                <label for="exam_password" class="block text-xs font-bold text-amber-700 dark:text-amber-400 uppercase tracking-wider mb-1.5">
                  🔒 Mật khẩu phòng thi <span class="text-rose-500">*</span>
                </label>
                <input
                  type="password"
                  name="exam_password"
                  id="exam_password"
                  required
                  placeholder="Nhập mật khẩu giáo viên cung cấp..."
                  class="w-full px-4 py-3 rounded-xl border border-amber-300 dark:border-amber-700 bg-white dark:bg-slate-900 text-sm font-semibold text-gray-900 dark:text-white outline-none focus:border-amber-500"
                />
              </div>
            )}
          </div>

          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold py-4 rounded-xl shadow-lg shadow-blue-500/20 hover:shadow-xl transition-all duration-150 text-base flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>▶ {isGraded ? 'Bắt đầu làm bài thi' : 'Xác nhận mật khẩu & Vào luyện tập'}</span>
          </button>
        </form>
      )}
    </div>
  </div>
</Layout>
