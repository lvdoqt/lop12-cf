---
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
const userId = user?.id || '';
// Chỉ tài khoản đăng ký qua Supabase (id dạng UUID trong public.users) mới dùng được nhóm
const isRegisteredMember = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(userId);
const userName = user?.fullname || 'Bạn';
const userAvatar = user?.avatar_url || 'https://api.dicebear.com/7.x/adventurer/svg?seed=Student12';
const userRole = user?.role === 'teacher' ? 'Giáo viên' : user?.role === 'admin' ? 'Quản trị viên' : 'Học sinh';
const isLoggedIn = Boolean(user);
---

<Layout
  title="Nhóm Lớp Học — Thảo Luận & Chia Sẻ"
  description="Không gian giao lưu, trao đổi bài tập và đăng tin thảo luận lớp học chuẩn phong cách hiện đại."
  showSidebar={false}
  showAds={false}
  noindex
>
  <div
    class="gpt-app"
    id="gpt-app"
    data-user-name={userName}
    data-user-avatar={userAvatar}
    data-user-role={userRole}
    data-is-logged-in={isLoggedIn ? 'true' : 'false'}
    data-user-id={userId}
    data-can-use={isRegisteredMember ? 'true' : 'false'}
  >
    <!-- Left Sidebar: ChatGPT Style Class List -->
    <aside class="gpt-sidebar" id="gpt-sidebar" aria-label="Danh sách lớp học">
      <!-- Sidebar Header / Brand & New Thread -->
      <div class="sidebar-top">
        <div class="sidebar-brand">
          <div class="brand-avatar">12</div>
          <div class="brand-info">
            <span class="brand-title">Nhóm Lớp Học</span>
            <span class="brand-subtitle">Lớp 12 LMS · Học tập</span>
          </div>
          <button class="sidebar-close-btn md:hidden" id="btn-close-sidebar" title="Đóng menu" aria-label="Đóng menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <button class="new-post-btn" id="btn-new-thread" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M12 5v14M5 12h14"/></svg>
          <span>Bài thảo luận mới</span>
          <kbd class="shortcut-key">Ctrl+K</kbd>
        </button>

        <!-- Search class input -->
        <div class="class-search-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-zinc-400"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" id="class-search-input" placeholder="Tìm lớp học (12A4, 11A8...)" />
        </div>
      </div>

      <!-- Class navigation items list -->
      <div class="sidebar-scroll" id="sidebar-scroll">
        <div class="section-label">LỚP HỌC CỦA BẠN</div>
        <div class="class-list" id="my-class-list">
          <!-- Rendered via JS -->
        </div>

        <div class="section-label mt-4">NHÓM ÔN THI & CÂU LẠC BỘ</div>
        <div class="class-list" id="club-class-list">
          <!-- Rendered via JS -->
        </div>
      </div>

      <!-- Sidebar footer / user profile card -->
      <div class="sidebar-footer">
        <div class="user-pill">
          <div class="relative">
            <img src={userAvatar} alt={userName} class="user-avatar" />
            <span class="online-dot"></span>
          </div>
          <div class="user-meta">
            <span class="user-name">{userName}</span>
            <span class="user-role-badge">{userRole} · Trực tuyến</span>
          </div>
          <a href="/dashboard" class="user-exit-link" title="Về Bảng điều khiển" aria-label="Bảng điều khiển">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
          </a>
        </div>
      </div>
    </aside>

    <!-- Sidebar Backdrop for Mobile -->
    <div class="gpt-sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- Main Chat & Post Stage (ChatGPT Right Workspace) -->
    <main class="gpt-main">
      <!-- Top Workspace Navigation Bar -->
      <header class="gpt-header">
        <div class="header-left">
          <button class="header-toggle-sidebar" id="btn-toggle-sidebar" title="Mở danh sách lớp" aria-label="Toggle Sidebar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
          </button>

          <div class="active-class-pill" id="active-class-pill">
            <div class="class-avatar-chip" id="header-class-badge">12</div>
            <div class="class-header-text">
              <div class="flex items-center gap-1.5">
                <h1 class="class-title" id="header-class-name">Lớp 12A4</h1>
                <span class="class-status-badge">KHTN & Tin Học</span>
              </div>
              <p class="class-meta" id="header-class-meta">42 học sinh · GVCN: Cô Minh Anh · Trực tuyến</p>
            </div>
          </div>
        </div>

        <div class="header-right">
          <!-- Filter Pinned Posts -->
          <button class="header-action-btn" id="btn-view-pinned" title="Xem tin đã ghim">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"/></svg>
            <span class="hidden sm:inline">Tin ghim</span>
            <span class="pinned-count-badge" id="pinned-count-badge">1</span>
          </button>

          <!-- Members List Modal Trigger -->
          <button class="header-action-btn" id="btn-view-members" title="Danh sách thành viên">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span class="hidden sm:inline">Thành viên</span>
          </button>

          <!-- Share Link / Invite -->
          <button class="header-action-btn primary" id="btn-share-group" title="Mời bạn cùng lớp">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span class="hidden sm:inline">Chia sẻ</span>
          </button>
        </div>
      </header>

      <!-- Pinned Announcement Banner (Zalo Style Ghim Tin Nhắn) -->
      <div class="pinned-banner" id="pinned-banner">
        <div class="pinned-banner-content">
          <div class="pinned-icon-wrapper">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-amber-400"><path d="M12 2a1 1 0 0 1 1 1v4.2l3.4 1.7a1 1 0 0 1 .6.9V13h-4v7a1 1 0 1 1-2 0v-7H7v-3.2a1 1 0 0 1 .6-.9L11 7.2V3a1 1 0 0 1 1-1z"/></svg>
          </div>
          <div class="pinned-text-group">
            <span class="pinned-label">THÔNG BÁO GHIM CỦA LỚP:</span>
            <span class="pinned-snippet" id="pinned-banner-text">Đã cập nhật lịch ôn tập & thi giữa kì môn Toán, Lí, Hoá. Xem tài liệu đính kèm bên dưới.</span>
          </div>
        </div>
        <button class="pinned-jump-btn" id="btn-jump-pinned" type="button">Xem bài</button>
      </div>

      <!-- Feed / Stream Area (Zalo Posts Running Up, ChatGPT Style) -->
      <div class="feed-viewport" id="feed-viewport">
        <!-- Welcome Hero for the Active Class -->
        <div class="class-welcome-hero" id="class-welcome-hero">
          <div class="hero-sparkle">✦</div>
          <h2 class="hero-title" id="welcome-class-title">Chào mừng đến với không gian Lớp 12A4</h2>
          <p class="hero-desc">
            Nơi giáo viên và học sinh trao đổi học tập, hỏi đáp bài tập khó, chia sẻ đề thi và tài liệu chất lượng cao.
          </p>
          <div class="hero-tags">
            <span class="tag-pill">📚 Trao đổi bài tập</span>
            <span class="tag-pill">📢 Thông báo lớp</span>
            <span class="tag-pill">💡 Đề cương & Tài liệu</span>
          </div>
        </div>

        <!-- Post list stream -->
        <div class="posts-stream" id="posts-stream">
          <!-- Filled dynamically via JS -->
        </div>

        <!-- Scroll to bottom button -->
        <button class="scroll-bottom-btn" id="btn-scroll-bottom" type="button" title="Cuộn xuống tin mới nhất">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          <span>Tin mới nhất</span>
        </button>
      </div>

      <!-- Bottom Chatbox / Composer Dock (ChatGPT Signature Floating Pill) -->
      <div class="composer-dock-container">
        <div class="composer-card">
          <!-- Image Previews Container before posting -->
          <div class="attachments-preview-zone hidden" id="preview-zone">
            <!-- Dynamic thumbnails -->
          </div>

          <!-- Attached Link Preview Chip before posting -->
          <div class="link-chip-zone hidden" id="link-chip-zone">
            <span class="link-icon">🔗</span>
            <span class="link-text" id="attached-link-display">https://...</span>
            <button class="remove-chip-btn" id="btn-remove-link" type="button" title="Gỡ liên kết">×</button>
          </div>

          <!-- Active Tag Chip -->
          <div class="tag-chip-zone" id="tag-chip-zone">
            <span class="active-tag-badge" id="active-tag-badge">💬 Thảo luận</span>
            <button class="change-tag-btn" id="btn-change-tag" type="button">Đổi chủ đề ▾</button>
            <div class="tag-menu-dropdown hidden" id="tag-menu-dropdown">
              <button type="button" data-tag="💬 Thảo luận">💬 Thảo luận tự do</button>
              <button type="button" data-tag="📢 Thông báo">📢 Thông báo quan trọng</button>
              <button type="button" data-tag="📚 Hỏi bài tập">📚 Hỏi bài tập / Lời giải</button>
              <button type="button" data-tag="📝 Tài liệu học">📝 Chia sẻ tài liệu</button>
              <button type="button" data-tag="🎯 Nhắc lịch thi">🎯 Nhắc lịch thi & nộp bài</button>
            </div>
          </div>

          <!-- Textarea composer box -->
          <div class="textarea-wrapper">
            <textarea
              id="composer-input"
              rows="1"
              placeholder="Nhắn tin hoặc đăng bài thảo luận cho Lớp 12A4... (Shift+Enter để xuống dòng)"
              maxlength="4000"
            ></textarea>
          </div>

          <!-- Action bar inside composer dock -->
          <div class="composer-actions-bar">
            <div class="composer-left-tools">
              <!-- Upload photos -->
              <label class="tool-btn" title="Đính kèm hình ảnh (tối đa 4 ảnh)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span class="tool-btn-label">Hình ảnh</span>
                <input type="file" id="input-images" accept="image/*" multiple class="hidden" />
              </label>

              <!-- Attach Link -->
              <button class="tool-btn" id="btn-attach-link" type="button" title="Đính kèm liên kết học tập">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                <span class="tool-btn-label">Link</span>
              </button>

              <!-- Quick Emoji Button -->
              <button class="tool-btn" id="btn-quick-emoji" type="button" title="Biểu cảm nhanh">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                <span class="tool-btn-label hidden sm:inline">Icon</span>
              </button>

              <!-- Quick emojis palette -->
              <div class="quick-emojis-bar hidden" id="quick-emojis-bar">
                <button type="button" class="emoji-tap">❤️</button>
                <button type="button" class="emoji-tap">👍</button>
                <button type="button" class="emoji-tap">👏</button>
                <button type="button" class="emoji-tap">🔥</button>
                <button type="button" class="emoji-tap">💡</button>
                <button type="button" class="emoji-tap">🎉</button>
                <button type="button" class="emoji-tap">💯</button>
              </div>
            </div>

            <!-- Right side: Send button -->
            <div class="composer-right-tools">
              <span class="char-counter" id="char-counter">0/4000</span>
              <button
                class="send-btn"
                id="btn-send-post"
                type="button"
                disabled
                title="Gửi bài (Enter)"
                aria-label="Đăng bài"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="composer-disclaimer">
          Nhấn <kbd>Enter</kbd> để đăng bài, <kbd>Shift + Enter</kbd> để xuống dòng · Thảo luận văn minh, tôn trọng nội quy lớp học Lớp 12 LMS.
        </div>
      </div>
    </main>
  </div>

  <!-- Fullscreen Lightbox for previewing post images -->
  <div class="lightbox-modal hidden" id="lightbox-modal">
    <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
    <div class="lightbox-container">
      <img src="" alt="Xem ảnh đính kèm" id="lightbox-image" class="lightbox-img" />
      <button class="lightbox-close-btn" id="btn-close-lightbox" title="Đóng (Esc)">✕</button>
    </div>
  </div>

  <!-- Members List Modal -->
  <div class="members-modal hidden" id="members-modal">
    <div class="members-backdrop" id="members-backdrop"></div>
    <div class="members-dialog">
      <div class="members-header">
        <h3 class="members-title" id="members-modal-title">Thành viên Lớp 12A4</h3>
        <button class="members-close-btn" id="btn-close-members">✕</button>
      </div>
      <div class="members-list-body" id="members-list-body">
        <!-- Rendered via JS -->
      </div>
    </div>
  </div>
</Layout>

<script>
  import { withBase } from '../lib/base';

  // TypeScript definitions for Groups & Posts
  interface GroupClass {
    id: string;
    name: string;
    grade: string;
    members: number;
    headTeacher: string;
    speciality: string;
    color: string;
    initials: string;
    unreadCount?: number;
    isClub?: boolean;
    pinnedNotice?: string;
  }

  // Dữ liệu trả về từ /api/nhom/posts (lưu trong Supabase)
  interface AuthorItem {
    id: string;
    name: string;
    avatar: string;
    role: string; // 'Giáo viên' | 'Quản trị viên' | 'Học sinh'
  }

  interface CommentItem {
    id: string;
    author: AuthorItem;
    body: string;
    createdAt: string;
  }

  type ReactionKey = 'heart' | 'like' | 'applause' | 'idea' | 'question';

  interface PostItem {
    id: string;
    classId: string;
    author: AuthorItem;
    tag: string;
    body: string;
    images: string[];
    link: { url: string; title: string } | null;
    pinned: boolean;
    createdAt: string;
    reactions: Record<ReactionKey, number>;
    userReaction: ReactionKey | null;
    comments: CommentItem[];
    canManage: boolean;
  }

  // Dữ liệu nhóm lấy từ API
  let classesData: GroupClass[] = [];

  // Helper DOM query
  const q = <T extends HTMLElement>(selector: string): T => document.querySelector<T>(selector)!;
  const qa = <T extends HTMLElement>(selector: string): NodeListOf<T> => document.querySelectorAll<T>(selector);

  // App State
  const appContainer = q('#gpt-app');
  const currentUserName = appContainer.dataset.userName || 'Bạn';
  const currentUserAvatar = appContainer.dataset.userAvatar || 'https://api.dicebear.com/7.x/adventurer/svg?seed=Student12';
  const canUseGroup = appContainer.dataset.canUse === 'true';

  let activeClass: GroupClass = { id: 'default', name: '', grade: '', members: 0, headTeacher: '', speciality: '', color: '#3f3f46', initials: 'NA' };
  let attachedFiles: File[] = [];
  let attachedPreviews: string[] = [];
  let attachedLink: { url: string; title: string } | null = null;
  let activeTag = '💬 Thảo luận';
  let searchTerm = '';
  let isPublishing = false;

  // Dữ liệu bài đăng lấy từ Supabase qua API
  let allPosts: PostItem[] = [];
  let lastSignature = '';

  const API = {
    groups: withBase('/api/nhom/groups'),
    posts: withBase('/api/nhom/posts'),
    comments: withBase('/api/nhom/comments'),
    reactions: withBase('/api/nhom/reactions'),
    members: withBase('/api/nhom/members'),
  };

  const MAX_IMAGES = 4;
  const MAX_IMAGE_BYTES = 5 * 1024 * 1024;
  const ALLOWED_IMAGE_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];

  async function api<T = any>(url: string, init?: RequestInit): Promise<T> {
    const res = await fetch(url, { credentials: 'same-origin', ...init });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error((data as any).error || `Lỗi máy chủ (${res.status})`);
    return data as T;
  }

  function jsonInit(method: string, payload: unknown): RequestInit {
    return { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) };
  }

  // Toast thông báo nhỏ
  function showToast(message: string, type: 'error' | 'success' = 'error') {
    let host = document.getElementById('nhom-toast-host');
    if (!host) {
      host = document.createElement('div');
      host.id = 'nhom-toast-host';
      host.className = 'nhom-toast-host';
      document.body.appendChild(host);
    }
    const el = document.createElement('div');
    el.className = `nhom-toast ${type}`;
    el.textContent = message;
    host.appendChild(el);
    setTimeout(() => el.classList.add('leaving'), 3200);
    setTimeout(() => el.remove(), 3600);
  }

  // Tải bài đăng của lớp hiện tại từ Supabase
  async function loadPosts(opts: { scrollBottom?: boolean; silent?: boolean } = {}) {
    if (!canUseGroup) {
      renderFeed();
      return;
    }
    const classId = activeClass.id;
    if (!opts.silent) {
      q('#posts-stream').innerHTML = `
        <div class="feed-loading">
          <div class="feed-skeleton"></div><div class="feed-skeleton"></div><div class="feed-skeleton short"></div>
        </div>`;
    }
    try {
      const { posts } = await api<{ posts: PostItem[] }>(`${API.posts}?classId=${encodeURIComponent(classId)}`);
      if (classId !== activeClass.id) return; // đã chuyển lớp khác trong lúc tải
      const sig = JSON.stringify(posts);
      if (opts.silent && sig === lastSignature) return;
      lastSignature = sig;
      allPosts = posts;
      updatePinnedBanner();
      renderFeed(!!opts.scrollBottom);
    } catch (e: any) {
      if (opts.silent) return;
      q('#posts-stream').innerHTML = `
        <div class="empty-feed-card">
          <div class="empty-icon">⚠️</div>
          <h3 class="empty-title">Không tải được bài thảo luận</h3>
          <p class="empty-subtitle">${escapeHtml(e.message || 'Lỗi không xác định')}</p>
          <button class="empty-start-btn" type="button" id="btn-retry-load">Thử lại</button>
        </div>`;
      const retry = document.getElementById('btn-retry-load');
      if (retry) retry.onclick = () => loadPosts({ scrollBottom: true });
    }
  }

  // Sanitize helper
  function escapeHtml(str: string): string {
    return String(str ?? '').replace(/[&<>'"]/g, tag => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    }[tag] || tag));
  }

  function safeUrl(url: string): string {
    return /^https?:\/\//i.test(url || '') ? escapeHtml(url) : '#';
  }

  function relTime(iso: string): string {
    const t = new Date(iso).getTime();
    if (Number.isNaN(t)) return '';
    const diff = Math.max(0, (Date.now() - t) / 1000);
    if (diff < 60) return 'Vừa xong';
    if (diff < 3600) return `${Math.floor(diff / 60)} phút trước`;
    if (diff < 86400) return `${Math.floor(diff / 3600)} giờ trước`;
    if (diff < 7 * 86400) return `${Math.floor(diff / 86400)} ngày trước`;
    return new Date(iso).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  function roleClassOf(role: string): string {
    if (role === 'Giáo viên') return 'role-teacher';
    if (role === 'Quản trị viên') return 'role-admin';
    return 'role-student';
  }

  // Format body with links and line breaks
  function formatBody(rawText: string): string {
    const safe = escapeHtml(rawText);
    const withLinks = safe.replace(
      /(https?:\/\/[^\s<]+)/g,
      '<a href="$1" target="_blank" rel="noopener noreferrer" class="post-inline-link">$1 ↗</a>'
    );
    return withLinks.replace(/\n/g, '<br/>');
  }

  // Render Sidebar Classes
  function renderSidebarClasses() {
    const myListEl = q('#my-class-list');
    const clubListEl = q('#club-class-list');

    const filtered = classesData.filter(c =>
      c.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      c.speciality.toLowerCase().includes(searchTerm.toLowerCase())
    );

    const regularClasses = filtered.filter(c => !c.isClub);
    const clubClasses = filtered.filter(c => c.isClub);

    const makeClassItem = (c: GroupClass) => {
      const isActive = c.id === activeClass.id;
      return `
        <button
          type="button"
          class="class-item-btn ${isActive ? 'active' : ''}"
          data-class-id="${c.id}"
          title="${c.name} - ${c.speciality}"
        >
          <div class="class-item-avatar" style="background-color: ${c.color}">
            ${c.initials}
          </div>
          <div class="class-item-details">
            <div class="class-item-name-row">
              <span class="class-item-name">Lớp ${c.name}</span>
              ${c.unreadCount ? `<span class="class-unread-badge">${c.unreadCount}</span>` : ''}
            </div>
            <span class="class-item-sub">${c.members} TV · ${c.speciality}</span>
          </div>
        </button>
      `;
    };

    myListEl.innerHTML = regularClasses.length
      ? regularClasses.map(makeClassItem).join('')
      : '<p class="empty-search-text">Không tìm thấy lớp học nào</p>';

    clubListEl.innerHTML = clubClasses.length
      ? clubClasses.map(makeClassItem).join('')
      : '<p class="empty-search-text">Không tìm thấy nhóm</p>';

    // Attach click events
    qa<HTMLButtonElement>('.class-item-btn').forEach(btn => {
      btn.onclick = () => {
        const id = btn.dataset.classId;
        if (id && id !== activeClass.id) {
          switchClass(id);
        }
      };
    });
  }

  // Switch Active Class
  function switchClass(classId: string) {
    const found = classesData.find(c => c.id === classId);
    if (!found) return;

    activeClass = found;
    // Clear unread
    activeClass.unreadCount = 0;

    // Update Header
    q('#header-class-name').textContent = `Lớp ${activeClass.name}`;
    q('#header-class-badge').textContent = activeClass.initials;
    q('#header-class-badge').style.backgroundColor = activeClass.color;
    q('#header-class-meta').textContent = `${activeClass.members} học sinh · GVCN: ${activeClass.headTeacher} · ${activeClass.speciality}`;

    // Update Welcome hero
    q('#welcome-class-title').textContent = `Chào mừng đến với không gian Lớp ${activeClass.name}`;

    // Update Pinned Banner
    updatePinnedBanner();

    // Close mobile sidebar if open
    closeMobileSidebar();

    // Refresh UI
    renderSidebarClasses();
    allPosts = [];
    lastSignature = '';
    loadPosts({ scrollBottom: true });

    // Update input placeholder
    q<HTMLTextAreaElement>('#composer-input').placeholder = `Nhắn tin hoặc đăng bài thảo luận cho Lớp ${activeClass.name}... (Shift+Enter để xuống dòng)`;
  }

  // Update Pinned Banner Info
  function updatePinnedBanner() {
    const classPosts = allPosts.filter(p => p.classId === activeClass.id);
    const pinnedPost = classPosts.find(p => p.pinned);
    const bannerEl = q('#pinned-banner');
    const countBadge = q('#pinned-count-badge');

    if (pinnedPost) {
      bannerEl.classList.remove('hidden');
      q('#pinned-banner-text').textContent = pinnedPost.body.slice(0, 95) + (pinnedPost.body.length > 95 ? '...' : '');
      countBadge.textContent = '1';
      countBadge.classList.remove('hidden');

      q('#btn-jump-pinned').onclick = () => {
        const targetPost = document.getElementById(pinnedPost.id);
        if (targetPost) {
          targetPost.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetPost.classList.add('highlight-flash');
          setTimeout(() => targetPost.classList.remove('highlight-flash'), 2500);
        }
      };
    } else {
      bannerEl.classList.add('hidden');
      countBadge.classList.add('hidden');
    }
  }

  // Render Post Stream
  const REACTION_META: { key: ReactionKey; emoji: string; title: string; extraClass: string }[] = [
    { key: 'heart', emoji: '❤️', title: 'Yêu thích', extraClass: 'heart-active' },
    { key: 'like', emoji: '👍', title: 'Thích', extraClass: 'like-active' },
    { key: 'applause', emoji: '👏', title: 'Hoan hô', extraClass: '' },
    { key: 'idea', emoji: '💡', title: 'Hay quá', extraClass: '' },
    { key: 'question', emoji: '❓', title: 'Cần giải thích thêm', extraClass: '' },
  ];

  function renderFeed(shouldScrollBottom = false) {
    const streamEl = q('#posts-stream');

    if (!canUseGroup) {
      streamEl.innerHTML = `
        <div class="empty-feed-card">
          <div class="empty-icon">🔐</div>
          <h3 class="empty-title">Nhóm lớp học dành cho thành viên đã đăng ký</h3>
          <p class="empty-subtitle">Vui lòng đăng nhập bằng tài khoản đã đăng ký để xem và tham gia thảo luận.</p>
          <a class="empty-start-btn" href="${withBase('/register')}">Đăng ký tài khoản ✨</a>
        </div>
      `;
      return;
    }

    const classPosts = allPosts.filter(p => p.classId === activeClass.id);

    if (classPosts.length === 0) {
      streamEl.innerHTML = `
        <div class="empty-feed-card">
          <div class="empty-icon">💬</div>
          <h3 class="empty-title">Chưa có bài thảo luận nào trong Lớp ${escapeHtml(activeClass.name)}</h3>
          <p class="empty-subtitle">Hãy là người đầu tiên đặt câu hỏi, chia sẻ tài liệu hoặc thảo luận bài học cùng các bạn!</p>
          <button class="empty-start-btn" type="button" onclick="document.getElementById('composer-input').focus()">
            Viết bài đầu tiên ngay ✨
          </button>
        </div>
      `;
      return;
    }

    // Giữ trạng thái UI (khung bình luận đang mở, nội dung đang gõ) khi render lại
    const prevOpen = new Map<string, boolean>();
    qa<HTMLElement>('.comments-section').forEach(el => {
      if (el.dataset.postId) prevOpen.set(el.dataset.postId, !el.classList.contains('hidden'));
    });
    const drafts = new Map<string, string>();
    qa<HTMLInputElement>('.reply-input').forEach(i => {
      if (i.value && i.dataset.postId) drafts.set(i.dataset.postId, i.value);
    });
    const activeEl = document.activeElement as HTMLInputElement | null;
    const focusedReplyId = activeEl?.classList?.contains('reply-input') ? activeEl.dataset.postId : null;

    streamEl.innerHTML = classPosts.map(post => {
      const roleClass = roleClassOf(post.author.role);

      // Images HTML (ảnh lưu trên Supabase Storage)
      let imagesHtml = '';
      if (post.images && post.images.length > 0) {
        const count = post.images.length;
        imagesHtml = `
          <div class="post-media-grid grid-${Math.min(count, 4)}">
            ${post.images.map((imgUrl, idx) => `
              <div class="post-img-thumb" data-full-image="${safeUrl(imgUrl)}">
                <img src="${safeUrl(imgUrl)}" alt="Ảnh đính kèm ${idx + 1}" loading="lazy" />
              </div>
            `).join('')}
          </div>
        `;
      }

      // Link preview card HTML
      let linkHtml = '';
      if (post.link) {
        linkHtml = `
          <a href="${safeUrl(post.link.url)}" target="_blank" rel="noopener noreferrer" class="link-preview-box">
            <div class="link-preview-icon">↗</div>
            <div class="link-preview-content">
              <span class="link-preview-title">${escapeHtml(post.link.title || post.link.url)}</span>
              <span class="link-preview-url">${escapeHtml(post.link.url)}</span>
            </div>
          </a>
        `;
      }

      const reactionsHtml = REACTION_META.map(r => `
        <button
          type="button"
          class="reaction-btn ${post.userReaction === r.key ? `active ${r.extraClass}` : ''}"
          data-post-id="${post.id}"
          data-reaction="${r.key}"
          title="${r.title}"
        >
          <span class="emoji-icon">${r.emoji}</span>
          <span class="reaction-count">${post.reactions[r.key] || 0}</span>
        </button>
      `).join('');

      // Comments section
      const commentsCount = post.comments?.length || 0;
      const isOpen = prevOpen.has(post.id) ? prevOpen.get(post.id) : commentsCount > 0;
      const commentsHtml = (post.comments || []).map(c => `
        <div class="comment-item">
          <img src="${safeUrl(c.author.avatar)}" alt="${escapeHtml(c.author.name)}" class="comment-avatar" />
          <div class="comment-bubble">
            <div class="comment-author-row">
              <span class="comment-author">${escapeHtml(c.author.name)}</span>
              <span class="comment-role">${escapeHtml(c.author.role)}</span>
              <span class="comment-time" title="${escapeHtml(new Date(c.createdAt).toLocaleString('vi-VN'))}">${relTime(c.createdAt)}</span>
            </div>
            <div class="comment-text">${escapeHtml(c.body)}</div>
          </div>
        </div>
      `).join('');

      return `
        <article class="post-card ${post.pinned ? 'is-pinned-card' : ''}" id="${post.id}">
          <!-- Post Header -->
          <header class="post-header">
            <div class="author-avatar-wrap">
              <img src="${safeUrl(post.author.avatar)}" alt="${escapeHtml(post.author.name)}" class="post-avatar" />
              <span class="author-online-indicator"></span>
            </div>
            <div class="post-author-info">
              <div class="author-name-row">
                <span class="post-author-name">${escapeHtml(post.author.name)}</span>
                <span class="post-role-badge ${roleClass}">${escapeHtml(post.author.role)}</span>
                ${post.pinned ? `<span class="post-pinned-badge">📌 Đã ghim</span>` : ''}
              </div>
              <div class="post-meta-row">
                <span class="post-time" title="${escapeHtml(new Date(post.createdAt).toLocaleString('vi-VN'))}">${relTime(post.createdAt)}</span>
                <span class="meta-dot">·</span>
                <span class="post-tag-badge">${escapeHtml(post.tag)}</span>
              </div>
            </div>

            <!-- Post Action dropdown / pin button -->
            <div class="post-action-menu">
              <button class="post-menu-btn" data-post-id="${post.id}" title="Tùy chọn bài viết">
                •••
              </button>
              <div class="post-dropdown-menu hidden" id="dropdown-${post.id}">
                ${post.canManage ? `
                <button type="button" class="action-toggle-pin" data-post-id="${post.id}">
                  ${post.pinned ? 'Bỏ ghim tin' : '📌 Ghim lên đầu nhóm'}
                </button>` : ''}
                <button type="button" class="action-copy-link" data-post-id="${post.id}">
                  🔗 Sao chép liên kết bài
                </button>
                ${post.canManage ? `
                <button type="button" class="action-delete-post text-rose-500" data-post-id="${post.id}">
                  🗑️ Xoá bài viết
                </button>` : ''}
              </div>
            </div>
          </header>

          <!-- Post Content -->
          <div class="post-body-content">
            ${formatBody(post.body)}
          </div>

          <!-- Attachments (Images & Link preview) -->
          ${imagesHtml}
          ${linkHtml}

          <!-- Post Footer / Zalo Reactions & Interactive Bar -->
          <footer class="post-footer">
            <div class="reactions-strip">
              ${reactionsHtml}
            </div>

            <!-- Comment toggle -->
            <button
              type="button"
              class="comments-toggle-btn"
              data-post-id="${post.id}"
              title="Xem và gửi bình luận"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span>${commentsCount > 0 ? `${commentsCount} bình luận` : 'Bình luận'}</span>
            </button>
          </footer>

          <!-- Comments Thread Section -->
          <div class="comments-section ${isOpen ? '' : 'hidden'}" id="comments-section-${post.id}" data-post-id="${post.id}">
            <div class="comments-list" id="comments-list-${post.id}">
              ${commentsHtml}
            </div>

            <!-- Inline Reply Box for this Post -->
            <div class="reply-composer-row">
              <img src="${safeUrl(currentUserAvatar)}" alt="${escapeHtml(currentUserName)}" class="reply-avatar" />
              <input
                type="text"
                class="reply-input"
                id="reply-input-${post.id}"
                placeholder="Viết trả lời cho bài viết này... (Enter để gửi)"
                maxlength="2000"
                data-post-id="${post.id}"
              />
              <button
                type="button"
                class="reply-send-btn"
                data-post-id="${post.id}"
                title="Gửi phản hồi"
              >
                Gửi
              </button>
            </div>
          </div>
        </article>
      `;
    }).join('');

    // Khôi phục nội dung đang gõ / focus
    drafts.forEach((value, postId) => {
      const input = document.getElementById(`reply-input-${postId}`) as HTMLInputElement | null;
      if (input) input.value = value;
    });
    if (focusedReplyId) {
      const input = document.getElementById(`reply-input-${focusedReplyId}`) as HTMLInputElement | null;
      if (input) {
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
      }
    }

    // Attach listeners for interactive post features
    bindPostInteractions();

    if (shouldScrollBottom) {
      scrollToBottom();
    }
  }

  // Bind Post Interactions (Reactions, Comments, Lightbox, Menus)
  function bindPostInteractions() {
    // 1. Image lightbox
    qa<HTMLElement>('.post-img-thumb').forEach(thumb => {
      thumb.onclick = () => {
        const url = thumb.dataset.fullImage;
        if (url) openLightbox(url);
      };
    });

    // 2. Reactions — cập nhật lạc quan rồi lưu vào Supabase
    qa<HTMLButtonElement>('.reaction-btn').forEach(btn => {
      btn.onclick = async () => {
        const postId = btn.dataset.postId;
        const type = btn.dataset.reaction as ReactionKey;
        if (!postId || !type) return;

        const post = allPosts.find(p => p.id === postId);
        if (!post) return;

        const prev = post.userReaction;
        const next: ReactionKey | null = prev === type ? null : type;
        if (prev) post.reactions[prev] = Math.max(0, (post.reactions[prev] || 1) - 1);
        if (next) post.reactions[next] = (post.reactions[next] || 0) + 1;
        post.userReaction = next;
        renderFeed(false);

        try {
          await api(API.reactions, jsonInit('POST', { postId, reaction: next }));
        } catch (e: any) {
          showToast(e.message || 'Không lưu được cảm xúc');
          loadPosts({ silent: true });
        }
      };
    });

    // 3. Comments Toggle
    qa<HTMLButtonElement>('.comments-toggle-btn').forEach(btn => {
      btn.onclick = () => {
        const postId = btn.dataset.postId;
        if (!postId) return;
        const section = document.getElementById(`comments-section-${postId}`);
        if (section) {
          section.classList.toggle('hidden');
          const input = document.getElementById(`reply-input-${postId}`) as HTMLInputElement | null;
          if (input && !section.classList.contains('hidden')) {
            input.focus();
          }
        }
      };
    });

    // 4. Send Reply / Comment → Supabase
    const sendReply = async (postId: string) => {
      const input = document.getElementById(`reply-input-${postId}`) as HTMLInputElement | null;
      if (!input || input.disabled) return;
      const text = input.value.trim();
      if (!text) return;

      input.disabled = true;
      try {
        await api(API.comments, jsonInit('POST', { postId, body: text }));
        input.value = '';
        input.disabled = false;
        await loadPosts({ silent: true });
        const fresh = document.getElementById(`reply-input-${postId}`) as HTMLInputElement | null;
        fresh?.focus();
      } catch (e: any) {
        input.disabled = false;
        showToast(e.message || 'Không gửi được bình luận');
      }
    };

    qa<HTMLButtonElement>('.reply-send-btn').forEach(btn => {
      btn.onclick = () => {
        const postId = btn.dataset.postId;
        if (postId) sendReply(postId);
      };
    });

    qa<HTMLInputElement>('.reply-input').forEach(input => {
      input.onkeydown = (e) => {
        if (e.key === 'Enter' && !e.isComposing) {
          e.preventDefault();
          const postId = input.dataset.postId;
          if (postId) sendReply(postId);
        }
      };
    });

    // 5. Post action dropdown menu
    qa<HTMLButtonElement>('.post-menu-btn').forEach(btn => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const postId = btn.dataset.postId;
        const menu = document.getElementById(`dropdown-${postId}`);
        qa('.post-dropdown-menu').forEach(m => {
          if (m !== menu) m.classList.add('hidden');
        });
        if (menu) menu.classList.toggle('hidden');
      };
    });

    // Pin Toggle → Supabase
    qa<HTMLButtonElement>('.action-toggle-pin').forEach(btn => {
      btn.onclick = async () => {
        const postId = btn.dataset.postId;
        const post = allPosts.find(p => p.id === postId);
        if (!post) return;
        try {
          await api(`${API.posts}/${post.id}`, jsonInit('PATCH', { pinned: !post.pinned }));
          await loadPosts({ silent: true });
        } catch (e: any) {
          showToast(e.message || 'Không ghim được bài viết');
        }
      };
    });

    // Copy Link
    qa<HTMLButtonElement>('.action-copy-link').forEach(btn => {
      btn.onclick = () => {
        navigator.clipboard.writeText(window.location.origin + withBase('/nhom') + '#' + btn.dataset.postId);
        showToast('Đã sao chép liên kết bài viết!', 'success');
      };
    });

    // Delete post → Supabase (xoá luôn ảnh trên Storage)
    qa<HTMLButtonElement>('.action-delete-post').forEach(btn => {
      btn.onclick = async () => {
        const postId = btn.dataset.postId;
        if (!postId || !confirm('Bạn có chắc muốn xoá bài viết này không?')) return;
        try {
          await api(`${API.posts}/${postId}`, { method: 'DELETE' });
          allPosts = allPosts.filter(p => p.id !== postId);
          updatePinnedBanner();
          renderFeed(false);
          showToast('Đã xoá bài viết', 'success');
        } catch (e: any) {
          showToast(e.message || 'Không xoá được bài viết');
        }
      };
    });
  }

  // Close open dropdowns on outside click
  document.addEventListener('click', () => {
    qa('.post-dropdown-menu').forEach(m => m.classList.add('hidden'));
    const tagDropdown = q('#tag-menu-dropdown');
    if (tagDropdown) tagDropdown.classList.add('hidden');
  });

  // Lightbox functions
  function openLightbox(imgUrl: string) {
    const modal = q('#lightbox-modal');
    const img = q<HTMLImageElement>('#lightbox-image');
    img.src = imgUrl;
    modal.classList.remove('hidden');
  }

  function closeLightbox() {
    q('#lightbox-modal').classList.add('hidden');
  }

  q('#btn-close-lightbox').onclick = closeLightbox;
  q('#lightbox-backdrop').onclick = closeLightbox;
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // Scroll Helpers
  function scrollToBottom() {
    const viewport = q('#feed-viewport');
    setTimeout(() => {
      viewport.scrollTo({
        top: viewport.scrollHeight,
        behavior: 'smooth'
      });
    }, 50);
  }

  const scrollBottomBtn = q('#btn-scroll-bottom');
  const feedViewport = q('#feed-viewport');
  feedViewport.onscroll = () => {
    const distanceToBottom = feedViewport.scrollHeight - feedViewport.scrollTop - feedViewport.clientHeight;
    if (distanceToBottom > 320) {
      scrollBottomBtn.classList.add('visible');
    } else {
      scrollBottomBtn.classList.remove('visible');
    }
  };
  scrollBottomBtn.onclick = scrollToBottom;

  // Composer Form & Input Logic
  const composerInput = q<HTMLTextAreaElement>('#composer-input');
  const sendBtn = q<HTMLButtonElement>('#btn-send-post');
  const previewZone = q('#preview-zone');
  const linkChipZone = q('#link-chip-zone');
  const attachedLinkDisplay = q('#attached-link-display');
  const charCounter = q('#char-counter');

  function updateComposerState() {
    const text = composerInput.value.trim();
    charCounter.textContent = `${composerInput.value.length}/4000`;

    // Auto expand textarea height
    composerInput.style.height = 'auto';
    composerInput.style.height = Math.min(composerInput.scrollHeight, 180) + 'px';

    const canSend = canUseGroup && !isPublishing && (text.length > 0 || attachedFiles.length > 0 || attachedLink !== null);
    sendBtn.disabled = !canSend;
  }

  composerInput.addEventListener('input', updateComposerState);

  // Send Post Action → upload ảnh lên Supabase Storage + lưu bài vào Supabase
  async function handlePublishPost() {
    if (isPublishing || !canUseGroup) return;
    const body = composerInput.value.trim();
    if (!body && attachedFiles.length === 0 && !attachedLink) return;

    // Detect link in body if not attached yet
    let detectedLink = attachedLink;
    if (!detectedLink) {
      const match = body.match(/https?:\/\/[^\s]+/);
      if (match) {
        detectedLink = {
          url: match[0],
          title: match[0].replace(/^https?:\/\//, '').split('/')[0] + ' · Tài liệu liên kết'
        };
      }
    }

    const form = new FormData();
    form.append('classId', activeClass.id);
    form.append('tag', activeTag);
    form.append('body', body);
    if (detectedLink) {
      form.append('linkUrl', detectedLink.url);
      form.append('linkTitle', detectedLink.title);
    }
    attachedFiles.forEach(file => form.append('images', file, file.name));

    isPublishing = true;
    sendBtn.classList.add('is-loading');
    updateComposerState();

    try {
      const { id } = await api<{ id: string }>(API.posts, { method: 'POST', body: form });

      // Reset composer
      composerInput.value = '';
      composerInput.style.height = 'auto';
      attachedPreviews.forEach(url => URL.revokeObjectURL(url));
      attachedFiles = [];
      attachedPreviews = [];
      attachedLink = null;
      renderImagePreviews();
      renderLinkChip();

      await loadPosts({ silent: true });

      // Animate newly posted card with slide-up
      const newEl = document.getElementById(id);
      if (newEl) {
        newEl.classList.add('post-slide-up');
        newEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (e: any) {
      showToast(e.message || 'Không đăng được bài');
    } finally {
      isPublishing = false;
      sendBtn.classList.remove('is-loading');
      updateComposerState();
    }
  }

  sendBtn.onclick = handlePublishPost;

  // Keyboard shortcut: Enter to send, Shift+Enter to newline
  composerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      handlePublishPost();
    }
  });

  // Nén ảnh lớn trước khi upload (giữ nguyên GIF)
  async function compressImage(file: File): Promise<File> {
    if (file.type === 'image/gif' || file.size < 800 * 1024) return file;
    try {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close?.();
      const blob = await new Promise<Blob | null>(resolve => canvas.toBlob(resolve, 'image/webp', 0.85));
      if (!blob || blob.size >= file.size) return file;
      return new File([blob], file.name.replace(/\.[^.]+$/, '') + '.webp', { type: 'image/webp' });
    } catch {
      return file;
    }
  }

  // Image Upload Handling
  const inputImages = q<HTMLInputElement>('#input-images');
  inputImages.addEventListener('change', async (e) => {
    const files = Array.from((e.target as HTMLInputElement).files || []);
    inputImages.value = '';
    if (!files.length) return;

    for (const original of files) {
      if (attachedFiles.length >= MAX_IMAGES) {
        showToast(`Tối đa ${MAX_IMAGES} ảnh mỗi bài`);
        break;
      }
      if (!ALLOWED_IMAGE_TYPES.includes(original.type)) {
        showToast(`Ảnh "${original.name}" không đúng định dạng (JPG, PNG, WEBP, GIF)`);
        continue;
      }
      const file = await compressImage(original);
      if (file.size > MAX_IMAGE_BYTES) {
        showToast(`Ảnh "${original.name}" vượt quá 5MB`);
        continue;
      }
      attachedFiles.push(file);
      attachedPreviews.push(URL.createObjectURL(file));
    }

    renderImagePreviews();
    updateComposerState();
  });

  function renderImagePreviews() {
    if (attachedPreviews.length === 0) {
      previewZone.classList.add('hidden');
      previewZone.innerHTML = '';
      return;
    }

    previewZone.classList.remove('hidden');
    previewZone.innerHTML = attachedPreviews.map((src, index) => `
      <div class="preview-item">
        <img src="${src}" alt="Ảnh đính kèm ${index + 1}" />
        <button type="button" class="btn-remove-preview" data-index="${index}" title="Xoá ảnh">✕</button>
      </div>
    `).join('');

    qa<HTMLButtonElement>('.btn-remove-preview').forEach(btn => {
      btn.onclick = () => {
        const idx = Number(btn.dataset.index);
        const [url] = attachedPreviews.splice(idx, 1);
        if (url) URL.revokeObjectURL(url);
        attachedFiles.splice(idx, 1);
        renderImagePreviews();
        updateComposerState();
      };
    });
  }

  // Attach Link Action
  q('#btn-attach-link').onclick = () => {
    const raw = prompt('Dán địa chỉ liên kết (URL) tài liệu, bài giảng hoặc website:');
    if (!raw) return;
    let url = raw.trim();
    if (!/^https?:\/\//i.test(url)) {
      url = 'https://' + url;
    }
    const title = prompt('Tiêu đề hoặc mô tả ngắn cho liên kết này (tuỳ chọn):', 'Tài liệu học tập') || url;
    attachedLink = { url, title };
    renderLinkChip();
    updateComposerState();
  };

  function renderLinkChip() {
    if (!attachedLink) {
      linkChipZone.classList.add('hidden');
      return;
    }
    linkChipZone.classList.remove('hidden');
    attachedLinkDisplay.textContent = `${attachedLink.title} (${attachedLink.url})`;
  }

  q('#btn-remove-link').onclick = () => {
    attachedLink = null;
    renderLinkChip();
    updateComposerState();
  };

  // Change Tag Dropdown
  const btnChangeTag = q('#btn-change-tag');
  const tagDropdown = q('#tag-menu-dropdown');
  btnChangeTag.onclick = (e) => {
    e.stopPropagation();
    tagDropdown.classList.toggle('hidden');
  };

  qa<HTMLButtonElement>('#tag-menu-dropdown button').forEach(btn => {
    btn.onclick = () => {
      const tag = btn.dataset.tag;
      if (tag) {
        activeTag = tag;
        q('#active-tag-badge').textContent = tag;
        tagDropdown.classList.add('hidden');
      }
    };
  });

  // Quick Emoji Bar
  const btnQuickEmoji = q('#btn-quick-emoji');
  const quickEmojiBar = q('#quick-emojis-bar');
  btnQuickEmoji.onclick = (e) => {
    e.stopPropagation();
    quickEmojiBar.classList.toggle('hidden');
  };

  qa<HTMLButtonElement>('.emoji-tap').forEach(btn => {
    btn.onclick = () => {
      composerInput.value += btn.textContent;
      composerInput.focus();
      updateComposerState();
    };
  });

  // Search Classes in Sidebar
  const classSearchInput = q<HTMLInputElement>('#class-search-input');
  classSearchInput.addEventListener('input', () => {
    searchTerm = classSearchInput.value.trim();
    renderSidebarClasses();
  });

  // Sidebar Mobile Toggle
  const sidebarEl = q('#gpt-sidebar');
  const backdropEl = q('#sidebar-backdrop');
  const btnToggleSidebar = q('#btn-toggle-sidebar');
  const btnCloseSidebar = q('#btn-close-sidebar');

  function openMobileSidebar() {
    sidebarEl.classList.add('open');
    backdropEl.classList.add('open');
  }

  function closeMobileSidebar() {
    sidebarEl.classList.remove('open');
    backdropEl.classList.remove('open');
  }

  btnToggleSidebar.onclick = openMobileSidebar;
  btnCloseSidebar.onclick = closeMobileSidebar;
  backdropEl.onclick = closeMobileSidebar;

  // New Thread Button
  q('#btn-new-thread').onclick = () => {
    composerInput.focus();
    composerInput.scrollIntoView({ behavior: 'smooth' });
  };

  // Keyboard shortcut Ctrl+K
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      composerInput.focus();
    }
  });

  // Members modal
  const membersModal = q('#members-modal');
  const btnViewMembers = q('#btn-view-members');
  const btnCloseMembers = q('#btn-close-members');
  const membersBackdrop = q('#members-backdrop');

  btnViewMembers.onclick = async () => {
    q('#members-modal-title').textContent = 'Thành viên nhóm lớp học';
    const listBody = q('#members-list-body');
    listBody.innerHTML = '<p class="members-loading">Đang tải danh sách thành viên...</p>';
    membersModal.classList.remove('hidden');

    if (!canUseGroup) {
      listBody.innerHTML = '<p class="members-loading">Vui lòng đăng nhập bằng tài khoản đã đăng ký.</p>';
      return;
    }

    try {
      const { members } = await api<{ members: AuthorItem[] }>(API.members);
      q('#members-modal-title').textContent = `Thành viên đã đăng ký · ${members.length}`;
      listBody.innerHTML = members.length
        ? members.map(m => `
          <div class="member-row">
            <img src="${safeUrl(m.avatar)}" alt="${escapeHtml(m.name)}" class="member-avatar" loading="lazy" />
            <div class="member-info">
              <span class="member-name">${escapeHtml(m.name)}</span>
              <span class="member-role">${escapeHtml(m.role)}</span>
            </div>
            <span class="post-role-badge ${roleClassOf(m.role)}">${escapeHtml(m.role)}</span>
          </div>
        `).join('')
        : '<p class="members-loading">Chưa có thành viên nào.</p>';
    } catch (e: any) {
      listBody.innerHTML = `<p class="members-loading">${escapeHtml(e.message || 'Không tải được danh sách')}</p>`;
    }
  };

  const closeMembers = () => membersModal.classList.add('hidden');
  btnCloseMembers.onclick = closeMembers;
  membersBackdrop.onclick = closeMembers;

  // Share group button
  q('#btn-share-group').onclick = () => {
    navigator.clipboard.writeText(window.location.href);
    alert(`Đã sao chép liên kết mời tham gia Lớp ${activeClass.name}!`);
  };

  // View pinned button
  q('#btn-view-pinned').onclick = () => {
    const pinnedPost = allPosts.find(p => p.classId === activeClass.id && p.pinned);
    if (pinnedPost) {
      const el = document.getElementById(pinnedPost.id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('highlight-flash');
        setTimeout(() => el.classList.remove('highlight-flash'), 2500);
      }
    } else {
      alert(`Lớp ${activeClass.name} hiện chưa có tin ghim nào.`);
    }
  };

  // Initialize Application
  async function initApp() {
    if (!canUseGroup) {
      composerInput.disabled = true;
      composerInput.placeholder = 'Đăng nhập bằng tài khoản đã đăng ký để tham gia thảo luận';
    }

    try {
      const { groups } = await api<{ groups: GroupClass[] }>(API.groups);
      classesData = groups;
    } catch (e) {
      console.warn('Cannot load classes', e);
      classesData = [];
    }

    const urlParams = new URLSearchParams(window.location.search);
    const groupId = urlParams.get('groupId');
    
    if (classesData.length > 0) {
      const target = classesData.find(g => g.id === groupId) || classesData[0];
      activeClass = target;
      renderSidebarClasses();
      switchClass(activeClass.id);
    } else {
      renderSidebarClasses();
    }
  }

  initApp();

  // Tự động cập nhật tin nhắn mới mỗi 20 giây khi tab đang mở
  setInterval(() => {
    if (document.visibilityState === 'visible' && canUseGroup && !isPublishing) {
      loadPosts({ silent: true });
    }
  }, 20000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && canUseGroup) loadPosts({ silent: true });
  });
</script>

