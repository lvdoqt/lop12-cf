    padding: 1px 5px;
    border-radius: 9999px;
  }

  /* Pinned Banner */
  .pinned-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 18px;
    background: rgba(245, 158, 11, 0.12);
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
    z-index: 10;
  }

  .pinned-banner-content {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .pinned-icon-wrapper {
    flex-shrink: 0;
  }

  .pinned-text-group {
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pinned-label {
    font-weight: 800;
    color: #f59e0b;
    margin-right: 6px;
    font-size: 11px;
  }

  .pinned-snippet {
    color: #fef3c7;
  }

  .pinned-jump-btn {
    font-size: 11px;
    font-weight: 700;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 3px 8px;
    border-radius: 6px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .pinned-jump-btn:hover {
    background: rgba(245, 158, 11, 0.25);
  }

  /* Feed Viewport */
  .feed-viewport {
    flex: 1;
    overflow-y: auto;
    padding: 24px 20px 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    scroll-behavior: smooth;
  }

  /* Welcome Hero */
  .class-welcome-hero {
    width: 100%;
    max-width: 740px;
    padding: 28px 24px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    margin-bottom: 24px;
  }

  .hero-sparkle {
    font-size: 20px;
    color: #818cf8;
    margin-bottom: 6px;
  }

  .hero-title {
    font-size: 18px;
    font-weight: 700;
    color: #fafafa;
    margin: 0 0 8px;
  }

  .hero-desc {
    font-size: 13px;
    color: #a1a1aa;
    max-width: 580px;
    margin: 0 auto 16px;
    line-height: 1.5;
  }

  .hero-tags {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag-pill {
    font-size: 11px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d4d4d8;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  /* Posts Stream */
  .posts-stream {
    width: 100%;
    max-width: 740px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Post Card (ChatGPT Meets Zalo Group Post) */
  .post-card {
    background: #2a2a2a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .post-card.is-pinned-card {
    border-color: rgba(245, 158, 11, 0.4);
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.05) 0%, #2a2a2a 100%);
  }

  .post-card.highlight-flash {
    animation: flashPulse 2s ease;
  }

  @keyframes flashPulse {
    0%, 100% { border-color: rgba(255, 255, 255, 0.08); }
    50% { border-color: #6366f1; box-shadow: 0 0 25px rgba(99, 102, 241, 0.5); }
  }

  .post-slide-up {
    animation: postSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes postSlideUp {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    margin-bottom: 12px;
  }

  .author-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .post-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #3f3f46;
    object-fit: cover;
  }

  .author-online-indicator {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #10b981;
    border: 2px solid #2a2a2a;
  }

  .post-author-info {
    flex: 1;
    min-width: 0;
  }

  .author-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .post-author-name {
    font-size: 14px;
    font-weight: 700;
    color: #f4f4f5;
  }

  .post-role-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 5px;
  }

  .role-teacher {
    background-color: rgba(239, 68, 68, 0.2);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .role-monitor {
    background-color: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .role-student {
    background-color: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .role-admin {
    background-color: rgba(168, 85, 247, 0.2);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .post-pinned-badge {
    font-size: 10px;
    font-weight: 700;
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
  }

  .post-time {
    font-size: 11px;
    color: #a1a1aa;
  }

  .meta-dot {
    color: #52525b;
    font-size: 10px;
  }

  .post-tag-badge {
    font-size: 11px;
    color: #818cf8;
    font-weight: 600;
  }

  .post-action-menu {
    position: relative;
  }

  .post-menu-btn {
    background: transparent;
    border: none;
    color: #71717a;
    font-size: 14px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
  }

  .post-menu-btn:hover {
    color: #f4f4f5;
    background: rgba(255, 255, 255, 0.08);
  }

  .post-dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    background: #1f1f1f;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    min-width: 170px;
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .post-dropdown-menu button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    padding: 8px 10px;
    border-radius: 6px;
    background: transparent;
    border: none;
    color: #d4d4d8;
    font-size: 12px;
    cursor: pointer;
  }

  .post-dropdown-menu button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .post-body-content {
    font-size: 14px;
    line-height: 1.65;
    color: #e4e4e7;
    word-break: break-word;
  }

  .post-inline-link {
    color: #818cf8;
    text-decoration: underline;
    font-weight: 600;
  }

  .post-inline-link:hover {
    color: #a5b4fc;
  }

  /* Post Media Grid (Zalo Style Photos) */
  .post-media-grid {
    display: grid;
    gap: 6px;
    margin-top: 12px;
    border-radius: 12px;
    overflow: hidden;
  }

  .post-media-grid.grid-1 {
    grid-template-columns: 1fr;
    max-height: 380px;
  }

  .post-media-grid.grid-2 {
    grid-template-columns: 1fr 1fr;
    max-height: 260px;
  }

  .post-media-grid.grid-3 {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    max-height: 320px;
  }

  .post-media-grid.grid-3 .post-img-thumb:first-child {
    grid-row: span 2;
  }

  .post-media-grid.grid-4 {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    max-height: 320px;
  }

  .post-img-thumb {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    background-color: #18181b;
  }

  .post-img-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .post-img-thumb:hover img {
    transform: scale(1.03);
  }

  /* Link Preview Box */
  .link-preview-box {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .link-preview-box:hover {
    background: rgba(0, 0, 0, 0.4);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .link-preview-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #312e81;
    color: #a5b4fc;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .link-preview-content {
    flex: 1;
    min-width: 0;
  }

  .link-preview-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #f4f4f5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-preview-url {
    display: block;
    font-size: 11px;
    color: #818cf8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Post Footer & Reactions */
  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .reactions-strip {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .reaction-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #a1a1aa;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .reaction-btn:hover {
    background: rgba(255, 255, 255, 0.09);
    color: #fff;
  }

  .reaction-btn.active {
    background: rgba(99, 102, 241, 0.2);
    border-color: rgba(99, 102, 241, 0.4);
    color: #c7d2fe;
    font-weight: 600;
  }

  .reaction-btn.heart-active {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }

  .reaction-btn.like-active {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.4);
    color: #93c5fd;
  }

  .emoji-icon {
    font-size: 13px;
  }

  .reaction-count {
    font-size: 11px;
  }

  .comments-toggle-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-size: 12px;
    cursor: pointer;
    padding: 5px 8px;
    border-radius: 6px;
  }

  .comments-toggle-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  /* Comments Section */
  .comments-section {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .comment-item {
    display: flex;
    gap: 9px;
  }

  .comment-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: #3f3f46;
    flex-shrink: 0;
  }

  .comment-bubble {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 8px 12px;
    flex: 1;
  }

  .comment-author-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 2px;
  }

  .comment-author {
    font-size: 12px;
    font-weight: 700;
    color: #f4f4f5;
  }

  .comment-role {
    font-size: 9px;
    color: #818cf8;
    background: rgba(99, 102, 241, 0.15);
    padding: 1px 4px;
    border-radius: 4px;
  }

  .comment-time {
    font-size: 10px;
    color: #71717a;
    margin-left: auto;
  }

  .comment-text {
    font-size: 12px;
    color: #d4d4d8;
    line-height: 1.5;
  }

  .reply-composer-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .reply-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .reply-input {
    flex: 1;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 7px 11px;
    color: #f4f4f5;
    font-size: 12px;
    outline: none;
  }

  .reply-input:focus {
    border-color: #6366f1;
  }

  .reply-send-btn {
    background: #4f46e5;
    border: none;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 7px 12px;
    border-radius: 8px;
    cursor: pointer;
  }

  .reply-send-btn:hover {
    background: #4338ca;
  }

  /* Empty feed card */
  .empty-feed-card {
    padding: 60px 24px;
    text-align: center;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 16px;
  }

  .empty-icon {
    font-size: 38px;
    margin-bottom: 12px;
  }

  .empty-title {
    font-size: 16px;
    font-weight: 700;
    color: #f4f4f5;
    margin: 0 0 6px;
  }

  .empty-subtitle {
    font-size: 13px;
    color: #a1a1aa;
    max-width: 420px;
    margin: 0 auto 18px;
  }

  .empty-start-btn {
    background: #4f46e5;
    color: #fff;
    border: none;
    padding: 9px 18px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  /* Scroll to Bottom Button */
  .scroll-bottom-btn {
    position: fixed;
    bottom: 140px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 9999px;
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fafafa;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 25;
    cursor: pointer;
  }

  .scroll-bottom-btn.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  /* ======================================================== */
  /* CHATGPT SIGNATURE BOTTOM DOCK COMPOSER                   */
  /* ======================================================== */
  .composer-dock-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 16px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(180deg, rgba(33, 33, 33, 0) 0%, rgba(33, 33, 33, 0.95) 45%, #212121 100%);
    pointer-events: none;
    z-index: 30;
  }

  .composer-card {
    width: 100%;
    max-width: 760px;
    background: #2f2f2f;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 10px 14px 10px 16px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
    pointer-events: auto;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .composer-card:focus-within {
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.55);
  }

  /* Attachment Previews */
  .attachments-preview-zone {
    display: flex;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 8px;
  }

  .preview-item {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 8px;
    overflow: hidden;
    background: #18181b;
  }

  .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .btn-remove-preview {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    border: none;
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  /* Attached Link Chip */
  .link-chip-zone {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    margin-bottom: 8px;
    font-size: 11px;
    color: #c7d2fe;
  }

  .link-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .remove-chip-btn {
    background: transparent;
    border: none;
    color: #fca5a5;
    font-size: 14px;
    cursor: pointer;
  }

  /* Active Tag Chip */
  .tag-chip-zone {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
    position: relative;
  }

  .active-tag-badge {
    font-size: 11px;
    font-weight: 700;
    color: #818cf8;
    background: rgba(99, 102, 241, 0.15);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .change-tag-btn {
    font-size: 10px;
    color: #a1a1aa;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .change-tag-btn:hover {
    color: #fff;
  }

  .tag-menu-dropdown {
    position: absolute;
    bottom: 100%;
    left: 0;
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 6px;
    margin-bottom: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 40;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    min-width: 190px;
  }

  .tag-menu-dropdown button {
    background: transparent;
    border: none;
    color: #d4d4d8;
    padding: 7px 10px;
    text-align: left;
    font-size: 12px;
    border-radius: 6px;
    cursor: pointer;
  }

  .tag-menu-dropdown button:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  /* Textarea */
  .textarea-wrapper {
    width: 100%;
  }

  .textarea-wrapper textarea {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: #fafafa;
    font-size: 14px;
    line-height: 1.5;
    resize: none;
    max-height: 180px;
    display: block;
    font-family: inherit;
  }

  .textarea-wrapper textarea::placeholder {
    color: #8e8e93;
  }

  /* Actions Bar */
  .composer-actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    position: relative;
  }

  .composer-left-tools {
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
  }

  .tool-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 9px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tool-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .quick-emojis-bar {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin-bottom: 8px;
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
    padding: 4px 8px;
    display: flex;
    gap: 4px;
    z-index: 40;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .emoji-tap {
