---
import Layout from '../../../layouts/Layout.astro';
import RandomPicker from '../../../components/giao-vien/RandomPicker';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Bốc thăm ngẫu nhiên — Công cụ giảng dạy">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <a href="/giao-vien" class="text-gray-400 hover:text-gray-600 dark:hover:text-slate-300 transition">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center gap-2">
            <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center text-white shadow-lg shadow-amber-500/20 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            Bốc thăm ngẫu nhiên
          </h1>
        </div>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1 ml-12">
          Gọi tên học sinh ngẫu nhiên, chia nhóm thảo luận. Lưu danh sách lớp để dùng lại.
        </p>
      </div>
    </div>

    <!-- Random picker component -->
    <RandomPicker client:load />
  </div>
</Layout>
