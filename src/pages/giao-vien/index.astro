---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}

// Fetch teacher stats
const isAdmin = user.role === 'admin';
const myExams = await db.getExams(undefined, isAdmin ? undefined : user.id);
const allAttempts = await db.getAllAttempts?.() || [];
const myExamIds = new Set(myExams.map(e => e.id));
const attemptsOnMyExams = allAttempts.filter((a: any) => myExamIds.has(a.exam_id));
const completedAttempts = attemptsOnMyExams.filter((a: any) => a.score !== null);
const avgScore = completedAttempts.length > 0
  ? (completedAttempts.reduce((sum: number, a: any) => sum + Number(a.score || 0), 0) / completedAttempts.length).toFixed(1)
  : '—';
---

<Layout title="Công cụ giảng dạy">
  <div class="space-y-8">
    <!-- Header -->
    <div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0v6" />
        </svg>
        Công cụ Giảng dạy
      </h1>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">
        Các tiện ích hỗ trợ giảng dạy trực tuyến — trình chiếu câu hỏi, bảng trắng và các công cụ lớp học.
      </p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-4">
        <p class="text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wide">Đề thi</p>
        <p class="text-2xl font-black text-gray-900 dark:text-white mt-1">{myExams.length}</p>
      </div>
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-4">
        <p class="text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wide">Lượt thi</p>
        <p class="text-2xl font-black text-gray-900 dark:text-white mt-1">{attemptsOnMyExams.length}</p>
      </div>
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-4">
        <p class="text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wide">Đã hoàn thành</p>
        <p class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">{completedAttempts.length}</p>
      </div>
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-4">
        <p class="text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wide">Điểm TB</p>
        <p class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-1">{avgScore}</p>
