              </svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-600 dark:bg-amber-950/20 dark:text-amber-400">
              Mới
            </span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mt-4 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
            Bốc thăm ngẫu nhiên
          </h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 mt-1.5 leading-relaxed">
            Gọi tên học sinh ngẫu nhiên với animation hấp dẫn, hoặc chia nhóm thảo luận nhanh. Lưu danh sách lớp.
          </p>
          <div class="mt-4 flex flex-wrap gap-2 text-[11px] font-semibold text-gray-500 dark:text-slate-400">
            <span class="px-2 py-1 rounded-lg bg-gray-100 dark:bg-slate-800">Bốc 1 bạn</span>
            <span class="px-2 py-1 rounded-lg bg-gray-100 dark:bg-slate-800">Chia nhóm</span>
            <span class="px-2 py-1 rounded-lg bg-gray-100 dark:bg-slate-800">Lưu danh sách lớp</span>
            <span class="px-2 py-1 rounded-lg bg-gray-100 dark:bg-slate-800">Toàn màn hình</span>
          </div>
        </a>

        <!-- Khảo sát nhanh — MỚI -->
        <a
          href="/giao-vien/khao-sat"
          class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
