---
import Layout from '../../../layouts/Layout.astro';
import ClassManager from '../../../components/giao-vien/ClassManager';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Quản lý Lớp (Lớp dạy & Chủ nhiệm) — Công cụ giảng dạy">
  <div class="space-y-6">
    <!-- Breadcrumb back link -->
    <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 dark:text-slate-400">
      <a href="/giao-vien" class="hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Công cụ Giảng dạy
      </a>
      <span>/</span>
      <span class="text-gray-900 dark:text-white">Quản lý Lớp học</span>
    </div>

    <!-- Main Client Component -->
    <ClassManager client:load />
  </div>
</Layout>
