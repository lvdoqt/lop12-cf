---
import Layout from '../../../layouts/Layout.astro';
import { PadletBoard } from '../../../components/giao-vien/padlet/PadletBoard';
import { PadletStudentView } from '../../../components/giao-vien/padlet/PadletStudentView';
import { padletKV, getPadletKV } from '../../../lib/padletKV';

export const prerender = false;

const user = Astro.locals.user;
const isTeacher = user && (user.role === 'teacher' || user.role === 'admin');

const { code } = Astro.params;
if (!code) {
  return Astro.redirect('/giao-vien/padlet');
}

const kv = getPadletKV();
const board = kv ? await padletKV.getBoardByCode(kv, code) : null;
if (!board) {
  return Astro.redirect(isTeacher ? '/giao-vien/padlet?error=notfound' : '/?error=notfound');
}
---

<Layout
  title={`${board.title} — Bảng tương tác Padlet`}
  showSidebar={false}
  showAds={false}
>
  {isTeacher ? (
    <PadletBoard client:load board={board} isTeacher={true} />
  ) : (
    <PadletStudentView client:load board={board} />
  )}
</Layout>
