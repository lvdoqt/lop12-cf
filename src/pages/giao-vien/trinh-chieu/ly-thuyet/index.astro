---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import { db } from '../../../../services/db';


export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}

const subjects = await db.getSubjects();
const allLessons = await getCollection('lessons');

// Count lessons per subject
const lessonCountBySubject: Record<string, number> = {};
for (const entry of allLessons) {
  const subjectSlug = entry.id.split('/')[0];
  lessonCountBySubject[subjectSlug] = (lessonCountBySubject[subjectSlug] || 0) + 1;
}

const subjectMetas: Record<string, { icon: string; color: string; gradient: string }> = {
  'toan-12':      { icon: '📐', color: 'blue',    gradient: 'from-blue-500 to-indigo-600' },
  'vat-ly-12':    { icon: '⚡', color: 'purple',  gradient: 'from-purple-500 to-violet-600' },
  'hoa-hoc-12':   { icon: '🧪', color: 'emerald', gradient: 'from-emerald-500 to-green-600' },
  'sinh-hoc-12':  { icon: '🧬', color: 'teal',    gradient: 'from-teal-500 to-cyan-600' },
  'ngu-van-12':   { icon: '📖', color: 'rose',    gradient: 'from-rose-500 to-pink-600' },
  'lich-su-12':   { icon: '🏛️', color: 'orange', gradient: 'from-orange-500 to-amber-600' },
  'dia-ly-12':    { icon: '🌏', color: 'cyan',    gradient: 'from-cyan-500 to-sky-600' },
  'ktpl-12':      { icon: '⚖️', color: 'yellow', gradient: 'from-yellow-500 to-amber-500' },
  'tieng-anh-12': { icon: '🇬🇧', color: 'amber', gradient: 'from-amber-500 to-orange-500' },
  'tin-hoc-12':   { icon: '💻', color: 'violet',  gradient: 'from-violet-500 to-purple-600' },
  'cong-nghe-12': { icon: '⚙️', color: 'slate',  gradient: 'from-slate-500 to-gray-600' },
};
---

<Layout title="Chọn môn học — Trình chiếu Lý thuyết">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          Lý thuyết &amp; Luyện tập
        </h1>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">
          Chọn môn học để xem danh sách bài giảng
        </p>
      </div>
      <a
        href="/giao-vien/trinh-chieu"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-700 text-sm font-semibold text-gray-600 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-800 transition shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Về Công cụ giảng dạy
      </a>
    </div>

    <!-- Subject grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      {subjects.map(subject => {
        const meta = subjectMetas[subject.slug] || { icon: '📚', color: 'blue', gradient: 'from-blue-500 to-indigo-600' };
        const count = lessonCountBySubject[subject.slug] || 0;
        if (count === 0) return null;
        return (
          <a
            href={`/giao-vien/trinh-chieu/ly-thuyet/${subject.slug}`}
            class="group bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex flex-col items-center text-center gap-3"
          >
            <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${meta.gradient} flex items-center justify-center shadow-lg text-2xl`}>
              {meta.icon}
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-snug group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {subject.name}
              </p>
              <p class="text-xs text-gray-400 dark:text-slate-500 mt-0.5 font-medium">
                {count} bài học
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
