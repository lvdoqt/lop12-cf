---
import Layout from '../../../layouts/Layout.astro';
import PresentationView from '../../../components/giao-vien/PresentationView';
import { db } from '../../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/giao-vien/trinh-chieu');
}

const exam = await db.getExamById(id);
if (!exam) {
  return Astro.redirect('/giao-vien/trinh-chieu');
}

const questions = await db.getQuestionsByExamId(exam.id);
---

<Layout title={`Trình chiếu: ${exam.title}`} showSidebar={false} showAds={false}>
  <PresentationView
    client:load
    exam={{ id: exam.id, slug: exam.slug, title: exam.title }}
    questions={questions}
  />
</Layout>
