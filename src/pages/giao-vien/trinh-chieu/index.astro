---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}

const isAdmin = user.role === 'admin';
const exams = await db.getExams(undefined, isAdmin ? undefined : user.id);
const examIds = exams.map(e => e.id);
const questionCounts = await db.getExamQuestionCounts(examIds);

const examTypeNames = {
  '15m': 'Kiểm tra 15p',
  '45m': 'Kiểm tra 1 tiết',
  'semester': 'Thi học kỳ',
  'mock_thpt': 'Thi thử THPT'
} as const;
---

<Layout title="Trình chiếu & Bảng trắng">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          Trình chiếu &amp; Bảng trắng
        </h1>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">
          Chọn một đề thi để trình chiếu toàn màn hình. Bật bảng trắng để vẽ trực tiếp lên câu hỏi.
        </p>
      </div>
      <a
        href="/giao-vien"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-700 text-sm font-semibold text-gray-600 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-800 transition shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Về Công cụ giảng dạy
      </a>
    </div>

    <!-- JSON Import card — always visible -->
    <a
      href="/giao-vien/trinh-chieu/json"
      class="group flex items-center gap-4 bg-gradient-to-r from-violet-50 to-purple-50 dark:from-violet-950/20 dark:to-purple-950/20 border border-violet-200/60 dark:border-violet-800/40 rounded-2xl p-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
    >
      <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-violet-500/20 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-bold text-violet-700 dark:text-violet-300 group-hover:text-violet-800 dark:group-hover:text-violet-200 transition-colors">
          Trình chiếu từ JSON
        </p>
        <p class="text-xs text-violet-600/70 dark:text-violet-400/70 mt-0.5">
          Dán hoặc tải lên file JSON câu hỏi để trình chiếu ngay — không cần lưu vào hệ thống
        </p>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-violet-400 group-hover:text-violet-600 dark:group-hover:text-violet-300 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <!-- Lý thuyết & Luyện tập card — always visible -->
    <a
      href="/giao-vien/trinh-chieu/ly-thuyet"
      class="group flex items-center gap-4 bg-gradient-to-r from-emerald-50 to-teal-50 dark:from-emerald-950/20 dark:to-teal-950/20 border border-emerald-200/60 dark:border-emerald-800/40 rounded-2xl p-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
    >
      <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-bold text-emerald-700 dark:text-emerald-300 group-hover:text-emerald-800 dark:group-hover:text-emerald-200 transition-colors">
          Lý thuyết &amp; Luyện tập
        </p>
        <p class="text-xs text-emerald-600/70 dark:text-emerald-400/70 mt-0.5">
          Chọn Môn → Bài học → Trình chiếu lý thuyết hoặc câu hỏi luyện tập từ nội dung bài giảng
        </p>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-300 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    {isAdmin && (
      <p class="text-xs text-amber-600 dark:text-amber-400 font-medium -mt-2">
        ⚠️ Chế độ admin: đang xem tất cả đề thi của mọi giáo viên.
      </p>
    )}

    {exams.length === 0 ? (
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-12 text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-50 dark:bg-amber-950/20 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-gray-800 dark:text-white mb-2">Bạn chưa có đề thi nào</h2>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-6">
          Tạo đề thi để trình chiếu, hoặc dùng nút "Trình chiếu từ JSON" bên trên để bắt đầu ngay.
        </p>
        <a
          href="/admin/exams"
          class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition"
        >
          Tạo đề thi
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {exams.map(exam => {
          const qCount = questionCounts[exam.id] || 0;
          return (
            <div
              class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col"
            >
              <div class="flex items-center justify-between mb-3 gap-2">
                {exam.subject && (
                  <span class="text-xs font-bold text-blue-600 dark:text-blue-400">
                    Môn {exam.subject.name}
                  </span>
                )}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-blue-50 text-blue-600 dark:bg-blue-950/20 dark:text-blue-400">
                  {examTypeNames[exam.exam_type]}
                </span>
              </div>

              <h2 class="text-lg font-bold text-gray-900 dark:text-white leading-snug">
                {exam.title}
              </h2>

              <div class="flex flex-wrap items-center gap-3 mt-3 text-xs text-gray-500 dark:text-slate-400 font-medium">
                <span class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {exam.duration} phút
                </span>
                <span class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {qCount} câu
                </span>
              </div>

              <div class="mt-5 pt-4 border-t border-gray-100 dark:border-slate-800 flex items-center justify-between">
                <span class={`text-xs font-bold ${qCount > 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-500'}`}>
                  {qCount > 0 ? `${qCount} câu sẵn sàng trình chiếu` : 'Chưa có câu hỏi'}
                </span>
                {qCount > 0 ? (
                  <a
                    href={`/giao-vien/trinh-chieu/${exam.id}`}
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow shadow-blue-500/20 transition"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Trình chiếu
                  </a>
                ) : (
                  <a
                    href={`/admin/exams/edit/${exam.id}`}
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-slate-300 text-sm font-bold hover:bg-gray-50 dark:hover:bg-slate-800 transition"
                  >
                    Thêm câu hỏi
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    )}

    <!-- Gợi ý sử dụng -->
    <div class="bg-blue-50/60 dark:bg-blue-950/20 border border-blue-200/50 dark:border-blue-900/30 rounded-2xl p-5">
      <h3 class="text-sm font-bold text-blue-700 dark:text-blue-300 mb-2 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Hướng dẫn nhanh khi trình chiếu
      </h3>
      <ul class="text-sm text-blue-800/80 dark:text-blue-200/70 space-y-1 font-medium">
        <li>• Dùng phím <b>←</b> / <b>→</b> để chuyển câu, <b>F</b> để toàn màn hình.</li>
        <li>• Bật <b>Bảng trắng</b> ở thanh dưới, chọn bút/tẩy + màu để vẽ trực tiếp lên slide khi share screen.</li>
        <li>• Phím <b>A</b> hiện đáp án, <b>E</b> hiện lời giải chi tiết.</li>
      </ul>
    </div>
  </div>
</Layout>
