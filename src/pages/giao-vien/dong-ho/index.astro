---
import Layout from '../../../layouts/Layout.astro';
import TimerApp from '../../../components/giao-vien/TimerApp';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Đồng hồ đếm ngược — Công cụ giảng dạy">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <a href="/giao-vien" class="text-gray-400 hover:text-gray-600 dark:hover:text-slate-300 transition">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center gap-2">
            <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-rose-500 to-orange-600 flex items-center justify-center text-white shadow-lg shadow-rose-500/20 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            Đồng hồ đếm ngược
          </h1>
        </div>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1 ml-12">
          Hẹn giờ cho kiểm tra bài, thảo luận nhóm, hoạt động trên lớp. Hỗ trợ toàn màn hình.
        </p>
      </div>
    </div>

    <!-- Timer component -->
    <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 md:p-8">
      <TimerApp client:load />
    </div>
  </div>
</Layout>
