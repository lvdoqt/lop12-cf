---
import Layout from '../../../layouts/Layout.astro';
import ExamRoomManager from '../../../components/giao-vien/ExamRoomManager';
import { db, roomStore } from '../../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'teacher' && user.role !== 'admin')) {
  return Astro.redirect('/dashboard');
}

// Load exams for this teacher
const exams = await db.getExams(undefined, user.id);
// Also get all exams if teacher has no exams yet
const allExams = exams.length > 0 ? exams : await db.getExams();

// Get teacher's existing rooms
const teacherRooms = roomStore.getTeacherRooms(user.id);
---

<Layout title="Phong thi ao - Giao vien">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-3">
          <a href="/giao-vien" class="text-gray-400 hover:text-gray-600 dark:hover:text-slate-300 transition">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center gap-2">
            <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </span>
            Phong thi ao
          </h1>
        </div>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1 ml-8">
          Tao phong thi voi ma phong, hoc sinh tham gia va lam bai real-time.
        </p>
      </div>
    </div>

    <!-- How it works banner -->
    <div class="bg-gradient-to-r from-emerald-50 to-teal-50 dark:from-emerald-950/20 dark:to-teal-950/20 border border-emerald-200 dark:border-emerald-800/40 rounded-2xl p-5">
      <h2 class="font-semibold text-emerald-900 dark:text-emerald-300 mb-3 text-sm uppercase tracking-wide">Cach hoat dong</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { step: '1', icon: 'M12 4v16m8-8H4', title: 'Mo phong', desc: 'Chon de thi, nhan Mo phong de tao ma phong 4 so ngau nhien' },
          { step: '2', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z', title: 'Hoc sinh vao', desc: 'Hoc sinh truy cap /thi-online, nhap ma phong va bat dau lam bai' },
          { step: '3', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z', title: 'Theo doi & Ket qua', desc: 'Xem tien do tung hoc sinh real-time, bang diem sau khi ket thuc' },
        ].map(s => (
          <div class="flex gap-3">
            <div class="w-7 h-7 rounded-full bg-emerald-500 text-white font-black text-xs flex items-center justify-center shrink-0 mt-0.5">{s.step}</div>
            <div>
              <p class="font-semibold text-emerald-900 dark:text-emerald-300 text-sm">{s.title}</p>
              <p class="text-xs text-emerald-700 dark:text-emerald-500 mt-0.5 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Main manager component -->
    <ExamRoomManager
      client:load
      exams={allExams.map(e => ({ id: e.id, title: e.title, duration: e.duration, subject: e.subject }))}
      teacherRooms={teacherRooms}
    />
  </div>
</Layout>