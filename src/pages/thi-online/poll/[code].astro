---
import Layout from '../../../layouts/Layout.astro';
import PollVoter from '../../../components/thi-online/PollVoter';
import { pollStore } from '../../../services/mockPollStore';

export const prerender = false;

const { code } = Astro.params;
let initialPoll = null;

if (code) {
  initialPoll = pollStore.getPollByCode(code);
}
---

<Layout title="Bình chọn khảo sát" showSidebar={false} showAds={false}>
  <div class="min-h-screen bg-gray-50 dark:bg-slate-950 px-4 py-8">
    <div class="max-w-md mx-auto mb-6 text-center">
      <a href="/" class="inline-flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg">L</div>
        <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-blue-600 to-blue-400 bg-clip-text text-transparent">LỚP 12 LMS</span>
      </a>
    </div>

    <PollVoter client:load initialPoll={initialPoll} />
  </div>
</Layout>
