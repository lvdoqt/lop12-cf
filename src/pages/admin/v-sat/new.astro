---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
export const prerender = false;
const user = Astro.locals.user;
if (!user || !['admin','teacher'].includes(user.role)) return Astro.redirect('/dashboard');
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const title = String(form.get('title') || '').trim();
    const subject_id = String(form.get('subject_id') || '');
    const duration = Number(form.get('duration'));
    const raw = String(form.get('json_data') || '');
    if (!title || !subject_id || !duration || !raw) throw new Error('Vui lòng nhập đủ tên đề, môn, thời gian và JSON câu hỏi.');
    const parsed = JSON.parse(raw);
    const source = Array.isArray(parsed) ? parsed : parsed.questions;
    if (!Array.isArray(source) || !source.length) throw new Error('JSON cần có mảng questions và ít nhất một câu.');
    const valid = ['msq','single_choice','read','matching','sa','cloze_text'];
    const batch = source.map((q: any, idx: number) => {
      if (!valid.includes(q.type)) throw new Error(`Câu ${idx + 1}: type “${q.type}” chưa được hỗ trợ cho V-SAT.`);
      const metadata: any = {};
      let answers: any[] = [];
      let answer: string | null = null;
      if (q.type === 'msq') {
        const statements = q.statements || q.options;
        if (!Array.isArray(statements) || statements.length < 2) throw new Error(`Câu ${idx + 1}: msq cần mảng statements.`);
        answers = statements.map((x: any) => ({ content: x.content || x.text, is_correct: ['true','đúng','d','đ'].includes(String(x.correct ?? x.answer).toLowerCase()) || x.correct === true }));
      } else if (q.type === 'single_choice') {
        const opts = q.options || [];
        if (opts.length < 2) throw new Error(`Câu ${idx + 1}: single_choice cần mảng options.`);
        answers = opts.map((x: any, i: number) => ({ content: typeof x === 'string' ? x : x.content, is_correct: String(q.correct_option || q.answer).toUpperCase() === String.fromCharCode(65 + i) }));
      } else if (q.type === 'read') {
        metadata.questions = q.questions || [];
        if (!metadata.questions.length) throw new Error(`Câu ${idx + 1}: read cần mảng questions.`);
      } else if (q.type === 'matching') {
        metadata.questions = q.questions || [];
        metadata.options = q.options || [];
        if (!metadata.questions.length || !metadata.options.length) throw new Error(`Câu ${idx + 1}: matching cần questions và options.`);
      } else if (q.type === 'cloze_text') {
        metadata.questions = q.blanks || q.questions || [];
        if (!metadata.questions.length) throw new Error(`Câu ${idx + 1}: cloze_text cần mảng blanks.`);
        metadata.questions.forEach((b: any, bi: number) => { if (!b.correct_answer && !b.accepted_answers?.length) throw new Error(`Câu ${idx + 1}, ô ${bi + 1}: thiếu correct_answer.`); });
      } else if (q.type === 'sa') answer = String(q.correct_answer ?? q.answer ?? '');
      return { question: { de_id: 'bank', so_cau: 0, phan: 'I', content: q.content || q.passage || '', options: [], answer, image_url: null, metadata, subject_id, explanation: q.explanation || '', difficulty: q.difficulty || 'medium', type: q.type, created_by: user.id }, answers };
    });
    const created = await db.createQuestionsBatch(batch as any);
    const exam = await db.createExam({ title, duration, subject_id, category_id: null, exam_type: 'vsat', created_by: user.id, password: String(form.get('password') || '').trim() || undefined }, created.map(q => q.id));
    return Astro.redirect(`/exams/${exam.slug}`);
  } catch (e: any) { error = e.message || 'Không thể tạo đề V-SAT.'; }
}
const subjects = await db.getSubjects();
const sample = JSON.stringify({ questions: [
  { type: 'msq', content: 'Cho dãy số $(u_n)$. Xét tính đúng sai:', statements: [{ content: 'Dãy số là cấp số cộng.', correct: true }, { content: 'Dãy số bị chặn trên.', correct: false }] },
  { type: 'read', content: 'Đọc dữ liệu sau và trả lời.', questions: [{ question: 'Kết luận nào đúng?', option_a: 'Phương án 1', option_b: 'Phương án 2', option_c: 'Phương án 3', option_d: 'Phương án 4', correct_option: 'A' }] },
  { type: 'matching', content: 'Ghép mỗi nội dung với phương án phù hợp.', questions: [{ content: 'Giá trị cực đại', correct_option: 'B' }, { content: 'Giá trị cực tiểu', correct_option: 'D' }], options: [{ key: 'A', content: '$-2$' }, { key: 'B', content: '$3$' }, { key: 'C', content: '$0$' }, { key: 'D', content: '$-1$' }] },
  { type: 'cloze_text', content: 'We cannot (21) ___ from bed. Taking naps is catching (22) ___.', blanks: [{ number: 21, correct_answer: 'get' }, { number: 22, correct_answer: 'on' }] },
  { type: 'sa', content: 'Tính giá trị biểu thức.', correct_answer: '42' }
] }, null, 2);
---
<Layout title="Tạo đề V-SAT" showSidebar={true}>
  <div class="mx-auto max-w-5xl space-y-6">
    <div><a href="/admin/exams" class="text-xs font-bold text-sky-700">← Quản lý đề thi</a><h1 class="mt-2 text-2xl font-black text-slate-800">Tạo đề thi V-SAT</h1><p class="mt-1 text-sm text-slate-500">Nhập một lần toàn bộ đề theo JSON, hỗ trợ công thức LaTeX và HTML/Markdown.</p></div>
    {error && <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-700">{error}</div>}
    <form method="post" class="space-y-6">
      <section class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-6 md:grid-cols-2">
        <label class="md:col-span-2 text-sm font-bold">Tên đề<input name="title" required placeholder="Đề minh họa V-SAT môn Toán 2025" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
        <label class="text-sm font-bold">Môn thi<select name="subject_id" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"><option value="">Chọn môn</option>{subjects.map(s => <option value={s.id}>{s.name}</option>)}</select></label>
        <label class="text-sm font-bold">Thời gian (phút)<input name="duration" type="number" min="1" value="90" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
        <label class="md:col-span-2 text-sm font-bold">Mật khẩu (không bắt buộc)<input name="password" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
      </section>
      <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div><h2 class="font-bold">Dữ liệu câu hỏi</h2><p class="text-xs text-slate-500">Type: msq · single_choice · read · matching · cloze_text · sa</p></div>
          <div class="flex flex-wrap gap-2">
            <button id="sample-math" type="button" class="rounded-lg bg-sky-50 px-3 py-2 text-xs font-bold text-sky-800">Nạp mẫu Toán</button>
            <button id="sample-english" type="button" class="rounded-lg bg-amber-50 px-3 py-2 text-xs font-bold text-amber-800">Nạp mẫu Tiếng Anh</button>
            <button id="full-english" type="button" class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white">Nạp đề Anh 2025 đầy đủ</button>
            <button id="sample" type="button" class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700">Mẫu ngắn</button>
          </div>
        </div>
        <div class="mt-3 flex gap-4 text-xs font-bold">
          <a href="/vsat-mau-toan.json" download class="text-sky-700 hover:underline">↓ Tải JSON Toán</a>
          <a href="/vsat-mau-tieng-anh.json" download class="text-amber-700 hover:underline">↓ Tải JSON Tiếng Anh</a>
          <a href="/vsat-tieng-anh-2025-day-du.json" download class="text-emerald-700 hover:underline">↓ Tải đề Anh 2025 đầy đủ</a>
        </div>
        <textarea id="json" name="json_data" required rows="22" spellcheck="false" placeholder='{"questions": [...]}' class="mt-4 w-full rounded-xl border border-slate-200 bg-slate-950 p-4 font-mono text-xs leading-5 text-slate-100"></textarea>
        <div id="feedback" class="mt-2 text-xs font-bold"></div>
      </section>
      <div class="flex justify-end"><button class="rounded-xl bg-[#075985] px-6 py-3 text-sm font-bold text-white">Tạo đề và xem trước →</button></div>
    </form>
  </div>
  <script define:vars={{ sample }}>
    const area = document.getElementById('json'); const feedback = document.getElementById('feedback');
    document.getElementById('sample')?.addEventListener('click', () => { area.value = sample; area.dispatchEvent(new Event('input')); });
    async function loadSample(url) {
      const response = await fetch(import.meta.env.BASE_URL + url.replace(/^\//, ''));
      if (!response.ok) throw new Error('Không tải được file mẫu.');
      area.value = await response.text();
      area.dispatchEvent(new Event('input'));
    }
    document.getElementById('sample-math')?.addEventListener('click', () => loadSample('/vsat-mau-toan.json'));
    document.getElementById('sample-english')?.addEventListener('click', () => loadSample('/vsat-mau-tieng-anh.json'));
    document.getElementById('full-english')?.addEventListener('click', () => loadSample('/vsat-tieng-anh-2025-day-du.json'));
    area?.addEventListener('input', () => { try { const p = JSON.parse(area.value); const n = Array.isArray(p) ? p.length : p.questions?.length; feedback.textContent = n ? `✓ JSON hợp lệ: ${n} câu` : 'JSON chưa có câu hỏi'; feedback.className = 'mt-2 text-xs font-bold text-emerald-600'; } catch { feedback.textContent = 'JSON chưa hợp lệ'; feedback.className = 'mt-2 text-xs font-bold text-amber-600'; } });
  </script>
</Layout>
