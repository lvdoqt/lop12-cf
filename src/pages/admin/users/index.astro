---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

let successMsg = '';
let errMsg = '';

// Handle Role Updates & Deletions (POST)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') as string;

    if (action === 'delete') {
      const deleteUserId = formData.get('userId') as string;
      if (!deleteUserId) {
        errMsg = 'Không tìm thấy ID người dùng để xóa.';
      } else if (deleteUserId === user.id) {
        errMsg = 'Bạn không thể tự xóa tài khoản của chính mình.';
      } else {
        await db.deleteUser(deleteUserId);
        successMsg = 'Đã xóa người dùng khỏi hệ thống thành công!';
      }
    } else {
      const userId = formData.get('userId') as string;
      const newRole = formData.get('role') as 'student' | 'teacher' | 'admin';

      if (userId && newRole) {
        if (userId === user.id) {
          errMsg = 'Cậu không thể tự thay đổi vai trò của chính mình.';
        } else {
          await db.updateUserRole(userId, newRole);
          successMsg = 'Cập nhật vai trò người dùng thành công!';
        }
      }
    }
  } catch (err: any) {
    errMsg = err.message || 'Lỗi thao tác người dùng.';
  }
}

// Fetch all users
const users = await db.getUsers();
---

<Layout title="Quản lý người dùng">
  <div class="space-y-6">
    <!-- Header -->
    <div>
      <a href="/admin" class="inline-flex items-center text-xs font-bold text-gray-400 hover:text-gray-600 dark:hover:text-slate-350 transition-colors uppercase tracking-wider mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Quản trị Admin
      </a>
      
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">Quản lý tài khoản</h1>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Danh sách tất cả người dùng và công cụ điều khiển phân quyền truy cập.</p>
    </div>

    <!-- Feedback messages -->
    {successMsg && (
      <div class="p-4 rounded-xl bg-emerald-50 text-emerald-600 text-sm font-semibold border border-emerald-100 dark:bg-emerald-950/20 dark:text-emerald-400 dark:border-emerald-900/35">
        {successMsg}
      </div>
    )}
    {errMsg && (
      <div class="p-4 rounded-xl bg-rose-50 text-rose-600 text-sm font-semibold border border-rose-100 dark:bg-rose-950/20 dark:text-rose-400 dark:border-rose-900/35">
        {errMsg}
      </div>
    )}

    <!-- Users Table Card -->
    <div class="bg-white border border-gray-250 dark:bg-slate-900 dark:border-slate-800/80 rounded-2xl p-6 shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-250 dark:divide-slate-800">
          <thead>
            <tr class="text-left text-xs font-bold text-gray-400 dark:text-slate-550 uppercase tracking-wider">
              <th class="pb-3">Họ và tên</th>
              <th class="pb-3">Email</th>
              <th class="pb-3">Vai trò</th>
              <th class="pb-3 hidden md:table-cell">Ngày đăng ký</th>
              <th class="pb-3 text-right">Hành động</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-800/60 text-sm font-medium">
            {users.map(u => (
              <tr class="text-gray-700 dark:text-slate-350 hover:bg-gray-50/50 dark:hover:bg-slate-800/40 transition">
                <!-- Avatar & Name -->
                <td class="py-4 pr-3 flex items-center space-x-3">
                  <img src={u.avatar_url || ''} alt={u.fullname || ''} class="w-8 h-8 rounded-full bg-slate-800" />
                  <div>
                    <span class="font-bold text-gray-900 dark:text-white block">{u.fullname || 'Học Sinh ẩn danh'}</span>
                    {u.id === user.id && (
                      <span class="text-[10px] text-emerald-500 font-bold uppercase tracking-wider">(Bạn)</span>
                    )}
                  </div>
                </td>
                
                <!-- Email -->
                <td class="py-4 pr-3 text-gray-500 dark:text-slate-400">
                  {u.email}
                </td>
                
                <!-- Role selection form -->
                <td class="py-4">
                  <form method="POST" id={`role-form-${u.id}`} class="flex items-center">
                    <input type="hidden" name="action" value="updateRole" />
                    <input type="hidden" name="userId" value={u.id} />
                    <select
                      name="role"
                      disabled={u.id === user.id}
                      class="px-2 py-1.5 rounded-lg border border-gray-250 dark:border-slate-800 bg-transparent text-xs font-bold focus:border-blue-500 outline-none text-gray-700 dark:text-slate-300 disabled:opacity-50 cursor-pointer"
                      onchange={`document.getElementById('role-form-${u.id}').submit()`}
                    >
                      <option value="student" selected={u.role === 'student'}>Học sinh</option>
                      <option value="teacher" selected={u.role === 'teacher'}>Giáo viên</option>
                      <option value="admin" selected={u.role === 'admin'}>Quản trị viên</option>
                    </select>
                  </form>
                </td>
                
                <!-- Registration Date -->
                <td class="py-4 hidden md:table-cell text-gray-500 dark:text-slate-450">
                  {new Date(u.created_at).toLocaleDateString('vi-VN')}
                </td>

                <!-- Delete action -->
                <td class="py-4 text-right">
                  {u.id === user.id ? (
                    <span class="text-xs text-gray-400 italic">Không thể xóa chính bạn</span>
                  ) : (
                    <form
                      method="POST"
                      onsubmit={`return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn người dùng "${u.fullname || u.email}"? Toàn bộ bài làm và dữ liệu liên quan sẽ bị xóa.');`}
                      class="inline-block"
                    >
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="userId" value={u.id} />
                      <button
                        type="submit"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-rose-500/10 hover:bg-rose-500 text-rose-600 hover:text-white border border-rose-500/30 transition shadow-sm"
                        title="Xóa thành viên này"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>Xóa</span>
                      </button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</Layout>
