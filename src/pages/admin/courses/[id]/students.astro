---
import Layout from '../../../../layouts/Layout.astro';
import { db } from '../../../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'teacher')) {
  return Astro.redirect('/dashboard');
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/courses');

const course = await db.getCourseById(id);
if (!course) return Astro.redirect('/admin/courses');

if (user.role === 'teacher' && course.created_by !== user.id) {
  return Astro.redirect('/admin/courses');
}

const enrollments = await db.getCourseEnrollments(id);

function formatDate(dateStr: string | null) {
  if (!dateStr) return '—';
  return new Date(dateStr).toLocaleString('vi-VN', {
    day: '2-digit', month: '2-digit', year: 'numeric',
    hour: '2-digit', minute: '2-digit'
  });
}
---

<Layout title={`HS dang ky — ${course.title}`}>
  <div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <a href="/admin/courses" class="inline-flex items-center text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors uppercase tracking-wider mb-2">
          <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Quan ly Khoa hoc
        </a>
        <h1 class="text-2xl md:text-3xl font-extrabold text-ink dark:text-[#E8E0D0] tracking-tight font-serif">
          Danh sach Hoc sinh
        </h1>
        <p class="text-sm text-[#8A7E72] dark:text-[#8A8A9E] mt-1 max-w-lg">
          {course.title}
        </p>
      </div>
      <div class="flex gap-3 shrink-0">
        <a
          href={`/api/admin/courses/${id}/students.csv`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm shadow shadow-teal-500/15 transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Tai ve CSV
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="flex flex-col items-center justify-center p-4 rounded-2xl border text-center bg-violet-50 text-violet-700 dark:bg-violet-900/20 dark:text-violet-300 border-violet-100 dark:border-violet-900/30">
        <span class="text-2xl font-extrabold">{enrollments.length}</span>
        <span class="text-xs font-semibold mt-0.5 opacity-80">Tong hoc sinh</span>
      </div>
      <div class="flex flex-col items-center justify-center p-4 rounded-2xl border text-center bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300 border-blue-100 dark:border-blue-900/30">
        <span class="text-sm font-bold">{course.subject?.name || 'Chua phan loai'}</span>
        <span class="text-xs font-semibold mt-0.5 opacity-80">Mon hoc</span>
      </div>
      <div class="flex flex-col items-center justify-center p-4 rounded-2xl border text-center bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300 border-emerald-100 dark:border-emerald-900/30">
        <span class="text-sm font-bold">{course.is_published ? 'Da xuat ban' : 'Ban nhap'}</span>
        <span class="text-xs font-semibold mt-0.5 opacity-80">Trang thai</span>
      </div>
    </div>

    <div class="bg-white dark:bg-[#22223A]/60 border border-slate-200/60 dark:border-slate-800/60 rounded-2xl overflow-hidden shadow-sm">
      {enrollments.length === 0 ? (
        <div class="text-center py-16 space-y-3">
          <div class="text-4xl">no</div>
          <p class="text-base font-bold text-ink dark:text-[#E8E0D0]">Chua co hoc sinh nao dang ky</p>
          <p class="text-sm text-[#8A7E72] dark:text-[#8A8A9E]">Hoc sinh dang ky tren trang khoa hoc.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-slate-50/80 dark:bg-slate-800/30">
              <tr class="text-left text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
                <th class="px-6 py-3 text-center w-12">STT</th>
                <th class="px-4 py-3">Hoc sinh</th>
                <th class="px-4 py-3">Email</th>
                <th class="px-4 py-3">Vai tro</th>
                <th class="px-4 py-3">Ngay dang ky</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
              {enrollments.map((enr, idx) => {
                const userObj = enr.user as any;
                return (
                  <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/20 transition-colors text-sm">
                    <td class="px-6 py-4 text-center text-xs text-slate-400 font-semibold">{idx + 1}</td>
                    <td class="px-4 py-4">
                      <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-full bg-violet-100 dark:bg-violet-900/30 flex items-center justify-center text-xs font-bold text-violet-600 dark:text-violet-400 shrink-0">
                          {(userObj?.fullname || userObj?.email || 'K').charAt(0).toUpperCase()}
                        </div>
                        <span class="font-semibold text-ink dark:text-[#E8E0D0] text-sm">{userObj?.fullname || 'Hoc sinh'}</span>
                      </div>
                    </td>
                    <td class="px-4 py-4 text-sm text-slate-500 dark:text-slate-400">{userObj?.email || '—'}</td>
                    <td class="px-4 py-4">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-bold ${
                        userObj?.role === 'admin' ? 'bg-rose-50 text-rose-600 dark:bg-rose-900/20 dark:text-rose-400' :
                        userObj?.role === 'teacher' ? 'bg-amber-50 text-amber-600 dark:bg-amber-900/20 dark:text-amber-400' :
                        'bg-blue-50 text-blue-600 dark:bg-blue-900/20 dark:text-blue-400'
                      }`}>
                        {userObj?.role === 'admin' ? 'Admin' : userObj?.role === 'teacher' ? 'GV' : 'HS'}
                      </span>
                    </td>
                    <td class="px-4 py-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
                      {formatDate(enr.enrolled_at)}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</Layout>