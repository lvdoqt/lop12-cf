---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'teacher')) {
  return Astro.redirect('/dashboard');
}

const isAdmin = user.role === 'admin';
const teacherId = isAdmin ? undefined : user.id;

// Fetch classes
const classes = await db.getClasses(teacherId);

// Fetch all users for the add-student modal
const allUsers = isAdmin ? await db.getUsers() : await db.getUsers();
const students = allUsers.filter(u => u.role === 'student');

let successMsg = '';
let errMsg = '';
---

<Layout title="Quản lý Học sinh">
  <div class="space-y-8">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <a href="/admin" class="inline-flex items-center text-xs font-bold text-gray-400 hover:text-gray-600 dark:hover:text-slate-350 transition-colors uppercase tracking-wider mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Quản trị Admin
        </a>
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">Quản lý Học sinh</h1>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Tạo lớp học, thêm học sinh và giao bài tập cho từng lớp.</p>
      </div>
      <button
        id="btn-open-create-class"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-500/30 transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Tạo lớp mới
      </button>
    </div>

    <!-- Stats bar -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800/80 rounded-2xl p-5 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">Tổng lớp học</p>
        <p class="text-3xl font-black text-indigo-600 dark:text-indigo-400">{classes.length}</p>
      </div>
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800/80 rounded-2xl p-5 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">Tổng học sinh</p>
        <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400">{classes.reduce((s, c) => s + (c.memberCount ?? 0), 0)}</p>
      </div>
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800/80 rounded-2xl p-5 shadow-sm col-span-2 md:col-span-1">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-1">Học sinh trong hệ thống</p>
        <p class="text-3xl font-black text-blue-600 dark:text-blue-400">{students.length}</p>
      </div>
    </div>

    <!-- Classes grid -->
    {classes.length === 0 ? (
      <div class="flex flex-col items-center justify-center py-20 text-center bg-white dark:bg-slate-900 border border-dashed border-gray-250 dark:border-slate-700 rounded-2xl">
        <div class="w-16 h-16 rounded-2xl bg-indigo-100 dark:bg-indigo-950/40 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="font-bold text-gray-700 dark:text-slate-300 text-lg mb-1">Chưa có lớp học nào</h3>
        <p class="text-sm text-gray-400 dark:text-slate-500 mb-5">Tạo lớp đầu tiên để bắt đầu quản lý học sinh.</p>
        <button id="btn-open-create-class-2" class="px-4 py-2 rounded-xl text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white transition">
          + Tạo lớp mới
        </button>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {classes.map(cls => (
          <div
            class="group relative bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800/80 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5"
            style={`border-top: 4px solid ${cls.color}`}
          >
            <!-- Class card header -->
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center font-black text-white text-sm shadow-sm" style={`background: ${cls.color}`}>
                  {cls.name.slice(0, 2).toUpperCase()}
                </div>
                <div>
                  <h3 class="font-bold text-gray-900 dark:text-white text-base leading-tight">{cls.name}</h3>
                  <p class="text-xs text-gray-400 dark:text-slate-500">Lớp {cls.grade}{cls.subject ? ` · ${cls.subject}` : ''}</p>
                </div>
              </div>
              <!-- Delete button -->
              <button
                class="delete-class-btn opacity-0 group-hover:opacity-100 p-1.5 rounded-lg text-gray-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/20 transition-all"
                data-class-id={cls.id}
                data-class-name={cls.name}
                title="Xóa lớp này"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>

            <!-- Member count -->
            <div class="flex items-center gap-1.5 text-sm text-gray-500 dark:text-slate-400 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="font-semibold">{cls.memberCount ?? 0}</span> học sinh
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-2">
              <a
                href={`/admin/hoc-sinh/${cls.id}`}
                class="flex-1 text-center px-3 py-2 rounded-xl text-xs font-bold bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-300 transition"
              >
                Xem chi tiết
              </a>
            </div>
          </div>
        ))}

        <!-- Add class card -->
        <button
          id="btn-open-create-class-3"
          class="flex flex-col items-center justify-center gap-2 bg-transparent border-2 border-dashed border-gray-250 dark:border-slate-700 rounded-2xl p-5 min-h-[160px] hover:border-indigo-400 hover:bg-indigo-50/50 dark:hover:bg-indigo-950/20 transition-all group"
        >
          <div class="w-10 h-10 rounded-xl bg-gray-100 dark:bg-slate-800 group-hover:bg-indigo-100 dark:group-hover:bg-indigo-950/40 flex items-center justify-center transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 group-hover:text-indigo-500 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">Tạo lớp mới</span>
        </button>
      </div>
    )}
  </div>

  <!-- ── Modal: Tạo lớp mới ────────────────────────────────────────────────── -->
  <div id="modal-create-class" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden" role="dialog" aria-modal="true" aria-labelledby="modal-create-class-title">
    <!-- Backdrop -->
    <div id="modal-create-class-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <!-- Panel -->
    <div class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-slate-700 w-full max-w-md p-6 animate-modal-in">
      <div class="flex items-center justify-between mb-6">
        <h2 id="modal-create-class-title" class="text-lg font-bold text-gray-900 dark:text-white">Tạo lớp học mới</h2>
        <button id="btn-close-create-class" class="p-2 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="form-create-class" class="space-y-4">
        <!-- Name -->
        <div>
          <label for="class-name" class="block text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Tên lớp *</label>
          <input
            id="class-name"
            name="name"
            type="text"
            required
            placeholder="VD: Lớp 12A1"
            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 text-gray-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
          />
        </div>
        <!-- Grade + Subject -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="class-grade" class="block text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Khối</label>
            <select id="class-grade" name="grade" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
              <option value="10">Lớp 10</option>
              <option value="11">Lớp 11</option>
              <option value="12" selected>Lớp 12</option>
            </select>
          </div>
          <div>
            <label for="class-subject" class="block text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Môn học</label>
            <input
              id="class-subject"
              name="subject"
              type="text"
              placeholder="VD: Toán, Lý..."
              class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
            />
          </div>
        </div>
        <!-- Color picker -->
        <div>
          <label class="block text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-2">Màu sắc</label>
          <div class="flex flex-wrap gap-2">
            {['#6366f1','#10b981','#f59e0b','#ef4444','#3b82f6','#8b5cf6','#ec4899','#14b8a6'].map(color => (
              <label class="relative cursor-pointer">
                <input type="radio" name="color" value={color} class="sr-only peer" checked={color === '#6366f1'} />
                <span
                  class="block w-8 h-8 rounded-full ring-2 ring-transparent peer-checked:ring-offset-2 peer-checked:ring-offset-white dark:peer-checked:ring-offset-slate-900 peer-checked:ring-current transition-all hover:scale-110"
                  style={`background: ${color}; color: ${color}`}
                ></span>
              </label>
            ))}
          </div>
        </div>

        <div id="create-class-error" class="hidden text-sm text-rose-500 font-medium"></div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="btn-cancel-create-class" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-600 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition">Hủy</button>
          <button type="submit" id="btn-submit-create-class" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white transition disabled:opacity-60 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Tạo lớp
          </button>
        </div>
      </form>
    </div>
  </div>

  <style>
    @keyframes modal-in {
      from { opacity: 0; transform: translateY(16px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-modal-in { animation: modal-in 0.2s ease-out both; }
  </style>

  <script>
    // Helper: open/close modal
    function openModal(id: string) { document.getElementById(id)?.classList.remove('hidden'); }
    function closeModal(id: string) { document.getElementById(id)?.classList.add('hidden'); }

    // Open buttons
    ['btn-open-create-class', 'btn-open-create-class-2', 'btn-open-create-class-3'].forEach(btnId => {
      document.getElementById(btnId)?.addEventListener('click', () => openModal('modal-create-class'));
    });
    document.getElementById('btn-close-create-class')?.addEventListener('click', () => closeModal('modal-create-class'));
    document.getElementById('btn-cancel-create-class')?.addEventListener('click', () => closeModal('modal-create-class'));
    document.getElementById('modal-create-class-backdrop')?.addEventListener('click', () => closeModal('modal-create-class'));

    // Create class form
    document.getElementById('form-create-class')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = document.getElementById('btn-submit-create-class') as HTMLButtonElement;
      const errEl = document.getElementById('create-class-error')!;
      errEl.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Đang tạo...';

      const fd = new FormData(form);
      const body = {
        name: fd.get('name'),
        grade: fd.get('grade'),
        subject: fd.get('subject'),
        color: fd.get('color') || '#6366f1',
      };

      try {
        const res = await fetch((window.withBase || ((p: string) => p))('/api/classes'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) {
          const err = await res.json();
          errEl.textContent = err.error || 'Lỗi tạo lớp.';
          errEl.classList.remove('hidden');
        } else {
          window.location.reload();
        }
      } catch {
        errEl.textContent = 'Lỗi kết nối.';
        errEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg> Tạo lớp';
      }
    });

    // Delete class buttons
    document.querySelectorAll<HTMLButtonElement>('.delete-class-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const classId = btn.dataset.classId!;
        const className = btn.dataset.className!;
        if (!confirm(`Bạn có chắc muốn xóa lớp "${className}"? Toàn bộ thành viên và bài giao sẽ bị xóa.`)) return;
        try {
          const res = await fetch((window.withBase || ((p: string) => p))(`/api/classes/${classId}`), { method: 'DELETE' });
          if (res.ok) { window.location.reload(); }
          else { alert('Lỗi xóa lớp.'); }
        } catch { alert('Lỗi kết nối.'); }
      });
    });
  </script>
</Layout>
