  function renderAiGeneratedPreview(questions: any[], saWarnings: string[]) {
    if (aiSaWarnings) {
      if (saWarnings.length > 0) {
        aiSaWarnings.innerHTML = `<p class="font-extrabold">⚠️ Lưu ý quy chuẩn phiếu tô Trả lời ngắn (≤ 4 ký tự):</p><ul class="list-disc pl-4">${saWarnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul>`;
        aiSaWarnings.classList.remove('hidden');
      } else {
        aiSaWarnings.classList.add('hidden');
      }
    }
    if (!aiResultPanel || !aiResultList || !aiResultSummary) return;

    const countsByType: Record<string, number> = {};
    questions.forEach(q => {
      const t = String(q.type || 'mcq').toLowerCase();
      countsByType[t] = (countsByType[t] || 0) + 1;
    });
    aiResultSummary.textContent = `✅ Đã sinh ${questions.length} mục câu hỏi (${Object.entries(countsByType).map(([t, c]) => `${c} ${getQuestionTypeLabelVi(t)}`).join(' · ')})`;

    const alphabet = ['A', 'B', 'C', 'D', 'E', 'F'];
    aiResultList.innerHTML = questions.map((q: any, idx: number) => {
      const qType = String(q.type || 'mcq').toLowerCase();
      const correctStr = String(q.correct_option ?? q.correct_answer ?? q.answer ?? '').trim();
      const correctKeys = correctStr ? correctStr.split(',').map((k: string) => k.trim().toUpperCase()).filter(Boolean) : [];
      const opts = [q.option_a, q.option_b, q.option_c, q.option_d, q.option_e, q.option_f].filter((v: any) => typeof v === 'string' && v.trim());

      const bodyHtml = (qType === 'sa' || qType === 'tl')
        ? (correctStr ? `<p class="mt-2 text-xs font-bold text-emerald-700 dark:text-emerald-400">Đáp án: <code>${escapeHtml(correctStr)}</code></p>` : '')
        : opts.length > 0
          ? `<div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-2">${opts.map((opt: string, oi: number) => {
              const letter = alphabet[oi] || String(oi + 1);
              const isRight = correctKeys.includes(letter);
              return `<div class="px-2.5 py-1.5 rounded-lg border text-xs ${isRight ? 'border-emerald-300 bg-emerald-50/80 dark:border-emerald-700 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 font-semibold' : 'border-slate-200 dark:border-slate-700 bg-slate-50/60 dark:bg-slate-900 text-slate-700 dark:text-slate-300'}"><strong>${letter}.</strong> ${escapeHtml(opt)}${qType === 'msq' ? (isRight ? ' [Đ]' : ' [S]') : (isRight ? ' ✓' : '')}</div>`;
            }).join('')}</div>`
          : '';

      return `<div class="p-3.5 rounded-xl bg-white dark:bg-[#1E1E38] border border-slate-200 dark:border-slate-700/80">
        <div class="flex items-center justify-between mb-1"><span class="text-xs font-extrabold text-indigo-700 dark:text-indigo-300">Câu ${idx + 1} · ${escapeHtml(getQuestionTypeLabelVi(qType))}</span></div>
        <div class="text-xs text-slate-800 dark:text-slate-100 whitespace-pre-line">${escapeHtml(q.question || q.content || '')}</div>
        ${bodyHtml}
      </div>`;
    }).join('');

    aiResultPanel.classList.remove('hidden');
    renderMath(aiResultList);
  }

  btnGenerateAi?.addEventListener('click', async () => {
    if (!subjectSelect?.value) { alert('Vui lòng chọn Môn học chính ở trên.'); subjectSelect?.focus(); return; }
    const apiKey = apiKeyInput?.value.trim() || '';
    if (!apiKey) { alert('Vui lòng nhập Gemini API Key.'); apiKeyInput?.focus(); return; }
    syncApiKeyStorage();

    activeAbortController = new AbortController();
    if (btnGenerateAi) btnGenerateAi.disabled = true;
    btnCancelAi?.classList.remove('hidden');
    if (aiBtnIcon) aiBtnIcon.textContent = '⏳';
    if (aiBtnLabel) aiBtnLabel.textContent = 'Đang biên soạn đề thi...';

    let elapsed = 0;
    timerInterval = window.setInterval(() => {
      elapsed += 1;
      if (aiStatusMsg) aiStatusMsg.textContent = `🤖 Gemini AI đang biên soạn đề thi (${elapsed}s)...`;
    }, 1000);

    try {
      const result = await callGeminiGenerateExam({
        apiKey,
        model: modelSelect?.value || 'gemini-2.5-flash',
        prompt: promptEditor?.value || '',
        signal: activeAbortController.signal,
      });
      if (jsonDataEl) jsonDataEl.value = result.rawJson;
      if (titleInput && !titleInput.value.trim() && result.title) titleInput.value = result.title;
      renderAiGeneratedPreview(result.questions, result.saWarnings);
      updateReadyQuestionsIndicator();
      if (aiStatusMsg) aiStatusMsg.textContent = `✅ Hoàn tất trong ${elapsed}s!`;
    } catch (err: any) {
      if (aiStatusMsg) aiStatusMsg.textContent = err?.name === 'AbortError' ? '⚠️ Đã hủy.' : `❌ ${err?.message}`;
    } finally {
      if (timerInterval !== null) { clearInterval(timerInterval); timerInterval = null; }
      activeAbortController = null;
      if (btnGenerateAi) btnGenerateAi.disabled = false;
      btnCancelAi?.classList.add('hidden');
      if (aiBtnIcon) aiBtnIcon.textContent = '✨';
      if (aiBtnLabel) aiBtnLabel.textContent = 'Tạo lại câu hỏi bằng Gemini AI';
    }
  });

