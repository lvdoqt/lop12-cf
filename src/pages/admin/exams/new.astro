---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
import { parseAiExamJson, MATRIX_ROW_KEYS, MATRIX_ROW_META } from '../../../lib/ai-exam-prompts';
import { mapProgramToDbExamType } from '../../../lib/exam';
import type { ExamProgram, ShowAnswersMode, ExamSettings } from '../../../types';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'teacher')) {
  return Astro.redirect('/dashboard');
}

const baseUrl = (import.meta.env.BASE_URL || '/lms').replace(/\/$/, '');

let errMsg = '';
let submittedValues = {
  mode: 'ai',
  title: '',
  duration: '90',
  subject_id: '',
  category_id: '',
  exam_program: 'mock_thpt' as ExamProgram,
  is_graded: false,
  password: '',
  open_at: '',
  close_at: '',
  max_attempts: '',
  show_answers_mode: 'always' as ShowAnswersMode,
  pick_per_type: '',
  point_per_question: '0.25',
  point_per_sa: '0.5',
  max_score: '10',
  json_data: '',
};

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const mode = (formData.get('mode') as string) || 'ai';
    const title = (formData.get('title') as string)?.trim() || '';
    const durationRaw = (formData.get('duration') as string)?.trim() || '';
    const duration = Number(durationRaw);
    const subject_id = (formData.get('subject_id') as string) || '';
    const category_id = (formData.get('category_id') as string) || null;
    const exam_program = ((formData.get('exam_program') as string) || 'mock_thpt') as ExamProgram;
    const exam_type = mapProgramToDbExamType(exam_program);

    const passwordRaw = (formData.get('password') as string)?.trim() || '';
    const openAtRaw = (formData.get('open_at') as string)?.trim() || '';
    const closeAtRaw = (formData.get('close_at') as string)?.trim() || '';
    const maxAttemptsRaw = (formData.get('max_attempts') as string)?.trim() || '';
    const showAnswersMode = ((formData.get('show_answers_mode') as string) || 'always') as ShowAnswersMode;

    const pickRaw = (formData.get('pick_per_type') as string)?.trim() || '';
    const ppqRaw = (formData.get('point_per_question') as string)?.trim() || '';
    const ppSaRaw = (formData.get('point_per_sa') as string)?.trim() || '';
    const maxScoreRaw = (formData.get('max_score') as string)?.trim() || '';
    const isGraded = formData.get('is_graded') === '1';
    const jsonRaw = (formData.get('json_data') as string) || '';

    submittedValues = {
      mode,
      title,
      duration: durationRaw,
      subject_id,
      category_id: category_id || '',
      exam_program,
      is_graded: isGraded,
      password: passwordRaw,
      open_at: openAtRaw,
      close_at: closeAtRaw,
      max_attempts: maxAttemptsRaw,
      show_answers_mode: showAnswersMode,
      pick_per_type: pickRaw,
      point_per_question: ppqRaw,
      point_per_sa: ppSaRaw,
      max_score: maxScoreRaw,
      json_data: jsonRaw,
    };

    const settings: ExamSettings = {
      exam_program,
    };

    if (pickRaw) {
      try {
        const pickObj = JSON.parse(pickRaw);
        if (typeof pickObj === 'object' && !Array.isArray(pickObj)) {
          const cleanedPick: Record<string, number> = {};
          for (const [k, v] of Object.entries(pickObj)) {
            const num = Number(v);
            if (Number.isInteger(num) && num > 0) {
              cleanedPick[k] = num;
            }
          }
          if (Object.keys(cleanedPick).length > 0) {
            settings.pick_per_type = cleanedPick;
          }
        }
      } catch (e: any) {
        throw new Error(`Cấu hình bốc câu ngẫu nhiên không hợp lệ: ${e.message}`);
      }
    }

    if (ppqRaw) {
      const ppqVal = parseFloat(ppqRaw);
      if (!Number.isNaN(ppqVal) && ppqVal > 0) settings.point_per_question = ppqVal;
    }
    if (ppSaRaw) {
      const ppSaVal = parseFloat(ppSaRaw);
      if (!Number.isNaN(ppSaVal) && ppSaVal > 0) settings.point_per_sa = ppSaVal;
    }
    if (maxScoreRaw) {
      const msVal = parseFloat(maxScoreRaw);
      if (!Number.isNaN(msVal) && msVal > 0) settings.max_score = msVal;
    }
    if (isGraded) {
      settings.is_graded = true;
    }

    if (openAtRaw) {
      const d = new Date(openAtRaw);
      if (Number.isNaN(d.getTime())) throw new Error('Thời điểm mở đề không hợp lệ.');
      settings.open_at = d.toISOString();
    }
    if (closeAtRaw) {
      const d = new Date(closeAtRaw);
      if (Number.isNaN(d.getTime())) throw new Error('Thời điểm đóng đề không hợp lệ.');
      settings.close_at = d.toISOString();
    }
    if (settings.open_at && settings.close_at && new Date(settings.close_at) <= new Date(settings.open_at)) {
      throw new Error('Thời điểm đóng ca thi phải sau thời điểm mở ca thi.');
    }
    if (maxAttemptsRaw) {
      const ma = parseInt(maxAttemptsRaw, 10);
      if (!Number.isNaN(ma) && ma > 0) settings.max_attempts = ma;
    }
    if (showAnswersMode && showAnswersMode !== 'always') {
      settings.show_answers_mode = showAnswersMode;
    }

    if (!title || !duration || !subject_id) {
      throw new Error('Tiêu đề, Thời gian và Môn học là bắt buộc.');
    }

    if (!jsonRaw.trim()) {
      if (mode === 'ai') {
        throw new Error('Chưa có câu hỏi nào được sinh ra. Vui lòng nhấn "✨ Tạo câu hỏi bằng Gemini AI" trước khi lưu đề thi.');
      }
      if (mode === 'file') {
        throw new Error('Chưa có câu hỏi được bóc tách từ tệp. Vui lòng tải file Word/PDF và nhấn bóc tách trước khi lưu.');
      }
      throw new Error('Vui lòng nhập dữ liệu JSON đề thi.');
    }

    let parsedPayload: { title?: string; questions: any[] };
    try {
      parsedPayload = parseAiExamJson(jsonRaw);
    } catch (e: any) {
      throw new Error(`JSON không hợp lệ: ${e?.message || 'Vui lòng kiểm tra cú pháp.'}`);
    }

    const qs = parsedPayload.questions;
    let rawRootObj: any = null;
    try {
      rawRootObj = JSON.parse(jsonRaw);
    } catch {
      rawRootObj = null;
    }

    const rootQuestionTypeId =
      rawRootObj && !Array.isArray(rawRootObj) && typeof rawRootObj?.question_type_id === 'string'
        ? rawRootObj.question_type_id.trim()
        : undefined;

    const difficultyMap: Record<string, 'easy' | 'medium' | 'hard'> = {
      easy: 'easy', medium: 'medium', hard: 'hard', very_hard: 'hard',
      dễ: 'easy', 'trung bình': 'medium', khó: 'hard',
      nb: 'easy', th: 'medium', vd: 'hard', vdc: 'hard',
    };
    const typeMap: Record<string, string> = {
      mcq: 'single_choice',
      single_choice: 'single_choice',
      msq: 'msq',
      multiple_choice: 'multiple_choice',
      tf_cluster: 'msq',
      tf: 'true_false',
      true_false: 'true_false',
      sa: 'sa',
      tl: 'tl',
      read: 'read',
      reading: 'read',
      list: 'list',
      read_cloze: 'read_cloze',
      ordering: 'ordering',
      matching: 'matching',
      cloze_text: 'cloze_text',
    };

    const batchItems: Array<{
      question: any;
      answers: { content: string; is_correct: boolean }[];
    }> = [];

    for (const q of qs) {
      const qType = typeMap[String(q.type || '').toLowerCase()] || 'single_choice';
      const rawDiffKey = String(q.difficulty_level || q.difficulty || q.cognitive_level || 'medium').toLowerCase();
      const qDiff = difficultyMap[rawDiffKey] || 'medium';
      const qContent = q.question || q.content || '';
      const qExpl = q.explanation || '';
      const correctStr = String(q.correct_option ?? q.correct_answer ?? q.answer ?? '').trim();
      const qImageUrl = typeof q.image_url === 'string' && q.image_url.trim() ? q.image_url.trim() : null;
      const isDynamic = Boolean(q.is_dynamic || q.metadata?.is_dynamic);
      const qTypeId =
        (typeof q.question_type_id === 'string' ? q.question_type_id.trim() : undefined) ||
        rootQuestionTypeId;
      const cognitiveLevel =
        typeof q.cognitive_level === 'string' ? q.cognitive_level.toLowerCase().trim() : undefined;

      let answers: { content: string; is_correct: boolean }[] = [];
      let metadata: any = undefined;

      if (qType === 'read' || qType === 'list' || qType === 'read_cloze') {
        const metaQuestions = Array.isArray(q.metadata?.questions)
          ? q.metadata.questions
          : (Array.isArray(q.questions) ? q.questions : []);
        if (metaQuestions.length === 0) {
          throw new Error(`Câu hỏi dạng ${qType} thiếu mảng metadata.questions.`);
        }
        const mappedQuestions = metaQuestions.map((sq: any) => {
          const out: any = {
            question: sq.question || sq.content || '',
            option_a: sq.option_a || '',
            option_b: sq.option_b || '',
            option_c: sq.option_c || '',
            option_d: sq.option_d || '',
            correct_option: String(sq.correct_option || '').toUpperCase(),
            ...(sq.explanation ? { explanation: sq.explanation } : {})
          };
          if (sq.option_e) out.option_e = sq.option_e;
          if (sq.option_f) out.option_f = sq.option_f;
          return out;
        });
        const audioUrl = q.metadata?.audio_url ? q.metadata.audio_url : undefined;
        metadata = {
          questions: mappedQuestions,
          ...(audioUrl ? { audio_url: audioUrl } : {}),
          ...(category_id ? { category_id } : {})
        };
      } else if (qType === 'matching') {
        const metaQuestions = Array.isArray(q.metadata?.questions) ? q.metadata.questions : (Array.isArray(q.questions) ? q.questions : []);
        const metaOptions = Array.isArray(q.metadata?.options) ? q.metadata.options : (Array.isArray(q.options) ? q.options : []);
        metadata = {
          questions: metaQuestions,
          options: metaOptions,
          ...(category_id ? { category_id } : {}),
        };
      } else if (qType === 'cloze_text') {
        const metaQuestions = Array.isArray(q.metadata?.questions) ? q.metadata.questions : (Array.isArray(q.questions) ? q.questions : []);
        metadata = {
          questions: metaQuestions,
          ...(category_id ? { category_id } : {}),
        };
      } else if (Array.isArray(q.answers)) {
        answers = q.answers.map((a: any) => ({
          content: a.content || String(a),
          is_correct: Boolean(a.is_correct || a.isCorrect || false)
        }));
      } else if (Array.isArray(q.options)) {
        const alphabet = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
        const correctKeys = correctStr
          ? correctStr.split(',').map((k: string) => k.trim().toUpperCase()).filter(Boolean)
          : [];
        answers = q.options.map((opt: string, idx: number) => ({
          content: opt,
          is_correct: correctKeys.includes(alphabet[idx]) || correctStr.toUpperCase() === alphabet[idx]
        }));
      } else if (qType === 'single_choice' || qType === 'multiple_choice' || qType === 'msq' || qType === 'ordering') {
        const options = [
          { key: 'A', text: q.option_a },
          { key: 'B', text: q.option_b },
          { key: 'C', text: q.option_c },
          { key: 'D', text: q.option_d },
          { key: 'E', text: q.option_e },
          { key: 'F', text: q.option_f },
        ].filter(o => typeof o.text === 'string' && o.text.trim().length > 0);
        const correctKeys = correctStr
          ? correctStr.split(',').map((k: string) => k.trim().toUpperCase()).filter(Boolean)
          : [];

        answers = options.map(o => ({
          content: o.text,
          is_correct: correctKeys.includes(o.key),
        }));
      } else if (qType === 'true_false') {
        const upper = correctStr.toUpperCase();
        answers = [
          { content: 'Đúng', is_correct: upper === 'TRUE' || upper === 'Đ' || upper === 'ĐÚNG' || upper === 'A' },
          { content: 'Sai', is_correct: upper === 'FALSE' || upper === 'S' || upper === 'SAI' || upper === 'B' },
        ];
      }

      const extraMeta: Record<string, any> = {
        ...(q.metadata && typeof q.metadata === 'object' ? q.metadata : {}),
        ...(metadata ? metadata : {}),
        ...(category_id ? { category_id } : {}),
        ...(isDynamic ? { is_dynamic: true } : {}),
        ...(qTypeId ? { question_type_id: qTypeId } : {}),
        ...(cognitiveLevel ? { cognitive_level: cognitiveLevel } : {}),
      };

      batchItems.push({
        question: {
          subject_id,
          content: qContent,
          explanation: qExpl,
          difficulty: qDiff,
          type: qType as any,
          answer: (qType === 'sa' || qType === 'tl') ? correctStr : null,
          image_url: qImageUrl,
          created_by: user.id,
          metadata: Object.keys(extraMeta).length > 0 ? extraMeta : undefined
        },
        answers
      });
    }

    let createdQs: any[];
    try {
      createdQs = await db.createQuestionsBatch(batchItems);
    } catch (qErr: any) {
      throw new Error(`Lỗi tạo câu hỏi (batch): ${qErr?.message || qErr?.details || String(qErr)}`);
    }

    const questionIds = Array.from(new Set(createdQs.map((q: any) => q.id)));

    try {
      await db.createExam(
        {
          title,
          duration,
          subject_id,
          category_id,
          exam_type,
          password: passwordRaw || null,
          created_by: user.id,
          settings,
        },
        questionIds
      );
    } catch (examErr: any) {
      throw new Error(`Lỗi tạo đề thi: ${examErr?.message || examErr?.details || String(examErr)}`);
    }
    return Astro.redirect('/admin/exams');

  } catch (err: any) {
    errMsg = err.message || err?.details || 'Lỗi tạo đề thi mới.';
  }
}

let subjects: any[] = [];
let allCategories: any[] = [];
try { subjects = await db.getSubjects(); } catch { /* fallback to empty */ }
try { allCategories = await db.getCategories(); } catch { /* fallback to empty */ }

const PICK_TYPE_ITEMS = [
  { key: 'mcq', label: 'TN 4 lựa chọn (mcq)' },
  { key: 'msq', label: 'Đúng/Sai 4 ý (msq)' },
  { key: 'sa', label: 'Trả lời ngắn (sa)' },
  { key: 'tl', label: 'Tự luận (tl)' },
  { key: 'read_cloze', label: 'Bài đọc điền (read_cloze)' },
  { key: 'ordering', label: 'Sắp xếp câu (ordering)' },
  { key: 'read', label: 'Bài đọc hiểu (read)' },
  { key: 'matching', label: 'Ghép cặp (matching)' },
];
---

<Layout title="Tạo đề thi mới">
  <div class="max-w-6xl mx-auto space-y-6">

    <!-- Breadcrumb -->
    <div>
      <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
        <a href="/admin" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Quản trị</a>
        <span>/</span>
        <a href="/admin/exams" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Đề thi</a>
        <span>/</span>
        <span class="text-ink dark:text-[#E8E0D0]">Tạo mới</span>
      </nav>
      <h1 class="text-2xl md:text-3xl font-extrabold text-ink dark:text-[#E8E0D0] tracking-tight font-serif">
        Tạo đề thi mới
      </h1>
      <p class="text-sm text-[#8A7E72] dark:text-[#8A8A9E] mt-1">
        Biên soạn đề mới bằng Gemini AI theo Ma trận 2 chiều, số hóa trực tiếp từ file Word (<code>.docx</code>) / PDF (<code>.pdf</code>), hoặc nhập mã JSON.
      </p>
    </div>

    <!-- Error Alert -->
    {errMsg && (
      <div class="p-4 rounded-xl bg-rose-50 text-rose-600 text-sm font-semibold border border-rose-100 dark:bg-rose-950/20 dark:text-rose-400 dark:border-rose-900/35 flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        {errMsg}
      </div>
    )}

    <!-- Form Card -->
    <div class="bg-white dark:bg-[#22223A]/80 border border-slate-200/60 dark:border-slate-800/60 rounded-2xl shadow-sm overflow-hidden">

      <form id="exam-create-form" method="POST" class="p-6 md:p-8 space-y-6">

        <!-- 1. Thông tin chung -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

          <!-- Title -->
          <div class="sm:col-span-2">
            <label for="title" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Tiêu đề đề thi <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              name="title"
              id="title"
              required
              value={submittedValues.title}
              placeholder="VD: Đề thi thử Tốt nghiệp THPT 2025 môn Toán - Lần 1..."
              class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] transition-colors placeholder:text-slate-400"
            />
          </div>

          <!-- Subject -->
          <div>
            <label for="subject_id" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Môn học chính <span class="text-rose-500">*</span>
            </label>
            <select name="subject_id" id="subject_id" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] cursor-pointer">
              <option value="" disabled selected={!submittedValues.subject_id}>-- Chọn môn học --</option>
              {subjects.map(s => (
                <option value={s.id} data-name={s.name} data-slug={s.slug} selected={s.id === submittedValues.subject_id}>
                  {s.name}
                </option>
              ))}
            </select>
          </div>

          <!-- Category -->
          <div>
            <label for="exam_category_id" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Chuyên mục
              <a href="/admin/categories" target="_blank" class="ml-2 text-blue-500 hover:text-blue-700 normal-case font-semibold">➕ Quản lý</a>
            </label>
            <select name="category_id" id="exam_category_id" data-initial={submittedValues.category_id} class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] cursor-pointer">
              <option value="">-- Tất cả / Không phân chuyên mục --</option>
            </select>
          </div>

          <!-- Expanded Exam Program -->
          <div>
            <label for="exam_program" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Phân loại kỳ thi tại Việt Nam <span class="text-rose-500">*</span>
            </label>
            <select name="exam_program" id="exam_program" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] cursor-pointer">
              <optgroup label="Kiểm tra phổ thông (GDPT 2018 & CV 7991)">
                <option value="15m" selected={submittedValues.exam_program === '15m'}>⏱️ Đánh giá thường xuyên (15 phút)</option>
                <option value="midterm" selected={submittedValues.exam_program === 'midterm' || submittedValues.exam_program === '45m'}>📝 Kiểm tra Giữa học kỳ (CV 7991)</option>
                <option value="semester" selected={submittedValues.exam_program === 'semester'}>🎓 Kiểm tra Cuối học kỳ (CV 7991)</option>
                <option value="hsg" selected={submittedValues.exam_program === 'hsg'}>🥇 Thi chọn Học sinh giỏi (Thang điểm 20)</option>
              </optgroup>
              <optgroup label="Thi Tốt nghiệp & Tuyển sinh Đại học">
                <option value="mock_thpt" selected={submittedValues.exam_program === 'mock_thpt'}>🏆 Thi thử Tốt nghiệp THPT (Chuẩn 2025)</option>
                <option value="dgnl_hsa" selected={submittedValues.exam_program === 'dgnl_hsa'}>🧠 ĐGNL ĐHQG Hà Nội (HSA - Liên môn)</option>
                <option value="dgnl_vact" selected={submittedValues.exam_program === 'dgnl_vact'}>🎯 ĐGNL ĐHQG TP.HCM (V-ACT - Liên môn)</option>
                <option value="dgtd_tsa" selected={submittedValues.exam_program === 'dgtd_tsa'}>🔬 ĐGTD ĐH Bách Khoa (TSA)</option>
                <option value="vsat" selected={submittedValues.exam_program === 'vsat'}>🎯 Đánh giá năng lực đại học V-SAT</option>
              </optgroup>
            </select>
          </div>

          <!-- Duration -->
          <div>
            <label for="duration" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Thời gian làm bài (phút) <span class="text-rose-500">*</span>
            </label>
            <input
              type="number"
              name="duration"
              id="duration"
              required
              min="1"
              max="300"
              value={submittedValues.duration}
              placeholder="15, 45, 50, 90..."
              class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] transition-colors placeholder:text-slate-400"
            />
          </div>

          <!-- Cross-subject selector for HSA / V-ACT / TSA -->
          <div id="cross-subjects-box" class="sm:col-span-2 hidden p-4 rounded-xl border border-indigo-200 dark:border-indigo-800/50 bg-indigo-50/40 dark:bg-indigo-950/20 space-y-2">
            <span class="block text-xs font-bold text-indigo-700 dark:text-indigo-300 uppercase tracking-wider">
              🧩 Chọn các lĩnh vực liên môn tích hợp trong đề ĐGNL / ĐGTD:
            </span>
            <div class="flex flex-wrap gap-2">
              {['Toán học & Xử lý số liệu', 'Ngữ văn / Đọc hiểu tiếng Việt', 'Tiếng Anh', 'Vật lí', 'Hóa học', 'Sinh học', 'Lịch sử', 'Địa lí'].map(item => (
                <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-indigo-200 dark:border-indigo-700/60 text-xs font-semibold text-slate-700 dark:text-slate-200 cursor-pointer select-none">
                  <input type="checkbox" value={item} class="cross-subject-cb rounded text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5" checked={item.includes('Toán') || item.includes('Đọc hiểu')} />
                  <span>{item}</span>
                </label>
              ))}
            </div>
          </div>
        </div>

        <!-- 2. Quản lý Ca thi chính thức & Bảo mật -->
        <div class="p-4 md:p-5 rounded-2xl border border-emerald-200 dark:border-emerald-800/50 bg-emerald-50/40 dark:bg-emerald-950/15 space-y-4">
          <label for="is_graded" class="flex items-start gap-3 cursor-pointer select-none">
            <input
              type="checkbox"
              name="is_graded"
              id="is_graded"
              value="1"
              checked={submittedValues.is_graded}
              class="mt-0.5 h-5 w-5 rounded border-emerald-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer shrink-0"
            />
            <div>
              <span class="block text-sm font-bold text-emerald-800 dark:text-emerald-300">
                📝 Tổ chức Ca thi chính thức (Lấy điểm, điền SBD/Lớp, lưu kết quả &amp; giám sát chuyển tab)
              </span>
              <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
                Bỏ chọn = <strong>Chế độ Luyện tập tự do</strong> (không lưu DB). Khi bật = yêu cầu Họ tên, SBD, Lớp và lưu bảng điểm CSV.
              </span>
            </div>
          </label>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 pt-3 border-t border-emerald-200/60 dark:border-emerald-800/40">
            <div>
              <label for="password" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1">
                🔒 Mật khẩu đề thi <span class="font-normal text-slate-400">(tùy chọn)</span>
              </label>
              <input type="text" name="password" id="password" value={submittedValues.password} placeholder="Để trống = không khóa" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs font-semibold text-ink dark:text-[#E8E0D0] outline-none focus:border-emerald-500" />
            </div>

            <div>
              <label for="open_at" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1">
                🟢 Giờ mở ca thi <span class="font-normal text-slate-400">(tùy chọn)</span>
              </label>
              <input type="datetime-local" name="open_at" id="open_at" value={submittedValues.open_at} class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs text-ink dark:text-[#E8E0D0] outline-none focus:border-emerald-500" />
            </div>

            <div>
              <label for="close_at" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1">
                🔴 Giờ đóng ca thi <span class="font-normal text-slate-400">(tùy chọn)</span>
              </label>
              <input type="datetime-local" name="close_at" id="close_at" value={submittedValues.close_at} class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs text-ink dark:text-[#E8E0D0] outline-none focus:border-emerald-500" />
            </div>

            <div>
              <label for="max_attempts" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1">
                🔁 Giới hạn lượt thi / HS
              </label>
              <input type="number" name="max_attempts" id="max_attempts" min="1" max="50" value={submittedValues.max_attempts} placeholder="Không giới hạn" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs font-semibold text-ink dark:text-[#E8E0D0] outline-none focus:border-emerald-500" />
            </div>

            <div class="sm:col-span-2 lg:col-span-4">
              <label for="show_answers_mode" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1">
                👁️ Chế độ công bố đáp án &amp; lời giải sau khi học sinh nộp bài
              </label>
              <select name="show_answers_mode" id="show_answers_mode" class="w-full sm:w-auto min-w-[320px] px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs font-semibold text-ink dark:text-[#E8E0D0] outline-none focus:border-emerald-500 cursor-pointer">
                <option value="always" selected={submittedValues.show_answers_mode === 'always'}>✅ Xem đáp án &amp; lời giải chi tiết ngay sau khi nộp bài (Mặc định)</option>
                <option value="after_close" selected={submittedValues.show_answers_mode === 'after_close'}>⏳ Chỉ hiện điểm số — Mở đáp án sau khi kết thúc Giờ đóng ca thi</option>
                <option value="never" selected={submittedValues.show_answers_mode === 'never'}>🔒 Chỉ hiện điểm tổng — Không công bố đáp án &amp; lời giải</option>
              </select>
            </div>
          </div>
        </div>

        <!-- 3. Cấu hình Thang điểm & Bốc ngẫu nhiên trực quan -->
        <details class="group rounded-2xl border border-slate-200 dark:border-slate-700/70 bg-slate-50/50 dark:bg-slate-900/30 overflow-hidden">
          <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider hover:bg-slate-100/70 dark:hover:bg-slate-800/40 transition">
            <span>⚙️ Cấu hình Thang điểm (Tự động theo Môn) &amp; Bốc ngẫu nhiên câu hỏi</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="p-4 pt-3 space-y-4 border-t border-slate-200/60 dark:border-slate-800/60">
            <div class="p-3.5 rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50/40 dark:bg-amber-950/10 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-xs font-bold text-amber-700 dark:text-amber-400 uppercase tracking-wider">
                  🏆 Cấu hình điểm số
                </p>
                <span class="text-[11px] text-amber-700 dark:text-amber-300 font-semibold">
                  Đúng/Sai 4 ý: 1 ý = 0.1đ · 2 ý = 0.25đ · 3 ý = 0.5đ · 4 ý = 1.0đ
                </span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label for="point_per_question" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Điểm mỗi câu MCQ / câu con</label>
                  <input type="number" name="point_per_question" id="point_per_question" min="0.01" max="100" step="0.01" value={submittedValues.point_per_question} class="w-full px-3.5 py-2 rounded-xl border border-amber-200 dark:border-amber-700/50 bg-white dark:bg-slate-900 text-sm font-bold text-ink dark:text-[#E8E0D0] outline-none focus:border-amber-500" />
                </div>
                <div>
                  <label for="point_per_sa" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Điểm mỗi câu Trả lời ngắn (<code>sa</code>)</label>
                  <input type="number" name="point_per_sa" id="point_per_sa" min="0.01" max="100" step="0.01" value={submittedValues.point_per_sa} class="w-full px-3.5 py-2 rounded-xl border border-amber-200 dark:border-amber-700/50 bg-white dark:bg-slate-900 text-sm font-bold text-ink dark:text-[#E8E0D0] outline-none focus:border-amber-500" />
                </div>
                <div>
                  <label for="max_score" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Thang điểm tối đa toàn bài</label>
                  <input type="number" name="max_score" id="max_score" min="1" max="1500" step="1" value={submittedValues.max_score} class="w-full px-3.5 py-2 rounded-xl border border-amber-200 dark:border-amber-700/50 bg-white dark:bg-slate-900 text-sm font-bold text-ink dark:text-[#E8E0D0] outline-none focus:border-amber-500" />
                </div>
              </div>
            </div>

            <div class="p-3.5 rounded-xl border border-blue-200 dark:border-blue-800/40 bg-blue-50/40 dark:bg-blue-950/10 space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs font-bold text-blue-700 dark:text-blue-400 uppercase tracking-wider">
                  🎲 Bốc ngẫu nhiên k câu từ kho câu hỏi của đề cho mỗi lượt làm bài
                </span>
                <button type="button" id="btn-clear-pick" class="text-[11px] font-bold text-blue-600 hover:underline">Xóa trắng</button>
              </div>
              <input type="hidden" name="pick_per_type" id="pick_per_type" value={submittedValues.pick_per_type} />
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                {PICK_TYPE_ITEMS.map(item => (
                  <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-blue-100 dark:border-slate-800 flex items-center justify-between gap-2">
                    <label for={`pick-${item.key}`} class="text-[11px] font-semibold text-slate-600 dark:text-slate-300 leading-tight">{item.label}</label>
                    <input type="number" id={`pick-${item.key}`} data-pick-key={item.key} min="1" max="100" placeholder="Tất cả" class="visual-pick-input w-16 px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-bold text-center text-ink dark:text-white outline-none focus:border-blue-500" />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </details>

        <!-- 4. Ba Tab Phương Thức Tạo Đề -->
        <div class="border-t border-slate-100 dark:border-slate-800/60 pt-6 space-y-6">
          <div class="flex flex-wrap gap-1.5 bg-slate-100 dark:bg-slate-800/60 rounded-xl p-1 w-fit">
            <button type="button" id="tab-ai" class="tab-btn px-4 py-2.5 text-xs font-bold rounded-lg transition-all cursor-pointer" data-target="ai-section">
              ✨ Tạo đề AI (Ma trận &amp; Prompt)
            </button>
            <button type="button" id="tab-file" class="tab-btn px-4 py-2.5 text-xs font-bold rounded-lg transition-all cursor-pointer" data-target="file-section">
              📄 Tạo đề từ Word / PDF
            </button>
            <button type="button" id="tab-json" class="tab-btn px-4 py-2.5 text-xs font-bold rounded-lg transition-all cursor-pointer" data-target="json-section">
              🧩 Nhập / Sửa JSON
            </button>
          </div>

          <input type="hidden" name="mode" id="input-mode" value={submittedValues.mode || 'ai'} />

          <!-- Khung dùng chung Gemini API Key cho cả Tab Tạo đề AI & Tab Word/PDF -->
          <div id="shared-gemini-box" class="p-4 md:p-5 rounded-2xl border border-indigo-200/80 dark:border-indigo-800/50 bg-gradient-to-br from-indigo-50/70 via-violet-50/40 to-white dark:from-indigo-950/25 dark:via-violet-950/15 dark:to-[#1E1E38] space-y-3.5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 class="text-sm font-extrabold text-indigo-900 dark:text-indigo-300 flex items-center gap-1.5">
                  <span>🔑</span> Kết nối Google Gemini API (Dùng chung cho Tạo đề AI &amp; Đọc Word/PDF)
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                  API Key lưu cục bộ trên trình duyệt của bạn và gọi trực tiếp tới Google AI, không gửi lưu lên máy chủ.
                </p>
              </div>
              <a
                href="https://aistudio.google.com/apikey"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-indigo-200 dark:border-indigo-700 text-xs font-bold text-indigo-600 dark:text-indigo-300 hover:bg-indigo-50 dark:hover:bg-slate-700 transition w-fit shrink-0"
              >
                ⚡ Lấy API Key miễn phí →
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div class="md:col-span-2">
                <label for="gemini-api-key" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1">
                  Gemini API Key <span class="text-rose-500">*</span>
                </label>
                <div class="relative flex items-center">
                  <input
                    type="password"
                    id="gemini-api-key"
                    autocomplete="off"
                    placeholder="AIzaSy... (Nhập khóa API Gemini của bạn)"
                    class="w-full pl-3.5 pr-20 py-2.5 rounded-xl border border-indigo-200 dark:border-indigo-700/60 bg-white dark:bg-slate-900 text-sm font-mono text-ink dark:text-[#E8E0D0] focus:border-indigo-500 outline-none placeholder:font-sans placeholder:text-slate-400"
                  />
                  <div class="absolute right-2 flex items-center gap-1">
                    <button type="button" id="btn-toggle-key" class="px-2 py-1 rounded-md text-[11px] font-semibold text-slate-500 hover:text-indigo-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition">Hiện</button>
                    <button type="button" id="btn-clear-key" class="px-1.5 py-1 rounded-md text-[11px] font-semibold text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">✕</button>
                  </div>
                </div>
              </div>

              <div>
                <label for="gemini-model" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1">
                  Mô hình AI
                </label>
                <select id="gemini-model" class="w-full px-3.5 py-2.5 rounded-xl border border-indigo-200 dark:border-indigo-700/60 bg-white dark:bg-slate-900 text-sm text-ink dark:text-[#E8E0D0] focus:border-indigo-500 outline-none cursor-pointer">
                  <option value="gemini-2.5-flash" selected>⚡ Gemini 2.5 Flash (Nhanh &amp; Đọc PDF chuẩn)</option>
                  <option value="gemini-2.5-pro">🧠 Gemini 2.5 Pro (Chuyên sâu / Đề khó)</option>
                  <option value="gemini-2.0-flash">🚀 Gemini 2.0 Flash (Tốc độ cao)</option>
                </select>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-0.5">
              <label class="inline-flex items-center gap-2 text-xs text-slate-600 dark:text-slate-300 cursor-pointer select-none">
                <input type="checkbox" id="remember-api-key" checked class="rounded border-indigo-300 text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5" />
                <span>Ghi nhớ API Key trên trình duyệt này cho lần sau</span>
              </label>
              <span id="key-saved-badge" class="hidden text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
                ✓ Đã nạp API Key từ trình duyệt
              </span>
            </div>
          </div>

          <!-- ============================================================ -->
          <!-- TAB 1: TẠO ĐỀ AI THEO MA TRẬN 2 CHIỀU & PROMPT               -->
          <!-- ============================================================ -->
          <div id="ai-section" class="space-y-6">
            <div class="p-4 md:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/35 space-y-4">
              <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                <div>
                  <h3 class="text-sm font-extrabold text-ink dark:text-[#E8E0D0]">
                    🎯 Bảng Ma trận đề thi 2 chiều (Dạng câu hỏi × Mức độ năng lực)
                  </h3>
                  <p id="ai-preset-note" class="text-xs text-emerald-700 dark:text-emerald-400 font-medium mt-0.5">
                    Chọn Môn học và Kỳ thi ở trên để hệ thống tự động điền chuẩn cấu trúc &amp; thang điểm.
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                  <button type="button" id="btn-apply-subject-preset" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition cursor-pointer">
                    ⚡ Nạp lại chuẩn theo Môn &amp; Kỳ thi
                  </button>
                  <span id="ai-total-badge" class="text-xs font-extrabold px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50">22 câu</span>
                  <span id="ai-score-badge" class="text-xs font-extrabold px-3 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/50">TN: 10.0đ</span>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <label class="inline-flex items-center gap-2 text-xs font-bold text-indigo-700 dark:text-indigo-300 cursor-pointer select-none">
                  <input type="checkbox" id="toggle-three-level" class="rounded border-indigo-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4" />
                  <span>📐 Chế độ 3 mức năng lực Công văn 7991 (Biết – Hiểu – Vận dụng)</span>
                </label>

                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-[11px] font-semibold text-slate-400 mr-1">Phân bổ nhanh:</span>
                  <button type="button" data-dist="40,30,30,0" data-3lvl="1" class="dist-preset-btn px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 text-[11px] font-bold text-slate-700 dark:text-slate-300 transition">📌 CV 7991 (40-30-30)</button>
                  <button type="button" data-dist="35,30,20,15" data-3lvl="0" class="dist-preset-btn px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 text-[11px] font-bold text-slate-700 dark:text-slate-300 transition">🏆 THPT 2025 (35-30-20-15)</button>
                  <button type="button" data-dist="50,30,20,0" data-3lvl="1" class="dist-preset-btn px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 text-[11px] font-bold text-slate-700 dark:text-slate-300 transition">⏱️ 15p (50-30-20)</button>
                  <button type="button" data-dist="10,25,40,25" data-3lvl="0" class="dist-preset-btn px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 text-[11px] font-bold text-slate-700 dark:text-slate-300 transition">🥇 HSG (10-25-40-25)</button>
                </div>
              </div>

              <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <table class="w-full text-xs text-left border-collapse">
                  <thead>
                    <tr class="bg-slate-100/80 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-700">
                      <th class="py-2.5 px-3 font-extrabold">Phần thi / Dạng câu hỏi</th>
                      <th class="py-2.5 px-2 text-center font-extrabold text-emerald-700 dark:text-emerald-400 w-24">Biết (NB)</th>
                      <th class="py-2.5 px-2 text-center font-extrabold text-blue-700 dark:text-blue-400 w-24">Hiểu (TH)</th>
                      <th class="py-2.5 px-2 text-center font-extrabold text-amber-700 dark:text-amber-400 w-24">Vận dụng (VD)</th>
                      <th id="th-col-vdc" class="py-2.5 px-2 text-center font-extrabold text-rose-700 dark:text-rose-400 w-24">VD Cao (VDC)</th>
                      <th class="py-2.5 px-3 text-center font-extrabold text-slate-800 dark:text-white w-24">Tổng mục</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    {MATRIX_ROW_KEYS.map(rKey => {
                      const info = MATRIX_ROW_META[rKey];
                      return (
                        <tr data-row-key={rKey} class="hover:bg-slate-50/70 dark:hover:bg-slate-800/30 transition">
                          <td class="py-2 px-3">
                            <span class="font-bold text-slate-800 dark:text-slate-200 block">{info.label}</span>
                            <span class="text-[10px] text-slate-400 font-mono">{info.sub} · đơn vị: {info.unitLabel}</span>
                          </td>
                          <td class="py-2 px-2 text-center">
                            <input type="number" min="0" max="50" value="0" data-m2d-row={rKey} data-m2d-lvl="nb" class="m2d-cell w-16 px-2 py-1 rounded-lg border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/30 dark:bg-slate-800 text-center font-bold text-ink dark:text-white outline-none focus:border-emerald-500" />
                          </td>
                          <td class="py-2 px-2 text-center">
                            <input type="number" min="0" max="50" value="0" data-m2d-row={rKey} data-m2d-lvl="th" class="m2d-cell w-16 px-2 py-1 rounded-lg border border-blue-200 dark:border-blue-800/60 bg-blue-50/30 dark:bg-slate-800 text-center font-bold text-ink dark:text-white outline-none focus:border-blue-500" />
                          </td>
