  async function renderCurrentPdfPage() {
    if (!activePdfController || !pdfReviewCanvas) return;
    await activePdfController.renderPageToCanvas(currentPdfPage, pdfReviewCanvas, 1.35);
    if (pdfPageLabel) pdfPageLabel.textContent = `Trang ${currentPdfPage} / ${activePdfController.pageCount}`;
    if (btnPdfPrev) btnPdfPrev.disabled = currentPdfPage <= 1;
    if (btnPdfNext) btnPdfNext.disabled = currentPdfPage >= activePdfController.pageCount;
  }

  btnPdfPrev?.addEventListener('click', () => {
    if (activePdfController && currentPdfPage > 1) {
      currentPdfPage--;
      renderCurrentPdfPage();
    }
  });
  btnPdfNext?.addEventListener('click', () => {
    if (activePdfController && currentPdfPage < activePdfController.pageCount) {
      currentPdfPage++;
      renderCurrentPdfPage();
    }
  });

  // Manual Drag-to-Crop on PDF Canvas
  let cropStart: { x: number; y: number } | null = null;

  function enterPdfCropMode(qIdx: number) {
    if (!activePdfController) {
      alert('Công cụ kéo cắt vùng trực tiếp chỉ áp dụng khi tệp đề gốc là PDF.');
      return;
    }
    activeCropQuestionIdx = qIdx;
    const suggestedPage = importedQuestionsState[qIdx]?.image_region?.page;
    if (suggestedPage && suggestedPage >= 1 && suggestedPage <= activePdfController.pageCount && suggestedPage !== currentPdfPage) {
      currentPdfPage = suggestedPage;
      renderCurrentPdfPage();
    }
    if (pdfCropTargetLabel) pdfCropTargetLabel.textContent = `✂️ Giữ chuột kéo vùng hình vẽ trên trang PDF cho Câu #${qIdx + 1}`;
    pdfCropHint?.classList.remove('hidden');
    if (pdfCanvasStage) pdfCanvasStage.style.cursor = 'crosshair';
  }

  function exitPdfCropMode() {
    activeCropQuestionIdx = null;
    cropStart = null;
    pdfCropHint?.classList.add('hidden');
    pdfCropRect?.classList.add('hidden');
    if (pdfCanvasStage) pdfCanvasStage.style.cursor = 'default';
  }

  btnCancelCropMode?.addEventListener('click', exitPdfCropMode);

  pdfCanvasStage?.addEventListener('mousedown', (e) => {
    if (activeCropQuestionIdx === null || !pdfReviewCanvas || !pdfCropRect) return;
    const rect = pdfReviewCanvas.getBoundingClientRect();
    cropStart = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    pdfCropRect.style.left = `${cropStart.x}px`;
    pdfCropRect.style.top = `${cropStart.y}px`;
    pdfCropRect.style.width = '0px';
    pdfCropRect.style.height = '0px';
    pdfCropRect.classList.remove('hidden');
  });

  window.addEventListener('mousemove', (e) => {
    if (!cropStart || activeCropQuestionIdx === null || !pdfReviewCanvas || !pdfCropRect) return;
    const rect = pdfReviewCanvas.getBoundingClientRect();
    const curX = Math.min(Math.max(0, e.clientX - rect.left), rect.width);
    const curY = Math.min(Math.max(0, e.clientY - rect.top), rect.height);
    const left = Math.min(cropStart.x, curX);
    const top = Math.min(cropStart.y, curY);
    pdfCropRect.style.left = `${left}px`;
    pdfCropRect.style.top = `${top}px`;
    pdfCropRect.style.width = `${Math.abs(curX - cropStart.x)}px`;
    pdfCropRect.style.height = `${Math.abs(curY - cropStart.y)}px`;
  });

  window.addEventListener('mouseup', async (e) => {
    if (!cropStart || activeCropQuestionIdx === null || !pdfReviewCanvas || !activePdfController) return;
    const targetIdx = activeCropQuestionIdx;
    const rect = pdfReviewCanvas.getBoundingClientRect();
    const endX = Math.min(Math.max(0, e.clientX - rect.left), rect.width);
    const endY = Math.min(Math.max(0, e.clientY - rect.top), rect.height);

    const x1 = Math.min(cropStart.x, endX);
    const y1 = Math.min(cropStart.y, endY);
    const x2 = Math.max(cropStart.x, endX);
    const y2 = Math.max(cropStart.y, endY);
    exitPdfCropMode();

    if (x2 - x1 < 15 || y2 - y1 < 15) return;

    const box2d: [number, number, number, number] = [
      Math.round((y1 / rect.height) * 1000),
      Math.round((x1 / rect.width) * 1000),
      Math.round((y2 / rect.height) * 1000),
      Math.round((x2 / rect.width) * 1000),
    ];

    try {
      const cropped = await activePdfController.cropNormalizedBox(currentPdfPage, box2d);
      if (importedQuestionsState[targetIdx]) {
        importedQuestionsState[targetIdx]._pendingBlob = cropped.blob;
        importedQuestionsState[targetIdx]._previewUrl = cropped.previewUrl;
        delete importedQuestionsState[targetIdx].image_url;
        syncDraftImportedJson();
        renderFileSplitQuestionsList();
      }
    } catch (err: any) {
      alert(`Không thể cắt ảnh: ${err?.message}`);
    }
  });

  function isQuestionMissingAnswer(q: ImportedExamQuestion): boolean {
    const t = String(q.type || 'mcq').toLowerCase();
    if (t === 'tl' || t === 'msq') return false;
    if (t === 'read' || t === 'read_cloze' || t === 'list' || t === 'matching') {
      const subs = q.metadata?.questions || [];
      return subs.length === 0 || subs.some((sq: any) => !String(sq.correct_option || sq.correct_answer || '').trim());
    }
    return !String(q.correct_option || '').trim();
  }

  function syncDraftImportedJson() {
    if (!jsonDataEl) return;
    const cleanForPreview = importedQuestionsState.map(q => {
      const copy: Record<string, any> = { ...q };
      delete copy._pendingBlob;
      delete copy._previewUrl;
      delete copy.image_region;
      return copy;
    });
    jsonDataEl.value = JSON.stringify(
      { ...(importedTitleState ? { title: importedTitleState } : {}), questions: cleanForPreview },
      null,
      2
    );
    updateReadyQuestionsIndicator();
  }

  function renderFileSplitQuestionsList() {
    if (!fileQuestionsList || !fileSummaryTitle) return;

    const missingCount = importedQuestionsState.filter(isQuestionMissingAnswer).length;
    const figCount = importedQuestionsState.filter(q => Boolean(q._previewUrl || q.image_url)).length;

    fileSummaryTitle.textContent = `✅ Đã nhận diện ${importedQuestionsState.length} mục câu hỏi · ${figCount} hình vẽ · ${missingCount} thiếu đáp án`;

    const visibleItems = importedQuestionsState
      .map((q, idx) => ({ q, idx }))
      .filter(({ q }) => {
        if (currentFileFilter === 'missing') return isQuestionMissingAnswer(q);
        if (currentFileFilter === 'figure') return Boolean(q._previewUrl || q.image_url);
        return true;
      });

    if (visibleItems.length === 0) {
      fileQuestionsList.innerHTML = `<div class="p-8 text-center rounded-xl bg-slate-50 dark:bg-slate-900 border border-dashed border-slate-200 dark:border-slate-800 text-xs text-slate-500">Không có câu hỏi nào thuộc bộ lọc này.</div>`;
      return;
    }

    const alphabet = ['A', 'B', 'C', 'D', 'E', 'F'];
    fileQuestionsList.innerHTML = visibleItems
      .map(({ q, idx }) => {
        const qType = String(q.type || 'mcq').toLowerCase();
        const imgSrc = q._previewUrl || q.image_url || '';
        const missing = isQuestionMissingAnswer(q);
        const opts = [q.option_a, q.option_b, q.option_c, q.option_d, q.option_e, q.option_f].filter((v: any) => typeof v === 'string' && v.trim());

        const imgBlock = imgSrc
          ? `<div class="my-2.5 p-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-3">
              <img src="${escapeHtml(imgSrc)}" alt="Hình câu ${idx + 1}" class="max-h-40 rounded-lg object-contain bg-white p-1 border border-slate-200" />
              <div class="flex flex-col gap-1.5 shrink-0">
                ${activePdfController ? `<button type="button" data-crop-idx="${idx}" class="btn-recrop-fig px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-[11px] font-bold hover:bg-indigo-100">✂️ Cắt lại từ PDF</button>` : ''}
                <button type="button" data-del-img="${idx}" class="btn-remove-fig px-2.5 py-1 rounded-lg bg-rose-50 text-rose-600 text-[11px] font-bold hover:bg-rose-100">🗑️ Xóa hình</button>
              </div>
            </div>`
          : activePdfController
            ? `<div class="mt-1.5"><button type="button" data-crop-idx="${idx}" class="btn-recrop-fig text-[11px] font-bold text-indigo-600 dark:text-indigo-400 hover:underline">✂️ + Kéo cắt hình từ trang PDF gắn vào câu này</button></div>`
            : '';

        const optsBlock = opts.length > 0
          ? `<div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-2">${opts.map((opt, oi) => `<div class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900 text-xs text-slate-700 dark:text-slate-300"><strong>${alphabet[oi]}.</strong> ${escapeHtml(opt || '')}</div>`).join('')}</div>`
          : '';

        const subsBlock = (qType === 'read' || qType === 'read_cloze') && Array.isArray(q.metadata?.questions)
          ? `<div class="mt-2 pl-3 border-l-2 border-indigo-200 space-y-1 text-xs">${q.metadata.questions.map((sq: any, sIdx: number) => `<div><strong>(${sIdx + 1})</strong> ${escapeHtml(sq.question || '')} → <strong class="text-emerald-600">${escapeHtml(sq.correct_option || '?')}</strong></div>`).join('')}</div>`
          : '';

        return `<div class="p-4 rounded-2xl bg-white dark:bg-[#1E1E38] border ${missing ? 'border-amber-400' : 'border-slate-200 dark:border-slate-700/80'} shadow-2xs space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-lg bg-indigo-600 text-white text-xs font-extrabold">Câu ${idx + 1}</span>
              <span class="text-xs font-bold text-slate-600 dark:text-slate-300">${escapeHtml(getQuestionTypeLabelVi(qType))}</span>
              ${missing ? '<span class="px-2 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-extrabold">⚠️ Cần điền đáp án</span>' : ''}
            </div>
            ${qType !== 'read' && qType !== 'read_cloze' ? `
              <div class="flex items-center gap-1.5 text-xs">
                <span class="text-slate-400 font-semibold">Đáp án đúng:</span>
                <input type="text" value="${escapeHtml(q.correct_option || '')}" data-ans-idx="${idx}" placeholder="${qType === 'msq' ? 'VD: A,C' : qType === 'sa' ? 'VD: 12,5' : 'A/B/C/D'}" class="quick-ans-input w-24 px-2 py-1 rounded-lg border border-emerald-300 dark:border-emerald-700 bg-emerald-50/50 dark:bg-slate-900 font-bold text-center text-emerald-800 dark:text-emerald-300 outline-none" />
              </div>
            ` : ''}
          </div>
          <div class="text-xs text-slate-800 dark:text-slate-100 leading-relaxed whitespace-pre-line">${escapeHtml(q.question || q.content || '')}</div>
          ${imgBlock}
          ${optsBlock}
          ${subsBlock}
        </div>`;
      })
      .join('');

    fileQuestionsList.querySelectorAll<HTMLInputElement>('.quick-ans-input').forEach(inp => {
      inp.addEventListener('change', () => {
        const i = parseInt(inp.dataset.ansIdx || '-1', 10);
        if (importedQuestionsState[i]) {
          importedQuestionsState[i].correct_option = inp.value.trim();
          syncDraftImportedJson();
          renderFileSplitQuestionsList();
        }
      });
