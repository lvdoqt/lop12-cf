---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
import ReadListPreview from '../../../components/ReadListPreview.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'teacher')) {
  return Astro.redirect('/dashboard');
}

const baseUrl = (import.meta.env.BASE_URL || '/lms').replace(/\/$/, '');

let errMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData    = await Astro.request.formData();
    const mode        = (formData.get('mode') as string) || 'manual';
    const title       = (formData.get('title') as string)?.trim();
    const duration    = Number(formData.get('duration'));
    const subject_id  = formData.get('subject_id') as string;
    const category_id = (formData.get('category_id') as string) || null;
    const exam_type   = formData.get('exam_type')  as '15m' | '45m' | 'semester' | 'mock_thpt' | 'vsat';
    const password    = (formData.get('password')  as string)?.trim() || undefined;

    if (!title || !duration || !subject_id || !exam_type) {
      throw new Error('Tiêu đề, Thời gian, Môn học và Phân loại đề thi là bắt buộc.');
    }

    let questionIds: string[] = [];

    if (mode === 'json') {
      const jsonRaw = formData.get('json_data') as string;
      if (!jsonRaw?.trim()) throw new Error('Vui lòng nhập dữ liệu JSON.');
      let parsed: any;
      try { 
        parsed = JSON.parse(jsonRaw); 
      } catch {
        throw new Error('JSON không hợp lệ. Vui lòng kiểm tra cú pháp.');
      }
      const qs = Array.isArray(parsed) ? parsed : (parsed.questions || []);
      if (!Array.isArray(qs) || qs.length === 0)
        throw new Error('JSON phải chứa mảng "questions" với ít nhất 1 câu hỏi.');

      const difficultyMap: Record<string, 'easy' | 'medium' | 'hard'> = {
        easy: 'easy', medium: 'medium', hard: 'hard',
        dễ: 'easy', 'trung bình': 'medium', khó: 'hard',
      };
      const typeMap: Record<string, string> = {
        mcq: 'single_choice',
        single_choice: 'single_choice',
        msq: 'msq',
        multiple_choice: 'multiple_choice',
        tf_cluster: 'msq',
        tf: 'true_false',
        true_false: 'true_false',
        sa: 'sa',
        tl: 'tl',
        read: 'read',
        reading: 'read',
        list: 'list',
        read_cloze: 'read_cloze',
        ordering: 'ordering'
      };

      const batchItems: Array<{
        question: any;
        answers: { content: string; is_correct: boolean }[];
      }> = [];

      for (const q of qs) {
        const qType = typeMap[q.type] || 'single_choice';
        const qDiff = difficultyMap[q.difficulty_level?.toLowerCase() || q.difficulty?.toLowerCase()] || 'medium';
        const qContent = q.question || q.content || '';
        const qExpl = q.explanation || '';
        const correctStr = (q.correct_option || q.correct_answer || q.answer || '').trim();

        let answers: { content: string; is_correct: boolean }[] = [];
        let metadata: any = undefined;

        if (qType === 'read' || qType === 'list' || qType === 'read_cloze') {
          const metaQuestions = Array.isArray(q.metadata?.questions) ? q.metadata.questions : (Array.isArray(q.questions) ? q.questions : []);
          if (metaQuestions.length === 0) {
            throw new Error('Câu hỏi dạng read/list thiếu metadata.questions.');
          }
          const mappedQuestions = metaQuestions.map((sq: any) => {
            const out: any = {
              question: sq.question || sq.content || '',
              option_a: sq.option_a || '',
              option_b: sq.option_b || '',
              option_c: sq.option_c || '',
              option_d: sq.option_d || '',
              correct_option: (sq.correct_option || '').toUpperCase(),
              ...(sq.explanation ? { explanation: sq.explanation } : {})
            };
            if (sq.option_e) out.option_e = sq.option_e;
            if (sq.option_f) out.option_f = sq.option_f;
            return out;
          });
          const audioUrl = q.metadata?.audio_url ? q.metadata.audio_url : undefined;
          metadata = {
            questions: mappedQuestions,
            ...(audioUrl ? { audio_url: audioUrl } : {}),
            ...(category_id ? { category_id } : {})
          };
        } else if (Array.isArray(q.answers)) {
          answers = q.answers.map((a: any) => ({
            content: a.content || String(a),
            is_correct: Boolean(a.is_correct || a.isCorrect || false)
          }));
        } else if (Array.isArray(q.options)) {
          const alphabet = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
          const correctKeys = correctStr.split(',').map((k: string) => k.trim().toUpperCase());
          answers = q.options.map((opt: string, idx: number) => ({
            content: opt,
            is_correct: correctKeys.includes(alphabet[idx]) || correctStr.toUpperCase() === alphabet[idx]
          }));
        } else if (qType === 'single_choice' || qType === 'multiple_choice' || qType === 'msq') {
          const options = [
            { key: 'A', text: q.option_a },
            { key: 'B', text: q.option_b },
            { key: 'C', text: q.option_c },
            { key: 'D', text: q.option_d },
            { key: 'E', text: q.option_e },
            { key: 'F', text: q.option_f },
          ].filter(o => o.text?.trim());
          const correctKeys = correctStr.split(',').map((k: string) => k.trim().toUpperCase());

          answers = options.map(o => ({
            content: o.text,
            is_correct: correctKeys.includes(o.key),
          }));
        } else if (qType === 'true_false') {
          answers = [
            { content: 'Đúng', is_correct: correctStr.toUpperCase() === 'TRUE' || correctStr.toUpperCase() === 'Đ' || correctStr.toUpperCase() === 'ĐÚNG' || correctStr.toUpperCase() === 'A' },
            { content: 'Sai', is_correct: correctStr.toUpperCase() === 'FALSE' || correctStr.toUpperCase() === 'S' || correctStr.toUpperCase() === 'SAI' || correctStr.toUpperCase() === 'B' },
          ];
        }

        batchItems.push({
          question: {
            subject_id,
            content: qContent,
            explanation: qExpl,
            difficulty: qDiff,
            type: qType as any,
            answer: (qType === 'sa' || qType === 'tl') ? correctStr : null,
            created_by: user.id,
            metadata: metadata ? metadata : (category_id ? { category_id } : undefined)
          },
          answers
        });
      }

      let createdQs: any[];
      try {
        createdQs = await db.createQuestionsBatch(batchItems);
      } catch (qErr: any) {
        throw new Error(`Lỗi tạo câu hỏi (batch): ${qErr?.message || qErr?.details || String(qErr)}`);
      }
      questionIds = createdQs.map((q: any) => q.id);

    } else if (mode === 'matrix') {
      const nb = Number(formData.get('matrix_nb')) || 0;
      const th = Number(formData.get('matrix_th')) || 0;
      const vd = Number(formData.get('matrix_vd')) || 0;
      const vdc = Number(formData.get('matrix_vdc')) || 0;
      const chapter = (formData.get('matrix_chapter') as string)?.trim() || undefined;
      const textbook = (formData.get('matrix_textbook') as string)?.trim() || undefined;

      if (nb + th + vd + vdc <= 0) {
        throw new Error('Vui lòng chỉ định số lượng câu hỏi cho ít nhất 1 cấp độ nhận thức.');
      }

      const matrixRes = await db.getQuestionsByMatrix({
        subjectId: subject_id,
        categoryId: category_id,
        chapter,
        textbook,
        levels: { nb, th, vd, vdc },
      });

      if (matrixRes.questions.length === 0) {
        throw new Error('Không tìm thấy câu hỏi phù hợp với ma trận đã chọn trong ngân hàng đề.');
      }

      questionIds = matrixRes.questions.map(q => q.id);

    } else {
      questionIds = formData.getAll('question_ids') as string[];
      if (questionIds.length === 0)
        throw new Error('Cần chọn ít nhất một câu hỏi từ ngân hàng để tạo đề thi này.');
    }

    // Deduplicate question IDs
    questionIds = Array.from(new Set(questionIds));

    try {
      await db.createExam({ title, duration, subject_id, category_id, exam_type, created_by: user.id, ...(password ? { password } : {}) }, questionIds);
    } catch (examErr: any) {
      throw new Error(`Lỗi tạo đề thi: ${examErr?.message || examErr?.details || String(examErr)}`);
    }
    return Astro.redirect('/admin/exams');

  } catch (err: any) {
    errMsg = err.message || err?.details || 'Lỗi tạo đề thi mới.';
  }
}

let subjects: any[] = [];
let questions: any[] = [];
let allCategories: any[] = [];
try { subjects = await db.getSubjects(); } catch { /* fallback to empty */ }
try { questions = await db.getQuestions(); } catch { /* fallback to empty */ }
try { allCategories = await db.getCategories(); } catch { /* fallback to empty */ }

// Handle pre-selected questions via GET ?q=id1,id2
const url = new URL(Astro.request.url);
const preselectedQ = url.searchParams.get('q');
const preselectedIds = preselectedQ ? preselectedQ.split(',') : [];

let preselectedSubjectId = '';
if (preselectedIds.length > 0) {
  const firstSelectedQ = questions.find(q => preselectedIds.includes(q.id));
  if (firstSelectedQ) {
    preselectedSubjectId = firstSelectedQ.subject_id;
  }
}
---

<Layout title="Tạo đề thi mới">
  <div class="max-w-4xl mx-auto space-y-6">

    <!-- Breadcrumb -->
    <div>
      <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
        <a href="/admin" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Quản trị</a>
        <span>/</span>
        <a href="/admin/exams" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Đề thi</a>
        <span>/</span>
        <span class="text-ink dark:text-[#E8E0D0]">Tạo mới</span>
      </nav>
      <h1 class="text-2xl md:text-3xl font-extrabold text-ink dark:text-[#E8E0D0] tracking-tight font-serif">
        Tạo đề thi mới
      </h1>
      <p class="text-sm text-[#8A7E72] dark:text-[#8A8A9E] mt-1">
        Chọn câu hỏi từ ngân hàng, soạn đề tự động theo ma trận hoặc dán mã JSON.
      </p>
    </div>

    <!-- Error Alert -->
    {errMsg && (
      <div class="p-4 rounded-xl bg-rose-50 text-rose-600 text-sm font-semibold border border-rose-100 dark:bg-rose-950/20 dark:text-rose-400 dark:border-rose-900/35 flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        {errMsg}
      </div>
    )}

    <!-- Form Card -->
    <div class="bg-white dark:bg-[#22223A]/80 border border-slate-200/60 dark:border-slate-800/60 rounded-2xl shadow-sm overflow-hidden">

      <form method="POST" class="p-6 md:p-8 space-y-6">

        <!-- Meta grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

          <!-- Title -->
          <div class="sm:col-span-2">
            <label for="title" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Tiêu đề đề thi <span class="text-rose-500">*</span>
            </label>
            <input type="text" name="title" id="title" required placeholder="VD: Đề thi thử THPT Quốc gia môn Toán..." class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] transition-colors placeholder:text-slate-400" />
          </div>

          <!-- Subject -->
          <div>
            <label for="subject_id" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Môn học <span class="text-rose-500">*</span></label>
            <select name="subject_id" id="subject_id" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] cursor-pointer">
              <option value="" disabled selected={!preselectedSubjectId}>-- Chọn môn học --</option>
              {subjects.map(s => (<option value={s.id} selected={s.id === preselectedSubjectId}>{s.name}</option>))}
            </select>
          </div>

          <!-- Category -->
          <div>
            <label for="exam_category_id" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Chuyên mục
              <a href="/admin/categories" target="_blank" class="ml-2 text-blue-500 hover:text-blue-700 normal-case font-semibold">➕ Quản lý</a>
            </label>
            <select name="category_id" id="exam_category_id" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] cursor-pointer">
              <option value="">-- Tất cả / Không phân chuyên mục --</option>
            </select>
          </div>

          <!-- Exam type -->
          <div>
            <label for="exam_type" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Phân loại đề thi <span class="text-rose-500">*</span></label>
            <select name="exam_type" id="exam_type" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] cursor-pointer">
              <option value="15m">⏱️ Kiểm tra 15 phút</option>
              <option value="45m">📝 Kiểm tra 1 tiết</option>
              <option value="semester">🎓 Thi học kỳ</option>
              <option value="mock_thpt" selected>🏆 Thi thử THPT</option>
              <option value="vsat">🎯 Thi đánh giá năng lực V-SAT</option>
            </select>
          </div>

          <!-- Duration -->
          <div>
            <label for="duration" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Thời gian (phút) <span class="text-rose-500">*</span></label>
            <input type="number" name="duration" id="duration" required min="1" max="300" placeholder="15, 45, 90..." class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] transition-colors placeholder:text-slate-400" />
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
              Mật khẩu <span class="ml-1 font-normal normal-case text-slate-400">(không bắt buộc)</span>
            </label>
            <div class="relative">
              <input type="text" name="password" id="password" placeholder="Để trống nếu không cần..." class="w-full px-4 py-3 pr-10 rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent text-sm focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] transition-colors placeholder:text-slate-400" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-base">🔒</span>
            </div>
          </div>
        </div>

        <!-- Tab: Chọn câu hỏi / Soạn ma trận / Nhập JSON -->
        <div class="border-t border-slate-100 dark:border-slate-800/60 pt-6">
          <div class="flex flex-wrap gap-1 mb-5 bg-slate-100 dark:bg-slate-800/50 rounded-xl p-1 w-fit">
            <button type="button" id="tab-manual" class="tab-btn px-4 py-2 text-xs font-bold rounded-lg transition-all" data-target="manual-section">📋 Chọn từ ngân hàng</button>
            <button type="button" id="tab-matrix" class="tab-btn px-4 py-2 text-xs font-bold rounded-lg transition-all" data-target="matrix-section">🎯 Soạn theo Ma trận đề</button>
            <button type="button" id="tab-json" class="tab-btn px-4 py-2 text-xs font-bold rounded-lg transition-all" data-target="json-section">📄 Nhập JSON</button>
          </div>

          <!-- Hidden input for mode -->
          <input type="hidden" name="mode" id="input-mode" value="manual" />

          <!-- Tab: Manual select -->
          <div id="manual-section" class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
              <div>
                <h3 class="text-sm font-bold text-ink dark:text-[#E8E0D0]">Chọn câu hỏi từ ngân hàng đề</h3>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Chọn môn học ở trên để hiển thị và chọn câu hỏi.</p>
              </div>
              <div class="flex items-center gap-2">
                <span id="selected-count" class="text-xs font-bold px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/30 hidden">0 câu đã chọn</span>
                <button type="button" id="btn-select-all" class="text-xs font-semibold px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 hidden">
                  Chọn tất cả đang hiện
                </button>
                <button type="button" id="btn-deselect-all" class="text-xs font-semibold px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 hidden">
                  Bỏ chọn
                </button>
              </div>
            </div>

            <!-- Search box within question bank -->
            <div id="bank-search-bar" class="hidden">
              <div class="relative">
                <input type="text" id="bank-search-input" placeholder="🔍 Tìm kiếm nhanh câu hỏi trong môn học này..." class="w-full px-4 py-2.5 pl-9 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-xs outline-none focus:border-blue-500 text-ink dark:text-[#E8E0D0] placeholder:text-slate-400" />
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs">🔎</span>
              </div>
            </div>

            <div id="no-subject-warning" class="text-center p-8 bg-slate-50 dark:bg-slate-900/40 rounded-xl text-sm text-slate-400 border border-dashed border-slate-200 dark:border-slate-700">
              <div class="text-3xl mb-2">📚</div>
              Hãy chọn môn học ở trên để hiển thị danh sách câu hỏi trong ngân hàng.
            </div>

            <div id="no-questions-warning" class="text-center p-8 bg-amber-50 dark:bg-amber-900/10 rounded-xl text-sm text-amber-600 dark:text-amber-400 border border-dashed border-amber-200 dark:border-amber-800/30 hidden">
              <div class="text-3xl mb-2">📭</div>
              Môn học này chưa có câu hỏi nào trong ngân hàng.
              <div class="mt-3">
                <a href="/admin/questions/new" class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline">Tạo câu hỏi mới →</a>
              </div>
            </div>

            <div id="questions-list" class="space-y-2.5 max-h-[420px] overflow-y-auto hidden pr-1">
              {questions.map(q => (
                <label
                  data-subject-id={q.subject_id}
                  data-category-id={q.category_id || q.metadata?.category_id || ''}
                  data-search-text={(q.content || '').replace(/\$/g, '')}
                  class="question-checkbox-item flex items-start gap-3 p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-blue-300 dark:hover:border-blue-700 hover:bg-blue-50/30 dark:hover:bg-blue-900/10 cursor-pointer select-none transition-all duration-150"
                >
                  <input type="checkbox" name="question_ids" value={q.id} checked={preselectedIds.includes(q.id)} class="rounded text-blue-600 focus:ring-blue-500 h-4 w-4 mt-0.5 shrink-0" />
                  <div class="flex-1 min-w-0">
                    {q.type === 'read' || q.type === 'list' || q.type === 'read_cloze' ? (
                      <ReadListPreview question={q} />
                    ) : (
                      <p class="text-sm font-semibold text-ink dark:text-[#E8E0D0] leading-snug line-clamp-2">{(q.content || '').replace(/\$/g, '')}</p>
                    )}
                    <div class="flex items-center gap-2 mt-1.5">
                      <span class={`inline-block text-[10px] font-bold uppercase px-2 py-0.5 rounded-full ${q.difficulty === 'easy' ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-900/20 dark:text-emerald-400' : q.difficulty === 'medium' ? 'bg-amber-50 text-amber-600 dark:bg-amber-900/20 dark:text-amber-400' : 'bg-rose-50 text-rose-600 dark:bg-rose-900/20 dark:text-rose-400'}`}>
                        {q.difficulty === 'easy' ? 'Dễ' : q.difficulty === 'medium' ? 'Trung bình' : 'Khó'}
                      </span>
                      <span class="text-[10px] text-slate-400 uppercase font-semibold">{q.type === 'read' ? 'Đọc hiểu' : q.type === 'read_cloze' ? 'Điền vào chỗ trống' : q.type === 'ordering' ? 'Sắp xếp câu' : q.type === 'list' ? 'Kỹ năng nghe' : q.type === 'single_choice' ? 'Chọn 1' : q.type === 'multiple_choice' ? 'Chọn nhiều' : 'Đúng/Sai'}</span>
                    </div>
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- Tab: Matrix Auto Generation -->
          <div id="matrix-section" class="space-y-5 hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 class="text-sm font-bold text-ink dark:text-[#E8E0D0]">Soạn đề tự động theo Ma trận nhận thức</h3>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Tự động chọn ngẫu nhiên từ ngân hàng đề theo cấu trúc đề thi Bộ GD&ĐT 2025.</p>
              </div>
              <span id="matrix-total-badge" class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40 w-fit">
                Tổng: 40 câu
              </span>
            </div>

            <!-- Quick Presets -->
            <div class="p-3.5 bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-xl space-y-2">
              <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">⚡ Mẫu phân phối nhanh:</span>
              <div class="flex flex-wrap gap-2">
                <button type="button" id="preset-thpt" class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-emerald-500 text-xs font-semibold text-slate-700 dark:text-slate-200 transition">
                  🏆 Chuẩn THPT 2025 (40 câu: 16 NB - 12 TH - 8 VD - 4 VDC)
                </button>
                <button type="button" id="preset-1tiet" class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-emerald-500 text-xs font-semibold text-slate-700 dark:text-slate-200 transition">
                  📝 Kiểm tra 1 tiết (25 câu: 10 NB - 8 TH - 5 VD - 2 VDC)
                </button>
                <button type="button" id="preset-15p" class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-emerald-500 text-xs font-semibold text-slate-700 dark:text-slate-200 transition">
                  ⏱️ Kiểm tra 15 phút (10 câu: 5 NB - 3 TH - 2 VD - 0 VDC)
                </button>
              </div>
            </div>

            <!-- 4 Cognitive Levels Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <!-- Nhận biết -->
              <div class="p-4 rounded-xl border border-emerald-200 dark:border-emerald-900/40 bg-emerald-50/40 dark:bg-emerald-950/20 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400">1. Nhận biết (NB)</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300 font-bold">Cơ bản</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">Công thức, định nghĩa, nhận dạng kiến thức</p>
                <div class="pt-1">
                  <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-300 mb-1">Số lượng câu:</label>
                  <input type="number" name="matrix_nb" id="matrix_nb" min="0" max="100" value="16" class="matrix-input w-full px-3 py-2 rounded-lg border border-emerald-300 dark:border-emerald-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-900 dark:text-white text-center focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                </div>
              </div>

              <!-- Thông hiểu -->
              <div class="p-4 rounded-xl border border-blue-200 dark:border-blue-900/40 bg-blue-50/40 dark:bg-blue-950/20 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase text-blue-700 dark:text-blue-400">2. Thông hiểu (TH)</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-300 font-bold">Hiểu sâu</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">Giải thích, suy luận đơn giản, biến đổi quen thuộc</p>
                <div class="pt-1">
                  <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-300 mb-1">Số lượng câu:</label>
                  <input type="number" name="matrix_th" id="matrix_th" min="0" max="100" value="12" class="matrix-input w-full px-3 py-2 rounded-lg border border-blue-300 dark:border-blue-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-900 dark:text-white text-center focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
              </div>

              <!-- Vận dụng -->
              <div class="p-4 rounded-xl border border-amber-200 dark:border-amber-900/40 bg-amber-50/40 dark:bg-amber-950/20 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase text-amber-700 dark:text-amber-400">3. Vận dụng (VD)</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-300 font-bold">Thực hành</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">Vận dụng quy trình, phương pháp giải toán chuẩn</p>
                <div class="pt-1">
                  <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-300 mb-1">Số lượng câu:</label>
                  <input type="number" name="matrix_vd" id="matrix_vd" min="0" max="100" value="8" class="matrix-input w-full px-3 py-2 rounded-lg border border-amber-300 dark:border-amber-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-900 dark:text-white text-center focus:outline-none focus:ring-2 focus:ring-amber-500" />
                </div>
              </div>

              <!-- Vận dụng cao -->
              <div class="p-4 rounded-xl border border-rose-200 dark:border-rose-900/40 bg-rose-50/40 dark:bg-rose-950/20 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase text-rose-700 dark:text-rose-400">4. Vận dụng cao (VDC)</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-rose-100 dark:bg-rose-900/50 text-rose-800 dark:text-rose-300 font-bold">Phân loại</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">Tổng hợp kiến thức phức hợp, liên hệ thực tế</p>
                <div class="pt-1">
                  <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-300 mb-1">Số lượng câu:</label>
                  <input type="number" name="matrix_vdc" id="matrix_vdc" min="0" max="100" value="4" class="matrix-input w-full px-3 py-2 rounded-lg border border-rose-300 dark:border-rose-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-900 dark:text-white text-center focus:outline-none focus:ring-2 focus:ring-rose-500" />
                </div>
              </div>
            </div>

            <!-- Optional Textbook & Chapter filters -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
              <div>
                <label for="matrix_textbook" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                  Bộ sách giáo khoa (tùy chọn)
                </label>
                <select name="matrix_textbook" id="matrix_textbook" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm text-ink dark:text-[#E8E0D0] cursor-pointer">
                  <option value="all">📚 Tất cả các bộ sách (Chung)</option>
                  <option value="kntt">📖 Kết nối tri thức với cuộc sống</option>
                  <option value="ctst">🌅 Chân trời sáng tạo</option>
                  <option value="cd">🪁 Cánh diều</option>
                </select>
              </div>

              <div>
                <label for="matrix_chapter" class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                  Chương / Chuyên đề (tùy chọn)
                </label>
                <input type="text" name="matrix_chapter" id="matrix_chapter" placeholder="Ví dụ: Đạo hàm, Mũ và Logarit, Oxyz..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent text-sm text-ink dark:text-[#E8E0D0] placeholder:text-slate-400" />
              </div>
            </div>
          </div>

          <!-- Tab: JSON import -->
          <div id="json-section" class="space-y-4 hidden">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-ink dark:text-[#E8E0D0]">Nhập JSON đề thi</h3>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Dán nội dung JSON theo mẫu bên dưới. Câu hỏi sẽ được tạo tự động.</p>
              </div>
              <a href="/sample-questions.json" target="_blank" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline">📄 Xem file mẫu</a>
            </div>

            <div class="bg-amber-50/50 dark:bg-amber-950/10 border border-amber-200/50 dark:border-amber-900/30 rounded-xl p-4 text-xs text-amber-700 dark:text-amber-400 space-y-1">
              <p class="font-semibold">📌 Hỗ trợ các loại câu hỏi:</p>
              <p><code class="bg-amber-100 dark:bg-amber-900/30 px-1 rounded">mcq</code> Trắc nghiệm 1 đáp án · <code class="bg-amber-100 dark:bg-amber-900/30 px-1 rounded">msq</code> Trắc nghiệm nhiều đáp án · <code class="bg-amber-100 dark:bg-amber-900/30 px-1 rounded">tf</code> Đúng/Sai · <code class="bg-amber-100 dark:bg-amber-900/30 px-1 rounded">sa</code> Trả lời ngắn</p>
              <p>Hỗ trợ LaTeX: dùng <code class="bg-amber-100 dark:bg-amber-900/30 px-1 rounded">$...$</code> cho công thức toán.</p>
            </div>

            <div class="bg-blue-50/50 dark:bg-blue-950/10 border border-blue-200/50 dark:border-blue-900/30 rounded-xl p-4 text-xs text-blue-700 dark:text-blue-400 space-y-1">
              <p class="font-semibold">💡 Hướng dẫn tạo JSON:</p>
              <ul class="list-disc pl-4 space-y-1 mt-1">
                <li>Đề thi Môn Toán, Lý, Hóa,... có công thức mathtype và hình ảnh thì vào link này để <a href="https://json.lop12.com/" target="_blank" class="font-bold underline hover:text-blue-800 dark:hover:text-blue-300">chuyển word to json</a>.</li>
                <li>Nếu bạn có file word Đề thi môn Anh, Sử, Địa, GDCD,... vào <a href="https://gemini.google.com/gem/1ITi5zYUCUaz0Qx9mAUIkeLU0Vy8oz0tk?usp=sharing" target="_blank" class="font-bold underline hover:text-blue-800 dark:hover:text-blue-300">Gemini này</a> tạo JSON.</li>
                <li>Các link mở ra tab mới; khi các bạn có code JSON đem lại đây dán vào để tạo đề thi.</li>
              </ul>
            </div>

            <textarea name="json_data" id="json-data" rows="12" placeholder='{"title":"...","questions":[{...}]}' class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#1E1E38] text-sm font-mono focus:border-blue-500 dark:focus:border-blue-500 outline-none text-ink dark:text-[#E8E0D0] transition-colors placeholder:text-slate-400 resize-y"></textarea>

            <div class="flex gap-3 text-xs">
              <button type="button" id="btn-paste-sample" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 font-semibold transition">📋 Dán mẫu</button>
              <button type="button" id="btn-validate-json" class="px-3 py-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 font-semibold transition">✓ Kiểm tra JSON</button>
            </div>
            <div id="json-feedback" class="hidden text-xs font-semibold"></div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex justify-between items-center pt-4 border-t border-slate-100 dark:border-slate-800/60">
          <a href="/admin/exams" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">Hủy bỏ</a>
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow-md shadow-blue-500/15 hover:shadow-xl transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Tạo đề thi
          </button>
        </div>

      </form>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ baseUrl, allCategories }}>
  // Tab switching
  const tabBtns = document.querySelectorAll('.tab-btn');
  const manualSection = document.getElementById('manual-section');
  const matrixSection = document.getElementById('matrix-section');
  const jsonSection = document.getElementById('json-section');
  const inputMode = document.getElementById('input-mode');

  function switchTab(target) {
    tabBtns.forEach(b => {
      b.classList.remove('bg-white', 'dark:bg-slate-700', 'text-blue-700', 'dark:text-white', 'shadow-sm');
      b.classList.add('text-slate-500', 'dark:text-slate-400');
    });

    if (target === 'manual-section') {
      manualSection?.classList.remove('hidden');
      matrixSection?.classList.add('hidden');
      jsonSection?.classList.add('hidden');
      if (inputMode) inputMode.value = 'manual';
      document.getElementById('tab-manual')?.classList.add('bg-white', 'dark:bg-slate-700', 'text-blue-700', 'dark:text-white', 'shadow-sm');
      document.getElementById('tab-manual')?.classList.remove('text-slate-500', 'dark:text-slate-400');
    } else if (target === 'matrix-section') {
      manualSection?.classList.add('hidden');
      matrixSection?.classList.remove('hidden');
      jsonSection?.classList.add('hidden');
      if (inputMode) inputMode.value = 'matrix';
      document.getElementById('tab-matrix')?.classList.add('bg-white', 'dark:bg-slate-700', 'text-blue-700', 'dark:text-white', 'shadow-sm');
      document.getElementById('tab-matrix')?.classList.remove('text-slate-500', 'dark:text-slate-400');
    } else {
      manualSection?.classList.add('hidden');
      matrixSection?.classList.add('hidden');
      jsonSection?.classList.remove('hidden');
      if (inputMode) inputMode.value = 'json';
      document.getElementById('tab-json')?.classList.add('bg-white', 'dark:bg-slate-700', 'text-blue-700', 'dark:text-white', 'shadow-sm');
      document.getElementById('tab-json')?.classList.remove('text-slate-500', 'dark:text-slate-400');
    }
  }

  // Attach tab switching events
  if (tabBtns.length) {
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.dataset.target));
    });
    // Default active tab
    switchTab('manual-section');
  }

  // Matrix live counter and presets
  const inputNb = document.getElementById('matrix_nb');
  const inputTh = document.getElementById('matrix_th');
  const inputVd = document.getElementById('matrix_vd');
  const inputVdc = document.getElementById('matrix_vdc');
  const matrixBadge = document.getElementById('matrix-total-badge');
  const inputDuration = document.getElementById('duration');
  const selectExamType = document.getElementById('exam_type');

  function updateMatrixTotal() {
    const nb = parseInt(inputNb?.value || '0', 10) || 0;
    const th = parseInt(inputTh?.value || '0', 10) || 0;
    const vd = parseInt(inputVd?.value || '0', 10) || 0;
    const vdc = parseInt(inputVdc?.value || '0', 10) || 0;
    const total = nb + th + vd + vdc;
    if (matrixBadge) {
      matrixBadge.textContent = `Tổng: ${total} câu`;
    }
  }

  [inputNb, inputTh, inputVd, inputVdc].forEach(el => {
    el?.addEventListener('input', updateMatrixTotal);
  });

  document.getElementById('preset-thpt')?.addEventListener('click', () => {
    if (inputNb) inputNb.value = '16';
    if (inputTh) inputTh.value = '12';
    if (inputVd) inputVd.value = '8';
    if (inputVdc) inputVdc.value = '4';
    if (inputDuration && (!inputDuration.value || inputDuration.value === '15' || inputDuration.value === '45')) inputDuration.value = '50';
    if (selectExamType) selectExamType.value = 'mock_thpt';
    updateMatrixTotal();
  });

  document.getElementById('preset-1tiet')?.addEventListener('click', () => {
    if (inputNb) inputNb.value = '10';
    if (inputTh) inputTh.value = '8';
    if (inputVd) inputVd.value = '5';
    if (inputVdc) inputVdc.value = '2';
    if (inputDuration && (!inputDuration.value || inputDuration.value === '15' || inputDuration.value === '50')) inputDuration.value = '45';
    if (selectExamType) selectExamType.value = '45m';
    updateMatrixTotal();
  });

  document.getElementById('preset-15p')?.addEventListener('click', () => {
    if (inputNb) inputNb.value = '5';
    if (inputTh) inputTh.value = '3';
    if (inputVd) inputVd.value = '2';
    if (inputVdc) inputVdc.value = '0';
    if (inputDuration && (!inputDuration.value || inputDuration.value === '45' || inputDuration.value === '50')) inputDuration.value = '15';
    if (selectExamType) selectExamType.value = '15m';
    updateMatrixTotal();
  });

  // Category dropdown dynamic filter
  function updateCategoryDropdown(subjectId, dropdownId) {
    const sel = document.getElementById(dropdownId);
    if (!sel) return;
    const currentVal = sel.value;
    const cats = Array.isArray(allCategories) ? allCategories : [];
    const filtered = subjectId ? cats.filter(c => c.subject_id === subjectId) : [];
    sel.innerHTML = '<option value="">-- Tất cả / Không phân chuyên mục --</option>';
    filtered.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = c.name;
      if (c.id === currentVal) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  // Manual select: filter by subject, category, and search text
  const subjectSelect = document.getElementById('subject_id');
  const categorySelect = document.getElementById('exam_category_id');
  const noSubjectWarning = document.getElementById('no-subject-warning');
  const noQuestionsWarning = document.getElementById('no-questions-warning');
  const questionsList = document.getElementById('questions-list');
  const questionItems = document.querySelectorAll('.question-checkbox-item');
  const selectedCount = document.getElementById('selected-count');
  const bankSearchBar = document.getElementById('bank-search-bar');
  const bankSearchInput = document.getElementById('bank-search-input');
  const btnSelectAll = document.getElementById('btn-select-all');
  const btnDeselectAll = document.getElementById('btn-deselect-all');

  function updateSelectedCount() {
    const checked = document.querySelectorAll('input[name="question_ids"]:checked').length;
    if (selectedCount) {
      selectedCount.textContent = `${checked} câu đã chọn`;
      selectedCount.classList.toggle('hidden', checked === 0);
    }
  }

  function filterQuestions() {
    const selectedId = subjectSelect?.value;
    const catId = categorySelect?.value;
    const query = (bankSearchInput?.value || '').toLowerCase().trim();
    
    if (noSubjectWarning && noQuestionsWarning && questionsList) {
      if (!selectedId) {
        noSubjectWarning.classList.remove('hidden');
        noQuestionsWarning.classList.add('hidden');
        questionsList.classList.add('hidden');
        bankSearchBar?.classList.add('hidden');
        btnSelectAll?.classList.add('hidden');
        btnDeselectAll?.classList.add('hidden');
        return;
      }

      noSubjectWarning.classList.add('hidden');
      bankSearchBar?.classList.remove('hidden');
      btnSelectAll?.classList.remove('hidden');
      btnDeselectAll?.classList.remove('hidden');

      let visibleCount = 0;
      questionItems.forEach(item => {
        const itemSubId = item.getAttribute('data-subject-id');
        const itemCatId = item.getAttribute('data-category-id');
        const contentText = (item.getAttribute('data-search-text') || item.textContent || '').toLowerCase();
        
        let matches = itemSubId === selectedId;
        if (matches && catId) {
          matches = (itemCatId === catId);
        }
        if (matches && query) {
          matches = contentText.includes(query);
        }
        
        item.classList.toggle('hidden', !matches);
        if (matches) visibleCount++;
      });
      noQuestionsWarning.classList.toggle('hidden', visibleCount > 0);
      questionsList.classList.toggle('hidden', visibleCount === 0);
      updateSelectedCount();
    }
  }

  let lastSubjectId = subjectSelect?.value || '';

  if (subjectSelect) {
    subjectSelect.addEventListener('change', () => {
      const newSubjectId = subjectSelect.value;
      if (newSubjectId !== lastSubjectId) {
        lastSubjectId = newSubjectId;
        // Uncheck all questions only when switching subjects
        document.querySelectorAll('input[name="question_ids"]').forEach(cb => {
          cb.checked = false;
        });
      }
      updateCategoryDropdown(newSubjectId, 'exam_category_id');
      filterQuestions();
    });
  }

  if (categorySelect) {
    categorySelect.addEventListener('change', filterQuestions);
  }

  bankSearchInput?.addEventListener('input', filterQuestions);

  btnSelectAll?.addEventListener('click', () => {
    questionItems.forEach(item => {
      if (!item.classList.contains('hidden')) {
        const cb = item.querySelector('input[type="checkbox"]');
        if (cb) cb.checked = true;
      }
    });
    updateSelectedCount();
  });

  btnDeselectAll?.addEventListener('click', () => {
    questionItems.forEach(item => {
      const cb = item.querySelector('input[type="checkbox"]');
      if (cb) cb.checked = false;
    });
    updateSelectedCount();
  });

  document.querySelectorAll('input[name="question_ids"]').forEach(cb => {
    cb.addEventListener('change', updateSelectedCount);
  });

  // JSON validate
  const jsonData = document.getElementById('json-data');
  const btnValidate = document.getElementById('btn-validate-json');
  const jsonFeedback = document.getElementById('json-feedback');

  if (btnValidate && jsonData && jsonFeedback) {
    btnValidate.addEventListener('click', () => {
      const raw = jsonData.value.trim();
      if (!raw) {
        jsonFeedback.textContent = '⚠️ Vui lòng nhập JSON.';
        jsonFeedback.className = 'text-xs font-semibold text-amber-600 dark:text-amber-400';
        jsonFeedback.classList.remove('hidden');
        return;
      }
      try {
        const parsed = JSON.parse(raw);
        const qs = Array.isArray(parsed) ? parsed : (parsed.questions || []);
        if (!Array.isArray(qs) || qs.length === 0) throw new Error('Thiếu mảng "questions" với ít nhất 1 câu hỏi.');
        jsonFeedback.textContent = `✅ JSON hợp lệ (${qs.length} câu hỏi)`;
        jsonFeedback.className = 'text-xs font-semibold text-emerald-600 dark:text-emerald-400';
        jsonFeedback.classList.remove('hidden');
      } catch (e) {
        jsonFeedback.textContent = `❌ Lỗi: ${e.message}`;
        jsonFeedback.className = 'text-xs font-semibold text-rose-600 dark:text-rose-400';
        jsonFeedback.classList.remove('hidden');
      }
    });
  }

  // Paste sample
  const btnSample = document.getElementById('btn-paste-sample');
  if (btnSample && jsonData) {
    btnSample.addEventListener('click', async () => {
      try {
        const sampleUrl = (baseUrl ? baseUrl : '') + '/sample-questions.json';
        const res = await fetch(sampleUrl);
        if (!res.ok) throw new Error('Fetch failed');
        const text = await res.text();
        jsonData.value = text;
        jsonData.dispatchEvent(new Event('input'));
      } catch {
