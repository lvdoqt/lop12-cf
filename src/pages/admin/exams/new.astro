  const durationInput = document.getElementById('duration') as HTMLInputElement | null;
  const crossSubjectsBox = document.getElementById('cross-subjects-box');

  const ppqInput = document.getElementById('point_per_question') as HTMLInputElement | null;
  const ppSaInput = document.getElementById('point_per_sa') as HTMLInputElement | null;
  const maxScoreInput = document.getElementById('max_score') as HTMLInputElement | null;
  const pickHiddenInput = document.getElementById('pick_per_type') as HTMLInputElement | null;
  const btnClearPick = document.getElementById('btn-clear-pick');

  const inputMode = document.getElementById('input-mode') as HTMLInputElement | null;
  const readyIndicator = document.getElementById('ready-questions-indicator');
  const btnSubmitExam = document.getElementById('btn-submit-exam') as HTMLButtonElement | null;
  const submitExamLabel = document.getElementById('submit-exam-label');

  // Tabs & Shared Gemini Box
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const sharedGeminiBox = document.getElementById('shared-gemini-box');
  const aiSection = document.getElementById('ai-section');
  const fileSection = document.getElementById('file-section');
  const jsonSection = document.getElementById('json-section');

  const apiKeyInput = document.getElementById('gemini-api-key') as HTMLInputElement | null;
  const modelSelect = document.getElementById('gemini-model') as HTMLSelectElement | null;
  const rememberCheckbox = document.getElementById('remember-api-key') as HTMLInputElement | null;
  const keySavedBadge = document.getElementById('key-saved-badge');
  const btnToggleKey = document.getElementById('btn-toggle-key');
  const btnClearKey = document.getElementById('btn-clear-key');

  // AI Matrix elements
  const toggleThreeLevel = document.getElementById('toggle-three-level') as HTMLInputElement | null;
  const thColVdc = document.getElementById('th-col-vdc');
  const colSumVdcEl = document.getElementById('col-sum-vdc');
  const presetNoteEl = document.getElementById('ai-preset-note');
  const totalBadgeEl = document.getElementById('ai-total-badge');
  const scoreBadgeEl = document.getElementById('ai-score-badge');
  const btnApplyPreset = document.getElementById('btn-apply-subject-preset');

  const textbookSelect = document.getElementById('ai-textbook') as HTMLSelectElement | null;
  const topicsInput = document.getElementById('ai-topics') as HTMLInputElement | null;
  const extraNotesInput = document.getElementById('ai-extra-notes') as HTMLInputElement | null;
  const includeDynamicCb = document.getElementById('ai-include-dynamic') as HTMLInputElement | null;

  const promptEditor = document.getElementById('ai-prompt-editor') as HTMLTextAreaElement | null;
  const promptEditedBadge = document.getElementById('prompt-edited-badge');
  const btnResetPrompt = document.getElementById('btn-reset-prompt');
  const btnCopyPrompt = document.getElementById('btn-copy-prompt');
  const btnGenerateAi = document.getElementById('btn-generate-ai') as HTMLButtonElement | null;
  const btnCancelAi = document.getElementById('btn-cancel-ai') as HTMLButtonElement | null;
  const aiBtnIcon = document.getElementById('ai-btn-icon');
  const aiBtnLabel = document.getElementById('ai-btn-label');
  const aiStatusMsg = document.getElementById('ai-status-msg');
  const aiSaWarnings = document.getElementById('ai-sa-warnings');
  const aiResultPanel = document.getElementById('ai-result-panel');
  const aiResultSummary = document.getElementById('ai-result-summary');
  const aiResultList = document.getElementById('ai-result-list');
  const btnEditInJsonTab = document.getElementById('btn-edit-in-json-tab');

  // Word / PDF Import elements
  const mainFileInput = document.getElementById('exam-main-file') as HTMLInputElement | null;
  const answerFileInput = document.getElementById('exam-answer-file') as HTMLInputElement | null;
  const dropzoneMain = document.getElementById('dropzone-main-file');
  const dropzoneAnswer = document.getElementById('dropzone-answer-file');
  const mainFileBadge = document.getElementById('main-file-badge');
  const answerFileBadge = document.getElementById('answer-file-badge');
  const btnClearAnswerFile = document.getElementById('btn-clear-answer-file');
  const fileAnswerStrategy = document.getElementById('file-answer-strategy') as HTMLSelectElement | null;
  const fileGenExplanation = document.getElementById('file-gen-explanation') as HTMLInputElement | null;
  const fileAutoCrop = document.getElementById('file-auto-crop') as HTMLInputElement | null;
  const btnExtractFile = document.getElementById('btn-extract-file') as HTMLButtonElement | null;
  const btnCancelFile = document.getElementById('btn-cancel-file') as HTMLButtonElement | null;
  const fileBtnIcon = document.getElementById('file-btn-icon');
  const fileBtnLabel = document.getElementById('file-btn-label');
  const fileStatusText = document.getElementById('file-status-text');
  const fileProgressBarWrap = document.getElementById('file-progress-bar-wrap');
  const fileProgressBar = document.getElementById('file-progress-bar');
  const fileWarningsBanner = document.getElementById('file-warnings-banner');
  const fileSplitReview = document.getElementById('file-split-review');
  const fileSummaryTitle = document.getElementById('file-summary-title');
  const fileQuestionsList = document.getElementById('file-questions-list');
  const btnSyncFileToJson = document.getElementById('btn-sync-file-to-json');

  // PDF Viewer & Manual Cropper
  const pdfPageControls = document.getElementById('pdf-page-controls');
  const btnPdfPrev = document.getElementById('btn-pdf-prev') as HTMLButtonElement | null;
  const btnPdfNext = document.getElementById('btn-pdf-next') as HTMLButtonElement | null;
  const pdfPageLabel = document.getElementById('pdf-page-label');
  const pdfViewerWrap = document.getElementById('pdf-viewer-wrap');
  const pdfCanvasStage = document.getElementById('pdf-canvas-stage');
  const pdfReviewCanvas = document.getElementById('pdf-review-canvas') as HTMLCanvasElement | null;
  const pdfCropRect = document.getElementById('pdf-crop-rect');
  const pdfCropHint = document.getElementById('pdf-crop-hint');
  const pdfCropTargetLabel = document.getElementById('pdf-crop-target-label');
  const btnCancelCropMode = document.getElementById('btn-cancel-crop-mode');
  const docxViewerWrap = document.getElementById('docx-viewer-wrap');

  // JSON Tab
  const jsonDataEl = document.getElementById('json-data') as HTMLTextAreaElement | null;
  const jsonFeedbackEl = document.getElementById('json-feedback');
  const btnPasteSample = document.getElementById('btn-paste-sample');
  const btnPasteDynamic = document.getElementById('btn-paste-dynamic-sample');
  const btnValidateJson = document.getElementById('btn-validate-json');
  const btnPreviewDynamic = document.getElementById('btn-preview-dynamic');
  const btnRerollDynamic = document.getElementById('btn-reroll-dynamic');
  const btnClosePreview = document.getElementById('btn-close-preview');
  const previewPanel = document.getElementById('dynamic-preview-panel');
  const previewList = document.getElementById('dynamic-preview-list');

  let isPromptManuallyEdited = false;
  let activeAbortController: AbortController | null = null;
  let timerInterval: number | null = null;

  // File Import Runtime State
  let selectedMainFile: File | null = null;
  let selectedAnswerFile: File | null = null;
  let importedQuestionsState: ImportedExamQuestion[] = [];
  let importedTitleState: string | undefined;
  let activePdfController: PdfDocumentController | null = null;
  let currentPdfPage = 1;
  let currentFileFilter: 'all' | 'missing' | 'figure' = 'all';
  let activeCropQuestionIdx: number | null = null;
  let isUploadingPendingImages = false;

  function escapeHtml(str: string): string {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderMath(container: HTMLElement | null) {
    if (!container) return;
    const renderMathInElement = (window as any).renderMathInElement;
    if (typeof renderMathInElement === 'function') {
      try {
        renderMathInElement(container, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false },
            { left: '\\(', right: '\\)', display: false },
            { left: '\\[', right: '\\]', display: true },
          ],
          throwOnError: false,
        });
      } catch { /* ignore */ }
    }
  }

  // ── 1. Visual pick_per_type Sync ──────────────────────────────────────────
  function hydrateVisualPickFromHidden() {
    if (!pickHiddenInput?.value.trim()) return;
    try {
      const obj = JSON.parse(pickHiddenInput.value);
      document.querySelectorAll<HTMLInputElement>('.visual-pick-input').forEach(inp => {
        const k = inp.dataset.pickKey || '';
        if (obj && typeof obj[k] === 'number' && obj[k] > 0) inp.value = String(obj[k]);
      });
    } catch { /* ignore */ }
  }

  function syncVisualPickToHidden() {
    if (!pickHiddenInput) return;
    const out: Record<string, number> = {};
    document.querySelectorAll<HTMLInputElement>('.visual-pick-input').forEach(inp => {
      const k = inp.dataset.pickKey || '';
      const v = parseInt(inp.value || '', 10);
      if (k && !Number.isNaN(v) && v > 0) out[k] = v;
    });
    pickHiddenInput.value = Object.keys(out).length > 0 ? JSON.stringify(out) : '';
  }

  document.querySelectorAll('.visual-pick-input').forEach(inp => inp.addEventListener('input', syncVisualPickToHidden));
  btnClearPick?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('.visual-pick-input').forEach(inp => { inp.value = ''; });
    syncVisualPickToHidden();
  });
  hydrateVisualPickFromHidden();

  // ── 2. Tabs (3 Modes: ai | file | json) ───────────────────────────────────
  function switchTab(target: 'ai-section' | 'file-section' | 'json-section') {
    tabBtns.forEach(b => {
      b.classList.remove('bg-white', 'dark:bg-slate-700', 'text-indigo-700', 'dark:text-white', 'shadow-sm');
      b.classList.add('text-slate-500', 'dark:text-slate-400');
    });

    aiSection?.classList.toggle('hidden', target !== 'ai-section');
    fileSection?.classList.toggle('hidden', target !== 'file-section');
    jsonSection?.classList.toggle('hidden', target !== 'json-section');
    sharedGeminiBox?.classList.toggle('hidden', target === 'json-section');

    const modeVal = target === 'file-section' ? 'file' : target === 'json-section' ? 'json' : 'ai';
    if (inputMode) inputMode.value = modeVal;

    const btnId = target === 'file-section' ? 'tab-file' : target === 'json-section' ? 'tab-json' : 'tab-ai';
    const activeBtn = document.getElementById(btnId);
    activeBtn?.classList.add('bg-white', 'dark:bg-slate-700', 'text-indigo-700', 'dark:text-white', 'shadow-sm');
    activeBtn?.classList.remove('text-slate-500', 'dark:text-slate-400');
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.target;
      if (t === 'file-section' || t === 'json-section') switchTab(t);
      else switchTab('ai-section');
    });
  });

  switchTab(
    inputMode?.value === 'file'
      ? 'file-section'
      : inputMode?.value === 'json'
        ? 'json-section'
        : 'ai-section'
  );

  // ── 3. Gemini API Key LocalStorage ────────────────────────────────────────
  try {
    const savedKey = localStorage.getItem(STORAGE_KEY_GEMINI);
    if (savedKey && apiKeyInput) {
      apiKeyInput.value = savedKey;
      keySavedBadge?.classList.remove('hidden');
    }
    const savedModel = localStorage.getItem(STORAGE_KEY_MODEL);
    if (savedModel && modelSelect) modelSelect.value = savedModel;
  } catch { /* ignore */ }

  function syncApiKeyStorage() {
    try {
      if (rememberCheckbox?.checked && apiKeyInput?.value.trim()) {
        localStorage.setItem(STORAGE_KEY_GEMINI, apiKeyInput.value.trim());
      } else if (!rememberCheckbox?.checked) {
        localStorage.removeItem(STORAGE_KEY_GEMINI);
      }
      if (modelSelect?.value) localStorage.setItem(STORAGE_KEY_MODEL, modelSelect.value);
    } catch { /* ignore */ }
  }

  apiKeyInput?.addEventListener('change', syncApiKeyStorage);
  rememberCheckbox?.addEventListener('change', syncApiKeyStorage);
  modelSelect?.addEventListener('change', syncApiKeyStorage);

  btnToggleKey?.addEventListener('click', () => {
    if (!apiKeyInput || !btnToggleKey) return;
    const isHidden = apiKeyInput.type === 'password';
    apiKeyInput.type = isHidden ? 'text' : 'password';
    btnToggleKey.textContent = isHidden ? 'Ẩn' : 'Hiện';
  });

  btnClearKey?.addEventListener('click', () => {
    if (apiKeyInput) apiKeyInput.value = '';
    keySavedBadge?.classList.add('hidden');
    try { localStorage.removeItem(STORAGE_KEY_GEMINI); } catch { /* ignore */ }
  });

  // ── 4. Category & Cross-Subject UI ────────────────────────────────────────
  function updateCategoryDropdown(subjectId: string) {
    if (!categorySelect) return;
    const currentVal = categorySelect.value || categorySelect.dataset.initial || '';
    const filtered = subjectId ? allCategories.filter(c => c.subject_id === subjectId) : [];
    categorySelect.innerHTML = '<option value="">-- Tất cả / Không phân chuyên mục --</option>';
    filtered.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = c.name;
      if (c.id === currentVal) opt.selected = true;
      categorySelect.appendChild(opt);
    });
    categorySelect.dataset.initial = '';
  }

  function updateCrossSubjectsVisibility() {
    const prog = examProgramSelect?.value || 'mock_thpt';
    const isCross = prog === 'dgnl_hsa' || prog === 'dgnl_vact' || prog === 'dgtd_tsa';
    crossSubjectsBox?.classList.toggle('hidden', !isCross);
  }

  function getSelectedCrossSubjects(): string[] {
    const prog = examProgramSelect?.value || 'mock_thpt';
    if (prog !== 'dgnl_hsa' && prog !== 'dgnl_vact' && prog !== 'dgtd_tsa') return [];
    const checked: string[] = [];
    document.querySelectorAll<HTMLInputElement>('.cross-subject-cb:checked').forEach(cb => checked.push(cb.value));
    return checked;
  }

  function getSelectedSubjectName(): string {
    if (!subjectSelect) return '';
    const opt = subjectSelect.options[subjectSelect.selectedIndex];
    if (!opt || !opt.value) return '';
    return opt.dataset.name || opt.textContent?.trim() || '';
  }

  // ── 5. 2D Matrix & AI Generation (Tab 1) ──────────────────────────────────
  function getCellInput(row: MatrixRowKey, lvl: 'nb' | 'th' | 'vd' | 'vdc'): HTMLInputElement | null {
    return document.querySelector<HTMLInputElement>(`input.m2d-cell[data-m2d-row="${row}"][data-m2d-lvl="${lvl}"]`);
  }

  function readMatrix2DFromDom(): ExamMatrix2D {
    const m = createEmptyMatrix2D();
    const is3Lvl = Boolean(toggleThreeLevel?.checked);
    for (const rKey of MATRIX_ROW_KEYS) {
      const nb = Math.max(0, parseInt(getCellInput(rKey, 'nb')?.value || '0', 10) || 0);
      const th = Math.max(0, parseInt(getCellInput(rKey, 'th')?.value || '0', 10) || 0);
      const vd = Math.max(0, parseInt(getCellInput(rKey, 'vd')?.value || '0', 10) || 0);
      const vdc = is3Lvl ? 0 : Math.max(0, parseInt(getCellInput(rKey, 'vdc')?.value || '0', 10) || 0);
      m[rKey] = { nb, th, vd, vdc };
    }
    return m;
  }

  function writeMatrix2DToDom(m: ExamMatrix2D) {
    for (const rKey of MATRIX_ROW_KEYS) {
      const cell = m[rKey] || { nb: 0, th: 0, vd: 0, vdc: 0 };
      const iNb = getCellInput(rKey, 'nb');
      const iTh = getCellInput(rKey, 'th');
      const iVd = getCellInput(rKey, 'vd');
      const iVdc = getCellInput(rKey, 'vdc');
      if (iNb) iNb.value = String(cell.nb || 0);
      if (iTh) iTh.value = String(cell.th || 0);
      if (iVd) iVd.value = String(cell.vd || 0);
      if (iVdc) iVdc.value = String(cell.vdc || 0);
    }
  }

  function applyThreeLevelColumnToggle() {
    const is3Lvl = Boolean(toggleThreeLevel?.checked);
    thColVdc?.classList.toggle('hidden', is3Lvl);
    colSumVdcEl?.classList.toggle('hidden', is3Lvl);
    document.querySelectorAll('.td-col-vdc').forEach(td => td.classList.toggle('hidden', is3Lvl));
    if (is3Lvl) {
      for (const rKey of MATRIX_ROW_KEYS) {
        const iVd = getCellInput(rKey, 'vd');
        const iVdc = getCellInput(rKey, 'vdc');
        const vdcVal = parseInt(iVdc?.value || '0', 10) || 0;
        if (vdcVal > 0 && iVd && iVdc) {
          iVd.value = String((parseInt(iVd.value || '0', 10) || 0) + vdcVal);
          iVdc.value = '0';
        }
      }
    }
  }

  function refreshMatrixSummaryAndPrompt(forcePrompt = false) {
    const m2d = readMatrix2DFromDom();
    const prog = (examProgramSelect?.value || 'mock_thpt') as ExamTypeKey;
    const ppq = parseFloat(ppqInput?.value || '0.25') || 0.25;
    const ppSa = parseFloat(ppSaInput?.value || '0.5') || 0.5;
    const maxSc = parseFloat(maxScoreInput?.value || '10') || 10;

    const sum = summarize2DMatrix(m2d, { pointPerQuestion: ppq, pointPerSa: ppSa, isVsat: prog === 'vsat' });
    for (const rKey of MATRIX_ROW_KEYS) {
      const el = document.getElementById(`row-sum-${rKey}`);
      if (el) el.textContent = String(sum.rowTotals[rKey]);
    }
    const cNb = document.getElementById('col-sum-nb');
    const cTh = document.getElementById('col-sum-th');
    const cVd = document.getElementById('col-sum-vd');
    const cVdc = document.getElementById('col-sum-vdc');
    const cGrand = document.getElementById('matrix-grand-total');
    if (cNb) cNb.textContent = String(sum.colTotals.nb);
    if (cTh) cTh.textContent = String(sum.colTotals.th);
    if (cVd) cVd.textContent = String(sum.colTotals.vd);
    if (cVdc) cVdc.textContent = String(sum.colTotals.vdc);
    if (cGrand) cGrand.textContent = String(sum.totalBlocks);

    if (totalBadgeEl) {
      totalBadgeEl.textContent = sum.totalEffectiveItems !== sum.totalBlocks
        ? `${sum.totalBlocks} mục (~${sum.totalEffectiveItems} câu)`
        : `${sum.totalBlocks} câu`;
    }
    if (scoreBadgeEl) {
      const tlNote = sum.rowTotals.tl > 0 ? ` + ${sum.rowTotals.tl} câu TL` : '';
      scoreBadgeEl.textContent = `TN: ${sum.estimatedObjectiveScore}đ${tlNote}`;
    }

    if ((forcePrompt || !isPromptManuallyEdited) && promptEditor) {
      promptEditor.value = buildExamPrompt({
        subjectName: getSelectedSubjectName(),
        crossSubjects: getSelectedCrossSubjects(),
        examType: prog,
        duration: parseInt(durationInput?.value || '50', 10) || 50,
        textbook: textbookSelect?.value || 'all',
        topics: topicsInput?.value || '',
        threeLevelMode: Boolean(toggleThreeLevel?.checked),
        matrix2d: m2d,
        pointPerQuestion: ppq,
        pointPerSa: ppSa,
        maxScore: maxSc,
        includeDynamicMath: Boolean(includeDynamicCb?.checked),
        extraNotes: extraNotesInput?.value || '',
      });
      if (forcePrompt) {
        isPromptManuallyEdited = false;
        promptEditedBadge?.classList.add('hidden');
      }
    }
  }

  function applyRecommendedSubjectPreset() {
    updateCrossSubjectsVisibility();
    const preset = getRecommendedPreset(getSelectedSubjectName(), (examProgramSelect?.value || 'mock_thpt') as ExamTypeKey);
    if (toggleThreeLevel) toggleThreeLevel.checked = preset.threeLevelMode;
    writeMatrix2DToDom(preset.matrix2d);
    applyThreeLevelColumnToggle();
    if (durationInput) durationInput.value = String(preset.duration);
    if (ppqInput) ppqInput.value = String(preset.pointPerQuestion);
    if (ppSaInput) ppSaInput.value = String(preset.pointPerSa);
    if (maxScoreInput) maxScoreInput.value = String(preset.maxScore);
    if (presetNoteEl) presetNoteEl.textContent = `💡 ${preset.note}`;
    refreshMatrixSummaryAndPrompt(true);
  }

  subjectSelect?.addEventListener('change', () => {
    updateCategoryDropdown(subjectSelect.value);
    applyRecommendedSubjectPreset();
  });
