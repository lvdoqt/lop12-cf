  btnExtractFile?.addEventListener('click', async () => {
    if (!subjectSelect?.value) {
      alert('Vui lòng chọn Môn học chính ở trên trước khi bóc tách đề.');
      subjectSelect?.focus();
      return;
    }
    if (!selectedMainFile) {
      alert('Vui lòng chọn tệp Đề thi (.pdf hoặc .docx).');
      return;
    }
    const apiKey = apiKeyInput?.value.trim() || '';
    if (!apiKey) {
      alert('Vui lòng nhập Gemini API Key ở khung Kết nối Google Gemini API phía trên.');
      apiKeyInput?.focus();
      return;
    }
    syncApiKeyStorage();

    if (activePdfController) {
      activePdfController.destroy();
      activePdfController = null;
    }

    activeAbortController = new AbortController();
    if (btnExtractFile) btnExtractFile.disabled = true;
    btnCancelFile?.classList.remove('hidden');
    fileProgressBarWrap?.classList.remove('hidden');
    if (fileBtnIcon) fileBtnIcon.textContent = '⏳';
    if (fileBtnLabel) fileBtnLabel.textContent = 'Đang đọc & số hóa đề thi...';

    try {
      const res = await extractExamFromFilesWithGemini({
        apiKey,
        model: modelSelect?.value || 'gemini-2.5-flash',
        mainFile: selectedMainFile,
        answerFile: selectedAnswerFile,
        subjectName: getSelectedSubjectName(),
        answerStrategy: ((fileAnswerStrategy?.value || 'extract_or_solve') as AnswerImportStrategy),
        generateExplanations: Boolean(fileGenExplanation?.checked),
        autoCropPdfFigures: Boolean(fileAutoCrop?.checked),
        signal: activeAbortController.signal,
        onProgress: (p) => {
          if (fileStatusText) fileStatusText.textContent = p.message;
          if (fileProgressBar) fileProgressBar.style.width = p.step === 1 ? '30%' : p.step === 2 ? '72%' : '95%';
        },
      });

      importedQuestionsState = res.questions;
      importedTitleState = res.title;
      if (titleInput && !titleInput.value.trim() && res.title) {
        titleInput.value = res.title;
      }

      const allWarns = [...res.warnings, ...res.saWarnings];
      if (fileWarningsBanner) {
        if (allWarns.length > 0) {
          fileWarningsBanner.innerHTML = `<p class="font-extrabold">⚠️ Lưu ý khi đọc tài liệu:</p><ul class="list-disc pl-4 space-y-0.5">${allWarns.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul>`;
          fileWarningsBanner.classList.remove('hidden');
        } else {
          fileWarningsBanner.classList.add('hidden');
        }
      }

      if (res.pdfController) {
        activePdfController = res.pdfController;
        currentPdfPage = 1;
        pdfViewerWrap?.classList.remove('hidden');
        pdfPageControls?.classList.remove('hidden');
        docxViewerWrap?.classList.add('hidden');
        await renderCurrentPdfPage();
      } else {
        pdfViewerWrap?.classList.add('hidden');
        pdfPageControls?.classList.add('hidden');
        if (docxViewerWrap) {
          docxViewerWrap.textContent = res.docxRawPreview || '';
          docxViewerWrap.classList.remove('hidden');
        }
      }

      syncDraftImportedJson();
      fileSplitReview?.classList.remove('hidden');
      renderFileSplitQuestionsList();

      if (fileProgressBar) fileProgressBar.style.width = '100%';
      if (fileStatusText) fileStatusText.textContent = `✅ Đã bóc tách thành công ${res.questions.length} mục câu hỏi! Đối chiếu bên dưới rồi bấm "Tạo đề thi".`;
    } catch (err: any) {
      if (fileStatusText) {
        fileStatusText.textContent = err?.name === 'AbortError' ? '⚠️ Đã hủy bóc tách tệp.' : `❌ ${err?.message}`;
      }
    } finally {
      activeAbortController = null;
      if (btnExtractFile) btnExtractFile.disabled = false;
      btnCancelFile?.classList.add('hidden');
      if (fileBtnIcon) fileBtnIcon.textContent = '📄';
      if (fileBtnLabel) fileBtnLabel.textContent = 'Bóc tách lại từ File';
    }
  });

  btnCancelFile?.addEventListener('click', () => activeAbortController?.abort());

  btnSyncFileToJson?.addEventListener('click', async () => {
    if (importedQuestionsState.length > 0) {
      btnSyncFileToJson.textContent = '⏳ Đang tải ảnh & chuyển sang JSON...';
      const finalJson = await uploadPendingImagesAndSerialize(importedQuestionsState, baseUrl, importedTitleState);
      if (jsonDataEl) jsonDataEl.value = finalJson;
      btnSyncFileToJson.textContent = '🧩 Mở xem trên Tab JSON →';
    }
    switchTab('json-section');
  });

  // ── 7. Form Submit Handler (Uploads pending cropped figures before POST) ──
  formEl?.addEventListener('submit', async (e) => {
    syncVisualPickToHidden();

    const hasPendingBlobs = importedQuestionsState.some(q => Boolean(q._pendingBlob));
    if (hasPendingBlobs && !isUploadingPendingImages) {
      e.preventDefault();
      isUploadingPendingImages = true;
      if (btnSubmitExam) btnSubmitExam.disabled = true;
      if (submitExamLabel) submitExamLabel.textContent = '☁️ Đang tải hình vẽ lên máy chủ...';

      try {
        const finalJson = await uploadPendingImagesAndSerialize(importedQuestionsState, baseUrl, importedTitleState);
        if (jsonDataEl) jsonDataEl.value = finalJson;
        formEl.submit();
      } catch (err: any) {
        isUploadingPendingImages = false;
        if (btnSubmitExam) btnSubmitExam.disabled = false;
        if (submitExamLabel) submitExamLabel.textContent = 'Tạo đề thi';
        alert(`Lỗi tải ảnh minh họa: ${err?.message}`);
      }
      return;
    }

    const rawJson = jsonDataEl?.value.trim() || '';
    if (!rawJson) {
      e.preventDefault();
      if (inputMode?.value === 'file') {
        alert('Vui lòng chọn file Word/PDF và nhấn "📄 Bóc tách Đề thi từ File" trước khi lưu.');
        btnExtractFile?.focus();
      } else if (inputMode?.value === 'ai') {
        alert('Vui lòng nhấn "✨ Tạo câu hỏi bằng Gemini AI" trước khi lưu đề thi.');
        btnGenerateAi?.focus();
      } else {
        alert('Vui lòng dán dữ liệu JSON câu hỏi trước khi tạo đề thi.');
        jsonDataEl?.focus();
      }
    }
  });

  // ── 8. JSON Tab Utilities ─────────────────────────────────────────────────
  const DYNAMIC_MATH_SAMPLE = {
    question_type_id: 'Math-10-11-12',
    questions: [
      {
        type: 'mcq',
        question: 'Cho hàm số $y = !a#0!x^2 + !b:1:15!x - !c(2,4,6)!$. Tính $y(1) = !a! + !b! - !c!$.',
        option_a: '{tinh: !a! + !b! - !c!}',
        option_b: '{tinh: !a! + !b! + !c!}',
        option_c: '{tinh: !a! - !b! - !c!}',
        option_d: '{tinh: !a! + !b! - !c! + 3}',
        correct_option: 'A',
        explanation: 'Thay $x = 1$ được $y(1) = {tinh: !a! + !b! - !c!}$.',
        difficulty_level: 'medium',
        is_dynamic: true,
      },
    ],
  };

  jsonDataEl?.addEventListener('input', updateReadyQuestionsIndicator);

  btnValidateJson?.addEventListener('click', () => {
    if (!jsonDataEl || !jsonFeedbackEl) return;
    const raw = jsonDataEl.value.trim();
    if (!raw) return;
    try {
      const parsed = parseAiExamJson(raw);
      const warnHtml = parsed.saWarnings.length > 0
        ? `<div class="mt-1 text-amber-600">⚠️ ${parsed.saWarnings.map(escapeHtml).join(' | ')}</div>`
        : '';
      jsonFeedbackEl.innerHTML = `<div class="text-emerald-600">✅ JSON hợp lệ (${parsed.questions.length} mục câu hỏi)</div>${warnHtml}`;
      jsonFeedbackEl.classList.remove('hidden');
      updateReadyQuestionsIndicator();
    } catch (e: any) {
      jsonFeedbackEl.textContent = `❌ Lỗi: ${e.message}`;
      jsonFeedbackEl.className = 'text-xs font-semibold text-rose-600';
      jsonFeedbackEl.classList.remove('hidden');
    }
  });

  btnPasteSample?.addEventListener('click', async () => {
    if (!jsonDataEl) return;
    try {
      const res = await fetch(`${baseUrl}/sample-questions.json`);
      jsonDataEl.value = res.ok ? await res.text() : JSON.stringify(DYNAMIC_MATH_SAMPLE, null, 2);
    } catch {
      jsonDataEl.value = JSON.stringify(DYNAMIC_MATH_SAMPLE, null, 2);
    }
    updateReadyQuestionsIndicator();
  });

  function renderDynamicPreview() {
    if (!jsonDataEl || !previewPanel || !previewList) return;
    try {
      const qs = parseAiExamJson(jsonDataEl.value).questions;
      const dynamicQs = qs.filter((q: any) => Boolean(q?.is_dynamic || q?.metadata?.is_dynamic));
      if (dynamicQs.length === 0) {
        previewPanel.classList.add('hidden');
        return;
      }
      previewList.innerHTML = dynamicQs.map((q: any, idx: number) => {
        const opts = [q.option_a, q.option_b, q.option_c, q.option_d].filter(Boolean);
        const res = instantiateDynamicTemplate(
          { type: q.type || 'mcq', content: q.question || q.content || '', options: opts, answer: q.correct_option || null, explanation: q.explanation || null },
          () => Math.random()
        );
        return `<div class="p-3 rounded-xl bg-white dark:bg-[#1E1E38] border border-slate-200 dark:border-slate-700 text-xs">
          <strong>#${idx + 1}:</strong> ${escapeHtml(res.content)}
        </div>`;
      }).join('');
      previewPanel.classList.remove('hidden');
      renderMath(previewList);
    } catch { /* ignore */ }
  }

  btnPasteDynamic?.addEventListener('click', () => {
    if (!jsonDataEl) return;
    jsonDataEl.value = JSON.stringify(DYNAMIC_MATH_SAMPLE, null, 2);
    updateReadyQuestionsIndicator();
    renderDynamicPreview();
  });
  btnPreviewDynamic?.addEventListener('click', renderDynamicPreview);
  btnRerollDynamic?.addEventListener('click', renderDynamicPreview);
  btnClosePreview?.addEventListener('click', () => previewPanel?.classList.add('hidden'));

  // ── Boot ──────────────────────────────────────────────────────────────────
  if (subjectSelect?.value) updateCategoryDropdown(subjectSelect.value);
  applyRecommendedSubjectPreset();
  updateReadyQuestionsIndicator();
</script>
