    fileQuestionsList.querySelectorAll<HTMLButtonElement>('.btn-remove-fig').forEach(btn => {
      btn.addEventListener('click', () => {
        const i = parseInt(btn.dataset.delImg || '-1', 10);
        if (importedQuestionsState[i]) {
          delete importedQuestionsState[i]._pendingBlob;
          delete importedQuestionsState[i]._previewUrl;
          delete importedQuestionsState[i].image_url;
          syncDraftImportedJson();
          renderFileSplitQuestionsList();
        }
      });
    });

    renderMath(fileQuestionsList);
  }

