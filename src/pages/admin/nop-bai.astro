---
import Layout from '../../layouts/Layout.astro';
import {
  getNopBaiAdminClient,
  getClasses,
  listSubmissions,
  type NopBaiClass,
  type NopBaiSubmission,
} from '../../services/nopBai';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'teacher')) {
  return Astro.redirect('/dashboard');
}

const runtimeEnv = Astro.locals.runtimeEnv;
const client = getNopBaiAdminClient(runtimeEnv);

const isAdmin = user.role === 'admin';

// Lấy danh sách lớp và bài nộp:
// - Giáo viên: chỉ thấy và quản lý lớp do chính mình tạo (createdBy === user.id) và bài nộp của lớp đó
// - Admin: thấy và toàn quyền quản lý tất cả các lớp của mọi giáo viên
const classes: NopBaiClass[] = await getClasses(
  client,
  isAdmin ? { isAdmin: true } : { teacherId: user.id }
);

const allowedClassNames = isAdmin ? undefined : classes.map(c => c.name);
const submissions: NopBaiSubmission[] = await listSubmissions(client, { allowedClassNames });

// Thống kê nhanh
const totalSubmissions = submissions.length;
const totalClasses = classes.length;
const uniqueStudents = new Set(submissions.map(s => `${s.studentName}-${s.className}`.toLowerCase())).size;

// Đếm bài nộp theo lớp
const classSubmissionCountMap: Record<string, number> = {};
submissions.forEach(s => {
  const c = s.className || 'Khác';
  classSubmissionCountMap[c] = (classSubmissionCountMap[c] || 0) + 1;
});
const pageBaseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
---

<Layout title="Quản Lý Nộp Bài & Lớp Học - Admin" description="Quản lý danh sách lớp học và theo dõi bài nộp của học sinh">
  <div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col">
    <!-- Header -->
    <header class="border-b border-slate-800 bg-slate-900/60 backdrop-blur-md sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/admin" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
          </a>
          <div>
            <h1 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <span>Quản Lý Nộp Bài & Lớp Học</span>
              <span class={`text-xs px-2.5 py-0.5 rounded-full font-semibold border ${
                isAdmin
                  ? 'bg-purple-500/20 text-purple-300 border-purple-500/30'
                  : 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30'
              }`}>
                {isAdmin ? 'Quản trị viên (Toàn quyền tất cả các lớp)' : `Giáo viên (${classes.length} lớp của bạn)`}
              </span>
            </h1>
            <p class="text-[11px] text-slate-400">
              {isAdmin
                ? 'Quyền Quản trị viên: Quản lý toàn bộ các lớp của tất cả giáo viên và xem mọi bài nộp.'
                : 'Mỗi giáo viên chỉ quản lý các lớp do chính mình tạo; giáo viên khác không thấy và không sửa được.'}
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/nop-bai"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Mở trang /nop-bai</span>
          </a>
        </div>
      </div>
    </header>

    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6 flex-1">
      
      <!-- Stats Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-400 font-medium">Tổng bài nộp</p>
            <p class="text-xl sm:text-2xl font-black text-white">{totalSubmissions}</p>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-400 font-medium">Lớp học quản lý</p>
            <p class="text-xl sm:text-2xl font-black text-white">{totalClasses}</p>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-400 font-medium">Học sinh đã nộp</p>
            <p class="text-xl sm:text-2xl font-black text-white">{uniqueStudents}</p>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-slate-400 font-medium">Supabase Storage</p>
            <p class="text-xs font-bold text-amber-300 mt-1">Bucket: nop-bai</p>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="tab-btn-submissions"
            class="px-4 py-2 rounded-xl text-sm font-bold bg-indigo-600 text-white shadow-sm transition"
          >
            📋 Danh Sách Bài Nộp ({totalSubmissions})
          </button>
          <button
            type="button"
            id="tab-btn-classes"
            class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition"
          >
            🏫 Quản Lý Lớp Học ({totalClasses})
          </button>
        </div>

        <!-- Add class button -->
        <button
          type="button"
          id="btn-open-create-class-modal"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>Tạo lớp mới</span>
        </button>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 1: DANH SÁCH BÀI NỘP -->
      <!-- ============================================================ -->
      <section id="tab-section-submissions" class="space-y-4">
        <!-- Filter bar -->
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row gap-3 items-center justify-between">
          <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
            <!-- Filter by class -->
            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-400 font-medium">Lớp:</span>
              <select
                id="filter-class-select"
                class="bg-slate-950 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500"
              >
                <option value="all">Tất cả các lớp ({totalSubmissions})</option>
                {classes.map(c => (
                  <option value={c.name}>
                    Lớp {c.name} ({classSubmissionCountMap[c.name] || 0} bài)
                  </option>
                ))}
              </select>
            </div>

            <!-- Search student name -->
            <div class="relative flex-1 sm:w-64">
              <input
                id="filter-search-input"
                type="text"
                placeholder="Tìm tên học sinh hoặc nội dung..."
                class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-1.5 pl-8 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500"
              />
              <svg class="w-4 h-4 text-slate-500 absolute left-2.5 top-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>

          <div class="text-xs text-slate-400 self-end sm:self-center">
            Hiển thị <span id="visible-submission-count" class="font-bold text-white">{totalSubmissions}</span> bài
          </div>
        </div>

        <!-- Submissions Table / Cards -->
        {submissions.length === 0 ? (
          <div class="p-12 text-center rounded-2xl bg-slate-900/40 border border-slate-800 text-slate-400 space-y-3">
            <div class="w-16 h-16 rounded-full bg-slate-800 mx-auto flex items-center justify-center text-slate-500">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <p class="font-semibold text-slate-300">
              {classes.length === 0
                ? 'Bạn chưa có lớp học nào'
                : 'Chưa có bài nộp nào trong các lớp bạn quản lý'}
            </p>
            <p class="text-xs max-w-sm mx-auto">
              {classes.length === 0
                ? 'Hãy bấm nút "Tạo lớp mới" ở phía trên để thêm lớp của bạn. Học sinh sẽ chọn lớp đó để nộp bài.'
                : 'Học sinh có thể truy cập trang /nop-bai để chọn lớp và gửi bài tập.'}
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="submissions-grid">
            {submissions.map((sub) => (
              <div
                class="submission-card p-5 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between shadow-sm relative group"
                data-class-name={sub.className}
                data-student-name={sub.studentName}
                data-content={sub.content}
              >
                <!-- Card Header -->
                <div>
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <div>
                      <h3 class="font-bold text-base text-white flex items-center gap-1.5">
                        <span>{sub.studentName}</span>
                      </h3>
                      <div class="flex items-center gap-2 mt-1">
                        <span class="text-xs px-2 py-0.5 rounded-md font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                          Lớp {sub.className}
                        </span>
                        <!-- Submission count badge -->
                        <span class="text-xs px-2 py-0.5 rounded-md font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                          Lần {sub.submissionCount}
                        </span>
                      </div>
                    </div>

                    <!-- Delete button -->
                    <button
                      type="button"
                      data-id={sub.id}
                      class="btn-delete-sub p-1.5 rounded-lg text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 transition"
                      title="Xóa bài nộp này"
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>

                  <!-- Content Preview -->
                  {sub.content && (
                    <div class="text-xs text-slate-300 bg-slate-950/60 p-3 rounded-xl border border-slate-800/80 mb-3 whitespace-pre-wrap line-clamp-4 leading-relaxed font-sans">
                      {sub.content}
                    </div>
                  )}

                  <!-- Image Attachments -->
                  {sub.images && sub.images.length > 0 && (
                    <div class="space-y-1.5 mb-3">
                      <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                        Ảnh đính kèm ({sub.images.length})
                      </p>
                      <div class="grid grid-cols-3 gap-2">
                        {sub.images.map((img, idx) => (
                          <div class="aspect-square rounded-lg overflow-hidden border border-slate-800 bg-slate-950 cursor-pointer hover:opacity-90 transition relative group/img">
                            <img
                              src={img.url}
                              alt={`Ảnh ${idx + 1}`}
                              loading="lazy"
                              class="w-full h-full object-cover admin-zoom-img"
                              data-full-url={img.url}
                            />
                            <span class="absolute bottom-1 right-1 text-[9px] px-1 rounded bg-black/70 text-white font-mono">
                              #{idx + 1}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                <!-- Card Footer -->
                <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
                  <span title={sub.createdAt}>
                    🕒 {new Date(sub.createdAt).toLocaleString('vi-VN')}
                  </span>
                  <button
                    type="button"
                    class="btn-view-full text-indigo-400 hover:text-indigo-300 font-semibold"
                    data-json={JSON.stringify(sub)}
                  >
                    Xem chi tiết →
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      <!-- ============================================================ -->
      <!-- TAB 2: QUẢN LÝ LỚP HỌC (12A4, 11A8, ...) -->
      <!-- ============================================================ -->
      <section id="tab-section-classes" class="space-y-4 hidden">
        {classes.length === 0 ? (
          <div class="p-12 text-center rounded-2xl bg-slate-900/40 border border-slate-800 text-slate-400 space-y-3">
            <div class="w-16 h-16 rounded-full bg-slate-800 mx-auto flex items-center justify-center text-slate-500">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <p class="font-semibold text-slate-300">
              {isAdmin ? 'Chưa có lớp học nào trên hệ thống' : 'Bạn chưa tạo lớp học nào'}
            </p>
            <p class="text-xs max-w-sm mx-auto">
              {isAdmin
                ? 'Bấm nút "Tạo lớp mới" ở góc trên bên phải để khởi tạo lớp học đầu tiên.'
                : 'Mỗi giáo viên chỉ quản lý các lớp do chính mình tạo. Giáo viên khác không thể xem hoặc sửa lớp của bạn.'}
            </p>
            <button
              type="button"
              onclick="document.getElementById('create-class-modal')?.classList.remove('hidden')"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-sm"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <span>+ Tạo lớp học của tôi</span>
            </button>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {classes.map((cls) => {
              const count = classSubmissionCountMap[cls.name] || 0;
              return (
                <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between shadow-sm">
                  <div>
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex items-center gap-3">
                        <div
                          class="w-12 h-12 rounded-2xl flex items-center justify-center font-black text-white text-base shadow-sm"
                          style={`background: ${cls.color || '#4f46e5'};`}
                        >
                          {cls.initials || cls.name}
                        </div>
                        <div>
                          <h3 class="font-bold text-lg text-white">Lớp {cls.name}</h3>
                          <p class="text-xs text-slate-400">Khối {cls.grade || '12'} • {cls.speciality || 'Chung'}</p>
                          {isAdmin && (cls.createdByName || cls.createdBy) && (
                            <span class="inline-block mt-1 text-[10px] font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full">
                              Tạo bởi: {cls.createdByName || cls.createdBy?.slice(0, 8)}
                            </span>
                          )}
                        </div>
                      </div>

                      <div class="flex items-center gap-1">
                        <!-- Edit class button -->
                        <button
                          type="button"
                          data-id={cls.id}
                          data-json={JSON.stringify(cls)}
                          class="btn-edit-class p-1.5 rounded-lg text-slate-400 hover:text-indigo-300 hover:bg-indigo-500/10 transition"
                          title="Sửa thông tin lớp này"
                        >
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                        </button>

                        <!-- Delete class button -->
                        <button
                          type="button"
                          data-id={cls.id}
                          data-name={cls.name}
                          class="btn-delete-class p-1.5 rounded-lg text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 transition"
                          title="Xóa lớp này"
                        >
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </div>

                    <!-- Pinned notice -->
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80 mb-3">
                      <p class="text-[10px] uppercase font-bold text-slate-400 mb-1">Lời dặn / Yêu cầu nộp bài:</p>
                      <p class="text-xs text-slate-300 line-clamp-3 leading-relaxed">
                        {cls.pinnedNotice || 'Chưa có lời dặn riêng cho lớp này.'}
                      </p>
                    </div>
                  </div>

                  <div class="pt-3 border-t border-slate-800 flex items-center justify-between">
                    <span class="text-xs text-indigo-400 font-semibold">
                      📊 {count} bài đã nộp
                    </span>

                    <a
                      href={`/nop-bai?lop=${cls.name}`}
                      target="_blank"
                      class="text-xs font-semibold text-slate-300 hover:text-white hover:underline flex items-center gap-1"
                    >
                      <span>Vào trang nộp</span>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
