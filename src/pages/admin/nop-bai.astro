  <script is:inline define:vars={{ pageBaseUrl }}>
    (function() {
      // Helper URL với base path
      function apiUrl(path) {
        var b = typeof pageBaseUrl !== 'undefined' ? pageBaseUrl : ((window && window.__BASE_URL__) || '');
        if (!b && typeof window !== 'undefined' && window.location.pathname.startsWith('/lms')) {
          b = '/lms';
        }
        if (!path) return b || '/';
        if (b && path.startsWith('/') && !path.startsWith('//') && !path.startsWith(b + '/')) {
          return b + path;
        }
        return path;
      }

      // Tabs switching
      const tabBtnSubmissions = document.getElementById('tab-btn-submissions');
      const tabBtnClasses = document.getElementById('tab-btn-classes');
      const tabSectionSubmissions = document.getElementById('tab-section-submissions');
      const tabSectionClasses = document.getElementById('tab-section-classes');

      tabBtnSubmissions?.addEventListener('click', () => {
        tabBtnSubmissions.className = 'px-4 py-2 rounded-xl text-sm font-bold bg-indigo-600 text-white shadow-sm transition';
        tabBtnClasses.className = 'px-4 py-2 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition';
        tabSectionSubmissions?.classList.remove('hidden');
        tabSectionClasses?.classList.add('hidden');
      });

      tabBtnClasses?.addEventListener('click', () => {
        tabBtnClasses.className = 'px-4 py-2 rounded-xl text-sm font-bold bg-indigo-600 text-white shadow-sm transition';
        tabBtnSubmissions.className = 'px-4 py-2 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition';
        tabSectionClasses?.classList.remove('hidden');
        tabSectionSubmissions?.classList.add('hidden');
      });

      // Filtering submissions
      const filterClassSelect = document.getElementById('filter-class-select');
      const filterSearchInput = document.getElementById('filter-search-input');
      const visibleSubmissionCount = document.getElementById('visible-submission-count');
      const submissionCards = document.querySelectorAll('.submission-card');

      function filterSubmissions() {
        const selectedClass = filterClassSelect?.value || 'all';
        const query = (filterSearchInput?.value || '').toLowerCase().trim();
        let visible = 0;

        submissionCards.forEach((card) => {
          const cName = card.dataset.className || '';
          const sName = (card.dataset.studentName || '').toLowerCase();
          const content = (card.dataset.content || '').toLowerCase();

          const matchClass = selectedClass === 'all' || cName.toLowerCase() === selectedClass.toLowerCase();
          const matchQuery = !query || sName.includes(query) || content.includes(query);

          if (matchClass && matchQuery) {
            card.style.display = '';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleSubmissionCount) visibleSubmissionCount.textContent = visible;
      }

      filterClassSelect?.addEventListener('change', filterSubmissions);
      filterSearchInput?.addEventListener('input', filterSubmissions);

      // Create Class Modal
      const createClassModal = document.getElementById('create-class-modal');
      const btnOpenCreate = document.getElementById('btn-open-create-class-modal');
      const btnCloseCreate = document.getElementById('btn-close-create-modal');
      const btnCancelCreate = document.getElementById('btn-cancel-create');
      const formCreateClass = document.getElementById('form-create-class');

      btnOpenCreate?.addEventListener('click', () => createClassModal?.classList.remove('hidden'));
      btnCloseCreate?.addEventListener('click', () => createClassModal?.classList.add('hidden'));
      btnCancelCreate?.addEventListener('click', () => createClassModal?.classList.add('hidden'));

      formCreateClass?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(formCreateClass);
        const payload = {
          name: formData.get('name'),
          grade: formData.get('grade'),
          color: formData.get('color'),
          speciality: formData.get('speciality'),
          pinnedNotice: formData.get('pinnedNotice'),
        };

        try {
          const res = await fetch(apiUrl('/api/nop-bai/classes'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          let data;
          try {
            data = await res.json();
          } catch (_) {
            throw new Error(`Máy chủ phản hồi không đúng định dạng JSON (${res.status})`);
          }
          if (!res.ok || data.error) throw new Error(data.error || 'Lỗi tạo lớp');
          alert('Tạo lớp thành công!');
          window.location.reload();
        } catch (err) {
          alert(err.message);
        }
      });

      // Edit Class Modal & Form
      const editClassModal = document.getElementById('edit-class-modal');
      const btnCloseEditModal = document.getElementById('btn-close-edit-modal');
      const btnCancelEdit = document.getElementById('btn-cancel-edit');
      const formEditClass = document.getElementById('form-edit-class');

      document.querySelectorAll('.btn-edit-class').forEach((btn) => {
        btn.addEventListener('click', () => {
          try {
            const cls = JSON.parse(btn.dataset.json || '{}');
            const idInput = document.getElementById('edit-class-id');
            const nameInput = document.getElementById('edit-class-name');
            const gradeSelect = document.getElementById('edit-class-grade');
            const colorInput = document.getElementById('edit-class-color');
            const specInput = document.getElementById('edit-class-speciality');
            const noticeInput = document.getElementById('edit-class-notice');

            if (idInput) idInput.value = cls.id || '';
            if (nameInput) nameInput.value = cls.name || '';
            if (gradeSelect) gradeSelect.value = cls.grade || '12';
            if (colorInput) colorInput.value = cls.color || '#4f46e5';
            if (specInput) specInput.value = cls.speciality || '';
            if (noticeInput) noticeInput.value = cls.pinnedNotice || '';

            editClassModal?.classList.remove('hidden');
          } catch (err) {
            console.error('Error opening edit class modal:', err);
          }
        });
      });

      btnCloseEditModal?.addEventListener('click', () => editClassModal?.classList.add('hidden'));
      btnCancelEdit?.addEventListener('click', () => editClassModal?.classList.add('hidden'));

      formEditClass?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(formEditClass);
        const payload = {
          id: formData.get('id'),
          name: formData.get('name'),
          grade: formData.get('grade'),
          color: formData.get('color'),
          speciality: formData.get('speciality'),
          pinnedNotice: formData.get('pinnedNotice'),
        };

        try {
          const res = await fetch(apiUrl('/api/nop-bai/classes'), {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          let data;
          try {
            data = await res.json();
          } catch (_) {
            throw new Error(`Máy chủ phản hồi không đúng định dạng JSON (${res.status})`);
          }
          if (!res.ok || data.error) throw new Error(data.error || 'Lỗi cập nhật lớp');
          alert('Đã cập nhật thông tin lớp thành công!');
          window.location.reload();
        } catch (err) {
          alert(err.message);
        }
      });

      // Delete Class
      document.querySelectorAll('.btn-delete-class').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          const name = btn.dataset.name;
          if (confirm(`Bạn có chắc muốn xóa lớp "${name}"?`)) {
            try {
              const res = await fetch(apiUrl(`/api/nop-bai/classes?id=${id}`), { method: 'DELETE' });
              let data;
              try {
                data = await res.json();
              } catch (_) {
                throw new Error(`Máy chủ phản hồi không đúng định dạng JSON (${res.status})`);
              }
              if (!res.ok || data.error) throw new Error(data.error || 'Lỗi xóa lớp');
              alert('Đã xóa lớp!');
              window.location.reload();
            } catch (err) {
              alert(err.message);
            }
          }
        });
      });

      // Delete Submission
      document.querySelectorAll('.btn-delete-sub').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          if (confirm('Bạn có chắc muốn xóa bài nộp này?')) {
            try {
              const res = await fetch(apiUrl(`/api/nop-bai/submissions?id=${id}`), { method: 'DELETE' });
              let data;
              try {
                data = await res.json();
              } catch (_) {
                throw new Error(`Máy chủ phản hồi không đúng định dạng JSON (${res.status})`);
              }
              if (!res.ok || data.error) throw new Error(data.error || 'Lỗi xóa bài nộp');
              alert('Đã xóa bài nộp!');
              window.location.reload();
            } catch (err) {
              alert(err.message);
            }
          }
        });
      });

      // Lightbox Zoom
      const adminLightbox = document.getElementById('admin-lightbox');
      const adminLightboxImg = document.getElementById('admin-lightbox-img');
      const btnCloseAdminLightbox = document.getElementById('btn-close-admin-lightbox');

      document.querySelectorAll('.admin-zoom-img').forEach((img) => {
        img.addEventListener('click', () => {
          const url = img.dataset.fullUrl || img.src;
          if (adminLightboxImg) adminLightboxImg.src = url;
          adminLightbox?.classList.remove('hidden');
        });
      });

      btnCloseAdminLightbox?.addEventListener('click', () => adminLightbox?.classList.add('hidden'));
      adminLightbox?.addEventListener('click', (e) => {
        if (e.target === adminLightbox) adminLightbox.classList.add('hidden');
      });

      // Full View Modal
      const viewSubModal = document.getElementById('view-submission-modal');
      const btnCloseViewModal = document.getElementById('btn-close-view-modal');
      const viewStudentName = document.getElementById('view-student-name');
      const viewSubMeta = document.getElementById('view-sub-meta');
      const viewContent = document.getElementById('view-content');
      const viewImagesGrid = document.getElementById('view-images-grid');

      document.querySelectorAll('.btn-view-full').forEach((btn) => {
        btn.addEventListener('click', () => {
          try {
            const sub = JSON.parse(btn.dataset.json || '{}');
            if (viewStudentName) viewStudentName.textContent = sub.studentName;
            if (viewSubMeta) viewSubMeta.textContent = `Lớp ${sub.className} • Lần nộp thứ ${sub.submissionCount} • ${new Date(sub.createdAt).toLocaleString('vi-VN')}`;
            if (viewContent) viewContent.textContent = sub.content || '(Không có văn bản viết kèm)';
            
            if (viewImagesGrid) {
              viewImagesGrid.innerHTML = '';
              if (sub.images && sub.images.length > 0) {
                sub.images.forEach((img, i) => {
                  const div = document.createElement('div');
                  div.className = 'rounded-xl overflow-hidden border border-slate-800 bg-slate-950 aspect-video cursor-pointer';
                  div.innerHTML = `<img src="${img.url}" alt="Ảnh ${i+1}" class="w-full h-full object-cover hover:scale-105 transition" />`;
                  div.addEventListener('click', () => {
                    if (adminLightboxImg) adminLightboxImg.src = img.url;
                    adminLightbox?.classList.remove('hidden');
                  });
                  viewImagesGrid.appendChild(div);
                });
              } else {
                viewImagesGrid.innerHTML = '<p class="text-xs text-slate-500 col-span-2">Không có hình ảnh đính kèm.</p>';
              }
            }

            viewSubModal?.classList.remove('hidden');
          } catch(e) {}
        });
      });

      btnCloseViewModal?.addEventListener('click', () => viewSubModal?.classList.add('hidden'));
    })();
  </script>
</Layout>
