---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
import { forumNumber, forumRelativeTime } from '../../../lib/forum-format';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'admin' && user.role !== 'teacher')) {
  return Astro.redirect('/dashboard');
}

const [analytics, reports, leaders, categories] = await Promise.all([
  db.getForumAnalytics(),
  db.getForumReports('all'),
  db.getForumLeaderboard(10),
  db.getForumCategories(),
]);

const reasonLabel: Record<string, string> = {
  spam: 'Spam', offtopic: 'Lạc đề', abuse: 'Quấy rối', wrong: 'Thông tin sai', other: 'Khác',
};
---

<Layout
  title="Quản lý diễn đàn | Quản trị"
  description="Thống kê, báo cáo vi phạm và kiểm duyệt diễn đàn học sinh."
  canonical="/admin/forum"
  noindex={true}
  breadcrumbs={[{ name: 'Quản trị', url: '/admin' }, { name: 'Diễn đàn', url: '/admin/forum' }]}
>
  <div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <a href="/admin" class="text-xs font-semibold text-blue-600 hover:underline">← Về quản trị</a>
        <h1 class="mt-3 text-2xl font-extrabold text-slate-900 dark:text-white md:text-3xl">🛡️ Quản lý diễn đàn Học sinh</h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Tổng quan hoạt động, báo cáo vi phạm và các công cụ kiểm duyệt.</p>
      </div>
      <a href="/forum" class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Xem diễn đàn ↗</a>
    </div>

    <!-- Stats -->
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {[
        { label: 'Bài viết', value: analytics.totalThreads, icon: '📝', tone: 'blue' },
        { label: 'Trả lời', value: analytics.totalReplies, icon: '💬', tone: 'indigo' },
        { label: 'Tỷ lệ đã giải', value: `${analytics.solvedRate}%`, icon: '✅', tone: 'emerald' },
        { label: 'Chưa giải', value: analytics.openThreads, icon: '🙋', tone: 'amber' },
        { label: 'Báo cáo chờ', value: analytics.reportsOpen, icon: '🚩', tone: 'rose' },
      ].map(item => (
        <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-xl">{item.icon}</div>
          <div class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-white">{item.value}</div>
          <div class="text-[11px] font-medium text-slate-500">{item.label}</div>
        </div>
      ))}
    </section>

    <!-- Tabs -->
    <div class="border-b border-slate-200 dark:border-slate-700">
      <nav class="-mb-px flex gap-6" id="admin-forum-tabs">
        <button data-tab="overview" class="tab-btn border-b-2 border-blue-600 pb-3 text-sm font-semibold text-blue-600">📊 Tổng quan</button>
        <button data-tab="categories" class="tab-btn border-b-2 border-transparent pb-3 text-sm font-semibold text-slate-500 hover:text-slate-700 dark:hover:text-slate-200">📂 Chuyên mục</button>
        <button data-tab="reports" class="tab-btn border-b-2 border-transparent pb-3 text-sm font-semibold text-slate-500 hover:text-slate-700 dark:hover:text-slate-200">🚩 Báo cáo ({reports.length})</button>
      </nav>
    </div>

    <!-- Tab: Tổng quan -->
    <div id="tab-overview" class="tab-panel space-y-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Theo chuyên mục -->
        <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">📂 Hoạt động theo chuyên mục</h2>
          <div class="mt-4 space-y-3">
            {analytics.byCategory.map(cat => {
              const max = Math.max(1, ...analytics.byCategory.map(c => c.threads));
              return (
                <div>
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold text-slate-700 dark:text-slate-200">{cat.icon} {cat.name}</span>
                    <span class="text-slate-500">{cat.threads} bài · {cat.replies} trả lời · {cat.solved} giải</span>
                  </div>
                  <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
                    <div class="h-full rounded-full bg-blue-500" style={`width:${Math.round((cat.threads / max) * 100)}%`}></div>
                  </div>
                </div>
              );
            })}
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {analytics.topTags.map(item => (
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">#{item.tag} ({item.count})</span>
            ))}
          </div>
        </section>

        <!-- Top thành viên -->
        <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">🏆 Thành viên tích cực</h2>
          <ul class="mt-4 space-y-3">
            {leaders.map((stat, i) => (
              <li class="flex items-center justify-between gap-3 text-xs">
                <span class="flex min-w-0 items-center gap-2">
                  <span class="w-4 text-slate-400">{i + 1}</span>
                  <span class="truncate font-semibold text-slate-700 dark:text-slate-200">{stat.user?.fullname || 'Thành viên'}</span>
                  <span class="hidden text-[10px] text-violet-600 sm:inline dark:text-violet-300">{stat.badges[0] || ''}</span>
                </span>
                <span class="shrink-0 font-extrabold text-amber-600">{forumNumber(stat.reputation)}</span>
              </li>
            ))}
          </ul>
          <a href="/forum/bang-xep-hang" class="mt-4 inline-block text-xs font-semibold text-blue-600 hover:underline">Xem bảng xếp hạng đầy đủ →</a>
        </section>
      </div>
    </div>

    <!-- Tab: Chuyên mục -->
    <div id="tab-categories" class="tab-panel hidden space-y-4">
      <!-- Nút thêm mới -->
      <div class="flex items-center justify-between">
        <p class="text-sm text-slate-500 dark:text-slate-400">Quản lý các chuyên mục của diễn đàn học sinh.</p>
        <button id="btn-add-cat" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-blue-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Thêm chuyên mục
        </button>
      </div>

      <!-- Bảng danh sách -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50 text-left dark:border-slate-800 dark:bg-slate-800/50">
              <th class="px-5 py-3 text-xs font-semibold text-slate-500">Icon</th>
              <th class="px-5 py-3 text-xs font-semibold text-slate-500">Tên chuyên mục</th>
              <th class="hidden px-5 py-3 text-xs font-semibold text-slate-500 sm:table-cell">Slug</th>
              <th class="hidden px-5 py-3 text-xs font-semibold text-slate-500 md:table-cell">Bài viết</th>
              <th class="px-5 py-3 text-xs font-semibold text-slate-500">Trạng thái</th>
              <th class="px-5 py-3 text-xs font-semibold text-slate-500">Thao tác</th>
            </tr>
          </thead>
          <tbody id="category-list" class="divide-y divide-slate-100 dark:divide-slate-800">
            {categories.map(cat => (
              <tr class="cat-row" data-id={cat.id} data-name={cat.name} data-slug={cat.slug}
                  data-description={cat.description || ''} data-icon={cat.icon || ''}
                  data-order={cat.order_index} data-active={cat.is_active ? 'true' : 'false'}>
                <td class="px-5 py-3 text-lg">{cat.icon || '📁'}</td>
                <td class="px-5 py-3">
                  <p class="font-semibold text-slate-800 dark:text-white">{cat.name}</p>
                  <p class="text-[11px] text-slate-400 mt-0.5">{cat.description}</p>
                </td>
                <td class="hidden px-5 py-3 font-mono text-[11px] text-slate-400 sm:table-cell">{cat.slug}</td>
                <td class="hidden px-5 py-3 text-slate-600 dark:text-slate-300 md:table-cell">{cat.thread_count}</td>
                <td class="px-5 py-3">
                  {cat.is_active
                    ? <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-600 dark:bg-emerald-950/40">Hiện</span>
                    : <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500 dark:bg-slate-800">Ẩn</span>
                  }
                </td>
                <td class="px-5 py-3">
                  <div class="flex items-center gap-2">
                    <button class="btn-edit-cat rounded-lg border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300">Sửa</button>
                    <button class="btn-del-cat rounded-lg border border-rose-200 px-2.5 py-1 text-[11px] font-bold text-rose-600 hover:bg-rose-50 dark:border-rose-900">Xóa</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {categories.length === 0 && (
          <p class="px-5 py-10 text-center text-sm text-slate-500">Chưa có chuyên mục nào.</p>
        )}
      </div>
    </div>

    <!-- Tab: Báo cáo -->
    <div id="tab-reports" class="tab-panel hidden">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
        <div class="border-b border-slate-100 px-5 py-4 dark:border-slate-800">
          <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">🚩 Báo cáo vi phạm ({reports.length})</h2>
        </div>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800">
          {reports.map(report => (
            <li class="px-5 py-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                    <span class="rounded bg-rose-50 px-2 py-0.5 text-[10px] font-bold text-rose-600 dark:bg-rose-950/40">{reasonLabel[report.reason] || report.reason}</span>
                    {report.thread?.title || 'Bài viết đã bị xoá'}
                  </p>
                  <p class="mt-1 text-xs text-slate-500">
                    Bởi {report.reporter?.fullname || 'Thành viên'} · {forumRelativeTime(report.created_at)} · Trạng thái: <strong>{report.status}</strong>
                  </p>
                  {report.details && <p class="mt-1 text-xs italic text-slate-400">"{report.details}"</p>}
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  {report.thread && (
                    <a href={`/forum/${report.thread.category?.slug}/${report.thread.slug}`} class="rounded-lg border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300">Xem bài</a>
                  )}
                  {report.status === 'open' ? (
                    <>
                      <button type="button" class="forum-report-action rounded-lg bg-rose-600 px-2.5 py-1 text-[11px] font-bold text-white hover:bg-rose-700" data-id={report.id} data-status="resolved">Xử lý</button>
                      <button type="button" class="forum-report-action rounded-lg border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300" data-id={report.id} data-status="dismissed">Bỏ qua</button>
                    </>
                  ) : null}
                </div>
              </div>
            </li>
          ))}
          {reports.length === 0 && (
            <li class="px-5 py-12 text-center text-sm text-slate-500">Không có báo cáo nào. 🎉</li>
          )}
        </ul>
      </section>
    </div>
  </div>

  <!-- Modal thêm/sửa chuyên mục -->
  <div id="cat-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl dark:bg-slate-900">
      <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4 dark:border-slate-800">
        <h3 id="modal-title" class="text-base font-extrabold text-slate-900 dark:text-white">Thêm chuyên mục</h3>
        <button id="modal-close" class="text-slate-400 hover:text-slate-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="cat-form" class="space-y-4 p-6">
        <input type="hidden" id="cat-id" value="" />
        <div>
          <label class="mb-1 block text-xs font-semibold text-slate-700 dark:text-slate-300">Tên chuyên mục <span class="text-rose-500">*</span></label>
          <input id="cat-name" type="text" required placeholder="Vd: Toán 12" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="mb-1 block text-xs font-semibold text-slate-700 dark:text-slate-300">Icon (emoji)</label>
            <input id="cat-icon" type="text" placeholder="📚" maxlength="4" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
          <div>
            <label class="mb-1 block text-xs font-semibold text-slate-700 dark:text-slate-300">Thứ tự</label>
            <input id="cat-order" type="number" min="0" value="0" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold text-slate-700 dark:text-slate-300">Mô tả</label>
          <textarea id="cat-desc" rows="2" placeholder="Mô tả ngắn về chuyên mục..." class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white resize-none"></textarea>
        </div>
        <div>
          <label class="mb-1 block text-xs font-semibold text-slate-700 dark:text-slate-300">Slug (tự tạo nếu để trống)</label>
          <input id="cat-slug" type="text" placeholder="vd: toan-12" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-mono focus:border-blue-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <div class="flex items-center gap-2">
          <input id="cat-active" type="checkbox" checked class="h-4 w-4 rounded" />
          <label for="cat-active" class="text-sm font-medium text-slate-700 dark:text-slate-300">Hiển thị chuyên mục</label>
        </div>
        <div id="cat-error" class="hidden rounded-lg bg-rose-50 px-3 py-2 text-xs text-rose-600 dark:bg-rose-950/40"></div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="modal-cancel" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300">Hủy</button>
          <button type="submit" id="modal-submit" class="rounded-xl bg-blue-600 px-5 py-2 text-sm font-bold text-white hover:bg-blue-700">Lưu</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    // ── Tabs ──────────────────────────────────────────────────────────────────
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');
    function activateTab(name) {
      tabBtns.forEach(btn => {
        const active = btn.getAttribute('data-tab') === name;
        btn.classList.toggle('border-blue-600', active);
        btn.classList.toggle('text-blue-600', active);
        btn.classList.toggle('border-transparent', !active);
        btn.classList.toggle('text-slate-500', !active);
      });
      tabPanels.forEach(p => p.classList.toggle('hidden', p.id !== 'tab-' + name));
    }
    tabBtns.forEach(btn => btn.addEventListener('click', () => activateTab(btn.getAttribute('data-tab'))));

    // ── Report actions ────────────────────────────────────────────────────────
    document.querySelectorAll('.forum-report-action').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        btn.disabled = true;
        try {
          var response = await fetch(window.withBase('/api/forum/reports/' + encodeURIComponent(btn.getAttribute('data-id')) + '/resolve'), {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: btn.getAttribute('data-status') }),
          });
          if (!response.ok) throw new Error('Không thể cập nhật báo cáo.');
          window.location.reload();
        } catch (error) {
          window.alert(error.message);
          btn.disabled = false;
        }
      });
    });

    // ── Category Modal ────────────────────────────────────────────────────────
    const modal = document.getElementById('cat-modal');
    const form = document.getElementById('cat-form');
    const modalTitle = document.getElementById('modal-title');
    const catError = document.getElementById('cat-error');

    function openModal(data) {
      document.getElementById('cat-id').value = data.id || '';
      document.getElementById('cat-name').value = data.name || '';
      document.getElementById('cat-icon').value = data.icon || '';
      document.getElementById('cat-desc').value = data.description || '';
      document.getElementById('cat-slug').value = data.slug || '';
      document.getElementById('cat-order').value = data.order !== undefined ? data.order : 0;
      document.getElementById('cat-active').checked = data.active !== false;
      modalTitle.textContent = data.id ? 'Sửa chuyên mục' : 'Thêm chuyên mục';
      catError.classList.add('hidden');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    document.getElementById('btn-add-cat').addEventListener('click', () => openModal({}));
    document.getElementById('modal-close').addEventListener('click', closeModal);
    document.getElementById('modal-cancel').addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

    // Edit buttons
    document.querySelectorAll('.btn-edit-cat').forEach(btn => {
      btn.addEventListener('click', function () {
        const row = btn.closest('.cat-row');
        openModal({
          id: row.dataset.id,
          name: row.dataset.name,
          slug: row.dataset.slug,
          description: row.dataset.description,
          icon: row.dataset.icon,
          order: parseInt(row.dataset.order) || 0,
          active: row.dataset.active === 'true',
        });
      });
    });

    // Delete buttons
    document.querySelectorAll('.btn-del-cat').forEach(btn => {
      btn.addEventListener('click', async function () {
        const row = btn.closest('.cat-row');
        if (!confirm('Xóa chuyên mục "' + row.dataset.name + '"? Thao tác không thể hoàn tác.')) return;
        btn.disabled = true;
        try {
          const res = await fetch(window.withBase('/api/forum/categories/' + encodeURIComponent(row.dataset.id)), { method: 'DELETE' });
          if (!res.ok) { const e = await res.json(); throw new Error(e.error || 'Lỗi xóa.'); }
          window.location.reload();
        } catch (err) {
          alert(err.message);
          btn.disabled = false;
        }
      });
    });

    // Form submit
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      catError.classList.add('hidden');
      const submit = document.getElementById('modal-submit');
      submit.disabled = true;
      submit.textContent = 'Đang lưu…';
      const id = document.getElementById('cat-id').value;
      const payload = {
        name: document.getElementById('cat-name').value.trim(),
        icon: document.getElementById('cat-icon').value.trim() || null,
        description: document.getElementById('cat-desc').value.trim() || null,
        slug: document.getElementById('cat-slug').value.trim() || undefined,
        order_index: parseInt(document.getElementById('cat-order').value) || 0,
        is_active: document.getElementById('cat-active').checked,
      };
      try {
        let res;
        if (id) {
          res = await fetch(window.withBase('/api/forum/categories/' + encodeURIComponent(id)), {
            method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
        } else {
          res = await fetch(window.withBase('/api/forum/categories'), {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
        }
        if (!res.ok) { const err = await res.json(); throw new Error(err.error || 'Lỗi không xác định.'); }
        window.location.reload();
      } catch (err) {
        catError.textContent = err.message;
        catError.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = 'Lưu';
      }
    });
  })();
</script>
