---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.role !== 'admin') return Astro.redirect('/dashboard');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');
  const id = String(form.get('id') || '');
  try {
    if (action === 'create') {
      const kind = String(form.get('kind') || 'task') === 'timetable' ? 'timetable' : 'task';
      const priorityValue = String(form.get('priority') || 'normal');
      const priority = ['normal', 'important', 'urgent'].includes(priorityValue) ? priorityValue as 'normal' | 'important' | 'urgent' : 'normal';
      const title = String(form.get('title') || '').trim();
      const dueValue = String(form.get('due_at') || '').trim();
      if (!title) throw new Error('Vui lòng nhập tiêu đề.');
      await db.createTeacherNotice({
        kind,
        title,
        content: String(form.get('content') || '').trim() || null,
        priority,
        due_at: dueValue ? new Date(dueValue).toISOString() : null,
        image_url: String(form.get('image_url') || '').trim() || null,
        is_published: form.get('is_published') === 'on',
        created_by: user.id,
        recipient_teacher_id: null,
      });
      return Astro.redirect('/admin/teacher-notices');
    }
    if (action === 'toggle' && id) {
      const notices = await db.getTeacherNotices(true);
      const notice = notices.find(item => item.id === id);
      if (notice) await db.updateTeacherNotice(id, { is_published: !notice.is_published });
      return Astro.redirect('/admin/teacher-notices');
    }
    if (action === 'delete' && id) {
      await db.deleteTeacherNotice(id);
      return Astro.redirect('/admin/teacher-notices');
    }
  } catch (err: any) {
    error = err.message || 'Không thể lưu thông báo.';
  }
}

const notices = await db.getTeacherNotices(true);
function formatDate(value: string | null) {
  return value ? new Date(value).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Không có hạn';
}
---

<Layout title="Thông báo giáo viên">
  <div class="max-w-6xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div>
        <a href="/admin" class="text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">← Quản trị</a>
        <h1 class="mt-2 text-2xl font-extrabold text-gray-900 dark:text-white">Thông báo giáo viên & thời khóa biểu</h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Việc được xuất bản sẽ hiện huy hiệu trong menu của giáo viên; thời khóa biểu có thể đính kèm ảnh qua URL công khai.</p>
      </div>
      <a href="/giao-vien/thong-bao" class="shrink-0 px-4 py-2 rounded-xl bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 text-sm font-bold hover:bg-blue-100 dark:hover:bg-blue-900/30">Xem giao diện giáo viên →</a>
    </div>

    {error && <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-700">{error}</div>}

    <form method="POST" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 md:p-6 shadow-sm space-y-4">
      <input type="hidden" name="_action" value="create" />
      <div class="flex items-center justify-between gap-3">
        <h2 class="font-extrabold text-gray-900 dark:text-white">Tạo việc hoặc thời khóa biểu</h2>
        <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300"><input type="checkbox" name="is_published" checked class="rounded text-blue-600" /> Xuất bản ngay</label>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <label class="text-sm font-semibold text-slate-700 dark:text-slate-200">Loại
          <select name="kind" class="mt-1.5 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm"><option value="task">Việc cần làm</option><option value="timetable">Thời khóa biểu</option></select>
        </label>
        <label class="text-sm font-semibold text-slate-700 dark:text-slate-200">Ưu tiên
          <select name="priority" class="mt-1.5 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm"><option value="normal">Bình thường</option><option value="important">Quan trọng</option><option value="urgent">Khẩn</option></select>
        </label>
        <label class="text-sm font-semibold text-slate-700 dark:text-slate-200">Hạn hoàn thành (nếu có)
          <input name="due_at" type="datetime-local" class="mt-1.5 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm" />
        </label>
      </div>
      <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Tiêu đề<input required name="title" placeholder="Ví dụ: Nộp kế hoạch tổ chuyên môn tháng 10" class="mt-1.5 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm" /></label>
      <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Nội dung<label class="ml-1 font-normal text-slate-400">(tùy chọn)</label><textarea name="content" rows="3" placeholder="Hướng dẫn, nơi nộp, người phụ trách..." class="mt-1.5 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm"></textarea></label>
      <label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">URL ảnh thời khóa biểu<label class="ml-1 font-normal text-slate-400">(dán liên kết ảnh công khai, tùy chọn)</label><input name="image_url" type="url" placeholder="https://.../thoi-khoa-bieu.png" class="mt-1.5 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-sm" /></label>
      <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow">Đăng cho giáo viên</button>
    </form>

    <section class="space-y-3">
      <h2 class="font-extrabold text-gray-900 dark:text-white">Đã tạo ({notices.length})</h2>
      {notices.length === 0 ? <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-10 text-center text-sm text-slate-500">Chưa có việc hoặc thời khóa biểu nào.</div> : notices.map(notice => (
        <article class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 flex flex-col md:flex-row md:items-start gap-4">
          <div class={`shrink-0 px-2.5 py-1 rounded-full text-xs font-bold ${notice.kind === 'timetable' ? 'bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-300' : notice.priority === 'urgent' ? 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300' : 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300'}`}>{notice.kind === 'timetable' ? 'Thời khóa biểu' : notice.priority === 'urgent' ? 'Khẩn' : 'Việc giáo viên'}</div>
          <div class="flex-1 min-w-0"><h3 class="font-bold text-gray-900 dark:text-white">{notice.title}</h3>{notice.content && <p class="mt-1 text-sm text-slate-500 dark:text-slate-400 whitespace-pre-line">{notice.content}</p>}<p class="mt-2 text-xs text-slate-400">Hạn: {formatDate(notice.due_at)} · {notice.is_published ? 'Đang hiển thị' : 'Bản nháp'}</p></div>
          <div class="flex gap-2 shrink-0"><form method="POST"><input type="hidden" name="_action" value="toggle" /><input type="hidden" name="id" value={notice.id} /><button class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200">{notice.is_published ? 'Ẩn' : 'Xuất bản'}</button></form><form method="POST" onsubmit="return confirm('Xóa mục này?')"><input type="hidden" name="_action" value="delete" /><input type="hidden" name="id" value={notice.id} /><button class="px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-50 dark:bg-rose-900/20 text-rose-600">Xóa</button></form></div>
        </article>
      ))}
    </section>
  </div>
</Layout>
