---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
import ForumReactions from '../../../components/forum/ForumReactions.astro';
import { renderForumMarkdown } from '../../../lib/markdown';
import { forumDate, forumNumber, forumRelativeTime } from '../../../lib/forum-format';

const categorySlug = Astro.params.category || '';
const threadSlug = Astro.params.thread || '';
const thread = await db.getForumThreadBySlug(threadSlug);
if (!thread || thread.category?.slug !== categorySlug) {
  return Astro.redirect('/hoc-sinh');
}

const user = Astro.locals.user;
const viewerId = user?.id || null;
const isStaff = user?.role === 'teacher' || user?.role === 'admin';
const canReply = !!user && thread.status !== 'locked' && thread.status !== 'archived';
const canAccept = !!user && (user.id === thread.author_id || isStaff);

const [interactions, reactions, posts, related, mentionCandidates] = await Promise.all([
  viewerId ? db.getForumInteractions(viewerId) : Promise.resolve(null),
  db.getForumThreadReactions(thread.id),
  db.getDecoratedForumPosts(thread.id, viewerId),
  db.getRelatedForumThreads(thread.id, 5),
  db.getForumLeaderboard(30),
]);
const bookmarked = !!interactions?.bookmarks.includes(thread.id);
const following = !!interactions?.follows.includes(thread.id);

const acceptedPost = posts.find(p => p.id === thread.accepted_post_id) || posts.find(p => p.is_answer);
const otherPosts = posts.filter(p => p.id !== acceptedPost?.id);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'DiscussionForumPosting',
  headline: thread.title,
  datePublished: thread.created_at,
  dateModified: thread.updated_at || thread.created_at,
  articleBody: thread.body,
  author: thread.is_anonymous ? undefined : { '@type': 'Person', name: thread.author?.fullname || 'Thành viên' },
};
---

<Layout
  title={`${thread.title} | Diễn đàn Học sinh`}
  description={thread.body.slice(0, 160)}
  canonical={`/hoc-sinh/${categorySlug}/${thread.slug}`}
  ogType="article"
  publishedTime={thread.created_at}
  modifiedTime={thread.updated_at || thread.created_at}
  structuredData={structuredData}
  breadcrumbs={[
    { name: 'Diễn đàn Học sinh', url: '/hoc-sinh' },
    { name: thread.category?.name || categorySlug, url: `/hoc-sinh/${categorySlug}` },
    { name: thread.title, url: `/hoc-sinh/${categorySlug}/${thread.slug}` },
  ]}
>
  <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
    <div class="space-y-6 min-w-0">
      <!-- Phase 2: banner cập nhật mới (polling nhẹ, không cần Realtime) -->
      <div id="forum-new-reply-banner" class="hidden items-center justify-between gap-3 rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-xs font-semibold text-blue-700 dark:border-blue-900 dark:bg-blue-950/30 dark:text-blue-300">
        <span id="forum-new-reply-text">💬 Có trả lời mới.</span>
        <button type="button" id="forum-reload-btn" class="shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white hover:bg-blue-700">Tải lại</button>
      </div>

      <!-- Bài viết gốc -->
      <article class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
        <div class="border-b border-slate-100 dark:border-slate-800 px-5 py-5 sm:px-7">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <a href={`/hoc-sinh/${categorySlug}`} class="rounded-full bg-blue-50 dark:bg-blue-950/40 px-3 py-1 font-bold text-blue-700 dark:text-blue-300 hover:bg-blue-100">
              {thread.category?.icon} {thread.category?.name}
            </a>
            {thread.status === 'solved' && (
              <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/50 px-3 py-1 font-bold text-emerald-700 dark:text-emerald-300">✅ Đã giải</span>
            )}
            {thread.is_pinned && <span class="rounded-full bg-amber-100 dark:bg-amber-950/40 px-3 py-1 font-bold text-amber-700">📌 Ghép top</span>}
          </div>

          <h1 class="mt-4 text-2xl font-extrabold leading-snug text-slate-900 dark:text-white md:text-3xl">
            {thread.title}
          </h1>

          {thread.summary && (
            <div class="mt-4 rounded-xl border border-violet-200 dark:border-violet-900/50 bg-violet-50/70 dark:bg-violet-950/20 px-4 py-3 text-xs leading-relaxed text-violet-900 dark:text-violet-200">
              <strong>📝 Tóm tắt:</strong> {thread.summary}
            </div>
          )}

          <div class="mt-4 flex flex-wrap items-center gap-2">
            {user ? (
              <>
                <button
                  type="button"
                  id="forum-bookmark-btn"
                  data-active={bookmarked}
                  class="forum-state-btn rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:border-amber-400 hover:text-amber-600 transition"
                >{bookmarked ? '🔖 Đã lưu' : '🔖 Lưu bài'}</button>
                <button
                  type="button"
                  id="forum-follow-btn"
                  data-active={following}
                  class="forum-state-btn rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:border-blue-400 hover:text-blue-600 transition"
                >{following ? '🔔 Đang theo dõi' : '🔔 Theo dõi'}</button>
              </>
            ) : (
              <a href="/login" class="rounded-lg border border-slate-200 px-3 py-1.5 text-[11px] font-semibold text-slate-500 hover:text-blue-600 dark:border-slate-700">🔑 Đăng nhập để lưu / theo dõi</a>
            )}
            {isStaff && (
              <>
                <button type="button" class="forum-moderate-btn rounded-lg border border-slate-200 px-2.5 py-1.5 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800" data-action={thread.is_pinned ? 'unpin' : 'pin'}>{thread.is_pinned ? '📌 Bỏ ghép' : '📌 Ghép top'}</button>
                <button type="button" class="forum-moderate-btn rounded-lg border border-slate-200 px-2.5 py-1.5 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800" data-action={thread.status === 'locked' ? 'unlock' : 'lock'}>{thread.status === 'locked' ? '🔓 Mở khoá' : '🔒 Khoá'}</button>
                <button type="button" class="forum-moderate-btn rounded-lg border border-slate-200 px-2.5 py-1.5 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800" data-action="archive">📦 Lưu trữ</button>
                <button type="button" id="forum-ai-summary-btn" class="rounded-lg border border-violet-300 px-2.5 py-1.5 text-[11px] font-bold text-violet-700 hover:bg-violet-50 dark:border-violet-800 dark:text-violet-300 dark:hover:bg-violet-950/30">✨ Tóm tắt AI</button>
                <button type="button" id="forum-to-question-btn" class="rounded-lg border border-emerald-300 px-2.5 py-1.5 text-[11px] font-bold text-emerald-700 hover:bg-emerald-50 dark:border-emerald-800 dark:text-emerald-300 dark:hover:bg-emerald-950/30">➡️ Thêm vào ngân hàng đề</button>
              </>
            )}
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-2">
              <img
                src={thread.is_anonymous
                  ? 'https://api.dicebear.com/7.x/adventurer/svg?seed=anonymous'
                  : (thread.author?.avatar_url || 'https://api.dicebear.com/7.x/adventurer/svg?seed=default')}
                alt=""
                class="h-7 w-7 rounded-full bg-slate-200"
              />
              <span class="font-semibold text-slate-700 dark:text-slate-200">
                {thread.is_anonymous ? 'Ẩn danh' : (thread.author?.fullname || 'Thành viên')}
              </span>
              {!thread.is_anonymous && thread.author?.role === 'teacher' && (
                <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700">Giáo viên</span>
              )}
            </span>
            <span>🕒 {forumDate(thread.created_at)}</span>
            <span>👁 {forumNumber(thread.views_count)} lượt xem</span>
            <span>💬 {thread.reply_count} trả lời</span>
          </div>
        </div>

        <div class="prose prose-slate dark:prose-invert max-w-none px-5 py-6 text-sm leading-relaxed sm:px-7 forum-content">
          <div set:html={renderForumMarkdown(thread.body)}></div>
        </div>

        {(thread.tags || []).length > 0 && (
          <div class="flex flex-wrap gap-2 border-t border-slate-100 dark:border-slate-800 px-5 py-4 sm:px-7">
            {thread.tags.map(tag => (
              <a
                href={`/hoc-sinh/tat-ca?tag=${encodeURIComponent(tag)}`}
                class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-blue-100 hover:text-blue-700 dark:hover:bg-blue-950/50"
              >#{tag}</a>
            ))}
          </div>
        )}
      </article>

      <!-- Câu trả lời được chấp nhận -->
      {acceptedPost && (
        <section>
          <h2 class="mb-3 flex items-center gap-2 text-sm font-extrabold text-emerald-700 dark:text-emerald-300">
            ✅ Câu trả lời được chấp nhận
          </h2>
          <div class="rounded-2xl border-2 border-emerald-300 dark:border-emerald-800 bg-emerald-50/40 dark:bg-emerald-950/10 overflow-hidden">
            <div class="px-5 py-5 sm:px-7">
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                <img src={acceptedPost.author?.avatar_url || 'https://api.dicebear.com/7.x/adventurer/svg?seed=default'} alt="" class="h-7 w-7 rounded-full bg-slate-200" />
                <span class="font-semibold text-slate-700 dark:text-slate-200">{acceptedPost.author?.fullname || 'Thành viên'}</span>
                {acceptedPost.author?.role === 'teacher' && <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700">Giáo viên</span>}
                <span>• {forumRelativeTime(acceptedPost.created_at)}</span>
              </div>
              <div class="prose prose-slate dark:prose-invert max-w-none mt-4 text-sm leading-relaxed forum-content" set:html={renderForumMarkdown(acceptedPost.body)}></div>
              <ForumReactions post={acceptedPost} canInteract={!!user} />
            </div>
          </div>
        </section>
      )}

      <!-- Các câu trả lời khác -->
      <section class="space-y-4">
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">
          💬 Tất cả trả lời ({posts.length})
        </h2>
        {otherPosts.map(post => (
          <article class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-5 py-5 sm:px-7">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                <img src={post.author?.avatar_url || 'https://api.dicebear.com/7.x/adventurer/svg?seed=default'} alt="" class="h-7 w-7 rounded-full bg-slate-200" />
                <span class="font-semibold text-slate-700 dark:text-slate-200">{post.author?.fullname || 'Thành viên'}</span>
                {post.author?.role === 'teacher' && <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700">Giáo viên</span>}
                <span>• {forumRelativeTime(post.created_at)}</span>
              </div>
              {canAccept && (
                <button
                  type="button"
                  class="forum-accept-btn rounded-lg border border-emerald-300 px-2.5 py-1 text-[11px] font-bold text-emerald-700 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition"
                  data-post-id={post.id}
                >✓ Chọn là đáp án</button>
              )}
            </div>
            <div class="prose prose-slate dark:prose-invert max-w-none mt-4 text-sm leading-relaxed forum-content" set:html={renderForumMarkdown(post.body)}></div>
            <ForumReactions post={post} canInteract={!!user} />
          </article>
        ))}
        {posts.length === 0 && (
          <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 px-5 py-10 text-center text-sm text-slate-500">
            Chưa có câu trả lời nào. Bạn có thể là người đầu tiên giúp bạn này nhé!
          </div>
        )}
      </section>

      <!-- Form trả lời -->
      {canReply ? (
        <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-7">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">✍️ Viết câu trả lời</h2>
            <button type="button" id="forum-ai-draft" class="rounded-lg border border-violet-300 dark:border-violet-800 bg-violet-50 dark:bg-violet-950/30 px-3 py-1.5 text-xs font-bold text-violet-700 dark:text-violet-300 hover:bg-violet-100 transition">
              ✨ Gợi ý từ AI
            </button>
          </div>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Hỗ trợ Markdown, công thức LaTeX ($...$, $$...$$), dán ảnh trực tiếp (Ctrl+V), @nhắc tên và đính kèm ảnh/PDF.</p>
          {mentionCandidates.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-1.5">
              <span class="text-[11px] font-semibold text-slate-400">@ Nhắc tên:</span>
              {mentionCandidates.slice(0, 8).map(m => m.user?.fullname).filter(Boolean).map(name => (
                <button type="button" class="forum-mention-chip rounded-full bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] text-slate-500 hover:bg-blue-100 hover:text-blue-700 dark:hover:bg-blue-950/40" data-name={name}>{name}</button>
              ))}
            </div>
          )}
          <form id="forum-reply-form" class="mt-4 space-y-3">
            <textarea
              id="forum-reply-body"
              rows="6"
              minlength="5"
              required
              placeholder="Viết câu trả lời của bạn... Ví dụ: Áp dụng công thức $y' = \frac{3}{(x+2)^2}$ nên..."
              class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
            ></textarea>
            <div class="hidden" aria-hidden="true">
              <label for="forum-reply-website">Website</label>
              <input id="forum-reply-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <label class="cursor-pointer rounded-lg border border-slate-200 px-2.5 py-1.5 text-[11px] font-semibold text-slate-500 hover:border-blue-300 hover:text-blue-600 dark:border-slate-700">
                  📎 Đính kèm
                  <input id="forum-reply-file" type="file" accept="image/png,image/jpeg,image/gif,image/webp,application/pdf" class="hidden" />
                </label>
                <span id="forum-reply-status" class="text-xs text-slate-500"></span>
              </div>
              <button type="submit" class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-blue-700 transition disabled:opacity-60">
                Gửi trả lời
              </button>
            </div>
          </form>
        </section>
      ) : (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 text-center">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            {user ? 'Bài viết này đã bị khoá, không thể trả lời.' : 'Bạn cần đăng nhập để trả lời bài viết này.'}
          </p>
          {!user && <a href="/login" class="mt-3 inline-block rounded-xl bg-blue-600 px-5 py-2 text-sm font-bold text-white hover:bg-blue-700">Đăng nhập</a>}
        </div>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="space-y-5">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5">
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">📊 Thông tin bài viết</h2>
        <dl class="mt-3 space-y-2 text-xs">
          <div class="flex justify-between"><dt class="text-slate-500">Trạng thái</dt><dd class="font-semibold text-slate-700 dark:text-slate-200">{thread.status === 'solved' ? 'Đã giải' : 'Chưa giải'}</dd></div>
          <div class="flex justify-between"><dt class="text-slate-500">Lượt xem</dt><dd class="font-semibold text-slate-700 dark:text-slate-200">{forumNumber(thread.views_count)}</dd></div>
          <div class="flex justify-between"><dt class="text-slate-500">Trả lời</dt><dd class="font-semibold text-slate-700 dark:text-slate-200">{posts.length}</dd></div>
          <div class="flex justify-between"><dt class="text-slate-500">Cảm xúc</dt><dd class="font-semibold text-slate-700 dark:text-slate-200">{reactions.length}</dd></div>
          <div class="flex justify-between"><dt class="text-slate-500">Ngày đăng</dt><dd class="font-semibold text-slate-700 dark:text-slate-200">{forumDate(thread.created_at)}</dd></div>
        </dl>
      </div>

      {related.length > 0 && (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5">
          <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">🔗 Câu hỏi liên quan</h2>
          <ul class="mt-3 space-y-3">
            {related.map(item => (
              <li>
                <a href={`/hoc-sinh/${item.category?.slug}/${item.slug}`} class="block text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-blue-600 hover:underline line-clamp-2">{item.title}</a>
                <span class="mt-0.5 block text-[10px] text-slate-400">{item.reply_count} trả lời · {forumNumber(item.views_count)} xem</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5">
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">🤝 Tham gia thảo luận</h2>
        <ul class="mt-3 space-y-2 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          <li>✓ Giải thích rõ cách làm, không chỉ đáp án.</li>
          <li>✓ Dùng LaTeX cho công thức để dễ đọc.</li>
          <li>✓ Tôn trọng mọi người, không chê bai câu hỏi.</li>
          <li>✓ Chọn <strong>Đáp án được chấp nhận</strong> nếu bạn là người hỏi.</li>
        </ul>
      </div>
    </aside>
  </div>
</Layout>

<style is:global>
  .forum-content .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    max-width: 100%;
    padding: 0.5rem 0 !important;
    margin: 0.75rem 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  .forum-content pre {
    overflow-x: auto;
  }
</style>

<script is:inline define:vars={{ threadId: thread.id, threadTitle: thread.title, initialReplyCount: thread.reply_count ?? 0 }}>
  (function () {
    // Đếm lượt xem (không cache ở API nên vẫn chính xác với trang public).
    fetch(window.withBase('/api/forum/threads/' + encodeURIComponent(threadId) + '/view'), {
      method: 'POST',
    }).catch(function () {});

    var form = document.getElementById('forum-reply-form');
    var bodyInput = document.getElementById('forum-reply-body');
    var statusEl = document.getElementById('forum-reply-status');
    var submitBtn = form && form.querySelector('button[type="submit"]');

    function setStatus(text, isError) {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.className = 'text-xs ' + (isError ? 'text-rose-600' : 'text-slate-500');
    }

    if (form) {
      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        var text = (bodyInput && bodyInput.value || '').trim();
        if (text.length < 5) {
          setStatus('Nội dung quá ngắn (tối thiểu 5 ký tự).', true);
          return;
        }
        if (submitBtn) submitBtn.disabled = true;
        setStatus('Đang gửi...', false);
        try {
          var response = await fetch(window.withBase('/api/forum/posts'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              threadId: threadId,
              body: text,
              website: (document.getElementById('forum-reply-website') || {}).value || '',
            }),
          });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể gửi trả lời.');
          window.location.reload();
        } catch (error) {
          setStatus(error.message || 'Có lỗi xảy ra.', true);
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }

    // Gợi ý nháp bằng endpoint AI có sẵn của dự án.
    var aiBtn = document.getElementById('forum-ai-draft');
    if (aiBtn && bodyInput) {
      aiBtn.addEventListener('click', async function () {
        aiBtn.disabled = true;
        setStatus('AI đang soạn gợi ý...', false);
        try {
          var response = await fetch(window.withBase('/api/ai'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Hãy soạn một câu trả lời ngắn gọn, dễ hiểu cho câu hỏi sau của học sinh lớp 12. ' +
                'Giải thích từng bước, dùng Markdown và LaTeX cho công thức. ' +
                'Chỉ trả về nội dung câu trả lời, không thêm lời dẫn.\n\nCâu hỏi: ' + threadTitle + '\n\n' + (bodyInput.value || ''),
            }),
          });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể gọi AI.');
          bodyInput.value = data.response || '';
          bodyInput.focus();
          setStatus('Đã điền gợi ý. Bạn hãy kiểm tra lại trước khi gửi nhé!', false);
        } catch (error) {
          setStatus(error.message || 'AI tạm thời không khả dụng.', true);
        } finally {
          aiBtn.disabled = false;
        }
      });
    }

    document.querySelectorAll('.forum-accept-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        if (!window.confirm('Chọn câu trả lời này là đáp án được chấp nhận?')) return;
        btn.disabled = true;
        try {
          var response = await fetch(window.withBase('/api/forum/threads/' + encodeURIComponent(threadId) + '/accept'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId: btn.getAttribute('data-post-id') }),
          });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể chọn đáp án.');
          window.location.reload();
        } catch (error) {
          window.alert(error.message || 'Có lỗi xảy ra.');
          btn.disabled = false;
        }
      });
    });

    // ── Phase 2–4: cảm xúc, lưu bài, theo dõi, báo cáo, kiểm duyệt, upload ──
    async function api(path, options) {
      var response = await fetch(window.withBase(path), options);
      var data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Có lỗi xảy ra.');
      return data;
    }

    document.querySelectorAll('.forum-react-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        btn.disabled = true;
        try {
          var data = await api('/api/forum/posts/' + encodeURIComponent(btn.getAttribute('data-post-id')) + '/react', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ kind: btn.getAttribute('data-kind') }),
          });
          document.querySelectorAll('.forum-react-btn[data-post-id="' + btn.getAttribute('data-post-id') + '"]').forEach(function (other) {
            var kind = other.getAttribute('data-kind');
            var el = other.querySelector('[data-reaction-count]');
            if (el) el.textContent = String((data.counts && data.counts[kind]) || 0);
            var active = data.kind === kind;
            other.classList.toggle('border-blue-400', active);
            other.classList.toggle('bg-blue-50', active);
            other.classList.toggle('text-blue-700', active);
            other.classList.toggle('dark:bg-blue-950/40', active);
            other.classList.toggle('dark:text-blue-300', active);
          });
        } catch (error) {
          window.alert(error.message);
        } finally {
          btn.disabled = false;
        }
      });
    });

    document.querySelectorAll('.forum-state-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var isBookmark = btn.id === 'forum-bookmark-btn';
        var path = isBookmark ? '/bookmark' : '/follow';
        btn.disabled = true;
        try {
          var data = await api('/api/forum/threads/' + encodeURIComponent(threadId) + path, { method: 'POST' });
          btn.setAttribute('data-active', data.active ? 'true' : 'false');
          btn.textContent = isBookmark
            ? (data.active ? '🔖 Đã lưu' : '🔖 Lưu bài')
            : (data.active ? '🔔 Đang theo dõi' : '🔔 Theo dõi');
        } catch (error) {
          window.alert(error.message);
        } finally {
          btn.disabled = false;
        }
      });
    });

    document.querySelectorAll('.forum-report-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var reasons = ['spam', 'offtopic', 'abuse', 'wrong', 'other'];
        var reason = window.prompt('Lý do báo cáo (spam, offtopic, abuse, wrong, other):', 'spam');
        if (!reason) return;
        reason = reason.trim().toLowerCase();
        if (reasons.indexOf(reason) < 0) { window.alert('Lý do không hợp lệ.'); return; }
        var details = window.prompt('Mô tả thêm (không bắt buộc):', '') || '';
        btn.disabled = true;
        try {
          await api('/api/forum/reports', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              threadId: btn.getAttribute('data-thread-id'),
              postId: btn.getAttribute('data-post-id'),
              reason: reason, details: details,
            }),
          });
          window.alert('Đã gửi báo cáo. Cảm ơn bạn!');
        } catch (error) {
          window.alert(error.message);
        } finally {
          btn.disabled = false;
        }
      });
    });

    document.querySelectorAll('.forum-moderate-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        if (!window.confirm('Thực hiện hành động kiểm duyệt này?')) return;
        btn.disabled = true;
        try {
          await api('/api/forum/threads/' + encodeURIComponent(threadId) + '/moderate', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: btn.getAttribute('data-action') }),
          });
          window.location.reload();
        } catch (error) {
          window.alert(error.message);
          btn.disabled = false;
        }
      });
    });

    document.querySelectorAll('.forum-mention-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        if (!bodyInput) return;
        var value = bodyInput.value;
        bodyInput.value = (value && !/\s$/.test(value) ? value + ' ' : value) + '@' + chip.getAttribute('data-name') + ' ';
        bodyInput.focus();
      });
    });

    function insertAtCursor(textarea, text) {
      var start = textarea.selectionStart || 0;
      var end = textarea.selectionEnd || 0;
      var val = textarea.value;
      textarea.value = val.substring(0, start) + text + val.substring(end);
      textarea.selectionStart = textarea.selectionEnd = start + text.length;
      textarea.focus();
    }

    // Hỗ trợ dán (paste) trực tiếp hình ảnh đã copy từ trang web khác hoặc ảnh chụp màn hình
    if (bodyInput) {
      bodyInput.addEventListener('paste', async function (event) {
        var clipboardData = event.clipboardData || window.clipboardData;
        if (!clipboardData) return;

        var items = clipboardData.items;
        var imageFile = null;
        if (items) {
          for (var i = 0; i < items.length; i++) {
            if (items[i].type && items[i].type.indexOf('image/') !== -1) {
              imageFile = items[i].getAsFile();
              break;
            }
          }
        }
        if (!imageFile && clipboardData.files && clipboardData.files.length > 0) {
          for (var j = 0; j < clipboardData.files.length; j++) {
            if (clipboardData.files[j].type && clipboardData.files[j].type.indexOf('image/') !== -1) {
              imageFile = clipboardData.files[j];
              break;
            }
          }
        }

        if (imageFile) {
          event.preventDefault();
          var placeholder = '\n![Đang tải ảnh lên...](' + Date.now() + ')\n';
          insertAtCursor(bodyInput, placeholder);
          setStatus('Đang tải ảnh dán lên...', false);

          try {
            var form = new FormData();
            var fileName = imageFile.name || ('pasted-image-' + Date.now() + '.png');
            form.append('file', imageFile, fileName);

            var response = await fetch(window.withBase('/api/forum/upload'), { method: 'POST', body: form });
            var data = await response.json();
            if (response.ok && data.url) {
              bodyInput.value = bodyInput.value.replace(placeholder, '\n![' + (data.name || 'Hình ảnh') + '](' + data.url + ')\n');
              setStatus('Đã dán ảnh thành công!', false);
            } else {
              throw new Error(data.error || 'Upload thất bại.');
            }
          } catch (err) {
            var reader = new FileReader();
            reader.onload = function (e) {
              var dataUrl = e.target && e.target.result;
              if (dataUrl) {
                bodyInput.value = bodyInput.value.replace(placeholder, '\n![Hình ảnh](' + dataUrl + ')\n');
                setStatus('Đã dán ảnh!', false);
              } else {
                bodyInput.value = bodyInput.value.replace(placeholder, '');
                setStatus('Không thể dán ảnh: ' + (err.message || 'Lỗi'), true);
              }
            };
            reader.readAsDataURL(imageFile);
          }
          return;
        }

        var html = clipboardData.getData('text/html');
        if (html && !clipboardData.getData('text/plain').includes('http')) {
          var match = html.match(/<img[^>]+src=["']([^"']+)["']/i);
          if (match && match[1]) {
            var imgSrc = match[1];
            if (imgSrc.startsWith('http://') || imgSrc.startsWith('https://') || imgSrc.startsWith('data:image/')) {
              event.preventDefault();
              insertAtCursor(bodyInput, '\n![Hình ảnh](' + imgSrc + ')\n');
              setStatus('Đã chèn ảnh từ trang web!', false);
            }
          }
        }
      });
    }

    var fileInput = document.getElementById('forum-reply-file');
    if (fileInput && bodyInput) {
      fileInput.addEventListener('change', async function () {
        var file = fileInput.files && fileInput.files[0];
        if (!file) return;
        setStatus('Đang upload tệp...', false);
        var form = new FormData();
        form.append('file', file);
        try {
          var response = await fetch(window.withBase('/api/forum/upload'), { method: 'POST', body: form });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể upload.');
          bodyInput.value += (bodyInput.value ? '\n\n' : '') + '![' + file.name + '](' + data.url + ')';
          setStatus('Đã chèn liên kết tệp vào nội dung.', false);
        } catch (error) {
          setStatus(error.message || 'Upload thất bại.', true);
        }
        fileInput.value = '';
      });
    }

    var summaryBtn = document.getElementById('forum-ai-summary-btn');
    if (summaryBtn) {
      summaryBtn.addEventListener('click', async function () {
        summaryBtn.disabled = true;
        setStatus('AI đang tóm tắt...', false);
        try {
          var ai = await api('/api/ai', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: 'Tóm tắt trong 2-3 câu nội dung câu hỏi và hướng giải quyết sau (tiếng Việt):\n\n' + threadTitle }),
          });
          var summary = String(ai.response || '').trim();
          await api('/api/forum/threads/' + encodeURIComponent(threadId) + '/summary', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ summary: summary }),
          });
          window.location.reload();
        } catch (error) {
          setStatus(error.message || 'Không thể tóm tắt.', true);
          summaryBtn.disabled = false;
        }
      });
    }

    var toQuestionBtn = document.getElementById('forum-to-question-btn');
    if (toQuestionBtn) {
      toQuestionBtn.addEventListener('click', async function () {
        if (!window.confirm('Chuyển câu hỏi này (kèm đáp án được chấp nhận) vào ngân hàng đề?')) return;
        toQuestionBtn.disabled = true;
        try {
          await api('/api/forum/threads/' + encodeURIComponent(threadId) + '/to-question', { method: 'POST' });
          window.alert('Đã thêm vào ngân hàng câu hỏi.');
        } catch (error) {
          window.alert(error.message);
        } finally {
          toQuestionBtn.disabled = false;
        }
      });
    }

    // Phase 2: polling nhẹ để báo "có trả lời mới" mà không cần Supabase Realtime.
    var banner = document.getElementById('forum-new-reply-banner');
    var bannerText = document.getElementById('forum-new-reply-text');
    var reloadBtn = document.getElementById('forum-reload-btn');
    var lastReplyCount = initialReplyCount;
    if (banner && reloadBtn) {
      reloadBtn.addEventListener('click', function () { window.location.reload(); });
      setInterval(async function () {
        try {
          var response = await fetch(window.withBase('/api/forum/threads/' + encodeURIComponent(threadId) + '/activity'), { cache: 'no-store' });
          if (!response.ok) return;
          var data = await response.json();
          if (data.reply_count > lastReplyCount) {
            lastReplyCount = data.reply_count;
            if (bannerText) bannerText.textContent = '💬 Có ' + data.reply_count + ' trả lời mới.';
            banner.classList.remove('hidden');
            banner.classList.add('flex');
          }
        } catch (error) {
          // Không làm phiền người dùng khi mất mạng — lần poll sau sẽ thử lại.
        }
      }, 20000);
    }
  })();
</script>
