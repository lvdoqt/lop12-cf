---
import Layout from '../../../layouts/Layout.astro';
import ForumThreadList from '../../../components/forum/ForumThreadList.astro';
import { db } from '../../../services/db';
import type { ForumThreadStatus } from '../../../types';

const slug = Astro.params.category || '';
const category = await db.getForumCategoryBySlug(slug);
if (!category) {
  return Astro.redirect('/hoc-sinh');
}

const q = Astro.url.searchParams.get('q')?.trim() || '';
const statusParam = Astro.url.searchParams.get('status') || 'all';
const status = (['all', 'open', 'solved'] as const).includes(statusParam as any)
  ? statusParam as ForumThreadStatus | 'all'
  : 'all';
const sortParam = Astro.url.searchParams.get('sort') || 'latest';
const sort = (['latest', 'active', 'popular'] as const).includes(sortParam as any)
  ? sortParam as 'latest' | 'active' | 'popular'
  : 'latest';
const tag = Astro.url.searchParams.get('tag')?.trim() || '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const pageSize = 20;

const [threadPage, allCategories, categoryThreads] = await Promise.all([
  db.getForumThreadPage({ categoryId: category.id, search: q, status, sort, tag }, page, pageSize),
  db.getForumCategories(),
  db.getForumThreads({ categoryId: category.id, limit: 200 }),
]);
const threads = threadPage.threads;

const popularTags = Array.from(
  categoryThreads.reduce((map, thread) => {
    (thread.tags || []).forEach(t => map.set(t, (map.get(t) || 0) + 1));
    return map;
  }, new Map<string, number>())
).sort((a, b) => b[1] - a[1]).slice(0, 8);
---

<Layout
  title={`${category.name} | Diễn đàn Học sinh`}
  description={category.description || `Thảo luận và hỏi đáp về ${category.name} cùng cộng đồng học sinh Lớp 12.`}
  canonical={`/hoc-sinh/${category.slug}`}
  breadcrumbs={[{ name: 'Diễn đàn Học sinh', url: '/hoc-sinh' }, { name: category.name, url: `/hoc-sinh/${category.slug}` }]}
>
  <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
    <ForumThreadList
      threads={threads}
      category={category}
      actionUrl={`/hoc-sinh/${category.slug}`}
      search={q}
      status={status}
      sort={sort}
      tag={tag}
      page={threadPage.page}
      total={threadPage.total}
      pageSize={threadPage.pageSize}
    />

    <aside class="space-y-5">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5">
        <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">📂 Chuyên mục khác</h2>
        <ul class="mt-3 space-y-1">
          {allCategories.filter(c => c.id !== category.id).map(c => (
            <li>
              <a
                href={`/hoc-sinh/${c.slug}`}
                class="flex items-center justify-between rounded-lg px-3 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition"
              >
                <span class="flex items-center gap-2"><span>{c.icon}</span>{c.name}</span>
                <span class="text-[11px] text-slate-400">{c.thread_count || 0}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {popularTags.length > 0 && (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5">
          <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">🏷️ Chủ đề phổ biến</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {popularTags.map(([name, count]) => (
              <a
                href={`/hoc-sinh/${category.slug}?tag=${encodeURIComponent(name)}`}
                class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-blue-100 hover:text-blue-700 dark:hover:bg-blue-950/50 transition"
              >
                #{name} <span class="text-slate-400">({count})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="rounded-2xl border border-blue-200 dark:border-blue-900/50 bg-blue-50/70 dark:bg-blue-950/20 p-5">
        <div class="text-2xl">💡</div>
        <h2 class="mt-2 text-sm font-extrabold text-blue-900 dark:text-blue-200">Hỏi bài hiệu quả hơn</h2>
        <p class="mt-2 text-xs leading-relaxed text-blue-800/80 dark:text-blue-300/70">
          Gõ rõ đề bài, kèm công thức bạn đã thử ($...$) và chỗ bạn bị kẹt. Câu hỏi cụ thể thường được giải đáp nhanh hơn!
        </p>
      </div>
    </aside>
  </div>
</Layout>
