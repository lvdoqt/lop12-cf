---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../services/db';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const categories = await db.getForumCategories();
const presetSlug = Astro.url.searchParams.get('chuyen-muc') || '';
---

<Layout
  title="Đăng bài mới | Diễn đàn Học sinh"
  description="Đặt câu hỏi hoặc chia sẻ kinh nghiệm học tập với cộng đồng học sinh Lớp 12."
  canonical="/hoc-sinh/dang-bai"
  noindex={true}
  breadcrumbs={[
    { name: 'Diễn đàn Học sinh', url: '/hoc-sinh' },
    { name: 'Đăng bài mới', url: '/hoc-sinh/dang-bai' },
  ]}
>
  <div class="mx-auto max-w-3xl space-y-6">
    <div>
      <a href="/hoc-sinh" class="text-xs font-semibold text-blue-600 hover:underline">← Về diễn đàn</a>
      <h1 class="mt-3 text-2xl font-extrabold text-slate-900 dark:text-white md:text-3xl">✍️ Đăng bài mới</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Câu hỏi càng cụ thể, câu trả lời càng hữu ích. Bạn có thể dùng Markdown và công thức LaTeX ($...$).
      </p>
    </div>

    <form id="forum-new-thread-form" class="space-y-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-7">
      <div>
        <label for="forum-category" class="block text-sm font-bold text-slate-800 dark:text-slate-200">Chuyên mục <span class="text-rose-500">*</span></label>
        <select
          id="forum-category"
          required
          class="mt-2 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
        >
          <option value="">-- Chọn chuyên mục --</option>
          {categories.map(cat => (
            <option value={cat.id} selected={cat.slug === presetSlug}>{cat.icon} {cat.name}</option>
          ))}
        </select>
      </div>

      <div>
        <div class="flex items-center justify-between gap-3">
          <label for="forum-title" class="block text-sm font-bold text-slate-800 dark:text-slate-200">Tiêu đề <span class="text-rose-500">*</span></label>
          <span class="text-[11px] text-slate-400">10–200 ký tự</span>
        </div>
        <input
          id="forum-title"
          type="text"
          minlength="10"
          maxlength="200"
          required
          placeholder="Ví dụ: Cách khảo sát sự biến thiên của y = (x-1)/(x+2)?"
          class="mt-2 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
        />
      </div>

      <div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <label for="forum-body" class="block text-sm font-bold text-slate-800 dark:text-slate-200">Nội dung <span class="text-rose-500">*</span></label>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" id="forum-ai-meta" class="rounded-lg border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 px-3 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 transition">
              🏷️ AI gợi ý tag
            </button>
            <button type="button" id="forum-ai-draft" class="rounded-lg border border-violet-300 dark:border-violet-800 bg-violet-50 dark:bg-violet-950/30 px-3 py-1.5 text-xs font-bold text-violet-700 dark:text-violet-300 hover:bg-violet-100 transition">
              ✨ Soạn nháp bằng AI
            </button>
          </div>
        </div>
        <textarea
          id="forum-body"
          rows="10"
          minlength="20"
          required
          placeholder={'Hãy mô tả rõ bài toán, những gì bạn đã thử và chỗ bạn bị kẹt.\n\nVí dụ: Em tính được $y\' = \\dfrac{3}{(x+2)^2}$ nhưng không biết kết luận đồng biến trên $\\mathbb{R}$ được không ạ?'}
          class="mt-2 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-sm leading-relaxed text-slate-800 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
        ></textarea>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <p class="text-[11px] text-slate-400">Hỗ trợ: **đậm**, `code`, $latex$, $$block math$$, dán ảnh (Ctrl+V) trực tiếp từ web khác.</p>
          <label class="cursor-pointer rounded-lg border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-500 hover:border-blue-300 hover:text-blue-600 dark:border-slate-700">
            📎 Ảnh / PDF (tối đa 5 MB)
            <input id="forum-upload-file" type="file" accept="image/png,image/jpeg,image/gif,image/webp,application/pdf" class="hidden" />
          </label>
        </div>
        <input id="forum-summary" type="hidden" />
        <div class="hidden" aria-hidden="true">
          <label for="forum-website">Website</label>
          <input id="forum-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="forum-tags" class="block text-sm font-bold text-slate-800 dark:text-slate-200">Tags</label>
          <input
            id="forum-tags"
            type="text"
            placeholder="dao-ham, khao-sat-ham-so"
            class="mt-2 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 outline-none focus:border-blue-500"
          />
          <p class="mt-1 text-[11px] text-slate-400">Tối đa 5 tag, cách nhau bằng dấu phẩy.</p>
        </div>
        <label class="flex items-start gap-3 rounded-xl border border-slate-200 dark:border-slate-700 px-4 py-3 cursor-pointer">
          <input id="forum-anonymous" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600" />
          <span>
            <span class="block text-sm font-semibold text-slate-800 dark:text-slate-200">Đăng ẩn danh</span>
            <span class="mt-0.5 block text-[11px] text-slate-500">Tên của bạn sẽ không hiển thị trên bài viết.</span>
          </span>
        </label>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 dark:border-slate-800 pt-5">
        <p id="forum-form-status" class="text-xs text-slate-500"></p>
        <div class="flex gap-3">
          <a href="/hoc-sinh" class="rounded-xl border border-slate-200 dark:border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800">Huỷ</a>
          <button type="submit" class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white hover:bg-blue-700 transition disabled:opacity-60">
            Đăng bài
          </button>
        </div>
      </div>
    </form>
  </div>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('forum-new-thread-form');
    var titleInput = document.getElementById('forum-title');
    var bodyInput = document.getElementById('forum-body');
    var tagsInput = document.getElementById('forum-tags');
    var categorySelect = document.getElementById('forum-category');
    var statusEl = document.getElementById('forum-form-status');
    var submitBtn = form && form.querySelector('button[type="submit"]');

    function setStatus(text, isError) {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.className = 'text-xs ' + (isError ? 'text-rose-600' : 'text-slate-500');
    }

    if (form) {
      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        var title = (titleInput && titleInput.value || '').trim();
        var body = (bodyInput && bodyInput.value || '').trim();
        if (title.length < 10) { setStatus('Tiêu đề phải từ 10 ký tự.', true); return; }
        if (body.length < 20) { setStatus('Nội dung phải từ 20 ký tự.', true); return; }
        if (!categorySelect || !categorySelect.value) { setStatus('Vui lòng chọn chuyên mục.', true); return; }

        if (submitBtn) submitBtn.disabled = true;
        setStatus('Đang đăng bài...', false);
        try {
          var response = await fetch(window.withBase('/api/forum/threads'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              categoryId: categorySelect.value,
              title: title,
              body: body,
              tags: (tagsInput && tagsInput.value || '').split(',').map(function (t) { return t.trim(); }).filter(Boolean),
              isAnonymous: !!(document.getElementById('forum-anonymous') || {}).checked,
              summary: (document.getElementById('forum-summary') || {}).value || '',
              website: (document.getElementById('forum-website') || {}).value || '',
            }),
          });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể đăng bài.');
          window.location.href = window.withBase(data.url);
        } catch (error) {
          setStatus(error.message || 'Có lỗi xảy ra.', true);
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }

    var aiBtn = document.getElementById('forum-ai-draft');
    if (aiBtn && titleInput && bodyInput) {
      aiBtn.addEventListener('click', async function () {
        aiBtn.disabled = true;
        setStatus('AI đang soạn nháp...', false);
        try {
          var response = await fetch(window.withBase('/api/ai'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Hãy soạn nháp một bài hỏi đáp trên diễn đàn học sinh lớp 12 dựa trên tiêu đề và gợi ý sau. ' +
                'Bài viết cần: nêu rõ đề bài/ngữ cảnh, những gì người hỏi đã thử, và chỗ còn bối rối. ' +
                'Dùng Markdown và LaTeX. Chỉ trả về nội dung bài viết.\n\n' +
                'Tiêu đề: ' + (titleInput.value || '(chưa có)') + '\n\nGợi ý: ' + (bodyInput.value || '(chưa có)'),
            }),
          });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể gọi AI.');
          if (bodyInput.value.trim()) {
            bodyInput.value = bodyInput.value.trim() + '\n\n---\n\n' + data.response;
          } else {
            bodyInput.value = data.response || '';
          }
          setStatus('Đã điền nháp. Bạn hãy chỉnh sửa cho đúng ý mình trước khi đăng!', false);
        } catch (error) {
          setStatus(error.message || 'AI tạm thời không khả dụng.', true);
        } finally {
          aiBtn.disabled = false;
        }
      });
    }

    // Phase 4: AI gợi ý tag + tóm tắt ngắn (parse JSON, fallback an toàn).
    var metaBtn = document.getElementById('forum-ai-meta');
    if (metaBtn && titleInput && bodyInput) {
      metaBtn.addEventListener('click', async function () {
        metaBtn.disabled = true;
        setStatus('AI đang gợi ý tag...', false);
        try {
          var response = await fetch(window.withBase('/api/ai'), {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Hãy trả về DUY NHẤT một đối tượng JSON hợp lệ dạng {"tags":["tag1","tag2"],"summary":"..."} cho bài hỏi đáp sau. ' +
                'tags là tối đa 5 từ khoá tiếng Việt viết thường, không dấu, nối bằng dấu gạch ngang. ' +
                'summary là 1-2 câu tiếng Việt tóm tắt.\n\nTiêu đề: ' + (titleInput.value || '') + '\n\nNội dung: ' + (bodyInput.value || '').slice(0, 1500),
            }),
          });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể gọi AI.');
          var text = String(data.response || '');
          var match = text.match(/\{[\s\S]*\}/);
          if (!match) throw new Error('AI không trả về định dạng mong đợi.');
          var meta = JSON.parse(match[0]);
          if (tagsInput && Array.isArray(meta.tags)) {
            tagsInput.value = meta.tags.slice(0, 5).map(function (t) { return String(t).trim().toLowerCase().replace(/\s+/g, '-'); }).join(', ');
          }
          var summaryInput = document.getElementById('forum-summary');
          if (summaryInput && meta.summary) summaryInput.value = String(meta.summary).slice(0, 600);
          setStatus('Đã gợi ý tag và tóm tắt. Bạn có thể chỉnh lại trước khi đăng!', false);
        } catch (error) {
          setStatus(error.message || 'AI tạm thời không khả dụng.', true);
        } finally {
          metaBtn.disabled = false;
        }
      });
    }

    function insertAtCursor(textarea, text) {
      var start = textarea.selectionStart || 0;
      var end = textarea.selectionEnd || 0;
      var val = textarea.value;
      textarea.value = val.substring(0, start) + text + val.substring(end);
      textarea.selectionStart = textarea.selectionEnd = start + text.length;
      textarea.focus();
    }

    // Hỗ trợ dán (paste) trực tiếp hình ảnh đã copy từ trang web khác hoặc ảnh chụp màn hình
    if (bodyInput) {
      bodyInput.addEventListener('paste', async function (event) {
        var clipboardData = event.clipboardData || window.clipboardData;
        if (!clipboardData) return;

        var items = clipboardData.items;
        var imageFile = null;
        if (items) {
          for (var i = 0; i < items.length; i++) {
            if (items[i].type && items[i].type.indexOf('image/') !== -1) {
              imageFile = items[i].getAsFile();
              break;
            }
          }
        }
        if (!imageFile && clipboardData.files && clipboardData.files.length > 0) {
          for (var j = 0; j < clipboardData.files.length; j++) {
            if (clipboardData.files[j].type && clipboardData.files[j].type.indexOf('image/') !== -1) {
              imageFile = clipboardData.files[j];
              break;
            }
          }
        }

        if (imageFile) {
          event.preventDefault();
          var placeholder = '\n![Đang tải ảnh lên...](' + Date.now() + ')\n';
          insertAtCursor(bodyInput, placeholder);
          setStatus('Đang tải ảnh dán lên...', false);

          try {
            var form = new FormData();
            var fileName = imageFile.name || ('pasted-image-' + Date.now() + '.png');
            form.append('file', imageFile, fileName);

            var response = await fetch(window.withBase('/api/forum/upload'), { method: 'POST', body: form });
            var data = await response.json();
            if (response.ok && data.url) {
              bodyInput.value = bodyInput.value.replace(placeholder, '\n![' + (data.name || 'Hình ảnh') + '](' + data.url + ')\n');
              setStatus('Đã dán ảnh thành công!', false);
            } else {
              throw new Error(data.error || 'Upload thất bại.');
            }
          } catch (err) {
            var reader = new FileReader();
            reader.onload = function (e) {
              var dataUrl = e.target && e.target.result;
              if (dataUrl) {
                bodyInput.value = bodyInput.value.replace(placeholder, '\n![Hình ảnh](' + dataUrl + ')\n');
                setStatus('Đã dán ảnh!', false);
              } else {
                bodyInput.value = bodyInput.value.replace(placeholder, '');
                setStatus('Không thể dán ảnh: ' + (err.message || 'Lỗi'), true);
              }
            };
            reader.readAsDataURL(imageFile);
          }
          return;
        }

        var html = clipboardData.getData('text/html');
        if (html && !clipboardData.getData('text/plain').includes('http')) {
          var match = html.match(/<img[^>]+src=["']([^"']+)["']/i);
          if (match && match[1]) {
            var imgSrc = match[1];
            if (imgSrc.startsWith('http://') || imgSrc.startsWith('https://') || imgSrc.startsWith('data:image/')) {
              event.preventDefault();
              insertAtCursor(bodyInput, '\n![Hình ảnh](' + imgSrc + ')\n');
              setStatus('Đã chèn ảnh từ trang web!', false);
            }
          }
        }
      });
    }

    var uploadInput = document.getElementById('forum-upload-file');
    if (uploadInput && bodyInput) {
      uploadInput.addEventListener('change', async function () {
        var file = uploadInput.files && uploadInput.files[0];
        if (!file) return;
        setStatus('Đang upload tệp...', false);
        var form = new FormData();
        form.append('file', file);
        try {
          var response = await fetch(window.withBase('/api/forum/upload'), { method: 'POST', body: form });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Không thể upload.');
          bodyInput.value += (bodyInput.value ? '\n\n' : '') + '![' + file.name + '](' + data.url + ')';
          setStatus('Đã chèn tệp vào nội dung.', false);
        } catch (error) {
          setStatus(error.message || 'Upload thất bại.', true);
        }
        uploadInput.value = '';
      });
    }
  })();
</script>
