---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../services/db';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/khoa-hoc');

const user = Astro.locals.user;
const course = await db.getCourseBySlug(slug);
if (!course || !course.is_published) return Astro.redirect('/khoa-hoc');

const lessons = await db.getCourseLessons(course.id);
const publishedLessons = lessons.filter(l => l.is_published);
const reviewQuizCounts = new Map(await Promise.all(
  publishedLessons.map(async lesson => [lesson.id, (await db.getLessonReviewQuestions(lesson.id)).length] as const),
));

let isEnrolled = false;
let completedIds = new Set<string>();
let learnerInsights: Awaited<ReturnType<typeof db.getUserCourseInsights>> | null = null;

if (user) {
  isEnrolled = await db.isUserEnrolled(course.id, user.id);
  if (isEnrolled) {
    learnerInsights = await db.getUserCourseInsights(user.id, course.id);
    learnerInsights.lessonProgress.filter(p => p.completed).forEach(p => completedIds.add(p.lesson_id));
  }
}

const progressPct = publishedLessons.length > 0 ? Math.round((completedIds.size / publishedLessons.length) * 100) : 0;
const progressByLesson = new Map(learnerInsights?.lessonProgress.map(progress => [progress.lesson_id, progress]) || []);
const weakSkills = learnerInsights?.skills.filter(skill => skill.mastery_score < 70 || skill.wrong_attempts >= 2).slice(0, 4) || [];
const lastActiveLessonId = learnerInsights?.lessonProgress
  .filter(progress => !progress.completed && publishedLessons.some(lesson => lesson.id === progress.lesson_id))
  .sort((a, b) => new Date(b.last_accessed_at || b.updated_at || 0).getTime() - new Date(a.last_accessed_at || a.updated_at || 0).getTime())[0]?.lesson_id;
const resumeLessonId = lastActiveLessonId || publishedLessons.find(lesson => !completedIds.has(lesson.id))?.id || publishedLessons[0]?.id;
function formatStudyTime(seconds: number) {
  if (seconds < 60) return `${seconds} giây`;
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  return hours > 0 ? `${hours} giờ ${minutes} phút` : `${minutes} phút`;
}
---

<Layout title={course.title} description={course.description || undefined} showSidebar={false}>
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Back -->
    <a href="/khoa-hoc" class="inline-flex items-center text-sm font-semibold text-gray-400 hover:text-gray-600 dark:hover:text-slate-300 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      Tất cả khóa học
    </a>

    <!-- Course Header -->
    <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-2xl p-8 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none"><circle cx="80" cy="20" r="30" fill="currentColor"/><circle cx="10" cy="80" r="25" fill="currentColor"/></svg>
      </div>
      <div class="relative">
        {course.subject && (
          <span class="inline-block bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full mb-3">{course.subject.name}</span>
        )}
        <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-3">{course.title}</h1>
        {course.description && <p class="text-white/80 text-sm leading-relaxed max-w-2xl">{course.description}</p>}
        <div class="flex items-center gap-6 mt-5 text-sm text-white/70">
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
            {publishedLessons.length} bài giảng
          </span>
          {isEnrolled && (
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {completedIds.size}/{publishedLessons.length} đã học
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- Progress bar (if enrolled) -->
    {isEnrolled && (
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-5 space-y-4">
        <div class="flex items-center justify-between mb-2">
          <p class="text-sm font-bold text-gray-700 dark:text-slate-200">Tiến độ học tập</p>
          <span class="text-sm font-bold text-blue-600 dark:text-blue-400">{progressPct}%</span>
        </div>
        <div class="w-full bg-gray-100 dark:bg-slate-800 rounded-full h-2.5">
          <div class="bg-blue-600 h-2.5 rounded-full transition-all duration-500" style={`width: ${progressPct}%`}></div>
        </div>
        {learnerInsights && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-1">
            <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3">
              <p class="text-lg font-extrabold text-slate-900 dark:text-white">{formatStudyTime(learnerInsights.totalTimeSpentSeconds)}</p>
              <p class="text-[11px] font-semibold text-slate-500">Thời gian học</p>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3">
              <p class="text-lg font-extrabold text-slate-900 dark:text-white">{learnerInsights.averageVideoPercent === null ? '—' : `${learnerInsights.averageVideoPercent}%`}</p>
              <p class="text-[11px] font-semibold text-slate-500">Video đã xem</p>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3">
              <p class="text-lg font-extrabold text-slate-900 dark:text-white">{learnerInsights.totalAttempts}</p>
              <p class="text-[11px] font-semibold text-slate-500">Lượt làm quiz</p>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3">
              <p class={`text-lg font-extrabold ${learnerInsights.wrongAttempts > 0 ? 'text-rose-600 dark:text-rose-400' : 'text-emerald-600'}`}>{learnerInsights.wrongAttempts}</p>
              <p class="text-[11px] font-semibold text-slate-500">Lượt trả lời sai</p>
            </div>
          </div>
        )}
      </div>
    )}

    {isEnrolled && weakSkills.length > 0 && (
      <section class="rounded-2xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/70 dark:bg-amber-950/20 p-5">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-amber-100 dark:bg-amber-900/40 p-2 text-amber-700 dark:text-amber-300">◎</div>
          <div class="flex-1">
            <h2 class="font-bold text-amber-950 dark:text-amber-100">Kiến thức nên ôn lại</h2>
            <p class="text-xs text-amber-800/70 dark:text-amber-200/70 mt-0.5">Dựa trên toàn bộ các lần bạn trả lời quiz, không chỉ kết quả cuối.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-3">
              {weakSkills.map(skill => (
                <div class="rounded-xl bg-white/80 dark:bg-slate-900/60 border border-amber-100 dark:border-amber-900/30 px-3 py-2.5 flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate">{skill.knowledge_tag}</p>
                    <p class="text-[11px] text-slate-500">Sai {skill.wrong_attempts}/{skill.total_attempts} lượt · đúng lần đầu {skill.first_try_accuracy}%</p>
                  </div>
                  <span class="shrink-0 text-sm font-extrabold text-amber-700 dark:text-amber-300">{skill.mastery_score}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Lessons list -->
      <div class="lg:col-span-2">
        <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 dark:border-slate-800">
            <h2 class="font-bold text-gray-900 dark:text-white">Danh sách bài giảng</h2>
          </div>
          <div class="divide-y divide-gray-100 dark:divide-slate-800">
            {publishedLessons.map((lesson, idx) => {
              const done = completedIds.has(lesson.id);
              const lessonProgress = progressByLesson.get(lesson.id);
              const canAccess = isEnrolled || lesson.is_free;
              return (
                <div class={`flex items-center gap-4 px-5 py-4 transition ${canAccess ? 'hover:bg-gray-50 dark:hover:bg-slate-800/50' : 'opacity-70'}`}>
                  <!-- Status icon -->
                  <div class={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 ${done ? 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400' : 'bg-gray-100 dark:bg-slate-800 text-gray-400'}`}>
                    {done ? (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    ) : (
                      <span class="text-xs font-bold">{idx + 1}</span>
                    )}
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-center flex-wrap gap-2">
                      <p class={`text-sm font-semibold truncate ${done ? 'text-emerald-700 dark:text-emerald-400' : 'text-gray-900 dark:text-white'}`}>{lesson.title}</p>
                      {lesson.is_free && <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">Học thử</span>}
                    </div>
                    <div class="flex items-center gap-3 mt-0.5 text-xs text-gray-400 dark:text-slate-500">
                      {lesson.duration && <span>{lesson.duration} phút</span>}
                      {lesson.video_url && <span class="text-blue-400">▶ Video</span>}
                      {reviewQuizCounts.get(lesson.id) ? <span class="font-semibold text-violet-500">◉ {reviewQuizCounts.get(lesson.id)} câu ôn tập</span> : null}
                      {!done && lessonProgress && lesson.video_url && <span class="text-amber-500">Đang học · {Math.min(100, Math.round(Number(lessonProgress.video_watched_seconds || 0) / Math.max(Number(lessonProgress.video_duration_seconds || 0), 1) * 100))}% video</span>}
                    </div>
                  </div>

                  {canAccess ? (
                    <a href={`/khoa-hoc/${slug}/${lesson.id}`} class={`shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-bold transition ${done ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-100' : 'bg-blue-600 text-white hover:bg-blue-700'}`}>
                      {done ? 'Xem lại' : (!isEnrolled && lesson.is_free ? 'Học thử' : 'Học ngay')}
                    </a>
                  ) : (
                    <span class="shrink-0 text-xs text-gray-400">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                    </span>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Enrollment sidebar -->
      <div class="space-y-4">
        <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 sticky top-24">
          {isEnrolled ? (
            <div class="text-center">
              <div class="w-14 h-14 bg-emerald-100 dark:bg-emerald-900/20 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <p class="font-bold text-gray-900 dark:text-white mb-1">Bạn đã đăng ký</p>
              <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Tiếp tục học từ bài chưa hoàn thành.</p>
              {resumeLessonId && (
                <a 
                  href={`/khoa-hoc/${slug}/${resumeLessonId}`}
                  class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-xl text-sm text-center transition"
                >
                  Tiếp tục học →
                </a>
              )}
            </div>
          ) : user ? (
            <div class="text-center">
              <div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
              </div>
              <p class="font-bold text-gray-900 dark:text-white mb-1">Đăng ký miễn phí</p>
              <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Học toàn bộ {publishedLessons.length} bài giảng.</p>
              <button id="enroll-btn" data-course-id={course.id} class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-xl text-sm text-center transition">
                Đăng ký học ngay
              </button>
            </div>
          ) : (
            <div class="text-center">
              <p class="font-bold text-gray-900 dark:text-white mb-2">Đăng nhập để học</p>
              <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Bạn cần đăng nhập để đăng ký và theo dõi tiến độ học.</p>
              <a href="/login" class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-xl text-sm text-center transition">
                Đăng nhập ngay
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const enrollBtn = document.getElementById('enroll-btn') as HTMLButtonElement | null;
  if (enrollBtn) {
    enrollBtn.addEventListener('click', async () => {
      const courseId = enrollBtn.dataset.courseId!;
      enrollBtn.disabled = true;
      enrollBtn.textContent = 'Đang đăng ký...';
      try {
        const res = await fetch(import.meta.env.BASE_URL + '/api/courses/enroll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ courseId })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(data.error || 'Có lỗi xảy ra. Vui lòng thử lại.');
          enrollBtn.disabled = false;
          enrollBtn.textContent = 'Đăng ký học ngay';
        }
      } catch {
        alert('Không thể kết nối. Vui lòng thử lại.');
        enrollBtn.disabled = false;
        enrollBtn.textContent = 'Đăng ký học ngay';
      }
    });
  }
</script>
