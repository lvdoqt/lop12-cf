---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
import { marked } from 'marked';

export const prerender = false;

const user = Astro.locals.user;

const { slug, lessonId } = Astro.params;
if (!slug || !lessonId) return Astro.redirect('/khoa-hoc');

const course = await db.getCourseBySlug(slug);
if (!course || !course.is_published) return Astro.redirect('/khoa-hoc');

const lessons = await db.getCourseLessons(course.id);
const publishedLessons = lessons.filter(l => l.is_published);
const currentLesson = publishedLessons.find(l => l.id === lessonId);

if (!currentLesson) return Astro.redirect(`/khoa-hoc/${slug}`);

// Ensure user is enrolled or lesson is free
const isEnrolled = user ? await db.isUserEnrolled(course.id, user.id) : false;
if (!isEnrolled && !currentLesson.is_free) {
  return Astro.redirect(`/khoa-hoc/${slug}`);
}

const currentIndex = publishedLessons.findIndex(l => l.id === lessonId);
const prevLesson = currentIndex > 0 ? publishedLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < publishedLessons.length - 1 ? publishedLessons[currentIndex + 1] : null;

// Convert markdown to HTML
const htmlContent = currentLesson.content ? marked.parse(currentLesson.content) : '';

// Get progress
const progress = user ? await db.getLessonProgress(user.id, course.id) : [];
const completedIds = new Set(progress.filter(p => p.completed).map(p => p.lesson_id));
const isCompleted = completedIds.has(lessonId);
const currentProgress = progress.find(p => p.lesson_id === lessonId);
const initialVideoPosition = Number(currentProgress?.video_position_seconds || 0);

// Video quizzes for this lesson
const videoQuizzes = (await db.getVideoQuizzes(lessonId))
  .sort((a, b) => a.timestamp_sec - b.timestamp_sec || a.order_index - b.order_index);
// Send quizzes to client WITHOUT correct answers
const clientQuizzes = videoQuizzes.map(({ answer: _a, explanation: _e, ...q }) => q);

// Independent end-of-lesson review quiz (separate from interactive video quizzes).
const reviewQuestions = await db.getLessonReviewQuestions(lessonId);
const reviewAttempts = user && isEnrolled ? await db.getLessonReviewAttempts(lessonId, user.id) : [];
const bestReviewScore = reviewAttempts.length ? Math.max(...reviewAttempts.map(attempt => attempt.score)) : null;

// Extract YouTube IDs from watch, short, embed, live and youtu.be URLs.
function getYouTubeId(url: string) {
  try {
    const parsed = new URL(url);
    const hostname = parsed.hostname.replace(/^www\./, '');
    if (hostname === 'youtu.be') return parsed.pathname.split('/').filter(Boolean)[0] || null;
    if (hostname === 'youtube.com' || hostname === 'm.youtube.com') {
      const pathParts = parsed.pathname.split('/').filter(Boolean);
      if (parsed.pathname === '/watch') return parsed.searchParams.get('v');
      if (['embed', 'shorts', 'live'].includes(pathParts[0])) return pathParts[1] || null;
    }
  } catch {
    // Keep a permissive fallback for legacy values without a full URL.
  }
  const match = url.match(/(?:youtu\.be\/|embed\/|shorts\/|live\/|[?&]v=)([^#&?\/]{11})/);
  return match?.[1] || null;
}
const ytId = currentLesson.video_url ? getYouTubeId(currentLesson.video_url) : null;
const hasQuizzes = videoQuizzes.length > 0;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${currentLesson.title} - ${course.title}`} showSidebar={false}>
  <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 max-w-7xl mx-auto">
    <!-- Main Content Area -->
    <div class="flex-1 min-w-0">
      <!-- Breadcrumb -->
      <nav class="flex items-center text-sm font-medium text-gray-500 dark:text-slate-400 mb-4 whitespace-nowrap overflow-x-auto pb-2">
        <a href="/khoa-hoc" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Khóa học</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-2 text-gray-300 dark:text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <a href={`/khoa-hoc/${slug}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition truncate max-w-[150px] sm:max-w-xs">{course.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-2 text-gray-300 dark:text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-gray-900 dark:text-white truncate">Bài {currentIndex + 1}</span>
      </nav>

      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm">
        <!-- Interactive Video Player -->
        {currentLesson.video_url && (
          <div class="relative bg-black" id="video-player-wrapper">
            {ytId ? (
              <div class="aspect-video" id="yt-player-container">
                <div id="yt-player"></div>
              </div>
            ) : (
              <div class="aspect-video bg-black">
                <video id="native-course-video" src={currentLesson.video_url} controls playsinline controlslist={hasQuizzes ? 'nofullscreen noremoteplayback' : undefined} disablepictureinpicture={hasQuizzes} class="w-full h-full" />
              </div>
            )}

            <!-- Quiz Overlay — shown when video pauses at a quiz timestamp -->
            <div
              id="quiz-overlay"
              class="absolute inset-0 bg-black/90 flex items-center justify-center z-20 hidden"
              role="dialog"
              aria-modal="true"
              aria-labelledby="quiz-question-text"
            >
              <div id="quiz-card" class="w-full max-w-xl bg-white dark:bg-slate-900 rounded-xl shadow-2xl">
                <!-- Quiz header -->
                <div class="quiz-header bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-3">
                  <div class="flex items-center gap-2 text-white/80 text-xs font-bold uppercase tracking-wide mb-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Câu hỏi kiểm tra
                  </div>
                  <div id="quiz-question-text" tabindex="-1" class="text-white font-semibold text-base leading-relaxed whitespace-pre-wrap"></div>
                </div>

                <!-- Options -->
                <div id="quiz-options" class="p-3 space-y-2"></div>

                <!-- Feedback area -->
                <div id="quiz-feedback" class="hidden px-3 pb-3" aria-live="polite">
                  <div id="quiz-feedback-inner" class="rounded-xl p-3 text-sm whitespace-pre-wrap"></div>
                </div>

                <!-- Footer -->
                <div class="quiz-footer p-3 flex flex-wrap items-center justify-between gap-2 bg-white dark:bg-slate-900">
                  <span id="quiz-attempt-label" class="text-xs text-gray-400 dark:text-slate-500"></span>
                  <button id="quiz-submit-btn" type="button" disabled class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white font-bold text-sm">
                    Kiểm tra đáp án
                  </button>
                  <button
                    id="quiz-continue-btn"
                    type="button"
                    class="hidden px-6 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm transition shadow-lg shadow-emerald-500/20"
                  >
                    Tiếp tục xem ▶
                  </button>
                </div>
              </div>
            </div>

            <!-- Quiz progress dots (top bar) -->
            {hasQuizzes && (
              <div class="absolute top-3 left-4 right-4 flex gap-1.5 z-10" id="quiz-dots-bar">
                {videoQuizzes.map((_, i) => (
                  <div
                    class="h-1 flex-1 rounded-full bg-white/20 transition-all duration-500"
                    id={`quiz-dot-${i}`}
                  ></div>
                ))}
              </div>
            )}
          </div>
        )}

        <div class="p-6 md:p-8">
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white mb-4">{currentLesson.title}</h1>

          {hasQuizzes && (
            <div class="mb-6 flex items-center gap-2 px-4 py-3 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 text-sm text-blue-700 dark:text-blue-300">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Bài học này có <strong>{videoQuizzes.length}</strong> câu hỏi trong video. Video sẽ tự dừng — hãy trả lời để tiếp tục.
            </div>
          )}

          {isEnrolled && currentProgress && !isCompleted && (
            <div class="mb-6 flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-100 dark:border-amber-800 text-sm text-amber-800 dark:text-amber-200">
              <span>Tiến độ được lưu tự động. Bạn có thể tiếp tục từ vị trí đã xem.</span>
              {currentProgress.video_duration_seconds && currentProgress.video_duration_seconds > 0 && (
                <strong class="shrink-0">{Math.min(100, Math.round(Number(currentProgress.video_watched_seconds || 0) / currentProgress.video_duration_seconds * 100))}% video</strong>
              )}
            </div>
          )}

          <div class="prose prose-blue dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400">
            <Fragment set:html={htmlContent} />
          </div>

          {reviewQuestions.length > 0 && (
            <section id="review-quiz-section" class="mt-10 rounded-2xl border border-violet-200 dark:border-violet-900/50 bg-violet-50/50 dark:bg-violet-950/10 overflow-hidden">
              <div class="border-b border-violet-100 dark:border-violet-900/40 bg-white/70 dark:bg-slate-900/50 px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                  <p class="text-[11px] font-bold uppercase tracking-wider text-violet-600 dark:text-violet-400">Ôn tập cuối bài</p>
                  <h2 class="text-lg font-extrabold text-gray-900 dark:text-white">Quiz kiểm tra kiến thức</h2>
                  <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">{reviewQuestions.length} câu · Chấm theo thang điểm 10 · Có lưu lịch sử làm bài</p>
                </div>
                {bestReviewScore !== null && (
                  <div class="rounded-xl bg-violet-100 dark:bg-violet-900/40 px-4 py-2 text-center">
                    <p class="text-[10px] font-bold uppercase text-violet-500">Điểm cao nhất</p>
                    <p class="text-xl font-black text-violet-700 dark:text-violet-300">{bestReviewScore.toFixed(1)}</p>
                  </div>
                )}
              </div>

              <form id="review-quiz-form" class="p-5 space-y-5">
                {reviewQuestions.map((question, questionIndex) => (
                  <fieldset id={`review-question-${question.id}`} class="rounded-xl border border-violet-100 dark:border-violet-900/30 bg-white dark:bg-slate-900 p-4 transition-colors">
                    <legend class="px-1 text-sm font-bold text-gray-900 dark:text-white">
                      Câu {questionIndex + 1}. {question.question}
                    </legend>
                    <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {question.options.map((option, optionIndex) => {
                        const letter = String.fromCharCode(65 + optionIndex);
                        return (
                          <label class="flex items-start gap-3 rounded-xl border border-gray-200 dark:border-slate-700 px-3 py-2.5 text-sm text-gray-700 dark:text-slate-200 hover:border-violet-400 hover:bg-violet-50/50 dark:hover:bg-violet-900/10 cursor-pointer transition">
                            <input type="radio" name={`review-${question.id}`} value={letter} data-question-id={question.id} class="mt-0.5 h-4 w-4 text-violet-600 focus:ring-violet-500" />
                            <span><strong class="text-violet-700 dark:text-violet-300">{letter}.</strong> {option}</span>
                          </label>
                        );
                      })}
                    </div>
                    <div id={`review-feedback-${question.id}`} class="hidden mt-3 rounded-lg px-3 py-2 text-xs"></div>
                  </fieldset>
                ))}

                {isEnrolled ? (
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-1">
                    <p id="review-quiz-summary" class="text-sm font-semibold text-gray-500 dark:text-slate-400">
                      {reviewAttempts.length > 0 ? `Bạn đã làm ${reviewAttempts.length} lần.` : 'Hãy trả lời tất cả câu hỏi trước khi nộp.'}
                    </p>
                    <button id="review-quiz-submit" type="submit" class="rounded-xl bg-violet-600 hover:bg-violet-700 px-6 py-3 text-sm font-bold text-white shadow shadow-violet-500/20 transition">
                      Nộp bài và xem điểm
                    </button>
                  </div>
                ) : (
                  <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
                    Bạn cần đăng nhập và đăng ký khóa học để làm quiz và lưu điểm.
                  </div>
                )}
              </form>
            </section>
          )}

          <div class="mt-10 pt-6 border-t border-gray-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="w-full sm:w-auto">
              {prevLesson ? (
                <a href={`/khoa-hoc/${slug}/${prevLesson.id}`} class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-600 dark:text-slate-300 bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                  Bài trước
                </a>
              ) : <div></div>}
            </div>

            <div class="w-full sm:w-auto flex flex-col sm:flex-row gap-3">
              {isEnrolled && (
                <button
                  id="mark-complete-btn"
                  data-lesson-id={currentLesson.id}
                  disabled={isCompleted}
                  class={`inline-flex items-center justify-center w-full sm:w-auto px-6 py-2.5 rounded-xl text-sm font-bold transition ${isCompleted ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 cursor-default' : 'bg-blue-600 hover:bg-blue-700 text-white shadow shadow-blue-500/20'}`}
                >
                  {isCompleted ? (
                    <>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      Đã hoàn thành
                    </>
                  ) : (
                    'Đánh dấu hoàn thành'
                  )}
                </button>
              )}

              {nextLesson && (
                <a href={`/khoa-hoc/${slug}/${nextLesson.id}`} class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-800 transition">
                  Bài tiếp theo
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Playlist -->
    <div class="w-full lg:w-80 shrink-0">
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl overflow-hidden sticky top-24">
        <div class="p-4 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-800/20">
          <h3 class="font-bold text-gray-900 dark:text-white">Nội dung khóa học</h3>
          <div class="mt-2 w-full bg-gray-200 dark:bg-slate-700 rounded-full h-1.5">
            <div class="bg-emerald-500 h-1.5 rounded-full transition-all" style={`width: ${Math.round((completedIds.size / publishedLessons.length) * 100)}%`}></div>
          </div>
          <p class="text-xs text-gray-500 mt-1.5">{completedIds.size}/{publishedLessons.length} bài hoàn thành</p>
        </div>

        <div class="max-h-[calc(100vh-250px)] overflow-y-auto">
          {publishedLessons.map((lesson, idx) => {
            const isCurrent = lesson.id === lessonId;
            const done = completedIds.has(lesson.id);
            return (
              <a
                href={`/khoa-hoc/${slug}/${lesson.id}`}
                class={`flex items-start gap-3 p-3 transition border-l-2 ${isCurrent ? 'bg-blue-50/50 dark:bg-blue-900/10 border-blue-600 dark:border-blue-500' : 'border-transparent hover:bg-gray-50 dark:hover:bg-slate-800/50'}`}
              >
                <div class="mt-0.5 shrink-0">
                  {done ? (
                    <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    </div>
                  ) : (
                    <div class={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${isCurrent ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-500'}`}>
                      {idx + 1}
                    </div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <p class={`text-sm leading-tight ${isCurrent ? 'font-bold text-blue-700 dark:text-blue-400' : done ? 'font-medium text-gray-600 dark:text-slate-400' : 'font-medium text-gray-900 dark:text-slate-200'}`}>
                    {lesson.title}
                  </p>
                  <p class="text-[11px] text-gray-400 mt-1 flex items-center gap-1">
                    {lesson.video_url && <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
                    {lesson.duration ? `${lesson.duration} phút` : 'Lý thuyết'}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Mark complete handler -->
<script>
  const completeBtn = document.getElementById('mark-complete-btn') as HTMLButtonElement | null;
  if (completeBtn) {
    completeBtn.addEventListener('click', async () => {
      const lessonId = completeBtn.dataset.lessonId!;
      completeBtn.disabled = true;
      completeBtn.innerHTML = 'Đang xử lý...';
      try {
        (window as any).__lmsCompleting = true;
        await (window as any).__lmsFlush?.();
        const res = await fetch(import.meta.env.BASE_URL.replace(/\/$/, '') + '/api/courses/progress', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lessonId, action: 'complete', sessionId: (window as any).__lmsSessionId })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          (window as any).__lmsCompleting = false;
          alert('Có lỗi xảy ra, vui lòng thử lại.');
          completeBtn.disabled = false;
          completeBtn.innerHTML = 'Đánh dấu hoàn thành';
        }
      } catch {
        (window as any).__lmsCompleting = false;
        alert('Không thể kết nối. Vui lòng kiểm tra mạng.');
        completeBtn.disabled = false;
        completeBtn.innerHTML = 'Đánh dấu hoàn thành';
      }
    });
  }
</script>

<!-- Independent review quiz submission and grading. -->
<script define:vars={{ reviewLessonId: lessonId, canSubmitReview: isEnrolled, baseUrl }}>
  if (canSubmitReview) {
    const form = document.getElementById('review-quiz-form');
    const submitButton = document.getElementById('review-quiz-submit');
    const summary = document.getElementById('review-quiz-summary');
    const BASE = baseUrl;

    form?.addEventListener('submit', async event => {
      event.preventDefault();
      const answers = {};
      form.querySelectorAll('input[type="radio"]:checked').forEach(input => {
        answers[input.dataset.questionId] = input.value;
      });
      const questionCount = form.querySelectorAll('fieldset').length;
      if (Object.keys(answers).length !== questionCount) {
        summary.textContent = 'Vui lòng trả lời đầy đủ tất cả câu hỏi.';
        summary.className = 'text-sm font-semibold text-rose-600 dark:text-rose-400';
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = 'Đang chấm điểm...';
      try {
        const response = await fetch(`${BASE}/api/courses/review-quiz`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lessonId: reviewLessonId, answers }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Không thể chấm bài.');

        data.results.forEach(result => {
          const card = document.getElementById(`review-question-${result.questionId}`);
          const feedback = document.getElementById(`review-feedback-${result.questionId}`);
          card?.classList.remove('border-violet-100', 'dark:border-violet-900/30', 'border-emerald-400', 'border-rose-400');
          card?.classList.add(result.isCorrect ? 'border-emerald-400' : 'border-rose-400');
          if (feedback) {
            feedback.textContent = result.isCorrect
              ? `✓ Chính xác.${result.explanation ? ` ${result.explanation}` : ''}`
              : `✕ Chưa đúng. Đáp án đúng: ${result.correctAnswer}.${result.explanation ? ` ${result.explanation}` : ''}`;
            feedback.className = `mt-3 rounded-lg px-3 py-2 text-xs ${result.isCorrect
              ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-300'
              : 'bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-300'}`;
          }
        });
        summary.textContent = `Lần ${data.attempt.attempt_number}: ${data.attempt.correct_count}/${data.attempt.total_questions} câu đúng · ${Number(data.attempt.score).toFixed(1)}/10 điểm`;
        summary.className = 'text-sm font-bold text-violet-700 dark:text-violet-300';
        submitButton.textContent = 'Nộp lại bài';
        if (typeof renderMathInElement === 'function') renderMathInElement(form, { throwOnError: false });
      } catch (error) {
        summary.textContent = error instanceof Error ? error.message : 'Không thể chấm bài.';
        summary.className = 'text-sm font-semibold text-rose-600 dark:text-rose-400';
        submitButton.textContent = 'Thử nộp lại';
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>

<!-- Learning telemetry: active study time, video coverage and resume position. -->
<script define:vars={{ lessonId, isEnrolled, baseUrl }}>
  if (isEnrolled) {
    const BASE = baseUrl;
    const sessionId = crypto.randomUUID();
    window.__lmsSessionId = sessionId;
    let activeSeconds = 0;
    let watchedSeconds = 0;
    let videoPositionSeconds = 0;
    let videoDurationSeconds = 0;
    let lastVideoPosition = null;
    let sending = false;

    window.addEventListener('lms-video-tick', (event) => {
      const detail = event.detail || {};
      const position = Math.max(0, Number(detail.position || 0));
      videoPositionSeconds = Math.round(position);
      videoDurationSeconds = Math.max(videoDurationSeconds, Math.round(Number(detail.duration || 0)));
      if (detail.playing && lastVideoPosition !== null) {
        const delta = position - lastVideoPosition;
        // Count continuous playback only; seeking cannot manufacture watch time.
        if (delta > 0 && delta <= 2.5) watchedSeconds += delta;
      }
      lastVideoPosition = position;
    });


    setInterval(() => {
      if (document.visibilityState === 'visible' && !window.__lmsCompleting) activeSeconds++;
    }, 1000);

    async function flush(keepalive = false) {
      if (sending || (activeSeconds <= 0 && watchedSeconds <= 0 && videoPositionSeconds <= 0)) return;
      sending = true;
      const payload = {
        lessonId,
        action: 'heartbeat',
        sessionId,
        activeSeconds,
        watchedSeconds: Math.round(watchedSeconds),
        videoPositionSeconds,
        videoDurationSeconds,
      };
      try {
        const response = await fetch(`${BASE}/api/courses/progress`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          keepalive,
        });
        if (response.ok) {
          activeSeconds = 0;
          watchedSeconds = 0;
        }
      } catch (error) {
        console.warn('Không thể lưu tiến độ học:', error);
      } finally {
        sending = false;
      }
    }

    window.__lmsFlush = flush;
    fetch(`${BASE}/api/courses/progress`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ lessonId, action: 'start', sessionId }),
    }).catch(() => {});
    setInterval(() => flush(), 15000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden' && !window.__lmsCompleting) flush(true);
    });
    window.addEventListener('pagehide', () => {
      if (!window.__lmsCompleting) flush(true);
    });
  }
</script>

