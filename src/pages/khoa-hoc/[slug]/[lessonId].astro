---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../services/db';
import { marked } from 'marked';

export const prerender = false;

const user = Astro.locals.user;

const { slug, lessonId } = Astro.params;
if (!slug || !lessonId) return Astro.redirect('/khoa-hoc');

const course = await db.getCourseBySlug(slug);
if (!course || !course.is_published) return Astro.redirect('/khoa-hoc');

const lessons = await db.getCourseLessons(course.id);
const publishedLessons = lessons.filter(l => l.is_published);
const currentLesson = publishedLessons.find(l => l.id === lessonId);

if (!currentLesson) return Astro.redirect(`/khoa-hoc/${slug}`);

// Ensure user is enrolled or lesson is free
const isEnrolled = user ? await db.isUserEnrolled(course.id, user.id) : false;
if (!isEnrolled && !currentLesson.is_free) {
  return Astro.redirect(`/khoa-hoc/${slug}`);
}

const currentIndex = publishedLessons.findIndex(l => l.id === lessonId);
const prevLesson = currentIndex > 0 ? publishedLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < publishedLessons.length - 1 ? publishedLessons[currentIndex + 1] : null;

// Convert markdown to HTML
const htmlContent = currentLesson.content ? marked.parse(currentLesson.content) : '';

// Get progress
const progress = user ? await db.getLessonProgress(user.id, course.id) : [];
const completedIds = new Set(progress.filter(p => p.completed).map(p => p.lesson_id));
const isCompleted = completedIds.has(lessonId);

// Video quizzes for this lesson
const videoQuizzes = await db.getVideoQuizzes(lessonId);
// Build quiz map: { [quizId]: { answer, explanation } } — server-side only, NOT sent to client
const quizAnswerMap: Record<string, { answer: string; explanation: string | null }> = {};
videoQuizzes.forEach(q => { quizAnswerMap[q.id] = { answer: q.answer, explanation: q.explanation }; });

// Send quizzes to client WITHOUT correct answers
const clientQuizzes = videoQuizzes.map(({ answer: _a, explanation: _e, ...q }) => q);

// Function to extract YouTube ID
function getYouTubeId(url: string) {
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
  const match = url.match(regExp);
  return (match && match[2].length === 11) ? match[2] : null;
}
const ytId = currentLesson.video_url ? getYouTubeId(currentLesson.video_url) : null;
const hasQuizzes = videoQuizzes.length > 0;
---

<Layout title={`${currentLesson.title} - ${course.title}`} showSidebar={false}>
  <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 max-w-7xl mx-auto">
    <!-- Main Content Area -->
    <div class="flex-1 min-w-0">
      <!-- Breadcrumb -->
      <nav class="flex items-center text-sm font-medium text-gray-500 dark:text-slate-400 mb-4 whitespace-nowrap overflow-x-auto pb-2">
        <a href="/khoa-hoc" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Khóa học</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-2 text-gray-300 dark:text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <a href={`/khoa-hoc/${slug}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition truncate max-w-[150px] sm:max-w-xs">{course.title}</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-2 text-gray-300 dark:text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-gray-900 dark:text-white truncate">Bài {currentIndex + 1}</span>
      </nav>

      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm">
        <!-- Interactive Video Player -->
        {ytId && (
          <div class="relative bg-black" id="video-player-wrapper">
            <!-- YouTube iframe (hidden until API ready) -->
            <div class="aspect-video" id="yt-player-container">
              <div id="yt-player"></div>
            </div>

            <!-- Quiz Overlay — shown when video pauses at a quiz timestamp -->
            <div
              id="quiz-overlay"
              class="absolute inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-20 hidden"
              aria-live="polite"
            >
              <div id="quiz-card" class="w-full max-w-xl mx-4 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl overflow-hidden transform transition-all duration-300 scale-95 opacity-0">
                <!-- Quiz header -->
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
                  <div class="flex items-center gap-2 text-white/80 text-xs font-bold uppercase tracking-wide mb-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Câu hỏi kiểm tra
                  </div>
                  <p id="quiz-question-text" class="text-white font-semibold text-base leading-snug"></p>
                </div>

                <!-- Options -->
                <div id="quiz-options" class="p-5 space-y-3"></div>

                <!-- Feedback area -->
                <div id="quiz-feedback" class="hidden px-5 pb-4">
                  <div id="quiz-feedback-inner" class="rounded-xl p-4 text-sm"></div>
                </div>

                <!-- Footer -->
                <div class="px-5 pb-5 flex items-center justify-between">
                  <span id="quiz-attempt-label" class="text-xs text-gray-400 dark:text-slate-500"></span>
                  <button
                    id="quiz-continue-btn"
                    class="hidden px-6 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm transition shadow-lg shadow-emerald-500/20"
                  >
                    Tiếp tục xem ▶
                  </button>
                </div>
              </div>
            </div>

            <!-- Quiz progress dots (top bar) -->
            {hasQuizzes && (
              <div class="absolute top-3 left-4 right-4 flex gap-1.5 z-10" id="quiz-dots-bar">
                {videoQuizzes.map((_, i) => (
                  <div
                    class="h-1 flex-1 rounded-full bg-white/20 transition-all duration-500"
                    id={`quiz-dot-${i}`}
                  ></div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Non-YouTube video fallback */}
        {!ytId && currentLesson.video_url && (
          <div class="aspect-video bg-black">
            <video src={currentLesson.video_url} controls class="w-full h-full" />
          </div>
        )}

        <div class="p-6 md:p-8">
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white mb-4">{currentLesson.title}</h1>

          {hasQuizzes && (
            <div class="mb-6 flex items-center gap-2 px-4 py-3 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 text-sm text-blue-700 dark:text-blue-300">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Bài học này có <strong>{videoQuizzes.length}</strong> câu hỏi trong video. Video sẽ tự dừng — hãy trả lời để tiếp tục.
            </div>
          )}

          <div class="prose prose-blue dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400">
            <Fragment set:html={htmlContent} />
          </div>

          <div class="mt-10 pt-6 border-t border-gray-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="w-full sm:w-auto">
              {prevLesson ? (
                <a href={`/khoa-hoc/${slug}/${prevLesson.id}`} class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-600 dark:text-slate-300 bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                  Bài trước
                </a>
              ) : <div></div>}
            </div>

            <div class="w-full sm:w-auto flex flex-col sm:flex-row gap-3">
              {isEnrolled && (
                <button
                  id="mark-complete-btn"
                  data-lesson-id={currentLesson.id}
                  disabled={isCompleted}
                  class={`inline-flex items-center justify-center w-full sm:w-auto px-6 py-2.5 rounded-xl text-sm font-bold transition ${isCompleted ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 cursor-default' : 'bg-blue-600 hover:bg-blue-700 text-white shadow shadow-blue-500/20'}`}
                >
                  {isCompleted ? (
                    <>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      Đã hoàn thành
                    </>
                  ) : (
                    'Đánh dấu hoàn thành'
                  )}
                </button>
              )}

              {nextLesson && (
                <a href={`/khoa-hoc/${slug}/${nextLesson.id}`} class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-800 transition">
                  Bài tiếp theo
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Playlist -->
    <div class="w-full lg:w-80 shrink-0">
      <div class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl overflow-hidden sticky top-24">
        <div class="p-4 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-800/20">
          <h3 class="font-bold text-gray-900 dark:text-white">Nội dung khóa học</h3>
          <div class="mt-2 w-full bg-gray-200 dark:bg-slate-700 rounded-full h-1.5">
            <div class="bg-emerald-500 h-1.5 rounded-full transition-all" style={`width: ${Math.round((completedIds.size / publishedLessons.length) * 100)}%`}></div>
          </div>
          <p class="text-xs text-gray-500 mt-1.5">{completedIds.size}/{publishedLessons.length} bài hoàn thành</p>
        </div>

        <div class="max-h-[calc(100vh-250px)] overflow-y-auto">
          {publishedLessons.map((lesson, idx) => {
            const isCurrent = lesson.id === lessonId;
            const done = completedIds.has(lesson.id);
            return (
              <a
                href={`/khoa-hoc/${slug}/${lesson.id}`}
                class={`flex items-start gap-3 p-3 transition border-l-2 ${isCurrent ? 'bg-blue-50/50 dark:bg-blue-900/10 border-blue-600 dark:border-blue-500' : 'border-transparent hover:bg-gray-50 dark:hover:bg-slate-800/50'}`}
              >
                <div class="mt-0.5 shrink-0">
                  {done ? (
                    <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    </div>
                  ) : (
                    <div class={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${isCurrent ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-500'}`}>
                      {idx + 1}
                    </div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <p class={`text-sm leading-tight ${isCurrent ? 'font-bold text-blue-700 dark:text-blue-400' : done ? 'font-medium text-gray-600 dark:text-slate-400' : 'font-medium text-gray-900 dark:text-slate-200'}`}>
                    {lesson.title}
                  </p>
                  <p class="text-[11px] text-gray-400 mt-1 flex items-center gap-1">
                    {lesson.video_url && <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
                    {lesson.duration ? `${lesson.duration} phút` : 'Lý thuyết'}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Mark complete handler -->
<script>
  const completeBtn = document.getElementById('mark-complete-btn') as HTMLButtonElement | null;
  if (completeBtn) {
    completeBtn.addEventListener('click', async () => {
      const lessonId = completeBtn.dataset.lessonId!;
      completeBtn.disabled = true;
      completeBtn.innerHTML = 'Đang xử lý...';
      try {
        const res = await fetch(import.meta.env.BASE_URL + '/api/courses/progress', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lessonId })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Có lỗi xảy ra, vui lòng thử lại.');
          completeBtn.disabled = false;
          completeBtn.innerHTML = 'Đánh dấu hoàn thành';
        }
      } catch {
        alert('Không thể kết nối. Vui lòng kiểm tra mạng.');
        completeBtn.disabled = false;
        completeBtn.innerHTML = 'Đánh dấu hoàn thành';
      }
    });
  }
</script>

<!-- Interactive Video Quiz Script -->
<script define:vars={{ ytId, clientQuizzes, lessonId }}>
  // Only initialise if there's a YouTube video
  if (!ytId) { /* nothing */ } else {

  // ── Guest ID (persisted in localStorage) ─────────────────────────────────
  function getGuestId() {
    let id = localStorage.getItem('vq-guest-id');
    if (!id) {
      id = 'g-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8);
      localStorage.setItem('vq-guest-id', id);
    }
    return id;
  }
  const GUEST_ID = getGuestId();
  const BASE = (window._astroEnv || {}).BASE_URL || '';

  // ── State ─────────────────────────────────────────────────────────────────
  const quizzes = clientQuizzes; // [{id, timestamp_sec, question, options, order_index}]
  const passedQuizIds = new Set(); // quizzes the user has answered correctly
  let quizStateReady = false;
  let currentQuizIdx = -1;        // index of quiz currently shown
  let player = null;              // YT.Player instance
  let pollTimer = null;           // setInterval for time polling
  let overlayOpen = false;

  // ── DOM refs ───────────────────────────────────────────────────────────────
  const overlay = document.getElementById('quiz-overlay');
  const card = document.getElementById('quiz-card');
  const questionEl = document.getElementById('quiz-question-text');
  const optionsEl = document.getElementById('quiz-options');
  const feedbackEl = document.getElementById('quiz-feedback');
  const feedbackInner = document.getElementById('quiz-feedback-inner');
  const continueBtn = document.getElementById('quiz-continue-btn');
  const attemptLabel = document.getElementById('quiz-attempt-label');

  // ── YouTube IFrame API ────────────────────────────────────────────────────
  window.onYouTubeIframeAPIReady = function () {
    player = new YT.Player('yt-player', {
      videoId: ytId,
      width: '100%',
      height: '100%',
      playerVars: {
        rel: 0,
        modestbranding: 1,
        enablejsapi: 1,
      },
      events: {
        onReady: () => {
          // Start polling for quiz timestamps
          if (quizzes.length > 0) {
            pollTimer = setInterval(checkQuizTrigger, 600);
          }
        },
        onStateChange: (e) => {
          // YT.PlayerState.PLAYING = 1
          if (e.data === 1 && overlayOpen) {
            // User somehow resumed — re-pause
            player.pauseVideo();
          }
        },
      },
    });
  };

  // Load the YouTube IFrame API script
  const tag = document.createElement('script');
  tag.src = 'https://www.youtube.com/iframe_api';
  const firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

  // ── Check if we hit a quiz timestamp ─────────────────────────────────────
  function checkQuizTrigger() {
    if (!quizStateReady || overlayOpen || !player || typeof player.getCurrentTime !== 'function') return;
    const currentTime = Math.floor(player.getCurrentTime());

    for (let i = 0; i < quizzes.length; i++) {
      const q = quizzes[i];
      if (passedQuizIds.has(q.id)) continue;
      // Trigger within a 1.5s window of the timestamp
      if (currentTime >= q.timestamp_sec && currentTime <= q.timestamp_sec + 1) {
        player.pauseVideo();
        showQuizOverlay(i);
        break;
      }
    }
  }

  async function restoreQuizState() {
    try {
      const params = new URLSearchParams({ lessonId });
      if (GUEST_ID) params.set('guestId', GUEST_ID);
      const response = await fetch(`${BASE}/api/courses/video-quiz-state?${params.toString()}`);
      if (response.ok) {
        const data = await response.json();
        (data.passedQuizIds || []).forEach(id => passedQuizIds.add(id));
      }
    } catch (error) {
      console.warn('Could not restore video quiz state:', error);
    } finally {
      quizStateReady = true;
    }
  }

  restoreQuizState();

  // ── Show quiz overlay ──────────────────────────────────────────────────────
  let attemptCount = 0;

  function showQuizOverlay(quizIdx) {
    currentQuizIdx = quizIdx;
    overlayOpen = true;
    attemptCount = 0;
    const quiz = quizzes[quizIdx];

    // Populate question
    questionEl.textContent = quiz.question;

    // Render options
    const letters = ['A', 'B', 'C', 'D'];
    optionsEl.innerHTML = '';
    quiz.options.forEach((opt, i) => {
      const letter = letters[i] || String.fromCharCode(65 + i);
      const btn = document.createElement('button');
      btn.dataset.letter = letter;
      btn.className = [
        'w-full text-left flex items-start gap-3 px-4 py-3 rounded-xl border-2 border-transparent',
        'bg-gray-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700',
        'hover:border-blue-400 text-sm font-medium text-gray-800 dark:text-slate-200',
        'transition-all duration-150 group quiz-option-btn',
      ].join(' ');
      btn.innerHTML = `
        <span class="shrink-0 w-7 h-7 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 flex items-center justify-center font-bold text-xs group-hover:bg-blue-200 dark:group-hover:bg-blue-800 transition">${letter}</span>
        <span class="leading-relaxed pt-0.5">${opt}</span>
      `;
      btn.addEventListener('click', () => handleAnswer(letter, btn));
      optionsEl.appendChild(btn);
    });

    // Reset feedback / continue
    feedbackEl.classList.add('hidden');
    continueBtn.classList.add('hidden');
    attemptLabel.textContent = '';

    // Show overlay with animation
    overlay.classList.remove('hidden');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        card.classList.remove('scale-95', 'opacity-0');
        card.classList.add('scale-100', 'opacity-100');
        // Render math in the quiz card
        if (typeof renderMathInElement === 'function') {
          renderMathInElement(card, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '\\[', right: '\\]', display: true},
              {left: '$', right: '$', display: false},
              {left: '\\(', right: '\\)', display: false}
            ],
            throwOnError: false,
            trust: true,
            strict: false
          });
        }
      });
    });

    // Update dot
    updateDot(quizIdx, 'active');
  }

  // ── Handle answer selection ────────────────────────────────────────────────
  async function handleAnswer(letter, clickedBtn) {
    attemptCount++;

    // Disable all buttons while checking
    document.querySelectorAll('.quiz-option-btn').forEach(b => b.disabled = true);

    // Send to server
    let isCorrect = false;
    let explanation = null;
    let serverAttemptNumber = attemptCount;
    try {
      const res = await fetch(BASE + '/api/courses/video-quiz-response', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          quizId: quizzes[currentQuizIdx].id,
          lessonId,
          selectedAnswer: letter,
          guestId: GUEST_ID,
        }),
      });
      const data = await res.json();
      isCorrect = data.isCorrect;
      explanation = data.explanation;
      serverAttemptNumber = data.attemptNumber || attemptCount;
    } catch (err) {
      console.error('Quiz response error:', err);
      // On network error, allow retry
      document.querySelectorAll('.quiz-option-btn').forEach(b => b.disabled = false);
      return;
    }

    // Style the clicked button
    if (isCorrect) {
      clickedBtn.classList.add('bg-emerald-50', 'dark:bg-emerald-900/20', 'border-emerald-500', 'text-emerald-700', 'dark:text-emerald-300');
      clickedBtn.querySelector('span').classList.replace('bg-blue-100', 'bg-emerald-100');
    } else {
      clickedBtn.classList.add('bg-red-50', 'dark:bg-red-900/20', 'border-red-400', 'text-red-700', 'dark:text-red-300');
      clickedBtn.classList.add('quiz-shake');
      setTimeout(() => clickedBtn.classList.remove('quiz-shake'), 600);
    }

    // Show feedback
    feedbackEl.classList.remove('hidden');
    if (isCorrect) {
      feedbackInner.className = 'rounded-xl p-4 text-sm bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200';
      feedbackInner.innerHTML = `
        <div class="flex items-start gap-2">
          <span class="text-lg shrink-0">✅</span>
          <div>
            <p class="font-bold">Chính xác!</p>
            ${explanation ? `<p class="mt-1 leading-relaxed opacity-90">${explanation}</p>` : ''}
          </div>
        </div>
      `;
      passedQuizIds.add(quizzes[currentQuizIdx].id);
      continueBtn.classList.remove('hidden');
      updateDot(currentQuizIdx, 'done');
      attemptLabel.textContent = `Trả lời đúng sau ${serverAttemptNumber} lần thử`;
    } else {
      feedbackInner.className = 'rounded-xl p-4 text-sm bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200';
      feedbackInner.innerHTML = `
        <div class="flex items-start gap-2">
          <span class="text-lg shrink-0">❌</span>
          <div>
            <p class="font-bold">Chưa đúng — hãy thử lại!</p>
            <p class="mt-1 opacity-80">Xem lại video và chọn đáp án khác.</p>
          </div>
        </div>
      `;
      attemptLabel.textContent = `Lần thử: ${serverAttemptNumber}`;
      // Re-enable non-selected options after 1s
      setTimeout(() => {
        document.querySelectorAll('.quiz-option-btn').forEach(b => {
          if (b !== clickedBtn) b.disabled = false;
        });
        // Reset clicked button style to allow re-selecting
        clickedBtn.classList.remove('bg-red-50', 'dark:bg-red-900/20', 'border-red-400', 'text-red-700', 'dark:text-red-300');
        clickedBtn.disabled = false;
      }, 1000);
    }

    if (typeof renderMathInElement === 'function') {
      renderMathInElement(feedbackInner, {
        delimiters: [
          {left: '$$', right: '$$', display: true},
          {left: '\\[', right: '\\]', display: true},
          {left: '$', right: '$', display: false},
          {left: '\\(', right: '\\)', display: false}
        ],
        throwOnError: false, trust: true, strict: false
      });
    }
  }

  // ── Continue button ────────────────────────────────────────────────────────
  if (continueBtn) {
    continueBtn.addEventListener('click', () => {
      hideOverlay();
      // Seek slightly past the quiz timestamp to avoid re-triggering
      if (player && quizzes[currentQuizIdx]) {
        player.seekTo(quizzes[currentQuizIdx].timestamp_sec + 2, true);
      }
      player.playVideo();
    });
  }

  function hideOverlay() {
    overlayOpen = false;
    card.classList.remove('scale-100', 'opacity-100');
    card.classList.add('scale-95', 'opacity-0');
    setTimeout(() => overlay.classList.add('hidden'), 300);
  }

  // ── Quiz progress dots ─────────────────────────────────────────────────────
  function updateDot(idx, state) {
    const dot = document.getElementById(`quiz-dot-${idx}`);
    if (!dot) return;
    dot.classList.remove('bg-white/20', 'bg-blue-400', 'bg-emerald-400');
    if (state === 'active') dot.classList.add('bg-blue-400');
    else if (state === 'done') dot.classList.add('bg-emerald-400');
    else dot.classList.add('bg-white/20');
  }

  } // end if ytId
</script>

<style>
  /* YouTube iframe sizing */
  #yt-player-container {
    position: relative;
    width: 100%;
  }
  #yt-player-container > #yt-player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Quiz card shake animation */
  @keyframes quizShake {
    0%, 100% { transform: translateX(0); }
    20%       { transform: translateX(-6px); }
    40%       { transform: translateX(6px); }
    60%       { transform: translateX(-4px); }
    80%       { transform: translateX(4px); }
  }
  .quiz-shake { animation: quizShake 0.55s ease; }
</style>
