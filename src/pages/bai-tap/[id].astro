---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../services/db';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const assignmentId = Astro.params.id;
if (!assignmentId) {
  return Astro.redirect('/dashboard');
}

const assignment = await db.getAssignmentById(assignmentId);
if (!assignment) {
  return Astro.redirect('/dashboard');
}

// Get class info
const cls = await db.getClassById(assignment.class_id);

// Check if user is member of class or teacher/admin
const isTeacherOrAdmin = user.role === 'teacher' || user.role === 'admin';
if (!isTeacherOrAdmin) {
  const members = await db.getClassMembers(assignment.class_id);
  const isMember = members.some(m => m.user_id === user.id);
  if (!isMember) {
    return Astro.redirect('/dashboard');
  }
}

// Helper to extract YouTube video ID
function getYouTubeId(url: string | null | undefined): string | null {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
  return match ? match[1] : null;
}

// Helper to get Google Drive embed preview link
function getDriveEmbedUrl(url: string | null | undefined): string | null {
  if (!url) return null;
  // Match drive file id: /file/d/FILE_ID/ or id=FILE_ID
  const matchFile = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
  if (matchFile) {
    return `https://drive.google.com/file/d/${matchFile[1]}/preview`;
  }
  const matchDoc = url.match(/\/document\/d\/([a-zA-Z0-9_-]+)/);
  if (matchDoc) {
    return `https://docs.google.com/document/d/${matchDoc[1]}/preview`;
  }
  const matchPres = url.match(/\/presentation\/d\/([a-zA-Z0-9_-]+)/);
  if (matchPres) {
    return `https://docs.google.com/presentation/d/${matchPres[1]}/embed`;
  }
  const matchSpread = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9_-]+)/);
  if (matchSpread) {
    return `https://docs.google.com/spreadsheets/d/${matchSpread[1]}/preview`;
  }
  const matchIdParam = url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  if (matchIdParam && url.includes('drive.google.com')) {
    return `https://drive.google.com/file/d/${matchIdParam[1]}/preview`;
  }
  return null;
}

const youtubeId = getYouTubeId(assignment.youtube_url);
const driveEmbedUrl = getDriveEmbedUrl(assignment.attachment_url);

const isPdf = assignment.attachment_type === 'pdf' || (assignment.attachment_url?.toLowerCase().includes('.pdf') ?? false);
const isWord = assignment.attachment_type === 'word' || (assignment.attachment_url?.toLowerCase().match(/\.(docx?)$/) ?? false);
const isPpt = assignment.attachment_type === 'ppt' || (assignment.attachment_url?.toLowerCase().match(/\.(pptx?)$/) ?? false);

// Determine initial embed url for document
let docEmbedUrl = '';
if (driveEmbedUrl) {
  docEmbedUrl = driveEmbedUrl;
} else if (assignment.attachment_url) {
  if (isPdf) {
    docEmbedUrl = assignment.attachment_url;
  } else {
    // Office web viewer or google viewer
    docEmbedUrl = `https://docs.google.com/viewer?url=${encodeURIComponent(assignment.attachment_url)}&embedded=true`;
  }
}

const hasDoc = Boolean(assignment.attachment_url);
const hasVideo = Boolean(youtubeId);
---

<Layout title={`${assignment.ref_title || 'Tài liệu học tập'} — Lớp 12 LMS`}>
  <div class="max-w-6xl mx-auto space-y-6 pb-12">
    <!-- Breadcrumb & Back -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 dark:text-slate-400">
        <a href="/dashboard" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Bảng điều khiển
        </a>
        <span>/</span>
        {cls && (
          <>
            <span class="text-gray-700 dark:text-slate-300 font-bold">{cls.name}</span>
            <span>/</span>
          </>
        )}
        <span class="text-indigo-600 dark:text-indigo-400 font-bold">Xem bài giao</span>
      </div>

      <div class="flex items-center gap-2">
        {assignment.deadline && (
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-900/40 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Hạn: {new Date(assignment.deadline).toLocaleDateString('vi-VN')}
          </span>
        )}
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-900/40">
          Lớp {cls?.name || '12'}
        </span>
      </div>
    </div>

    <!-- Assignment Banner -->
    <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-slate-900 rounded-3xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>
      <div class="relative z-10 space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-white/10 backdrop-blur-md text-indigo-200 border border-white/10">
            {assignment.type === 'material' ? '📄 Tài liệu & Video' : assignment.type === 'exam' ? '📝 Đề thi' : '📘 Khóa học'}
          </span>
          <span class="text-xs text-indigo-200/80">
            Giao ngày {new Date(assignment.assigned_at).toLocaleDateString('vi-VN')}
          </span>
        </div>

        <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight">
          {assignment.ref_title || 'Tài liệu học tập'}
        </h1>

        {assignment.note && (
          <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/10 backdrop-blur-md border border-white/10 max-w-3xl text-sm text-indigo-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-300 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p><strong class="font-bold text-white">Lời dặn của giáo viên:</strong> {assignment.note}</p>
          </div>
        )}

        <!-- Status Badges for student -->
        <div class="flex items-center gap-3 pt-1 flex-wrap text-xs">
          <div id="doc-status-badge" class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold transition ${hasDoc ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'hidden'}`}>
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="doc-status-text">Đang ghi nhận xem tài liệu...</span>
          </div>

          <div id="yt-status-badge" class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-bold transition ${hasVideo ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'hidden'}`}>
            <span class="w-2 h-2 rounded-full bg-rose-400"></span>
            <span id="yt-status-text">Phát video để ghi nhận xem YouTube</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Viewer Section -->
    <div class="space-y-4">
      <!-- Viewer Tabs / Switcher (if both doc & video exist) -->
      {hasDoc && hasVideo && (
        <div class="flex items-center justify-between flex-wrap gap-2 p-1.5 bg-gray-100 dark:bg-slate-800 rounded-2xl border border-gray-200 dark:border-slate-700/60 max-w-md">
          <button id="tab-btn-doc" class="flex-1 py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 bg-white dark:bg-slate-700 text-gray-900 dark:text-white shadow-sm">
            <span>📄</span> Tài liệu
          </button>
          <button id="tab-btn-video" class="flex-1 py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white">
            <span>🎥</span> Video YouTube
          </button>
          <button id="tab-btn-both" class="hidden md:flex flex-1 py-2 px-3 rounded-xl text-xs font-bold transition items-center justify-center gap-1.5 text-gray-500 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white">
            <span>⚡</span> Song song
          </button>
        </div>
      )}

      <!-- Main Viewer Area -->
      <div id="viewer-container" class="grid grid-cols-1 gap-6 transition-all">
        <!-- ── DOCUMENT VIEWER FRAME ──────────────────────────────────────── -->
        {hasDoc && (
          <div id="panel-doc" class="bg-white dark:bg-slate-900 rounded-3xl border border-gray-200 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col">
            <!-- Frame Header -->
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-gray-100 dark:border-slate-800 bg-gray-50/70 dark:bg-slate-800/40">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
                  {isPdf ? 'PDF' : isWord ? 'DOC' : isPpt ? 'PPT' : 'FILE'}
                </div>
                <div>
                  <h3 class="font-bold text-sm text-gray-900 dark:text-white flex items-center gap-1.5">
                    Khung xem tài liệu
                    <span class="text-xs px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 font-semibold">
                      {driveEmbedUrl ? 'Google Drive' : isPdf ? 'PDF Viewer' : isWord ? 'Word' : isPpt ? 'PowerPoint' : 'Viewer'}
                    </span>
                  </h3>
                  <p class="text-[11px] text-gray-400 dark:text-slate-500">Xem trực tiếp nội dung bài học ngay bên dưới</p>
                </div>
              </div>

              <!-- Tools -->
              <div class="flex items-center gap-2">
                {assignment.attachment_url && (
                  <a
                    href={assignment.attachment_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-slate-300 hover:text-indigo-600 hover:border-indigo-500 transition inline-flex items-center gap-1"
                    title="Mở tài liệu trong tab mới hoặc tải về"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Mở tab mới
                  </a>
                )}
                {isWord || isPpt ? (
                  <button
                    id="btn-switch-viewer"
                    class="px-2.5 py-1.5 rounded-xl text-xs font-semibold bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 hover:bg-gray-200 transition"
                    title="Chuyển đổi giữa Google Viewer và Office Viewer"
                  >
                    Đổi chế độ xem
                  </button>
                ) : null}
              </div>
            </div>

            <!-- Frame Content -->
            <div class="relative w-full bg-slate-100 dark:bg-slate-950 min-h-[600px] h-[75vh]">
              <iframe
                id="doc-iframe"
                src={docEmbedUrl}
                class="w-full h-full border-0"
                allow="autoplay; fullscreen"
                title="Khung xem tài liệu học tập"
              ></iframe>
            </div>
          </div>
        )}

        <!-- ── YOUTUBE PLAYER FRAME ───────────────────────────────────────── -->
        {hasVideo && youtubeId && (
          <div id="panel-video" class="bg-white dark:bg-slate-900 rounded-3xl border border-gray-200 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col">
            <!-- Frame Header -->
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-gray-100 dark:border-slate-800 bg-gray-50/70 dark:bg-slate-800/40">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-rose-100 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-sm text-gray-900 dark:text-white flex items-center gap-1.5">
                    Video bài giảng YouTube
                    <span class="text-xs px-2 py-0.5 rounded-md bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 font-semibold">
                      Tự động ghi nhận lượt xem
                    </span>
                  </h3>
                  <p class="text-[11px] text-gray-400 dark:text-slate-500">Bấm phát để xem video và hoàn thành bài được giao</p>
                </div>
              </div>

              {assignment.youtube_url && (
                <a
                  href={assignment.youtube_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-slate-300 hover:text-rose-600 hover:border-rose-500 transition inline-flex items-center gap-1"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  Xem trên YouTube
                </a>
              )}
            </div>

            <!-- Frame Content (16:9 Aspect Ratio) -->
            <div class="relative w-full bg-black aspect-video flex items-center justify-center">
              <div id="youtube-player" class="w-full h-full"></div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ assignmentId, hasDoc, hasVideo, youtubeId, attachmentUrl: assignment.attachment_url, isWord, isPpt }}>
  // ── VIEW TRACKING HELPER ───────────────────────────────────────────────────
  let recordedDoc = false;
  let recordedYt = false;

  async function recordView(viewType) {
    try {
      const res = await fetch(`/api/assignments/${assignmentId}/view`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ viewType }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        if (viewType === 'document') {
          recordedDoc = true;
          const statusText = document.getElementById('doc-status-text');
          const statusBadge = document.getElementById('doc-status-badge');
          if (statusText) statusText.textContent = `✓ Đã ghi nhận xem tài liệu (${data.data.document_views} lần)`;
          if (statusBadge) {
            statusBadge.classList.remove('bg-emerald-500/20', 'text-emerald-300');
            statusBadge.classList.add('bg-emerald-600', 'text-white');
          }
        } else if (viewType === 'youtube') {
          recordedYt = true;
          const statusText = document.getElementById('yt-status-text');
          const statusBadge = document.getElementById('yt-status-badge');
          if (statusText) statusText.textContent = `✓ Đã ghi nhận xem YouTube (${data.data.youtube_views} lần)`;
          if (statusBadge) {
            statusBadge.classList.remove('bg-rose-500/20', 'text-rose-300');
            statusBadge.classList.add('bg-rose-600', 'text-white');
          }
        }
      }
    } catch (err) {
      console.error('Lỗi ghi nhận view:', err);
    }
  }

  // ── RECORD DOCUMENT VIEW AUTOMATICALLY ON LOAD ──────────────────────────────
  if (hasDoc) {
    // Record after 2 seconds to make sure student actually stayed to view
    setTimeout(() => {
      recordView('document');
    }, 2000);
  }

  // ── YOUTUBE IFRAME API ─────────────────────────────────────────────────────
  if (hasVideo && youtubeId) {
    // Load YouTube API
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    window.onYouTubeIframeAPIReady = function () {
      new window.YT.Player('youtube-player', {
        videoId: youtubeId,
        playerVars: {
          autoplay: 0,
          rel: 0,
          modestbranding: 1,
          enablejsapi: 1,
        },
        events: {
          onStateChange: function (event) {
            // YT.PlayerState.PLAYING === 1
            if (event.data === window.YT.PlayerState.PLAYING && !recordedYt) {
              recordView('youtube');
            }
          },
        },
      });
    };
  }

  // ── SWITCH DOCUMENT VIEWER MODE (Google / Office) ──────────────────────────
  if (isWord || isPpt) {
    let mode = 'google';
    document.getElementById('btn-switch-viewer')?.addEventListener('click', () => {
      const iframe = document.getElementById('doc-iframe');
      if (!iframe || !attachmentUrl) return;
      if (mode === 'google') {
        mode = 'office';
        iframe.src = `https://view.officeapps.live.com/op/embed.aspx?src=${encodeURIComponent(attachmentUrl)}`;
      } else {
        mode = 'google';
        iframe.src = `https://docs.google.com/viewer?url=${encodeURIComponent(attachmentUrl)}&embedded=true`;
      }
    });
  }

  // ── TAB SWITCHER (DOC / VIDEO / BOTH) ──────────────────────────────────────
  if (hasDoc && hasVideo) {
    const btnDoc = document.getElementById('tab-btn-doc');
    const btnVideo = document.getElementById('tab-btn-video');
    const btnBoth = document.getElementById('tab-btn-both');
    const panelDoc = document.getElementById('panel-doc');
    const panelVideo = document.getElementById('panel-video');
    const container = document.getElementById('viewer-container');

    function setActiveTab(tab) {
      const activeClass = ['bg-white', 'dark:bg-slate-700', 'text-gray-900', 'dark:text-white', 'shadow-sm'];
      const inactiveClass = ['text-gray-500', 'dark:text-slate-400'];

      [btnDoc, btnVideo, btnBoth].forEach(b => {
        if (!b) return;
        b.classList.remove(...activeClass);
        b.classList.add(...inactiveClass);
      });

      if (tab === 'doc') {
        btnDoc?.classList.add(...activeClass);
        btnDoc?.classList.remove(...inactiveClass);
        panelDoc?.classList.remove('hidden');
        panelVideo?.classList.add('hidden');
        container?.classList.remove('grid-cols-1', 'lg:grid-cols-2');
        container?.classList.add('grid-cols-1');
      } else if (tab === 'video') {
        btnVideo?.classList.add(...activeClass);
        btnVideo?.classList.remove(...inactiveClass);
        panelDoc?.classList.add('hidden');
        panelVideo?.classList.remove('hidden');
        container?.classList.remove('grid-cols-1', 'lg:grid-cols-2');
        container?.classList.add('grid-cols-1');
      } else if (tab === 'both') {
        btnBoth?.classList.add(...activeClass);
        btnBoth?.classList.remove(...inactiveClass);
        panelDoc?.classList.remove('hidden');
        panelVideo?.classList.remove('hidden');
        container?.classList.remove('grid-cols-1');
        container?.classList.add('lg:grid-cols-2');
      }
    }

    btnDoc?.addEventListener('click', () => setActiveTab('doc'));
    btnVideo?.addEventListener('click', () => setActiveTab('video'));
    btnBoth?.addEventListener('click', () => setActiveTab('both'));
  }
</script>
